{
  "name": "chord-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chord — High-Performance, Zero-Electron Alternative Discord Desktop Client with Pure Rust Core, DAVE MLS v1 E2EE Voice, and Tauri 2",
  "keywords": [
    "discord",
    "discord-client",
    "tauri",
    "tauri2",
    "rust",
    "alternative-discord-client",
    "lightweight-discord",
    "dave-mls",
    "e2ee-voice",
    "webrtc",
    "pipewire",
    "wayland",
    "zero-electron",
    "krisp-noise-suppression",
    "linux-discord",
    "desktop-app",
    "clean-room"
  ],
  "bin": {
    "chord": "./bin/chord.mjs",
    "discord-lab": "./bin/discord-lab.mjs"
  },
  "scripts": {
    "git:status": "node scripts/git-sync.mjs status",
    "git:pull": "node scripts/git-sync.mjs pull",
    "git:check": "node scripts/git-sync.mjs check",
    "git:push": "node scripts/git-sync.mjs push",
    "git:sync": "node scripts/git-sync.mjs sync",
    "git:watch": "node scripts/git-sync.mjs watch",
    "tdd:sync": "node scripts/sync-tdd-plan.mjs --fix",
    "auto:driver": "node scripts/orchestration-auto-driver.mjs --once",
    "auto:driver:watch": "node scripts/orchestration-auto-driver.mjs --watch 15",
    "roadmap:audit": "node scripts/roadmap-audit.mjs",
    "roadmap:sync": "node scripts/roadmap-audit.mjs --sync",
    "test:rust": "bash scripts/test-all-rust.sh",
    "test:stress": "node scripts/stress-fts5.mjs --messages 10000 --threads 2",
    "audit:bridges": "node scripts/audit-thin-bridges.mjs",
    "audit:deadcode": "node scripts/clean-dead-code.mjs",
    "routine:detect": "node scripts/worker-routine-detector.mjs --scan",
    "routine:fix": "node scripts/worker-routine-detector.mjs --auto-fix",
    "scaffold:dto": "node scripts/scaffold-dto.mjs",
    "slots:reserve": "node scripts/reserve-slots.mjs --reserve 15",
    "slots:dispatch": "node scripts/reserve-slots.mjs --dispatch 15",
    "slots:status": "node scripts/reserve-slots.mjs --status",
    "audit:security": "bash scripts/security-audit-deps.sh && node scripts/security-shield.mjs",
    "generate:ipc": "node scripts/generate-ipc-bridges.mjs",
    "autopilot": "node scripts/pipeline-auto-pilot.mjs --once",
    "autopilot:daemon": "node scripts/pipeline-auto-pilot.mjs --daemon 20",
    "harvest": "node scripts/auto-worker-harvester.mjs --once",
    "gate:quick": "bash scripts/quick-gate.sh",
    "ram:guard": "bash scripts/worker-ram-guard.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.agent.json && tsc -p rust/gui-spike/ui/tsconfig.json",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:unit": "node --test 'tests/unit/**/*.test.mjs'",
    "test:meta": "node --test 'tests/meta/**/*.test.mjs'",
    "test:smoke": "node --test 'tests/smoke/**/*.test.mjs'",
    "test:e2e": "node --test --test-concurrency=1 'tests/e2e/**/*.test.mjs'",
    "test:watch": "node --test --watch 'tests/unit/**/*.test.mjs'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=90 --test-coverage-functions=80 --test-coverage-branches=90 'tests/unit/**/*.test.mjs'",
    "check": "npm run typecheck && npm test",
    "precheck": "node scripts/precheck.mjs",
    "dev:gui": "bash scripts/gui-run.sh start",
    "gui:start": "bash scripts/gui-run.sh start",
    "gui:stop": "bash scripts/gui-run.sh stop",
    "gui:status": "bash scripts/gui-run.sh status",
    "orca:status": "bash scripts/orca-slim.sh",
    "sync:push": "bash scripts/sync-push.sh",
    "ci:pause": "bash scripts/ci-pause.sh",
    "tdd:red": "bash scripts/tdd-runner.sh --red",
    "tdd:green": "bash scripts/tdd-runner.sh --green",
    "protocol:check": "bash scripts/protocol-sync.sh check",
    "protocol:pr": "bash scripts/protocol-sync.sh pr-summary",
    "audit:scope": "bash scripts/scope-audit.sh",
    "report:worker": "bash scripts/worker-report.sh",
    "wave:accept": "bash scripts/wave-accept.sh",
    "review:scaffold": "bash scripts/review-scaffold.sh",
    "worktree:prune": "bash scripts/worktree-prune.sh",
    "dependabot:batch": "bash scripts/dependabot-batch.sh",
    "worker:rotate": "bash scripts/worker-rotate.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "gate:worker": "node scripts/gate.mjs --scope worker",
    "gate:release": "node scripts/gate.mjs --scope release",
    "gate:qualify": "node scripts/gate.mjs --scope qualify",
    "workers:monitor": "bash scripts/workers-monitor.sh",
    "auto:commit": "bash scripts/auto-commit-push.sh",
    "golden:freeze": "node scripts/gate.mjs --freeze-golden",
    "gate:mutation": "node scripts/mutation-gate.mjs",
    "auto:status": "bash scripts/auto-loop.sh --status",
    "auto:step": "bash scripts/auto-loop.sh --step",
    "auto:watch": "bash scripts/auto-loop.sh --watch",
    "ops": "node scripts/chord-ops.mjs",
    "gc": "node scripts/worker-gc.mjs",
    "inspect:monolith": "node scripts/monolith-inspector.mjs",
    "kanban:status": "bash scripts/auto-loop.sh --kanban status",
    "kanban:list": "bash scripts/auto-loop.sh --kanban list",
    "pr:scan": "node scripts/pr-collaborator.mjs scan",
    "pr:plan": "node scripts/pr-collaborator.mjs plan",
    "pr:rework": "node scripts/pr-collaborator.mjs rework",
    "pr:approve": "bash scripts/pr.sh approve",
    "pr:salvage": "node scripts/pr-collaborator.mjs salvage",
    "protocol:sync": "node scripts/protocol-daemon.mjs --once",
    "protocol:watch": "node scripts/protocol-daemon.mjs --watch",
    "protocol:status": "node scripts/protocol-daemon.mjs --status",
    "pr:inspect": "bash scripts/pr.sh inspect",
    "pr:audit": "bash scripts/pr.sh audit",
    "pr:comment": "bash scripts/pr.sh comment",
    "pr:request-changes": "bash scripts/pr.sh request-changes",
    "pr:template": "bash scripts/pr.sh template",
    "bus": "node scripts/agent-bus.mjs",
    "bus:status": "node scripts/agent-bus.mjs status",
    "collab": "bash scripts/collab.sh",
    "rust:slim": "bash scripts/rust-slim.sh",
    "contract:lint": "node scripts/contract-lint.mjs",
    "kanban:sync": "bash scripts/kanban-sync.sh",
    "pr:quarantine": "bash scripts/pr-quarantine.sh",
    "test:visual": "node scripts/visual-diff.mjs",
    "security:shield": "node scripts/security-shield.mjs",
    "docs:graph": "node scripts/docs-graph.mjs",
    "docs:lint": "node scripts/docs-lint.mjs",
    "docs:sync": "node scripts/docs-graph.mjs && node scripts/docs-lint.mjs",
    "socrati:health": "bash scripts/socrati-guard.sh",
    "socrati:impact": "node scripts/socrati-impact.mjs",
    "socrati:search": "node scripts/socrati-search.mjs",
    "socrati:hub": "node scripts/socrati-hub-check.mjs",
    "socrati:cycles": "node scripts/socrati-cycles.mjs",
    "socrati:auto-test": "node scripts/socrati-impact.mjs --run",
    "socrati:analyze": "node scripts/socrati-analyzer.mjs",
    "socrati:scaffold": "node scripts/socrati-scaffold-test.mjs",
    "socrati:suite": "node scripts/socrati-smart-suite.mjs",
    "socrati:dashboard": "node scripts/socrati-dashboard.mjs",
    "qa:auto": "node scripts/qa-auto-suite.mjs --auto",
    "qa:rootless": "node scripts/qa-auto-suite.mjs --rootless",
    "qa:memory": "node scripts/qdrant-qa-memory.mjs",
    "doom:guard": "node scripts/doom-loop-guard.mjs",
    "qa:inspect": "node scripts/qa-inspector.mjs",
    "qa:modals": "node scripts/modal-fsm-suite.mjs",
    "qa:scaffold": "node scripts/qa-scaffold.mjs",
    "gui:audit": "node scripts/gui-parity-audit.mjs",
    "gui:live": "node scripts/gui-live-e2e.mjs",
    "gui:watch": "node scripts/gui-watch.mjs",
    "test:gui:live": "node scripts/gui-live-e2e.mjs",
    "test:all": "node scripts/qa-auto-system.mjs",
    "test:audit": "node scripts/test-auditor.mjs",
    "qa:system": "node scripts/qa-auto-system.mjs",
    "codemap": "node scripts/socrati-codemap.mjs",
    "test:gen": "node scripts/auto-test-generator.mjs",
    "plan:fix": "node scripts/plan-autofix.mjs",
    "trace:calls": "node scripts/app-call-tracer.mjs",
    "fix:routine": "node scripts/auto-fix-routine.mjs",
    "branch:audit": "node scripts/branch-auditor.mjs",
    "branch:prune": "node scripts/branch-auditor.mjs --prune-stale"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@preact/signals-core": "^1.14.5",
    "@tanstack/virtual-core": "^3.19.11",
    "frida": "17.26.3",
    "tinykeys": "^4.0.1"
  },
  "allowScripts": {
    "frida@17.23.2": true
  },
  "devDependencies": {
    "@types/frida-gum": "^19.13.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
