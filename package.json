{
  "name": "chord-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chord — High-performance native GPU desktop client and clean-room protocol analysis tools",
  "bin": {
    "chord": "./bin/chord.mjs",
    "discord-lab": "./bin/discord-lab.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.agent.json",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:unit": "node --test 'tests/unit/**/*.test.mjs'",
    "test:meta": "node --test 'tests/meta/**/*.test.mjs'",
    "test:smoke": "node --test 'tests/smoke/**/*.test.mjs'",
    "test:e2e": "node --test --test-concurrency=1 'tests/e2e/**/*.test.mjs'",
    "test:watch": "node --test --watch 'tests/unit/**/*.test.mjs'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=90 --test-coverage-functions=80 --test-coverage-branches=90 'tests/unit/**/*.test.mjs'",
    "check": "npm run typecheck && npm test",
    "gate:worker": "node scripts/gate.mjs --scope worker",
    "gate:release": "node scripts/gate.mjs --scope release",
    "gate:qualify": "node scripts/gate.mjs --scope qualify",
    "golden:freeze": "node scripts/gate.mjs --freeze-golden",
    "gate:mutation": "node scripts/mutation-gate.mjs",
    "auto:status": "bash scripts/auto-loop.sh --status",
    "auto:step": "bash scripts/auto-loop.sh --step",
    "auto:watch": "bash scripts/auto-loop.sh --watch",
    "ops": "node scripts/chord-ops.mjs",
    "gc": "node scripts/worker-gc.mjs",
    "inspect:monolith": "node scripts/monolith-inspector.mjs",
    "kanban:status": "bash scripts/auto-loop.sh --kanban status",
    "kanban:list": "bash scripts/auto-loop.sh --kanban list",
    "pr:scan": "node scripts/pr-collaborator.mjs scan",
    "pr:plan": "node scripts/pr-collaborator.mjs plan",
    "pr:rework": "node scripts/pr-collaborator.mjs rework",
    "pr:approve": "node scripts/pr-collaborator.mjs approve",
    "pr:salvage": "node scripts/pr-collaborator.mjs salvage",
    "protocol:sync": "node scripts/protocol-daemon.mjs --once",
    "protocol:watch": "node scripts/protocol-daemon.mjs --watch",
    "protocol:status": "node scripts/protocol-daemon.mjs --status",
    "pr:inspect": "bash scripts/pr.sh inspect",
    "pr:audit": "bash scripts/pr.sh audit",
    "pr:comment": "bash scripts/pr.sh comment",
    "pr:request-changes": "bash scripts/pr.sh request-changes",
    "pr:approve": "bash scripts/pr.sh approve",
    "pr:template": "bash scripts/pr.sh template",
    "bus": "node scripts/agent-bus.mjs",
    "bus:status": "node scripts/agent-bus.mjs status"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "frida": "17.26.2"
  },
  "allowScripts": {
    "frida@17.23.2": true
  },
  "devDependencies": {
    "@types/frida-gum": "^19.13.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
