#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct IdlePolicy {
    /// С какого времени бездействия статус становится `Idle`.
    pub idle_after_secs: u64,
    /// С какого времени бездействия статус становится `Dnd`.
    pub dnd_after_secs: u64,
}

impl IdlePolicy {
    /// 10 минут до `Idle`, 30 минут до `Dnd` — конфигурация, не подтверждённый RE-факт.
    pub const DEFAULT: Self = Self {
        idle_after_secs: 600,
        dnd_after_secs: 1800,
    };

    /// Статус по времени бездействия.
    ///
    /// `idle_after == dnd_after` → `Dnd` уже при `>=`; нулевые пороги срабатывают сразу;
    /// сравнения только `u64`, без арифметики — переполнение невозможно.
    pub fn status(&self, idle_secs: u64) -> PresenceStatus {
        if idle_secs >= self.dnd_after_secs {
            PresenceStatus::Dnd
        } else if idle_secs >= self.idle_after_secs {
            PresenceStatus::Idle
        } else {
            PresenceStatus::Online
        }
    }
}
//! Контракт P6-06: питание и idle через freedesktop D-Bus (`ScreenSaver`, `login1`).
//!
//! Независимый оракул — приватный `dbus-daemon` (`--session --print-address --fork`) и
//! мок-сервисы `waves/RW-31/power/mock_power.py` на **libdbus** (`python3-dbus`): они
//! регистрируют `org.freedesktop.ScreenSaver` и `org.freedesktop.login1`, журналируют
//! вызовы (TSV) и эмитят `PrepareForSleep`/чужие сигналы. Rust-код здесь — только клиент,
//! поэтому поведение не может быть «подогнано» под свою же реализацию.
//!
//! Skip-aware: нет `dbus-daemon`, `python3-dbus`/`gi` или мок не поднялся → тест печатает
//! `SKIP: <причина>` и завершается успешно (окружение недоступно, а не падение).
//!
//! Live-проверка (`p11`) выключена по умолчанию и только читает состояние
//! (`IsActive`/`GetSessionIdleTime`): экран не гасится, ингибитор не ставится.

use discord_platform::dbus::{BusAddress, Connection, DbusError, Value};
use discord_platform::power::{
    IdlePolicy, PowerEvent, PowerMonitor, PresenceStatus, ScreenSaver, LOGIN1_DESTINATION,
    LOGIN1_INTERFACE, LOGIN1_PATH, SCREENSAVER_DESTINATION, SCREENSAVER_INTERFACE,
    SCREENSAVER_PATH, SLEEP_SIGNAL,
};
use std::fs;
use std::path::{Path, PathBuf};
use std::process::{Child, Command, Stdio};
use std::time::{Duration, Instant};

const SKIP_NO_DAEMON: &str = "нет dbus-daemon";
const SKIP_NO_PYTHON: &str = "нет python3 с модулями dbus и gi";
const MOCK_DESTINATION: &str = "lab.Mock";
const MOCK_PATH: &str = "/lab/Mock";
const MOCK_INTERFACE: &str = "lab.Mock.Power";

/// Приватная шина + мок-сервисы; всё убирается в `Drop`.
struct Harness {
    address: String,
    journal: PathBuf,
    dir: PathBuf,
    daemon_pid: u32,
    mock: Child,
}

impl Harness {
    fn start(extra_mock_args: &[&str]) -> Result<Self, String> {
        if !command_exists("dbus-daemon") {
            return Err(SKIP_NO_DAEMON.to_owned());
        }
        if !python_dbus_available() {
            return Err(SKIP_NO_PYTHON.to_owned());
        }

        let dir = std::env::temp_dir().join(format!(
            "discord-lab-w31a-{}-{}",
            std::process::id(),
            unique_suffix()
        ));
        fs::create_dir_all(&dir).map_err(|err| format!("tempdir {}: {err}", dir.display()))?;

        let started = Command::new("dbus-daemon")
            .args(["--session", "--print-address=1", "--print-pid=1", "--fork"])
            .output()
            .map_err(|err| format!("запуск dbus-daemon: {err}"))?;
        if !started.status.success() {
            return Err(format!(
                "dbus-daemon завершился: {}",
                String::from_utf8_lossy(&started.stderr).trim()
            ));
        }
        let stdout = String::from_utf8_lossy(&started.stdout).into_owned();
        let mut lines = stdout.lines().filter(|line| !line.trim().is_empty());
        let address = lines
            .next()
            .ok_or_else(|| "dbus-daemon не напечатал адрес".to_owned())?
            .trim()
            .to_owned();
        let daemon_pid: u32 = lines
            .next()
            .ok_or_else(|| "dbus-daemon не напечатал pid".to_owned())?
            .trim()
            .parse()
            .map_err(|err| format!("pid dbus-daemon: {err}"))?;

        let journal = dir.join("journal.tsv");
        let mut mock = Command::new("python3")
            .arg(repo_path("waves/RW-31/power/mock_power.py"))
            .arg("--address")
            .arg(&address)
            .arg("--log")
            .arg(&journal)
            .args(extra_mock_args)
            .stdout(Stdio::null())
            .stderr(Stdio::piped())
            .spawn()
            .map_err(|err| format!("запуск mock_power.py: {err}"))?;

        let deadline = Instant::now() + Duration::from_secs(10);
        loop {
            if fs::read_to_string(&journal)
                .map(|text| text.contains("READY"))
                .unwrap_or(false)
            {
                break;
            }
            if let Ok(Some(status)) = mock.try_wait() {
                let stderr = read_child_stderr(&mut mock);
                return Err(format!("мок-питание завершился ({status}): {stderr}"));
            }
            if Instant::now() > deadline {
                return Err("мок-питание не поднялся за 10 с".to_owned());
            }
            std::thread::sleep(Duration::from_millis(50));
        }

        Ok(Self {
            address,
            journal,
            dir,
            daemon_pid,
            mock,
        })
    }

    fn bus_address(&self) -> BusAddress {
        BusAddress::parse(&self.address).expect("адрес приватного демона")
    }

    fn journal(&self) -> Vec<Vec<String>> {
        fs::read_to_string(&self.journal)
            .unwrap_or_default()
            .lines()
            .map(|line| line.split('\t').map(str::to_owned).collect())
            .collect()
    }

    fn journal_member(&self, member: &str) -> Vec<Vec<String>> {
        self.journal()
            .into_iter()
            .filter(|fields| fields.first().map(String::as_str) == Some(member))
            .collect()
    }

    /// Ждёт появления `count` записей журнала (мок пишет их асинхронно).
    fn wait_for_member(&self, member: &str, count: usize) -> Vec<Vec<String>> {
        let deadline = Instant::now() + Duration::from_secs(5);
        loop {
            let records = self.journal_member(member);
            if records.len() >= count || Instant::now() > deadline {
                return records;
            }
            std::thread::sleep(Duration::from_millis(20));
        }
    }

    fn kill_daemon(&mut self) {
        let _ = Command::new("kill")
            .arg(self.daemon_pid.to_string())
            .status();
        self.daemon_pid = 0;
    }
}

impl Drop for Harness {
    fn drop(&mut self) {
        let _ = self.mock.kill();
        let _ = self.mock.wait();
        if self.daemon_pid != 0 {
            let _ = Command::new("kill")
                .arg(self.daemon_pid.to_string())
                .status();
        }
        let _ = fs::remove_dir_all(&self.dir);
    }
}

fn read_child_stderr(child: &mut Child) -> String {
    use std::io::Read as _;
    let mut text = String::new();
    if let Some(stderr) = child.stderr.as_mut() {
        let _ = stderr.read_to_string(&mut text);
    }
    text.trim().to_owned()
}

fn repo_path(relative: &str) -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("../../..")
        .join(relative)
}

fn command_exists(name: &str) -> bool {
    Command::new("sh")
        .arg("-c")
        .arg(format!("command -v {name}"))
        .stdout(Stdio::null())
        .stderr(Stdio::null())
        .status()
        .map(|status| status.success())
        .unwrap_or(false)
}

/// Та же проба, но с явным PATH — используется в `p12` для проверки skip-ветки.
fn command_exists_in_path(path: &str, name: &str) -> bool {
    Command::new("sh")
        .arg("-c")
        .arg(format!("PATH={path} command -v {name}"))
        .stdout(Stdio::null())
        .stderr(Stdio::null())
        .status()
        .map(|status| status.success())
        .unwrap_or(false)
}

fn python_dbus_available() -> bool {
    Command::new("python3")
        .args(["-c", "import dbus, gi"])
        .stdout(Stdio::null())
        .stderr(Stdio::null())
        .status()
        .map(|status| status.success())
        .unwrap_or(false)
}

/// Готовность окружения без запуска стенда: причина skip или `Ok(())`.
fn environment_ready() -> Result<(), String> {
    if !command_exists("dbus-daemon") {
        return Err(SKIP_NO_DAEMON.to_owned());
    }
    if !python_dbus_available() {
        return Err(SKIP_NO_PYTHON.to_owned());
    }
    Ok(())
}

fn unique_suffix() -> u64 {
    use std::sync::atomic::{AtomicU64, Ordering};
    static COUNTER: AtomicU64 = AtomicU64::new(0);
    let nanos = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|duration| duration.as_nanos() as u64)
        .unwrap_or(0);
    nanos ^ (COUNTER.fetch_add(1, Ordering::Relaxed) << 32)
}

/// Запускает стенд или печатает причину skip и выходит из теста.
macro_rules! harness {
    ($extra:expr) => {
        match Harness::start($extra) {
            Ok(harness) => harness,
            Err(reason) => {
                println!("SKIP: {reason}");
                return;
            }
        }
    };
}

fn control_connection(harness: &Harness) -> Connection {
    Connection::connect(&harness.bus_address()).expect("управляющее соединение с моком")
}

fn call_control(connection: &mut Connection, member: &str, body: &[(char, Value)]) {
    connection
        .call(MOCK_DESTINATION, MOCK_PATH, MOCK_INTERFACE, member, body)
        .unwrap_or_else(|err| panic!("{member}: {err:?}"));
}

// --- JSON-фикстура (минимальный парсер, как в dbus_contract) ---------------------

#[derive(Debug)]
enum Json {
    Null,
    Bool(bool),
    Num(f64),
    Str(String),
    Arr(Vec<Json>),
    Obj(Vec<(String, Json)>),
}

impl Json {
    fn parse(text: &str) -> Result<Self, String> {
        let mut parser = JsonParser {
            bytes: text.as_bytes(),
            pos: 0,
        };
        let value = parser.value()?;
        parser.skip_ws();
        if parser.pos != parser.bytes.len() {
            return Err(format!("мусор после JSON на позиции {}", parser.pos));
        }
        Ok(value)
    }

    fn get(&self, key: &str) -> Option<&Json> {
        match self {
            Self::Obj(entries) => entries
                .iter()
                .find(|(name, _)| name == key)
                .map(|(_, value)| value),
            _ => None,
        }
    }

    fn as_str(&self) -> Option<&str> {
        match self {
            Self::Str(value) => Some(value),
            _ => None,
        }
    }

    fn as_u64(&self) -> Option<u64> {
        match self {
            Self::Num(value) if *value >= 0.0 => Some(*value as u64),
            _ => None,
        }
    }

    fn as_bool(&self) -> Option<bool> {
        match self {
            Self::Bool(value) => Some(*value),
            _ => None,
        }
    }

    fn as_arr(&self) -> Option<&[Json]> {
        match self {
            Self::Arr(items) => Some(items),
            _ => None,
        }
    }
}

struct JsonParser<'a> {
    bytes: &'a [u8],
    pos: usize,
}

impl JsonParser<'_> {
    fn skip_ws(&mut self) {
        while matches!(self.bytes.get(self.pos), Some(b' ' | b'\n' | b'\r' | b'\t')) {
            self.pos += 1;
        }
    }

    fn expect(&mut self, byte: u8) -> Result<(), String> {
        if self.bytes.get(self.pos) == Some(&byte) {
            self.pos += 1;
            Ok(())
        } else {
            Err(format!(
                "ожидался {:?} на позиции {}",
                byte as char, self.pos
            ))
        }
    }

    fn value(&mut self) -> Result<Json, String> {
        self.skip_ws();
        match self.bytes.get(self.pos).copied() {
            Some(b'{') => self.object(),
            Some(b'[') => self.array(),
            Some(b'"') => Ok(Json::Str(self.string()?)),
            Some(b't') => self.literal("true", Json::Bool(true)),
#!/usr/bin/env python3
"""Мутационная проверка контракта W31a (питание и idle).

Каждая мутация — один точечный дефект в `discord-platform/src/power.rs`. Ожидание:
targeted-тесты `power_contract` падают (мутация «убита»). Файл восстанавливается из
снимка, совпадение md5 до/после обязательно.

Запуск (из корня репозитория):
    CARGO_TARGET_DIR=/tmp/opencode/target-w31a python3 waves/RW-31/run-mutations-w31a.py

Код выхода: 0 — все мутации убиты и файл восстановлен; 1 — выжившая мутация,
ошибка восстановления или сбой запуска тестов.
"""

import hashlib
import os
import re
import subprocess
import sys

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
CRATE = os.path.join(REPO_ROOT, "rust", "crates", "discord-platform")
POWER = os.path.join(CRATE, "src", "power.rs")
LOG_PATH = os.path.join(REPO_ROOT, "waves", "RW-31", "mutations-w31a.log")
WORKDIR = os.path.join(REPO_ROOT, "rust")
TESTS = ["--test", "power_contract"]

# (id, имя, фрагмент-оригинал, фрагмент-мутация, что должен поймать)
MUTATIONS = [
    (
        "01",
        "policy_idle_boundary_off_by_one",
        """        } else if idle_secs >= self.idle_after_secs {""",
        """        } else if idle_secs > self.idle_after_secs {""",
        "p01: граница idle_after (600) съезжает на 601",
    ),
    (
        "02",
        "sleep_flag_reversed",
        """        [Value::Bool(true)] => Some(PowerEvent::GoingToSleep),
        [Value::Bool(false)] => Some(PowerEvent::WakingUp),""",
        """        [Value::Bool(true)] => Some(PowerEvent::WakingUp),
        [Value::Bool(false)] => Some(PowerEvent::GoingToSleep),""",
        "p06: true/false у PrepareForSleep перепутаны",
    ),
    (
        "03",
        "timeout_becomes_error",
        """                Err(DbusError::Timeout) => return Ok(None),""",
        """                Err(DbusError::Timeout) => return Err(DbusError::Timeout),""",
        "p08: таймаут next_event становится ошибкой вместо Ok(None)",
    ),
    (
        "04",
        "unknown_method_is_fatal",
        """fn is_unknown_member(name: &str) -> bool {
    matches!(
        name,
        "org.freedesktop.DBus.Error.UnknownMethod"
            | "org.freedesktop.DBus.Error.UnknownInterface"
    )
}""",
        """fn is_unknown_member(name: &str) -> bool {
    let _ = name;
    false
}""",
        "p05: UnknownMethod/UnknownInterface больше не дают Ok(None)",
    ),
    (
        "05",
        "cookie_off_by_one",
        """            Some(Value::U32(cookie)) => Ok(cookie),""",
        """            Some(Value::U32(cookie)) => Ok(cookie.wrapping_add(1)),""",
        "p02/p03: cookie ингибитора сдвинут на 1",
    ),
    (
        "06",
        "signal_filter_accepts_garbage",
        """        [Value::Bool(true)] => Some(PowerEvent::GoingToSleep),
        [Value::Bool(false)] => Some(PowerEvent::WakingUp),
        _ => None,""",
        """        [Value::Bool(true)] => Some(PowerEvent::GoingToSleep),
        [Value::Bool(false)] => Some(PowerEvent::WakingUp),
        _ => Some(PowerEvent::GoingToSleep),""",
        "p07: PrepareForSleep с чужим телом принимается за событие",
    ),
    (
        "07",
        "uninhibit_fallback_removed",
        """            Err(DbusError::Remote { name, .. }) if is_unknown_member(&name) => {
                self.call(UNINHIBIT_FALLBACK_METHOD, "u", &body)?;
                Ok(())
            }""",
        """            Err(DbusError::Remote { name, .. }) if is_unknown_member(&name) => {
                Err(DbusError::Remote {
                    name,
                    message: "fallback disabled".to_owned(),
                })
            }""",
        "p03: нет fallback UnInhibit → Uninhibit",
    ),
]

TEST_LINE = re.compile(r"^test (\S+) \.\.\. FAILED$", re.MULTILINE)
SUMMARY = re.compile(r"^test result: FAILED\..*$", re.MULTILINE)


def md5(path):
    with open(path, "rb") as handle:
        return hashlib.md5(handle.read()).hexdigest()


def run_tests():
    env = dict(os.environ)
    env.setdefault("CARGO_TARGET_DIR", "/tmp/opencode/target-w31a")
    command = ["cargo", "test", "--offline", "-p", "discord-platform"] + TESTS
    completed = subprocess.run(
        command,
        cwd=WORKDIR,
        env=env,
        capture_output=True,
        text=True,
        check=False,
    )
    return completed.returncode, completed.stdout + completed.stderr


def main():
    lines = ["# W31a — мутации питания/idle", ""]
    failures = []

    baseline_code, baseline_output = run_tests()
    baseline_skips = baseline_output.count("SKIP:")
    baseline_ok = baseline_code == 0 and "test result: ok" in baseline_output
    lines.append("baseline: exit=%d, SKIP=%d" % (baseline_code, baseline_skips))
    if not baseline_ok or baseline_skips:
        lines.append("ОСТАНОВ: базовый прогон не зелёный или содержит SKIP")
        lines.append(baseline_output[-4000:])
        write_log(lines)
        return 1
    lines.append("")

    for mutation_id, name, original, mutated, expectation in MUTATIONS:
        before_md5 = md5(POWER)
        with open(POWER, encoding="utf-8") as handle:
            source = handle.read()
        if original not in source:
            failures.append("%s: фрагмент не найден" % mutation_id)
            lines.append("## %s %s — ОШИБКА: фрагмент не найден" % (mutation_id, name))
            continue

        lines.append("## %s %s" % (mutation_id, name))
        lines.append("ждём: %s" % expectation)
        lines.append("md5 до: %s" % before_md5)

        try:
            with open(POWER, "w", encoding="utf-8") as handle:
                handle.write(source.replace(original, mutated, 1))
            code, output = run_tests()
            failing = sorted(set(TEST_LINE.findall(output)))
            skips = output.count("SKIP:")
            killed = code != 0 and "test result: FAILED" in output and skips == 0
            verdict = "KILLED" if killed else ("INCONCLUSIVE (SKIP)" if skips else "SURVIVED")
            lines.append("exit: %d, SKIP=%d — %s" % (code, skips, verdict))
            if failing:
                lines.append("упавшие тесты: %s" % ", ".join(failing))
            for match in SUMMARY.findall(output):
                lines.append("  %s" % match)
            if not failing:
                tail = [line for line in output.splitlines() if line.startswith("error")]
                lines.append("вывод: %s" % " | ".join(tail[:3]))
            if not killed:
                failures.append("%s %s: %s" % (mutation_id, name, verdict))
        finally:
            with open(POWER, "w", encoding="utf-8") as handle:
                handle.write(source)
            after_md5 = md5(POWER)
            lines.append(
                "md5 после restore: %s — %s"
                % (after_md5, "OK" if after_md5 == before_md5 else "РАСХОЖДЕНИЕ")
            )
            if after_md5 != before_md5:
                failures.append("%s: md5 после восстановления не совпал" % mutation_id)
        lines.append("")

    lines.append("## Итог")
    lines.append("мутаций: %d" % len(MUTATIONS))
    if failures:
        lines.append("проблемы: %s" % "; ".join(failures))
        write_log(lines)
        return 1
    lines.append("все мутации убиты, все файлы восстановлены")
    write_log(lines)
    return 0


def write_log(lines):
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, "w", encoding="utf-8") as handle:
        handle.write("\n".join(lines) + "\n")
    print("\n".join(lines[-8:]))
    print("\nлог: %s" % LOG_PATH)


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Мок-сервисы питания на libdbus для контрактных тестов W31a.

Оракул независим от Rust-реализации: сервисы и транспорт — python3-dbus (libdbus) на
приватном `dbus-daemon`. На одной шине поднимаются два well-known имени:

- `org.freedesktop.ScreenSaver` (`/org/freedesktop/ScreenSaver`): `Inhibit`, `UnInhibit`,
  алиас `Uninhibit` (fallback), `IsActive`, `GetSessionIdleTime`. `GetSessionIdleTime`
  умеет отвечать значением или D-Bus-ошибкой (`UnknownMethod`/`UnknownInterface`/своя),
  чтобы проверить ветку `Ok(None)`/`Err` контракта.
- `org.freedesktop.login1` (`/org/freedesktop/login1`, интерфейс Manager): сигнал
  `PrepareForSleep(b)`; методами не пользуется — клиент только `AddMatch`.

Управляющий интерфейс `lab.Mock.Power` на `/lab/Mock`: `EmitPrepareForSleep(b)`,
`EmitForeign()`, `SetActive(b)`, `SetIdleMode(s)`, `SetIdleSeconds(u)`.

CLI:
    mock_power.py --address <unix:path=...> --log <file>
                  [--cookie-start 41] [--active] [--idle-seconds 1234]
                  [--idle-mode value|unknown-method|unknown-interface|error]
                  [--force-uninhibit-alias]

Журнал вызовов — TSV-строки (первое поле — член вызова):
    READY
    Inhibit\t<app_name>\t<reason>\t<cookie>
    UnInhibit\t<cookie>
    Uninhibit\t<cookie>
    IsActive\t<0|1>
    GetSessionIdleTime\t<mode>\t<seconds>
    EmitPrepareForSleep\t<1|0>
    EmitForeign
    SetActive\t<1|0>
    SetIdleMode\t<mode>
    SetIdleSeconds\t<seconds>

Сервис ничего не пишет в stderr в штатном режиме (тест читает журнал файлом).
"""

import argparse
import os
import sys

import dbus
import dbus.lowlevel
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

SCREENSAVER_DESTINATION = "org.freedesktop.ScreenSaver"
SCREENSAVER_PATH = "/org/freedesktop/ScreenSaver"
SCREENSAVER_IFACE = "org.freedesktop.ScreenSaver"

LOGIN1_DESTINATION = "org.freedesktop.login1"
LOGIN1_PATH = "/org/freedesktop/login1"
LOGIN1_IFACE = "org.freedesktop.login1.Manager"

CONTROL_PATH = "/lab/Mock"
CONTROL_IFACE = "lab.Mock.Power"
CONTROL_DESTINATION = "lab.Mock"

IDLE_MODES = ("value", "unknown-method", "unknown-interface", "error")


class MockScreenSaver(dbus.service.Object):
    def __init__(self, bus, log_path, cookie_start, active, idle_seconds, idle_mode, force_alias):
        super().__init__(bus, SCREENSAVER_PATH)
        self._log_path = log_path
        self._next_cookie = cookie_start
        self._issued = set()
        self._active = active
        self._idle_seconds = idle_seconds
        self._idle_mode = idle_mode
        self._force_uninhibit_alias = force_alias

    def _log(self, *fields):
        with open(self._log_path, "a", encoding="utf-8") as handle:
            handle.write("\t".join(str(field) for field in fields) + "\n")
            handle.flush()
            os.fsync(handle.fileno())

    def _consume_cookie(self, cookie):
        if cookie not in self._issued:
            # Неизвестный cookie — ошибка сервера: клиент обязан вернуть Err, не паниковать.
            raise dbus.exceptions.DBusException(
                "unknown cookie %d" % cookie,
                name="org.freedesktop.ScreenSaver.Error.InvalidCookie",
            )
        self._issued.discard(cookie)

    @dbus.service.method(SCREENSAVER_IFACE, in_signature="ss", out_signature="u")
    def Inhibit(self, app_name, reason):
        cookie = self._next_cookie
        self._next_cookie += 1
        self._issued.add(cookie)
        self._log("Inhibit", str(app_name), str(reason), cookie)
        return dbus.UInt32(cookie)

    @dbus.service.method(SCREENSAVER_IFACE, in_signature="u", out_signature="")
    def UnInhibit(self, cookie):
        self._log("UnInhibit", int(cookie))
        if self._force_uninhibit_alias:
            # Сервис без `UnInhibit` (только `Uninhibit`): клиент обязан попробовать алиас.
            raise dbus.exceptions.DBusException(
                "mock exposes only Uninhibit",
                name="org.freedesktop.DBus.Error.UnknownMethod",
            )
        self._consume_cookie(int(cookie))

    @dbus.service.method(SCREENSAVER_IFACE, in_signature="u", out_signature="")
    def Uninhibit(self, cookie):
        self._log("Uninhibit", int(cookie))
        self._consume_cookie(int(cookie))

    @dbus.service.method(SCREENSAVER_IFACE, in_signature="", out_signature="b")
    def IsActive(self):
        self._log("IsActive", 1 if self._active else 0)
        return dbus.Boolean(self._active)

    @dbus.service.method(SCREENSAVER_IFACE, in_signature="", out_signature="u")
    def GetSessionIdleTime(self):
        self._log("GetSessionIdleTime", self._idle_mode, self._idle_seconds)
        if self._idle_mode == "unknown-method":
            raise dbus.exceptions.DBusException(
                "GetSessionIdleTime is not implemented",
                name="org.freedesktop.DBus.Error.UnknownMethod",
            )
        if self._idle_mode == "unknown-interface":
            raise dbus.exceptions.DBusException(
                "org.freedesktop.ScreenSaver is not implemented",
                name="org.freedesktop.DBus.Error.UnknownInterface",
            )
        if self._idle_mode == "error":
            raise dbus.exceptions.DBusException(
                "mock idle failure",
                name="org.freedesktop.ScreenSaver.Error.MockFailure",
            )
        return dbus.UInt32(self._idle_seconds)

    # --- управление из теста (не входит в контракт ScreenSaver) -----------------

    def set_active(self, active):
        self._active = bool(active)
        self._log("SetActive", 1 if self._active else 0)

    def set_idle_mode(self, mode):
        self._idle_mode = mode
        self._log("SetIdleMode", mode)

    def set_idle_seconds(self, seconds):
        self._idle_seconds = int(seconds)
        self._log("SetIdleSeconds", int(seconds))


class MockLogin1(dbus.service.Object):
    def __init__(self, bus, log_path):
        super().__init__(bus, LOGIN1_PATH)
        self._bus = bus
        self._log_path = log_path

    def _log(self, *fields):
        with open(self._log_path, "a", encoding="utf-8") as handle:
            handle.write("\t".join(str(field) for field in fields) + "\n")
            handle.flush()
            os.fsync(handle.fileno())

    @dbus.service.signal(LOGIN1_IFACE, signature="b")
    def PrepareForSleep(self, start):
        pass

    def emit_prepare_for_sleep(self, start):
        self._log("EmitPrepareForSleep", 1 if start else 0)
        self.PrepareForSleep(dbus.Boolean(start))

    def emit_foreign(self):
        """Шлёт чужие сигналы: другой интерфейс и PrepareForSleep с телом `s`."""
        self._log("EmitForeign")
        ping = dbus.lowlevel.SignalMessage(CONTROL_PATH, "lab.Mock.Ping", "Ping")
        ping.append(dbus.String("foreign"), signature="s")
        self._bus.send_message(ping)

