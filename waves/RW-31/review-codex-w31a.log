   353	
   354	    fn value(&mut self) -> Result<Json, String> {
   355	        self.skip_ws();
   356	        match self.bytes.get(self.pos).copied() {
   357	            Some(b'{') => self.object(),
   358	            Some(b'[') => self.array(),
   359	            Some(b'"') => Ok(Json::Str(self.string()?)),
   360	            Some(b't') => self.literal("true", Json::Bool(true)),
   361	            Some(b'f') => self.literal("false", Json::Bool(false)),
   362	            Some(b'n') => self.literal("null", Json::Null),
   363	            Some(byte) if byte == b'-' || byte.is_ascii_digit() => self.number(),
   364	            other => Err(format!(
   365	                "неожиданный байт {other:?} на позиции {}",
   366	                self.pos
   367	            )),
   368	        }
   369	    }
   370	
   371	    fn literal(&mut self, text: &str, value: Json) -> Result<Json, String> {
   372	        if self.bytes[self.pos..].starts_with(text.as_bytes()) {
   373	            self.pos += text.len();
   374	            Ok(value)
   375	        } else {
   376	            Err(format!("ожидался литерал {text} на позиции {}", self.pos))
   377	        }
   378	    }
   379	
   380	    fn number(&mut self) -> Result<Json, String> {
   381	        let start = self.pos;
   382	        if self.bytes.get(self.pos) == Some(&b'-') {
   383	            self.pos += 1;
   384	        }
   385	        while matches!(self.bytes.get(self.pos), Some(byte) if byte.is_ascii_digit()) {
   386	            self.pos += 1;
   387	        }
   388	        if self.bytes.get(self.pos) == Some(&b'.') {
   389	            self.pos += 1;
   390	            while matches!(self.bytes.get(self.pos), Some(byte) if byte.is_ascii_digit()) {
   391	                self.pos += 1;
   392	            }
   393	        }
   394	        let text =
   395	            std::str::from_utf8(&self.bytes[start..self.pos]).map_err(|err| err.to_string())?;
   396	        text.parse::<f64>()
   397	            .map(Json::Num)
   398	            .map_err(|err| format!("число {text:?}: {err}"))
   399	    }
   400	
   401	    fn string(&mut self) -> Result<String, String> {
   402	        self.expect(b'"')?;
   403	        let mut out = String::new();
   404	        loop {
   405	            let Some(&byte) = self.bytes.get(self.pos) else {
   406	                return Err("незакрытая строка".to_owned());
   407	            };
   408	            self.pos += 1;
   409	            match byte {
   410	                b'"' => return Ok(out),
   411	                b'\\' => {
   412	                    let Some(&escaped) = self.bytes.get(self.pos) else {
   413	                        return Err("незакрытый escape".to_owned());
   414	                    };
   415	                    self.pos += 1;
   416	                    out.push(match escaped {
   417	                        b'"' => '"',
   418	                        b'\\' => '\\',
   419	                        b'n' => '\n',
   420	                        b't' => '\t',
   421	                        b'r' => '\r',
   422	                        other => return Err(format!("escape \\{}", other as char)),
   423	                    });
   424	                }
   425	                _ => out.push(byte as char),
   426	            }
   427	        }
   428	    }
   429	
   430	    fn array(&mut self) -> Result<Json, String> {
   431	        self.expect(b'[')?;
   432	        let mut items = Vec::new();
   433	        self.skip_ws();
   434	        if self.bytes.get(self.pos) == Some(&b']') {
   435	            self.pos += 1;
   436	            return Ok(Json::Arr(items));
   437	        }
   438	        loop {
   439	            items.push(self.value()?);
   440	            self.skip_ws();
   441	            match self.bytes.get(self.pos) {
   442	                Some(b',') => self.pos += 1,
   443	                Some(b']') => {
   444	                    self.pos += 1;
   445	                    return Ok(Json::Arr(items));
   446	                }
   447	                other => return Err(format!("ожидался ',' или ']', получено {other:?}")),
   448	            }
   449	        }
   450	    }
   451	
   452	    fn object(&mut self) -> Result<Json, String> {
   453	        self.expect(b'{')?;
   454	        let mut entries = Vec::new();
   455	        self.skip_ws();
   456	        if self.bytes.get(self.pos) == Some(&b'}') {
   457	            self.pos += 1;
   458	            return Ok(Json::Obj(entries));
   459	        }
   460	        loop {
   461	            self.skip_ws();
   462	            let key = self.string()?;
   463	            self.skip_ws();
   464	            self.expect(b':')?;
   465	            let value = self.value()?;
   466	            entries.push((key, value));
   467	            self.skip_ws();
   468	            match self.bytes.get(self.pos) {
   469	                Some(b',') => self.pos += 1,
   470	                Some(b'}') => {
   471	                    self.pos += 1;
   472	                    return Ok(Json::Obj(entries));
   473	                }
   474	                other => return Err(format!("ожидался ',' или '}}', получено {other:?}")),
   475	            }
   476	        }
   477	    }
   478	}
