   199	    /// `sqlite3_exec`: один или несколько SQL-операторов без параметров.
   200	    pub(crate) fn exec(&self, sql: &str) -> Result<(), FfiError> {
   201	        let c_sql =
   202	            CString::new(sql).map_err(|_| FfiError::new(SQLITE_MISUSE, "SQL содержит NUL-байт"))?;
   203	        let mut error_message: *mut c_char = ptr::null_mut();
   204	        // SAFETY: handle жив; `c_sql` — валидная C-строка; callback = None (результат не нужен),
   205	        // `error_message` — out-параметр, который SQLite заполнит через sqlite3_malloc.
   206	        let code = unsafe {
   207	            sqlite3_exec(
   208	                self.raw.as_ptr(),
   209	                c_sql.as_ptr(),
   210	                None,
   211	                ptr::null_mut(),
   212	                &mut error_message,
   213	            )
   214	        };
   215	        let text = if error_message.is_null() {
   216	            None
   217	        } else {
