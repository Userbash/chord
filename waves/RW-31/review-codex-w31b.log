            }
            CStr::from_ptr(pointer).to_string_lossy().into_owned()
        }
    }

    fn extended_errcode(&self) -> i32 {
        // SAFETY: `raw` — живой handle соединения, функция только читает его состояние.
        unsafe { sqlite3_extended_errcode(self.raw.as_ptr()) }
    }

    fn failure(&self, fallback: c_int) -> FfiError {
        let code = self.extended_errcode();
        FfiError::new(
            if code == SQLITE_OK { fallback } else { code },
            self.errmsg(),
        )
    }

    /// `sqlite3_exec`: один или несколько SQL-операторов без параметров.
    pub(crate) fn exec(&self, sql: &str) -> Result<(), FfiError> {
        let c_sql =
            CString::new(sql).map_err(|_| FfiError::new(SQLITE_MISUSE, "SQL содержит NUL-байт"))?;
        let mut error_message: *mut c_char = ptr::null_mut();
        // SAFETY: handle жив; `c_sql` — валидная C-строка; callback = None (результат не нужен),
        // `error_message` — out-параметр, который SQLite заполнит через sqlite3_malloc.
        let code = unsafe {
            sqlite3_exec(
                self.raw.as_ptr(),
                c_sql.as_ptr(),
                None,
                ptr::null_mut(),
                &mut error_message,
            )
        };
        let text = if error_message.is_null() {
            None
        } else {
            // SAFETY: SQLite выделила строку через sqlite3_malloc; читаем её до освобождения.
            let text = unsafe { CStr::from_ptr(error_message) }
                .to_string_lossy()
                .into_owned();
            // SAFETY: тот же указатель, выделенный SQLite, ещё не освобождён и больше не нужен.
            unsafe { sqlite3_free(error_message.cast()) };
            Some(text)
        };
        if code == SQLITE_OK {
            return Ok(());
        }
        Err(match text {
            Some(message) => FfiError::new(self.extended_errcode().max(code), message),
            None => self.failure(code),
        })
    }

    /// `PRAGMA busy_timeout` (мс): ждать блокировку записи, а не падать сразу.
    pub(crate) fn busy_timeout(&self, milliseconds: c_int) -> Result<(), FfiError> {
        // SAFETY: `raw` — живой handle; функция только настраивает соединение.
        let code = unsafe { sqlite3_busy_timeout(self.raw.as_ptr(), milliseconds) };
        if code == SQLITE_OK {
            Ok(())
        } else {
            Err(self.failure(code))
        }
    }

    /// Готовит один SQL-оператор с параметрами (`?1`, `?2`, …).
    pub(crate) fn prepare(&self, sql: &str) -> Result<Stmt<'_>, FfiError> {
        let c_sql =
            CString::new(sql).map_err(|_| FfiError::new(SQLITE_MISUSE, "SQL содержит NUL-байт"))?;
        let mut raw: *mut Sqlite3Stmt = ptr::null_mut();
        // SAFETY: handle жив; `c_sql` валиден; `bytes = -1` — читать до NUL; `tail` = NULL
        // (хвост после первого оператора не используется); `&mut raw` — out-параметр.
        let code = unsafe {
            sqlite3_prepare_v2(
                self.raw.as_ptr(),
                c_sql.as_ptr(),
                -1,
                &mut raw,
                ptr::null_mut(),
            )
        };
        match NonNull::new(raw) {
            Some(raw) if code == SQLITE_OK => Ok(Stmt { raw, db: self }),
            Some(raw) => {
                // SAFETY: SQLite вернула подготовленный statement — финализируем его ровно раз.
                unsafe { sqlite3_finalize(raw.as_ptr()) };
                Err(self.failure(code))
            }
            None => Err(self.failure(code)),
        }
    }

    /// Число строк, изменённых последним `INSERT`/`UPDATE`/`DELETE`.
    pub(crate) fn changes(&self) -> u64 {
        // SAFETY: `raw` — живой handle соединения.
        let count = unsafe { sqlite3_changes(self.raw.as_ptr()) };
        u64::try_from(count).unwrap_or(0)
    }
}

impl Drop for Db {
    fn drop(&mut self) {
        // SAFETY: handle открыт в `open` и ещё не закрыт; statement'ы не могут пережить `Db`
        // (их держит заимствование `&Db`), поэтому close не вернёт SQLITE_BUSY. Код закрытия
        // не проверяем: освобождать handle всё равно больше нечем.
        unsafe {
            sqlite3_close(self.raw.as_ptr());
        }
    }
}

/// Подготовленный statement. Финализируется в `Drop`; живёт не дольше своего `Db`.
pub(crate) struct Stmt<'a> {
    raw: NonNull<Sqlite3Stmt>,
    db: &'a Db,
}

impl Stmt<'_> {
    fn check(&self, code: c_int) -> Result<(), FfiError> {
        if code == SQLITE_OK {
            Ok(())
        } else {
            Err(self.db.failure(code))
        }
    }

    fn index(column: usize) -> Result<c_int, FfiError> {
        c_int::try_from(column)
            .map_err(|_| FfiError::new(SQLITE_RANGE, "индекс параметра/колонки вне c_int"))
    }

    /// Биндит текст. Внутренний NUL недопустим (C-строка) — ошибка, а не обрезание.
    pub(crate) fn bind_text(&mut self, index: usize, value: &str) -> Result<(), FfiError> {
        let c_value = CString::new(value)
            .map_err(|_| FfiError::new(SQLITE_MISUSE, "значение содержит NUL-байт"))?;
        let bytes = c_int::try_from(c_value.as_bytes().len())
            .map_err(|_| FfiError::new(SQLITE_RANGE, "значение длиннее c_int"))?;
        let index = Self::index(index)?;
        // SAFETY: statement жив; `c_value` валиден на время вызова; SQLITE_TRANSIENT просит
        // SQLite скопировать данные сразу, поэтому указатель после вызова не хранится.
        let code = unsafe {
            sqlite3_bind_text(
                self.raw.as_ptr(),
                index,
                c_value.as_ptr(),
                bytes,
                SQLITE_TRANSIENT,
            )
        };
        self.check(code)
    }

    pub(crate) fn bind_i64(&mut self, index: usize, value: i64) -> Result<(), FfiError> {
        let index = Self::index(index)?;
        // SAFETY: statement жив; биндинг целого не владеет памятью.
        let code = unsafe { sqlite3_bind_int64(self.raw.as_ptr(), index, value) };
        self.check(code)
    }

    pub(crate) fn bind_null(&mut self, index: usize) -> Result<(), FfiError> {
        let index = Self::index(index)?;
        // SAFETY: statement жив; биндинг NULL не владеет памятью.
        let code = unsafe { sqlite3_bind_null(self.raw.as_ptr(), index) };
        self.check(code)
    }

    /// Шаг выполнения: `Row` — есть строка (колонки можно читать), `Done` — конец.
    pub(crate) fn step(&mut self) -> Result<Step, FfiError> {
        // SAFETY: statement жив и подготовлен; вызов можно повторять до `Done`.
        let code = unsafe { sqlite3_step(self.raw.as_ptr()) };
        match code {
            SQLITE_ROW => Ok(Step::Row),
            SQLITE_DONE => Ok(Step::Done),
            _ => Err(self.db.failure(code)),
        }
    }

    /// Сбрасывает statement для повторного использования (параметры сохраняются).
    #[allow(dead_code)] // часть согласованного FFI-слота (TZ §1): переиспользование prepare
    pub(crate) fn reset(&mut self) -> Result<(), FfiError> {
        // SAFETY: statement жив и не выполняется в этот момент (владение `&mut self`).
        let code = unsafe { sqlite3_reset(self.raw.as_ptr()) };
        self.check(code)
    }

    /// Снимает все биндинги (после `reset` statement готов к новым значениям).
    #[allow(dead_code)] // часть согласованного FFI-слота (TZ §1)
    pub(crate) fn clear_bindings(&mut self) -> Result<(), FfiError> {
        // SAFETY: statement жив; функция только очищает биндинги.
        let code = unsafe { sqlite3_clear_bindings(self.raw.as_ptr()) };
        self.check(code)
    }

    /// Число колонок в результате.
    #[allow(dead_code)] // диагностический слот FFI; прикладной код читает колонки по индексу
    pub(crate) fn column_count(&self) -> c_int {
        // SAFETY: statement жив и подготовлен.
        unsafe { sqlite3_column_count(self.raw.as_ptr()) }
    }

    /// `true`, если колонка текущей строки — SQL NULL.
    pub(crate) fn column_is_null(&self, column: usize) -> Result<bool, FfiError> {
        let column = Self::index(column)?;
        // SAFETY: statement жив; вызывающий читает колонки только после `Step::Row`.
        let kind = unsafe { sqlite3_column_type(self.raw.as_ptr(), column) };
        Ok(kind == SQLITE_NULL)
    }

    /// Значение TEXT текущей строки; `None` для SQL NULL.
    pub(crate) fn column_text(&self, column: usize) -> Result<Option<String>, FfiError> {
        let column = Self::index(column)?;
        // SAFETY: statement жив; вызывающий читает колонки только после `Step::Row`.
        // `sqlite3_column_type` различает SQL NULL от пустой строки — без этого NULL
        // превратился бы в `Some("")`.
        let kind = unsafe { sqlite3_column_type(self.raw.as_ptr(), column) };
        if kind == SQLITE_NULL {
            return Ok(None);
        }
        // SAFETY: statement жив; `sqlite3_column_text` конвертирует значение и возвращает
        // указатель на буфер, принадлежащий statement; `sqlite3_column_bytes` даёт длину.
        let (pointer, bytes) = unsafe {
            (
                sqlite3_column_text(self.raw.as_ptr(), column),
                sqlite3_column_bytes(self.raw.as_ptr(), column),
            )
        };
        if pointer.is_null() {
            // Нулевая длина может вернуть NULL-указатель — это пустая строка, не NULL.
            return if bytes == 0 {
                Ok(Some(String::new()))
            } else {
                Err(FfiError::new(
                    SQLITE_CORRUPT,
                    "колонка TEXT вернула NULL-указатель",
                ))
            };
        }
        let length = usize::try_from(bytes)
            .map_err(|_| FfiError::new(SQLITE_CORRUPT, "длина колонки отрицательна"))?;
        // SAFETY: `pointer` валиден для `length` байт, пока statement не сдвинут на новую
        // строку; копируем данные в Vec до возврата управления вызывающему.
        let data = unsafe { slice::from_raw_parts(pointer, length) }.to_vec();
        String::from_utf8(data)
            .map(Some)
            .map_err(|_| FfiError::new(SQLITE_CORRUPT, "колонка TEXT не является UTF-8"))
    }

    /// Значение INTEGER текущей строки (для NULL вернёт 0 — проверяйте `column_is_null`).
    pub(crate) fn column_i64(&self, column: usize) -> Result<i64, FfiError> {
        let column = Self::index(column)?;
        // SAFETY: statement жив; чтение INTEGER не владеет памятью.
        Ok(unsafe { sqlite3_column_int64(self.raw.as_ptr(), column) })
    }
}

impl Drop for Stmt<'_> {
    fn drop(&mut self) {
        // SAFETY: statement подготовлен в `prepare`/`Db::prepare` и ещё не финализирован;
        // код возврата не нужен — это освобождение ресурса, ошибок вызывающему не вернуть.
        unsafe {
            sqlite3_finalize(self.raw.as_ptr());
        }
    }
}
[package]
name = "discord-store"
version.workspace = true
edition.workspace = true
license.workspace = true
description = "Локальное хранилище (SQLite) и миграции схемы"

[lints.rust]
unsafe_code = "deny"
# Каркас нативного клиента Discord на Rust (фазы P0/P1 плана docs/rust-client/PLAN.md).
# Внешние зависимости: ruzstd 0.9.1 (чистый Rust, карточка RW-02) и — с RW-04 — транспорт
# шлюза: tokio/tokio-tungstenite (WS), rustls с провайдером ring, webpki-roots, futures-util;
# dev-зависимость `zstd` (C-энкодер) — только для стабов в тестах. После первой сборки (сеть,
# разрешение владельца 2026-10-19) тесты идут офлайн (`cargo test --offline`).
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.package]
version = "0.1.0"
edition = "2024"
license = "MIT OR Apache-2.0"
rust-version = "1.87"

[workspace.dependencies]
discord-json = { path = "crates/discord-json" }
discord-codec = { path = "crates/discord-codec" }
discord-core = { path = "crates/discord-core" }
discord-conformance = { path = "crates/discord-conformance" }
# Транспорт шлюза (RW-04). Версии — стартовые из ТЗ, точные фиксирует Cargo.lock.
tokio = { version = "1.53", features = ["rt-multi-thread", "macros", "net", "time"] }
tokio-tungstenite = { version = "0.30", features = ["rustls-tls-webpki-roots"] }
# TLS-провайдер ring (не aws-lc-rs: без cmake/nasm), tls12 оставлен для совместимости.
rustls = { version = "0.23", default-features = false, features = ["ring", "std", "tls12"] }
# HTTP/1.1-транспорт REST (RW-10, решение владельца — вариант A): TLS поверх tokio.
# Версии уже в Cargo.lock/офлайн-кэше; сетевых загрузок нет.
tokio-rustls = { version = "0.26", default-features = false, features = ["ring", "tls12"] }
httparse = "1"
webpki-roots = "1"
futures-util = { version = "0.3", default-features = false, features = ["sink", "std"] }
# Энкодер zstd — только для стабов тестов (продукт на чтении использует ruzstd).
zstd = "0.14"
#!/usr/bin/env python3
"""Независимый оракул файла БД `discord-store` (RW-31, W31b).

Читает **только сам файл** через stdlib `sqlite3` (Python 3, системная libsqlite3 3.54) и
печатает построчный отчёт `ключ=значение`, поля через `|`. Никакого доступа к Rust-коду и
никакого доверия к его утверждениям: схема берётся из `sqlite_master`/`PRAGMA table_info`,
данные — обычным SQL, а порядок и keyset-пагинация **перепроверяются в Python** (сортировка
кортежей и фильтр «строго меньше курсора»), результат сравнения — `order_matches` и
`keyset_matches`.

Формат полей:
  table=<имя>
  index=<таблица>|<имя>
  index_column=<индекс>|<seqno>|<колонка>
  column=<таблица>|<колонка>|<тип>|<notnull>|<pk>
  message=<id>|<channel_id>|<author_id>|<timestamp>|<edited|->|<flags>|<deleted>|<content_hex>
  channel=<id>|<guild_id|->|<name_hex>|<kind>|<position>
  kv=<key>|<value>

Запуск:
    python3 waves/RW-31/sqlite/oracle.py /path/to/store.db

Код выхода: 0 — отчёт напечатан; 1 — БД не читается или схема не соответствует v1;
2 — ошибка аргументов.
"""

import sqlite3
import sys

MESSAGE_COLUMNS = (
    "id",
    "channel_id",
    "author_id",
    "timestamp",
    "edited_timestamp",
    "flags",
    "deleted",
    "content",
)


def quote(name):
    """Идентификатор для PRAGMA (параметры там не поддерживаются)."""
    return '"' + name.replace('"', '""') + '"'


def emit(lines, key, value):
    lines.append("%s=%s" % (key, value))


def enc(text):
    return "" if text is None else str(text).encode("utf-8").hex()


def dec(row):
    return {
        "id": row[0],
        "channel_id": row[1],
        "author_id": row[2],
        "timestamp": row[3],
        "edited_timestamp": row[4],
        "flags": row[5],
        "deleted": row[6],
        "content": row[7],
    }


def report(conn, lines):
    emit(lines, "sqlite_version", sqlite3.sqlite_version)
    emit(lines, "user_version", conn.execute("PRAGMA user_version").fetchone()[0])
    emit(lines, "journal_mode", conn.execute("PRAGMA journal_mode").fetchone()[0].lower())
    emit(lines, "integrity_check", conn.execute("PRAGMA integrity_check").fetchone()[0])
    emit(lines, "foreign_key_violations", len(conn.execute("PRAGMA foreign_key_check").fetchall()))

    tables = [
        name
        for (name,) in conn.execute(
            "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name"
        )
    ]
    for name in tables:
        emit(lines, "table", name)
        for cid, column, kind, notnull, _default, pk in conn.execute(
            "PRAGMA table_info(%s)" % quote(name)
        ):
            emit(lines, "column", "%s|%s|%s|%d|%d" % (name, column, kind or "", notnull, pk))

    for name, table in conn.execute(
        "SELECT name, tbl_name FROM sqlite_master WHERE type = 'index' AND name NOT LIKE 'sqlite_%' ORDER BY name"
    ):
        emit(lines, "index", "%s|%s" % (table, name))
        for seqno, _cid, column in conn.execute("PRAGMA index_info(%s)" % quote(name)):
            emit(lines, "index_column", "%s|%d|%s" % (name, seqno, column))

    if "channels" in tables:
        for row in conn.execute(
            "SELECT id, guild_id, name, kind, position FROM channels ORDER BY id"
        ):
            emit(
                lines,
                "channel",
                "%s|%s|%s|%d|%d"
                % (row[0], "-" if row[1] is None else row[1], enc(row[2]), row[3], row[4]),
            )

    if "messages" in tables:
        cursor = conn.execute(
            "SELECT %s FROM messages ORDER BY timestamp DESC, id DESC" % ", ".join(MESSAGE_COLUMNS)
        )
        rows = [dec(row) for row in cursor]
        for row in rows:
            emit(
                lines,
                "message",
                "%s|%s|%s|%d|%s|%d|%d|%s"
                % (
                    row["id"],
                    row["channel_id"],
                    row["author_id"],
                    row["timestamp"],
                    "-" if row["edited_timestamp"] is None else row["edited_timestamp"],
                    row["flags"],
                    row["deleted"],
                    enc(row["content"]),
                ),
            )
        emit(
            lines,
            "duplicate_ids",
            conn.execute(
                "SELECT count(*) FROM (SELECT id FROM messages GROUP BY id HAVING count(*) > 1)"
            ).fetchone()[0],
        )
        # Независимая проверка порядка: SQL ORDER BY против сортировки кортежей в Python.
        expected = sorted(rows, key=lambda row: (row["timestamp"], row["id"]), reverse=True)
        emit(lines, "order_matches", int([r["id"] for r in rows] == [r["id"] for r in expected]))
        # Независимая проверка keyset-пагинации от самого нового сообщения.
        if expected:
            head = expected[0]
            keyset = [
                row_id
                for (row_id,) in conn.execute(
                    "SELECT id FROM messages WHERE deleted = 0"
                    " AND (timestamp < ? OR (timestamp = ? AND id < ?))"
                    " ORDER BY timestamp DESC, id DESC",
                    (head["timestamp"], head["timestamp"], head["id"]),
                )
            ]
            predicted = [
                row["id"]
                for row in expected
                if (row["timestamp"], row["id"]) < (head["timestamp"], head["id"])
            ]
            emit(lines, "keyset_matches", int(keyset == predicted))
            emit(lines, "keyset_size", len(keyset))
        else:
            emit(lines, "keyset_matches", 1)
            emit(lines, "keyset_size", 0)

    if "kv" in tables:
#!/usr/bin/env python3
"""Мутационная проверка контракта W31b (SQLite-store через FFI к `libsqlite3`).

Каждая мутация — один точечный дефект в продуктовом коде `discord-store`
(`src/lib.rs`). Ожидание: targeted-тесты `store_contract` падают (мутация «убита»).
`KILLED` — только если прогон вернул `test result: FAILED`, ненулевой exit code и **ноль**
`SKIP:` (иначе вердикт `INCONCLUSIVE`). Исходник восстанавливается из снимка, совпадение md5
до/после обязательно.

Запуск (из корня репозитория):
    CARGO_TARGET_DIR=/tmp/opencode/target-w31b python3 waves/RW-31/run-mutations-w31b.py

Код выхода: 0 — все мутации убиты и файлы восстановлены; 1 — выжившая мутация,
ошибка восстановления, не найден фрагмент или baseline не зелёный.
"""

import hashlib
import os
import re
import subprocess
import sys

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
LIB = os.path.join(REPO_ROOT, "rust", "crates", "discord-store", "src", "lib.rs")
LOG_PATH = os.path.join(REPO_ROOT, "waves", "RW-31", "mutations-w31b.log")
WORKDIR = os.path.join(REPO_ROOT, "rust")
TARGET_DIR = os.environ.get("CARGO_TARGET_DIR", "/tmp/opencode/target-w31b")
TESTS = ["--test", "store_contract", "--", "--nocapture"]

# (id, имя, фрагмент-оригинал, фрагмент-мутация, все вхождения?, что должен поймать)
MUTATIONS = [
    (
        "01",
        "foreign_keys_off",
        'self.db.exec("PRAGMA foreign_keys = ON")?;',
        'self.db.exec("PRAGMA foreign_keys = OFF")?;',
        False,
        "s06: FK выключен, сообщение без канала молча сохраняется",
    ),
    (
        "02",
        "order_by_asc",
        "ORDER BY timestamp DESC, id DESC",
        "ORDER BY timestamp ASC, id ASC",
        True,
        "s04/s05: обратный порядок истории и пагинации",
    ),
    (
        "03",
        "limit_clamp_removed",
        "let limit = limit.min(MAX_MESSAGES_LIMIT);",
        "let limit = limit;",
        False,
        "s04: limit > 1000 не клампится до 1000",
    ),
    (
        "04",
        "upsert_to_insert",
        """ON CONFLICT(id) DO UPDATE SET
    channel_id = excluded.channel_id,
    author_id = excluded.author_id,
    content = excluded.content,
    timestamp = excluded.timestamp,
    edited_timestamp = excluded.edited_timestamp,
    flags = excluded.flags,
    deleted = excluded.deleted
""",
        "",
        False,
        "s03: повторный put_message падает на PK вместо обновления",
    ),
    (
        "05",
        "soft_delete_flag_cleared",
        'self.db.prepare("UPDATE messages SET deleted = 1 WHERE id = ?1")?;',
        'self.db.prepare("UPDATE messages SET deleted = 0 WHERE id = ?1")?;',
        False,
        "s07: soft delete не скрывает сообщение из messages",
    ),
    (
        "06",
        "bind_to_concatenation",
        """                let mut statement = self.db.prepare(SQL_MESSAGES_BEFORE)?;
                statement.bind_text(1, channel_id)?;
                statement.bind_i64(2, timestamp)?;
                statement.bind_text(3, id)?;
                statement.bind_i64(4, limit)?;""",
        """                let sql = format!(
                    "SELECT id, channel_id, author_id, content, timestamp, edited_timestamp, flags, deleted \\
                     FROM messages WHERE channel_id = '{channel_id}' AND deleted = 0 \\
                     AND (timestamp < {timestamp} OR (timestamp = {timestamp} AND id < '{id}')) \\
                     ORDER BY timestamp DESC, id DESC LIMIT {limit}"
                );
                let mut statement = self.db.prepare(&sql)?;""",
        False,
        "s10: channel_id/id подставляются в SQL конкатенацией, враждебный id ломает запрос",
    ),
    (
        "07",
        "user_version_two",
        'self.db.exec("PRAGMA user_version = 1")?;',
        'self.db.exec("PRAGMA user_version = 2")?;',
        False,
        "s01/s12: версия схемы не 1 (повторный migrate упирается в Migration/оракул)",
    ),
]

TEST_LINE = re.compile(r"^test (\S+) \.\.\. FAILED$", re.MULTILINE)
SUMMARY = re.compile(r"^test result: FAILED\..*$", re.MULTILINE)


def md5(path):
    with open(path, "rb") as handle:
        return hashlib.md5(handle.read()).hexdigest()


def run_tests():
    env = dict(os.environ)
    env["CARGO_TARGET_DIR"] = TARGET_DIR
    command = ["cargo", "test", "--offline", "-p", "discord-store"] + TESTS
    completed = subprocess.run(
        command,
        cwd=WORKDIR,
        env=env,
        capture_output=True,
        text=True,
        check=False,
    )
    return completed.returncode, completed.stdout + completed.stderr


def write_log(lines):
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, "w", encoding="utf-8") as handle:
        handle.write("\n".join(lines) + "\n")
    print("\n".join(lines[-8:]))
    print("\nлог: %s" % LOG_PATH)


def main():
    lines = [
        "# W31b — мутации SQLite-store (`discord-store/src/lib.rs`)",
        "",
        "targeted: cargo test --offline -p discord-store --test store_contract -- --nocapture",
        "CARGO_TARGET_DIR=%s" % TARGET_DIR,
        "",
    ]
    failures = []

    baseline_code, baseline_output = run_tests()
    baseline_skips = baseline_output.count("SKIP:")
    baseline_ok = "test result: ok" in baseline_output
    lines.append(
        "baseline: exit=%d, SKIP=%d, test result ok=%s"
        % (baseline_code, baseline_skips, "да" if baseline_ok else "нет")
    )
    if baseline_code != 0 or not baseline_ok or baseline_skips:
        lines.append("ОСТАНОВ: базовый прогон не зелёный или содержит SKIP")
        lines.append(baseline_output[-4000:])
        write_log(lines)
        return 1
    lines.append("")

    for mutation_id, name, original, mutated, all_occurrences, expectation in MUTATIONS:
        before_md5 = md5(LIB)
        with open(LIB, encoding="utf-8") as handle:
            source = handle.read()
        occurrences = source.count(original)
        if occurrences == 0 or (occurrences > 1 and not all_occurrences):
            detail = "фрагмент не найден" if occurrences == 0 else "фрагмент не уникален (%d)" % occurrences
            failures.append("%s: %s" % (mutation_id, detail))
            lines.append("## %s %s — ОШИБКА: %s" % (mutation_id, name, detail))
            continue

        lines.append("## %s %s" % (mutation_id, name))
        lines.append("ждём: %s" % expectation)
        lines.append("вхождений: %d" % occurrences)
        lines.append("md5 до: %s" % before_md5)

        try:
            replace_count = -1 if all_occurrences else 1
            with open(LIB, "w", encoding="utf-8") as handle:
                handle.write(source.replace(original, mutated, replace_count))
            code, output = run_tests()
            failing = sorted(set(TEST_LINE.findall(output)))
            skips = output.count("SKIP:")
            failed_result = "test result: FAILED" in output
            killed = code != 0 and failed_result and skips == 0
            if skips:
                verdict = "INCONCLUSIVE (SKIP)"
            elif killed:
                verdict = "KILLED"
            else:
                verdict = "SURVIVED"
            lines.append("exit: %d, SKIP=%d — %s" % (code, skips, verdict))
            if failing:
                lines.append("упавшие тесты: %s" % ", ".join(failing))
            for match in SUMMARY.findall(output):
                lines.append("  %s" % match)
            if not killed:
                tail = [line for line in output.splitlines() if line.startswith("error")]
                lines.append("вывод: %s" % " | ".join(tail[:3]))
                failures.append("%s %s: %s" % (mutation_id, name, verdict))
        finally:
            with open(LIB, "w", encoding="utf-8") as handle:
                handle.write(source)
            after_md5 = md5(LIB)
            lines.append(
                "md5 после restore: %s — %s"
                % (after_md5, "OK" if after_md5 == before_md5 else "РАСХОЖДЕНИЕ")
            )
            if after_md5 != before_md5:
                failures.append("%s: md5 после восстановления не совпал" % mutation_id)
        lines.append("")

    lines.append("## Итог")
    lines.append("мутаций: %d" % len(MUTATIONS))
    if failures:
        lines.append("проблемы: %s" % "; ".join(failures))
        write_log(lines)
# REPORT W31b — P2-03 SQLite-store через FFI к системному libsqlite3

Батч: RW-31, карточка P2-03, seat STORE-1 / W31b. Дата: 2026-10-22.
Репозиторий: `discord-lab`, крейт `discord-store`. Решение владельца — **вариант A**
(`waves/RW-31/SQLITE-DECISION.md`). Сеть не использовалась, новых крейтов и правок workspace
`Cargo.toml`/`Cargo.lock` нет, `git commit/push` не выполнялись.

## 1. Границы

- Изменены/созданы только файлы ТЗ:
  - `rust/crates/discord-store/src/lib.rs` — безопасный API `Store` (переписан);
  - `rust/crates/discord-store/src/ffi.rs` — новый, единственное место с `unsafe`;
  - `rust/crates/discord-store/Cargo.toml` — одна строка: `unsafe_code = "forbid"` → `"deny"`;
  - `rust/crates/discord-store/tests/store_contract.rs` — новый контрактный тест s01–s14;
  - `waves/RW-31/sqlite/oracle.py` — независимый оракул (Python 3 stdlib `sqlite3`);
  - `waves/RW-31/run-mutations-w31b.py`, `waves/RW-31/mutations-w31b.log`,
    `waves/RW-31/workers/W31b/{red.log,green.log}`, этот отчёт.
- Не трогал: другие крейты, workspace `Cargo.toml`/`Cargo.lock`, чужие тесты, доки, golden,
  `package.json`. `CORE_TABLES`/`SCHEMA_VERSION` и unit-тест `core_tables_are_set` сохранены.
- Пересечений с W31a нет (`discord-platform` не затрагивался).

## 2. Что сделано

- `src/ffi.rs` — тонкая обёртка `extern "C"` (`#[link(name = "sqlite3")]`, система 3.54):
  `sqlite3_open_v2/close/errmsg/extended_errcode/exec/free/busy_timeout/prepare_v2/bind_text/
  bind_int64/bind_null/step/reset/clear_bindings/column_count/column_type/column_text/
  column_bytes/column_int64/finalize/changes`.
  Безопасные типы `Db`/`Stmt<'a>`/`Step`; `Stmt<'a>` держит `&'a Db` (statement не переживает
  соединение), `Drop` закрывает/финализирует ровно один раз. 26 `// SAFETY:`-комментариев;
  `unsafe` — только в этом файле; в `lib.rs` — `#[allow(unsafe_code)] mod ffi;` и
  `#![deny(unsafe_op_in_unsafe_fn)]`. Вне `ffi.rs` нет `unsafe`, `unwrap`, `expect`, `panic!`.
- `src/lib.rs` — замороженный контракт §1 TZ дословно: `MessageRow`, `ChannelRow`, `StoreError`,
  `Store::{open, open_in_memory, migrate, schema_version, put_channel, channel, put_message,
  messages, delete_message, kv_set, kv_get}`. Модель и ошибка — `Debug/Clone/PartialEq/Eq`
  (нужно тестам), `Display + std::error::Error` для ошибки, `Debug` для `Store` (путь, без handle).
  `Store` — `!Send + !Sync` (проверено компилятором): один поток, один писатель.
- `migrate`: `busy_timeout=5000`, `PRAGMA foreign_keys = ON`, `PRAGMA journal_mode = WAL`
  (до транзакции — внутри `BEGIN` эти PRAGMA не действуют), затем `BEGIN IMMEDIATE` →
  `CREATE TABLE/INDEX IF NOT EXISTS` → `PRAGMA user_version = 1` → `COMMIT`; при ошибке
  `ROLLBACK`. `user_version > 1` → `StoreError::Migration`. Повторный вызов — no-op.
- Схема v1: `channels(id PK, guild_id, name, kind, position)`,
  `messages(id PK, channel_id → channels(id) ON DELETE CASCADE, author_id, content, timestamp,
  edited_timestamp, flags, deleted)`, `kv(key PK, value)`, индексы
  `(channel_id, timestamp DESC)` и `(channel_id, id DESC)`.
- `messages`: `ORDER BY timestamp DESC, id DESC`, `deleted = 0`, `limit==0` → пусто,
  `limit>1000` → 1000, `before` — keyset по `(timestamp, id)` строго меньше курсора
  (неизвестный курсор → пустая страница). Все значения — только `?n` + `sqlite3_bind_*`,
  конкатенации SQL со значениями нет.
- `put_*` — upsert `ON CONFLICT(id) DO UPDATE`; `put_message` к несуществующему каналу →
  `StoreError::Constraint` (FK, extended code 787); `delete_message` — soft delete
  (`UPDATE … SET deleted = 1`), `true` если строка существует, `false` если её нет.

