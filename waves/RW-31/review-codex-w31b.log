   326	    /// История канала: `ORDER BY timestamp DESC, id DESC`.
   327	    ///
   328	    /// `before` — id сообщения-курсора: вернутся только строки строго старше `(timestamp, id)`.
   329	    /// `limit == 0` → пусто, `limit > 1000` → 1000. Неизвестный курсор → пустая страница.
   330	    pub fn messages(
   331	        &self,
   332	        channel_id: &str,
   333	        before: Option<&str>,
   334	        limit: usize,
   335	    ) -> Result<Vec<MessageRow>, StoreError> {
   336	        let limit = limit.min(MAX_MESSAGES_LIMIT);
   337	        if limit == 0 {
   338	            return Ok(Vec::new());
   339	        }
   340	        let limit = i64::try_from(limit).map_err(|_| corrupt("limit не влезает в i64"))?;
   341	
   342	        let cursor = match before {
   343	            None => None,
   344	            Some(id) => match self.message_timestamp(id)? {
   345	                Some(timestamp) => Some((timestamp, id)),
   346	                // Продолжать не с чего: курсор вне этой БД (или уже вычищен).
   347	                None => return Ok(Vec::new()),
   348	            },
   349	        };
   350	
   351	        let mut rows = Vec::new();
   352	        match cursor {
   353	            None => {
   354	                let mut statement = self.db.prepare(SQL_MESSAGES_HEAD)?;
   355	                statement.bind_text(1, channel_id)?;
   356	                statement.bind_i64(2, limit)?;
   357	                while step_row(&mut statement)? {
   358	                    rows.push(read_message(&statement)?);
   359	                }
   360	            }
   361	            Some((timestamp, id)) => {
   362	                let mut statement = self.db.prepare(SQL_MESSAGES_BEFORE)?;
   363	                statement.bind_text(1, channel_id)?;
   364	                statement.bind_i64(2, timestamp)?;
   365	                statement.bind_text(3, id)?;
   366	                statement.bind_i64(4, limit)?;
   367	                while step_row(&mut statement)? {
   368	                    rows.push(read_message(&statement)?);
   369	                }
   370	            }
   371	        }
   372	        Ok(rows)
   373	    }
