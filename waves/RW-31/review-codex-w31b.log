   225	    /// Создаёт схему v1 и выставляет `user_version = 1`. Идемпотентно.
   226	    ///
   227	    /// Транзакция `BEGIN IMMEDIATE`; `foreign_keys = ON` и `journal_mode = WAL` выставляются
   228	    /// до неё (внутри транзакции эти PRAGMA не действуют).
   229	    pub fn migrate(&mut self) -> Result<(), StoreError> {
   230	        self.db.busy_timeout(5_000)?;
   231	        self.db.exec("PRAGMA foreign_keys = ON")?;
   232	        // Для файла — WAL; для `:memory:` SQLite вернёт "memory", ошибки нет.
   233	        self.db.exec("PRAGMA journal_mode = WAL")?;
   234	
   235	        let version = self.schema_version()?;
   236	        if version > SCHEMA_VERSION {
   237	            return Err(StoreError::Migration(format!(
   238	                "user_version {version} новее поддерживаемой {SCHEMA_VERSION}: обновите клиент"
   239	            )));
   240	        }
   241	
   242	        self.db.exec("BEGIN IMMEDIATE")?;
   243	        if let Err(error) = self.apply_schema_v1() {
   244	            // best-effort: транзакцию надо снять, иначе соединение останется в ней;
   245	            // исходная ошибка важнее ошибки отката.
   246	            if let Err(rollback) = self.db.exec("ROLLBACK") {
   247	                return Err(StoreError::Migration(format!(
   248	                    "{error}; откат транзакции не удался: {rollback}"
   249	                )));
   250	            }
   251	            return Err(error);
   252	        }
   253	        self.db.exec("COMMIT")?;
   254	        Ok(())
   255	    }
