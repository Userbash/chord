   139	
   140	impl Db {
   141	    /// Открывает (или создаёт) БД по пути; `:memory:` — БД в памяти.
   142	    pub(crate) fn open(path: &str) -> Result<Self, FfiError> {
   143	        let c_path = CString::new(path)
   144	            .map_err(|_| FfiError::new(SQLITE_MISUSE, "путь содержит NUL-байт"))?;
   145	        let mut raw: *mut Sqlite3 = ptr::null_mut();
   146	        // SAFETY: `c_path` — валидная NUL-терминированная строка на всё время вызова;
   147	        // `&mut raw` — корректный out-параметр, `vfs` = NULL (VFS по умолчанию).
   148	        let code = unsafe {
   149	            sqlite3_open_v2(
   150	                c_path.as_ptr(),
   151	                &mut raw,
   152	                SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE,
   153	                ptr::null(),
   154	            )
   155	        };
   156	        let Some(db) = NonNull::new(raw).map(|raw| Self { raw }) else {
   157	            return Err(FfiError::new(
   158	                if code == SQLITE_OK {
   159	                    SQLITE_MISUSE
   160	                } else {
   161	                    code
   162	                },
   163	                "sqlite3_open_v2 вернул NULL-handle",
   164	            ));
   165	        };
   166	        if code != SQLITE_OK {
   167	            // Handle, даже неудачный, нужно закрыть — это делает Drop у `db`.
   168	            return Err(db.failure(code));
   169	        }
   170	        Ok(db)
   171	    }
   172	
   173	    /// Текст последней ошибки соединения (копия — указатель принадлежит SQLite).
   174	    pub(crate) fn errmsg(&self) -> String {
   175	        // SAFETY: `raw` — живой handle; `sqlite3_errmsg` возвращает NUL-терминированную
   176	        // строку, принадлежащую соединению. Копируем её сразу, до следующего вызова SQLite.
   177	        unsafe {
   178	            let pointer = sqlite3_errmsg(self.raw.as_ptr());
   179	            if pointer.is_null() {
   180	                return "<нет сообщения>".to_owned();
   181	            }
   182	            CStr::from_ptr(pointer).to_string_lossy().into_owned()
   183	        }
   184	    }
   185	
   186	    fn extended_errcode(&self) -> i32 {
   187	        // SAFETY: `raw` — живой handle соединения, функция только читает его состояние.
   188	        unsafe { sqlite3_extended_errcode(self.raw.as_ptr()) }
   189	    }
   190	
   191	    fn failure(&self, fallback: c_int) -> FfiError {
   192	        let code = self.extended_errcode();
   193	        FfiError::new(
   194	            if code == SQLITE_OK { fallback } else { code },
   195	            self.errmsg(),
   196	        )
   197	    }
