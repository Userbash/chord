   376	    fn message_timestamp(&self, id: &str) -> Result<Option<i64>, StoreError> {
   377	        let mut statement = self.db.prepare(SQL_SELECT_MESSAGE_CURSOR)?;
   378	        statement.bind_text(1, id)?;
   379	        if !step_row(&mut statement)? {
