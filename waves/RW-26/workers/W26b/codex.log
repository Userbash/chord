fn json_u64(value: u64) -> JsonValue {
    JsonValue::Number(discord_json::JsonNumber::from_u64(value))
}

fn object(fields: Vec<(&str, JsonValue)>) -> JsonValue {
    JsonValue::Object(
        fields
            .into_iter()
            .map(|(key, value)| (key.to_owned(), value))
            .collect(),
    )
}

