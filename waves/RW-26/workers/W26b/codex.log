+        assert!(matches!(parse_rtc_regions(&format!("[{{\"region\":\"x\",\"ips\":[\"{endpoint}\"]}}]")), Err(RegionError::InvalidEndpoint(_))));
+    }
+    let parsed = parse_rtc_regions(r#"[{"region":"x","ips":["[::1]:19308","[::1]:19308"]}]"#).unwrap();
