+    assert_eq!(latency.samples("x"), &[9, 1, 5]);
+    assert_eq!(latency.median_ms("x"), Some(5));
+    latency.record("x", 3);
+    assert_eq!(latency.median_ms("x"), Some(3));
+}
+
+#[test]
+fn ranking_matches_engine_log_and_ties_use_geo_then_lexical() {
+    let geo = ["frankfurt", "brussels", "rotterdam", "paris", "milan"].map(str::to_owned);
+    let mut latency = RegionLatency::new();
+    for (region, rtt) in [("frankfurt", 45), ("rotterdam", 55), ("paris", 60), ("milan", 70), ("brussels", 90)] { latency.record(region, rtt); }
+    assert_eq!(ranked_region_names(&latency, &geo), ["frankfurt", "rotterdam", "paris", "milan", "brussels"]);
+    let mut tie = RegionLatency::new(); tie.record("z", 10); tie.record("a", 10);
+    assert_eq!(ranked_region_names(&tie, &["z".into(), "a".into(), "geo-only".into()]), ["z", "a", "geo-only"]);
+}
+
+#[test]
+fn unmeasured_regions_follow_measured() {
+    let mut latency = RegionLatency::new(); latency.record("b", 10);
+    assert_eq!(ranked_region_names(&latency, &["a".into(), "b".into(), "c".into()]), ["b", "a", "c"]);
+}
+
+#[test]
+fn selection_checks_manual_against_union() {
+    let mut latency = RegionLatency::new(); latency.record("measured", 3);
+    assert_eq!(regions::select_measured_region(&latency, &["geo".into()], Some("measured")).unwrap(), "measured");
+    assert!(regions::select_measured_region(&latency, &["geo".into()], Some("missing")).is_err());
+    assert_eq!(regions::select_measured_region(&latency, &["geo".into()], None).unwrap(), "measured");
+}
+
+#[test]
+fn probes_rotate_endpoints_and_limit_per_region() {
+    let regions = vec![RegionEndpoint { region: "x".into(), ips: vec!["1.1.1.1:1".into(), "1.1.1.1:2".into(), "1.1.1.1:3".into()] }];
+    assert_eq!(plan_probes(&regions, 0, 100, 3).iter().map(|p| p.endpoint.as_str()).collect::<Vec<_>>(), ["1.1.1.1:1", "1.1.1.1:2", "1.1.1.1:3"]);
+    assert_eq!(plan_probes(&regions, 2, 100, 2).iter().map(|p| p.endpoint.as_str()).collect::<Vec<_>>(), ["1.1.1.1:3", "1.1.1.1:1"]);
+    assert!(plan_probes(&regions, 0, 100, 0).is_empty());
+}
+
+#[test]
+fn probe_completion_observes_timeout_and_clock_order() {
+    let probe = plan_probes(&[RegionEndpoint { region: "x".into(), ips: vec!["1.1.1.1:1".into()] }], 0, 100, 1).remove(0);
+    assert_eq!(complete_probe(&probe, 145, 50), Some(45));
+    assert_eq!(complete_probe(&probe, 151, 50), None);
+    assert_eq!(complete_probe(&probe, 99, 50), None);
+}

