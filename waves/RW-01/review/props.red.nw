//!СвойствакодекаETF(волнаRW-1,P0-02,крейт`discord-codec`):round-trip,канонический//!энкод,ошибки,лимитыглубиныиfuzz-lite.//!//!Оракулы:фиксированныеканоническиебайтысверенысреальнымитермамизахвата//!(`capture-run2.jsonl`,сокет`95974.1389`;`gw-proto/msgs-run2-95974_1389.jsonl`)исоспекой//!`docs/re/gateway-protocol.md`§2.Правилаканона—контрактТЗRW-01.//!//!Проверяемоесвойство:`decode_term(encode_term(v))==v`**побайтово**обратимо//!(`encode_term(decode_term(b).0)==b`)дляканоническихбайт.usediscord_codec::etf::{self,EtfError,EtfValue,MAX_DEPTH};///Строкаhex→байты(пробелыигнорируются).fnunhex(s:&str)->Vec<u8>{letcompact:String=s.chars().filter(|c|!c.is_whitespace()).collect();assert_eq!(compact.len()%2,0,"hexнечётнойдлины:{s}");(0..compact.len()/2).map(|i|u8::from_str_radix(&compact[2*i..2*i+2],16).expect("hex")).collect()}///Байты→строкаhex.fnhex(bytes:&[u8])->String{bytes.iter().map(|b|format!("{b:02x}")).collect()}fnatom(s:&str)->EtfValue{EtfValue::Atom(s.to_string())}fnint(v:i64)->EtfValue{EtfValue::Int(v)}fntext(s:&str)->EtfValue{EtfValue::Str(s.to_string())}///Рекурсивнаясверкабитов`f64`(чтобы`-0.0`не«уравнивался»с`0.0`по`PartialEq`).fnassert_float_bits_equal(expected:&EtfValue,actual:&EtfValue,path:&str){match(expected,actual){(EtfValue::Float(x),EtfValue::Float(y))=>{assert_eq!(x.to_bits(),y.to_bits(),"{path}:битыf64");}(EtfValue::Tuple(x),EtfValue::Tuple(y))|(EtfValue::List(x),EtfValue::List(y))=>{assert_eq!(x.len(),y.len(),"{path}:длина");for(i,(xe,xa))inx.iter().zip(y.iter()).enumerate(){assert_float_bits_equal(xe,xa,&format!("{path}[{i}]"));}}(EtfValue::Map(x),EtfValue::Map(y))=>{assert_eq!(x.len(),y.len(),"{path}:числопар");for(i,((ke,ve),(ka,va)))inx.iter().zip(y.iter()).enumerate(){assert_float_bits_equal(ke,ka,&format!("{path}[{i}].key"));assert_float_bits_equal(ve,va,&format!("{path}[{i}].value"));}}_=>{}}}///Round-tripзначения:`encode_term→decode_term`и`encode→decode`.fnroundtrip(value:&EtfValue){letpayload=etf::encode_term(value);let(decoded,consumed)=etf::decode_term(&payload).expect("decode_term");assert_eq!(consumed,payload.len(),"consumed!=длинытерма");assert_eq!(&decoded,value,"значениеисказилось");assert_float_bits_equal(value,&decoded,"$");assert_eq!(etf::encode_term(&decoded),payload,"повторныйэнкоднеидемпотентен");letframed=etf::encode(value);assert_eq!(framed.first().copied(),Some(0x83),"encodeобязанначинатьсяс0x83");assert_eq!(&framed[1..],payload.as_slice(),"0x83+терм");let(decoded_framed,framed_consumed)=etf::decode(&framed).expect("decode");assert_eq!(framed_consumed,framed.len());assert_eq!(decoded_framed,*value);}///Кейсыround-trip:всеварианты`EtfValue`,границыцелых,спец-значенияfloat.fnroundtrip_cases()->Vec<EtfValue>{vec![EtfValue::Nil,atom("op"),atom("nil"),atom("Проверка"),int(0),int(255),int(256),int(-1),int(i32::MINasi64),int(i32::MAXasi64),int(2_147_483_648),int(i64::MIN),int(i64::MAX),EtfValue::Float(1.5),EtfValue::Float(-0.0),EtfValue::Float(41_250.0),text(""),text("привет"),text(r#"["gateway-prd-arm-us-east1-d-04m5",{"micros":0.0}]"#),EtfValue::Tuple(vec![]),EtfValue::Tuple(vec![int(1),atom("a"),text("b")]),EtfValue::List(vec![]),EtfValue::List(vec![int(1),EtfValue::Nil]),EtfValue::Map(vec![]),EtfValue::Map(vec![(atom("a"),int(1)),(text("b"),text("x"))]),//Вложенностьтрёхуровней:map→list→map.EtfValue::Map(vec![(atom("l1"),EtfValue::List(vec![EtfValue::Map(vec![(atom("l3"),int(3))])]),)]),]}#[test]fnroundtrip_covers_every_variant_and_border_values(){forvalueinroundtrip_cases(){roundtrip(&value);}}#[test]fncanonical_encoder_matches_fixed_bytes(){//КонтрактканонаТЗRW-01;big-int—реальныебайтызахвата(SESSIONS_REPLACE#5,//`processed_at_timestamp=1792391313326`).letcases:Vec<(EtfValue,&str)>=vec![(int(10),"610a"),(int(41250),"620000a122"),(int(255),"61ff"),(int(-1),"62ffffffff"),(int(2_147_483_648),"6e040000000080"),(int(1_792_391_313_326),"6e0600aef7d852a101"),(int(i64::MAX),"6e0800ffffffffffffff7f"),(int(i64::MIN),"6e08010000000000000080"),(EtfValue::Float(1.5),"463ff8000000000000"),(atom("op"),"6400026f70"),(text("abc"),"6d00000003616263"),(EtfValue::List(vec![int(1),int(2)]),"6c00000002610161026a"),(EtfValue::Tuple(vec![int(1)]),"68016101"),(EtfValue::Map(vec![(atom("a"),int(1))]),"7400000001640001616101",),(EtfValue::Nil,"6a"),(text(""),"6d00000000"),(EtfValue::List(vec![]),"6c000000006a"),(EtfValue::Tuple(vec![]),"6800"),(EtfValue::Map(vec![]),"7400000000"),];for(value,expected)incases{assert_eq!(hex(&etf::encode_term(&value)),expected,"канон{value:?}");}assert_eq!(hex(&etf::encode(&int(10))),"83610a","0x83передтермом");assert_eq!(hex(&etf::encode_term(&int(1_014_537_851_418_980_372))),"6e0800143004f5cc5c140e","guild_idизPRESENCE_UPDATE#18");}#[test]fncanonical_encoder_uses_expected_tags_for_atoms_and_big_containers(){//Атом:чистыйASCII→0x64;unicode≤255Б→0x77;>255Б→0x76.letunicode_atom="Проверка";assert_eq!(hex(&etf::encode_term(&atom(unicode_atom))),format!("77{:02x}{}",unicode_atom.len(),hex(unicode_atom.as_bytes())),"unicode-атом≤255Бидёттегом0x77");assert_eq!(hex(&etf::encode_term(&atom("op"))),"6400026f70","ASCII-атомидёттегом0x64");letlong_atom="Проверка".repeat(40);//640Б(>255)letencoded=hex(&etf::encode_term(&atom(&long_atom)));assert!(encoded.starts_with(&format!("76{:04x}",long_atom.len())),"длинныйатом:{encoded}");//Кортеж:≤255элементов→0x68(u8count),256→0x69(u32count).lettuple255=EtfValue::Tuple(vec![EtfValue::Nil;255]);lettuple256=EtfValue::Tuple(vec![EtfValue::Nil;256]);assert!(hex(&etf::encode_term(&tuple255)).starts_with("68ff"));assert!(hex(&etf::encode_term(&tuple256)).starts_with("6900000100"));//Списокдлиной256—u32count.letlist256=EtfValue::List(vec![EtfValue::Nil;256]);assert!(hex(&etf::encode_term(&list256)).starts_with("6c00000100"));forvaluein[tuple255,tuple256,list256]{roundtrip(&value);}}///Ожиданиеошибки`decode_term`безпривязкикконкретным`at`/`need`.fnexpect_err(name:&str,bytes:&[u8])->EtfError{matchetf::decode_term(bytes){Err(e)=>e,Ok((value,consumed))=>{panic!("{name}:ожидаласьошибка,получено{value:?}({consumed}Б)")}}}#[test]fndecoder_reports_specific_errors(){//Пустойбуфериобрывфиксированногополя.assert!(matches!(expect_err("пусто",&[]),EtfError::UnexpectedEof{..}),"пустойбуфер—UnexpectedEof");assert!(matches!(expect_err("0x62без4байт",&[0x62,0x00]),EtfError::UnexpectedEof{..}));assert!(matches!(expect_err("0x46без8байт",&[0x46,0x00,0x00]),EtfError::UnexpectedEof{..}));//Неизвестныйтег(вт.ч.0x83—маркеркадра,втерменедопустим).assert_eq!(expect_err("0x7f",&[0x7f]),EtfError::UnknownTag{tag:0x7f,at:0});assert_eq!(expect_err("0x83",&[0x83]),EtfError::UnknownTag{tag:0x83,at:0});matchexpect_err("тегвнутриmap",&unhex("74000000017f6101")){EtfError::UnknownTag{tag,..}=>assert_eq!(tag,0x7f),other=>panic!("ожидалсяUnknownTag,получено{other:?}"),}//СтрогийUTF-8у0x6d.matchexpect_err("0x6dff",&unhex("6d00000001ff")){EtfError::InvalidUtf8{..}=>{}other=>panic!("ожидалсяInvalidUtf8,получено{other:?}"),}matchexpect_err("0x76невалидныйutf8",&unhex("760002ff80")){EtfError::InvalidUtf8{..}=>{}other=>panic!("ожидалсяInvalidUtf8,получено{other:?}"),}//ХвостLIST_EXT—толькоNIL_EXT.matchexpect_err("хвост-Int",&unhex("6c0000000161016101")){EtfError::ListTailNotNil{tail_tag,..}=>assert_eq!(tail_tag,0x61),other=>panic!("ожидалсяListTailNotNil,получено{other:?}"),}matchexpect_err("хвост-0x83",&unhex("6c0000000083")){EtfError::ListTailNotNil{tail_tag,..}=>assert_eq!(tail_tag,0x83),other=>panic!("ожидалсяListTailNotNil,получено{other:?}"),}matchexpect_err("хвостоборван",&unhex("6c000000016101")){EtfError::UnexpectedEof{..}=>{}other=>panic!("ожидалсяUnexpectedEof,получено{other:?}"),}//FLOAT_EXT:31байтмусоранепарситсякакf64.letmutspaces=vec![0x63];spaces.extend([0x20u8;31]);matchexpect_err("floatизпробелов",&spaces){EtfError::MalformedFloat{..}=>{}other=>panic!("ожидалсяMalformedFloat,получено{other:?}"),}assert!(matches!(expect_err("0x63без31Б",&[0x63,0x31]),EtfError::UnexpectedEof{..}),"0x63короткий—UnexpectedEof");//Заявленнаядлина0xffffffff:ошибкаДОкакой-либоаллокации(не4ГиБ).matchexpect_err("0x6dffffffff",&unhex("6dffffffff")){EtfError::UnexpectedEof{..}=>{}other=>panic!("ожидалсяUnexpectedEof,получено{other:?}"),}forsrcin["6bffff03616263","69000000","6cffffffff6a","74ffffffff"]{assert!(matches!(expect_err(src,&unhex(src)),EtfError::UnexpectedEof{..}),"{src}:ожидалсяUnexpectedEof");}//decodeсведущим0x83,нобезтерма.assert!(matches!(etf::decode(&[0x83]),Err(EtfError::UnexpectedEof{..})));}#[test]fnbig_int_rejects_overflow_and_keeps_signed_borders(){//n>16→BigIntOverflow(0x6e:u8n,0x6f:u32n).letmutsmall17=vec![0x6e,17,0];small17.extend([0u8;17]);assert!(matches!(expect_err("0x6en=17",&small17),EtfError::BigIntOverflow{..}));letmutlarge17=vec![0x6f,0,0,0,17,0];large17.extend([0u8;17]);assert!(matches!(expect_err("0x6fn=17",&large17),EtfError::BigIntOverflow{..}));//sign=0иmagnitude>i64::MAX.assert!(matches!(expect_err("u64::MAXположительный",&unhex("6e0800ffffffffffffffff")),EtfError::BigIntOverflow{..}));//sign=1иmagnitude>2^63.assert!(matches!(expect_err("2^63+1отрицательный",&unhex("6e08010100000000000080")),EtfError::BigIntOverflow{..}));//Границыi64разбираются:i64::MAX(sign=0)иi64::MIN(sign=1,magnitude2^63).assert_eq!(etf::decode_term(&unhex("6e0800ffffffffffffff7f")),Ok((int(i64::MAX),11)));assert_eq!(etf::decode_term(&unhex("6e08010000000000000080")),Ok((int(i64::MIN),11)));assert_eq!(etf::decode_term(&unhex("6f00000008010000000000000080")),Ok((int(i64::MIN),14)));//Нольбайтцифр:6e00sign→0.assert_eq!(etf::decode_term(&unhex("6e0000")),Ok((int(0),3)));}///Ровно`depth`вложенныхLIST(внутри—Int(0)),поконтрактуглубины.fnnested_lists(depth:usize)->Vec<u8>{letmutbuf=Vec::new();for_in0..depth{buf.extend_from_slice(&[0x6c,0x00,0x00,0x00,0x01]);}buf.extend_from_slice(&[0x61,0x00]);for_in0..depth{buf.push(0x6a);}buf}#[test]fnnesting_depth_limit_is_enforced(){letok=nested_lists(MAX_DEPTH);let(value,consumed)=etf::decode_term(&ok).expect("ровноMAX_DEPTH—допустимо");assert_eq!(consumed,ok.len());letmutcursor=&value;letmutdepth=0;whileletSome(items)=cursor.as_list(){depth+=1;cursor=&items[0];}assert_eq!(depth,MAX_DEPTH,"вложенностьразобраласьнеполностью");assert_eq!(cursor,&int(0));roundtrip(&value);matchetf::decode_term(&nested_lists(MAX_DEPTH+1)){Err(EtfError::DepthLimit{..})=>{}other=>panic!("MAX_DEPTH+1:ожидалсяDepthLimit,получено{other:?}"),}//Глубинарежетсяивнутрикортежей/map:65кортежейподряд—предел.letmutdeep_tuple=Vec::new();for_in0..=MAX_DEPTH{deep_tuple.extend_from_slice(&[0x68,0x01]);}deep_tuple.extend_from_slice(&[0x61,0x00]);assert!(matches!(etf::decode_term(&deep_tuple),Err(EtfError::DepthLimit{..})));}#[test]fntruncated_hello_prefixes_are_errors_not_panics(){lethello=unhex(HELLO_HEX);forlenin0..138{matchetf::decode(&hello[..len]){Err(_)=>{}Ok(other)=>panic!("усечение{len}Бразобранокакцелыйтерм:{other:?}"),}}assert!(etf::decode(&hello).is_ok(),"полныйHELLO—ок");}#[test]fnfuzz_lite_never_panics_on_garbage(){//ДетерминированныйLCG(безвнешнихкрейтов):x=x*6364136223846793005+1442695040888963407.letmutstate:u64=0x0123_4567_89ab_cdef;letmutnext=||{state=state.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407);state};for_in0..20_000{letlen=(next()>>33)asusize%65;letbuf:Vec<u8>=(0..len).map(|_|(next()>>24)asu8).collect();let_=etf::decode_term(&buf);let_=etf::decode(&buf);}//Исчерпывающе:всеоднобайтовыебуферы.forbytein0u8..=255{let_=etf::decode_term(&[byte]);}//Одиночныеинверсии(xor0xff)первых≤64байтпятиреальныхвекторов.forsrcin[HELLO_HEX,ACK_HEX,PRESENCE_HEX,MESSAGE_ACK_HEX,MEMBER_LIST_HEX,]{letbytes=unhex(src);lethead=bytes.len().min(64);foriin0..head{letmutmutated=bytes[..head].to_vec();mutated[i]^=0xff;let_=etf::decode_term(&mutated);let_=etf::decode(&mutated);}}}#[test]fnaccessors_keep_types_strict(){leta=atom("nil");lets=text("nil");letn=EtfValue::Nil;assert_eq!(a.as_atom(),Some("nil"));assert_eq!(a.as_str(),None,"атом—небинарник");assert_eq!(s.as_str(),Some("nil"));assert_eq!(s.as_atom(),None,"бинарник—неатом");assert_eq!(n.as_atom(),None);assert_eq!(n.as_str(),None);assert_eq!(n.as_int(),None);assert_eq!(n.as_float(),None);assert_eq!(int(3).as_int(),Some(3));assert_eq!(int(3).as_float(),None,"int—неfloat");assert_eq!(EtfValue::Float(3.5).as_float(),Some(3.5));assert_eq!(EtfValue::Float(3.5).as_int(),None,"float—неint");assert_eq!(EtfValue::Tuple(vec![int(1)]).as_list(),None);assert_eq!(EtfValue::List(vec![int(1)]).as_list(),Some(&[int(1)][..]));assert_eq!(EtfValue::List(vec![int(1)]).as_map(),None);assert_eq!(EtfValue::Map(vec![(atom("k"),int(9))]).as_map().map(<[(EtfValue,EtfValue)]>::len),Some(1));//get:толькоMap;ключ—атомИЛИбинарник.letm=EtfValue::Map(vec![(atom("a"),int(1)),(text("b"),int(2))]);assert_eq!(m.get("a"),Some(&int(1)));assert_eq!(m.get("b"),Some(&int(2)));assert_eq!(m.get("c"),None);assert_eq!(n.get("a"),None);assert_eq!(EtfValue::Map(vec![(int(1),text("x"))]).get("1"),None);//БинарныеключиHELLO-подобнойmapсдубликатоматом/бинарник:находитсяпервый.letmixed=EtfValue::Map(vec![(atom("k"),int(1)),(text("k"),int(2))]);assert_eq!(mixed.get("k"),Some(&int(1)));}///Сырыетермыпровода(теже,чтов`etf_vectors.rs`):HELLO#1иACK#6,сокет95974.1389.constHELLO_HEX:&str="8374000000046400016474000000026400065f74726163656c000000016d000000325b22676174657761792d7072642d61726d2d75732d65617374312d642d30346d35222c7b226d6963726f73223a302e307d5d6a6400126865617274626561745f696e74657276616c620000a1226400026f70610a640001736400036e696c640001746400036e696c";constACK_HEX:&str="837400000004640001646400036e696c6400026f70610b640001736400036e696c640001746400036e696c";constPRESENCE_HEX:&str="";constMESSAGE_ACK_HEX:&str="8374000000046400016474000000056d0000000a6368616e6e656c5f69646e08000b1082a7ed57f2116d00000005666c61677361006d0000000b6c6173745f76696577656462000010d66d0000000a6d6573736167655f69646e08007b0040228806ab156d0000000776657273696f6e620001f7b66400026f7061006400017361266400017464000b4d4553534147455f41434b";constMEMBER_LIST_HEX:&str="";