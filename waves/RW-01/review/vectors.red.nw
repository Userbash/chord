//!ЭталонныевекторыETF:реальныетермышлюзаDiscord(волнаRW-1,P0-02,крейт`discord-codec`).//!//!**Провенанс**(независимыйоракул,всезначениясверенысартефактами)://!-сырыебайтытермов—`capture-run2.jsonl`,сокет`requestId95974.1389`,вырезаны//!`gw-slice-terms.mjs`(копияпроверенного`gw-decode.mjs`);//!-ожидаемыезначения—`/home/user/clean-room-oracle/gw-proto/msgs-run2-95974_1389.jsonl`//!(поле`term`,индекс`idx`);длинытермовсовпадаютсполем`bytes`(длинабез`0x83`)://!138→137,43→42,210→209,148→147,257→256;//!-спека:`docs/re/gateway-protocol.md`§2(11фактическихтегов,big-int—знакДОцифр,//!«nil»-атом≠`NIL_EXT`,хвост`LIST_EXT`=`NIL_EXT`).//!//!ТестыфиксированыТЗRW-01;hex-константыменятьнельзя(иначепотеряетсяоракул).usediscord_codec::etf::{self,EtfError,EtfValue};///Строкаhex→байты(пробелыигнорируются).fnunhex(s:&str)->Vec<u8>{letcompact:String=s.chars().filter(|c|!c.is_whitespace()).collect();assert_eq!(compact.len()%2,0,"hexнечётнойдлины:{s}");(0..compact.len()/2).map(|i|u8::from_str_radix(&compact[2*i..2*i+2],16).expect("hex")).collect()}///Байты→строкаhex(длячитаемыхрасхожденийround-trip).fnhex(bytes:&[u8])->String{bytes.iter().map(|b|format!("{b:02x}")).collect()}fnatom(s:&str)->EtfValue{EtfValue::Atom(s.to_string())}fnint(v:i64)->EtfValue{EtfValue::Int(v)}fntext(s:&str)->EtfValue{EtfValue::Str(s.to_string())}///Mapсатомнымиключами(порядоккакввекторах).fnmap(pairs:Vec<(&str,EtfValue)>)->EtfValue{EtfValue::Map(pairs.into_iter().map(|(k,v)|(atom(k),v)).collect())}///HELLO,терм#1,138Б(полныйпотокпровода,сведущим`0x83`).constHELLO_HEX:&str="8374000000046400016474000000026400065f74726163656c000000016d000000325b22676174657761792d7072642d61726d2d75732d65617374312d642d30346d35222c7b226d6963726f73223a302e307d5d6a6400126865617274626561745f696e74657276616c620000a1226400026f70610a640001736400036e696c640001746400036e696c";///HEARTBEATACK,терм#6,43Б.constACK_HEX:&str="837400000004640001646400036e696c6400026f70610b640001736400036e696c640001746400036e696c";///PRESENCE_UPDATE,терм#18,210Б.constPRESENCE_HEX:&str="";///MESSAGE_ACK,терм#46,148Б(ключивнутри`d`—бинарники`0x6d`).constMESSAGE_ACK_HEX:&str="8374000000046400016474000000056d0000000a6368616e6e656c5f69646e08000b1082a7ed57f2116d00000005666c61677361006d0000000b6c6173745f76696577656462000010d66d0000000a6d6573736167655f69646e08007b0040228806ab156d0000000776657273696f6e620001f7b66400026f7061006400017361266400017464000b4d4553534147455f41434b";///GUILD_MEMBER_LIST_UPDATE,терм#75,257Б.constMEMBER_LIST_HEX:&str="";///Разборвектораспроверкой`consumed`иbyte-exactканона.fndecode_framed(name:&str,hex_src:&str)->EtfValue{letbytes=unhex(hex_src);let(value,consumed)=etf::decode(&bytes).unwrap_or_else(|e|panic!("{name}:{e}"));assert_eq!(consumed,bytes.len(),"{name}:consumed");letcanonical=etf::encode(&value);assert_eq!(hex(&canonical),hex(&bytes),"{name}:каноннесовпалспроводом");value}#[test]fneleven_wire_tags_decode_with_exact_consumed_len(){//Таблица§2спеки:11тегов,реальновстречающихсявзахвате(без0x83—decode_term).letcases:Vec<(&str,&str,EtfValue)>=vec![("0x46NEW_FLOAT_EXT","463ff8000000000000",EtfValue::Float(1.5)),("0x61SMALL_INTEGER_EXT","610a",int(10)),("0x62INTEGER_EXT","620000a122",int(41250)),("0x64ATOM_EXT","6400026f70",atom("op")),("0x68SMALL_TUPLE_EXT","680261016102",EtfValue::Tuple(vec![int(1),int(2)]),),("0x6aNIL_EXT","6a",EtfValue::Nil),("0x6bSTRING_EXT(latin1)","6b0003616263",text("abc")),("0x6cLIST_EXT(хвостNIL)","6c00000002610161026a",EtfValue::List(vec![int(1),int(2)]),),("0x6dBINARY_EXT(UTF-8)","6d00000003616263",text("abc")),("0x6eSMALL_BIG_EXT","6e0100ff",int(255)),("0x74MAP_EXT","7400000001640001616101",EtfValue::Map(vec![(atom("a"),int(1))]),),];assert_eq!(cases.len(),11,"втаблицеобязаныбытьвсе11теговзахвата");for(name,src,expected)incases{letbytes=unhex(src);let(value,consumed)=etf::decode_term(&bytes).unwrap_or_else(|e|panic!("{name}:{e}"));assert_eq!(value,expected,"{name}");assert_eq!(consumed,bytes.len(),"{name}:consumed");}}#[test]fnsupported_but_unseen_tags_decode_per_contract(){//Теги,поддержанные§2спеки,новзахватеневстреченные(latin1,LARGE_*,UTF-8-атомы).letfloat_ext=format!("63312e35{}","20".repeat(28));//"1.5"+28пробелов=31Бletcases:Vec<(&str,&str,EtfValue)>=vec![("0x63FLOAT_EXT(ASCII+пробелы)",float_ext.as_str(),EtfValue::Float(1.5),),("0x69LARGE_TUPLE_EXT","690000000261016102",EtfValue::Tuple(vec![int(1),int(2)]),),("0x6fLARGE_BIG_EXT(guild_id)","6f0000000800143004f5cc5c140e",int(1_014_537_851_418_980_372),),("0x73SMALL_ATOM_EXT(latin1)","73026f70",atom("op")),("0x76ATOM_UTF8_EXT","7600026f70",atom("op")),("0x77SMALL_ATOM_UTF8_EXT","77026f70",atom("op")),("0x64ATOM_EXTlatin10xff","640001ff",atom("\u{ff}")),("0x73SMALL_ATOM_EXTlatin10xe8","7301e8",atom("\u{e8}")),("0x6bSTRING_EXTlatin10xe8","6b0001e8",text("\u{e8}")),("0x6dBINARY_EXTUTF-8«я»","6d00000002d18f",text("\u{44f}")),];for(name,src,expected)incases{letbytes=unhex(src);let(value,consumed)=etf::decode_term(&bytes).unwrap_or_else(|e|panic!("{name}:{e}"));assert_eq!(value,expected,"{name}");assert_eq!(consumed,bytes.len(),"{name}:consumed");}}#[test]fndecode_skips_only_the_leading_version_byte(){lethello=unhex(HELLO_HEX);let(framed,consumed)=etf::decode(&hello).expect("decodeframed");assert_eq!(consumed,138,"0x83входитвconsumed");letpayload=&hello[1..];let(unframed,payload_consumed)=etf::decode_term(payload).expect("decode_termpayload");assert_eq!(unframed,framed,"значениебез0x83совпадаетсframed");assert_eq!(payload_consumed,137);assert_eq!(payload_consumed+1,consumed);//С0x83вначалеdecode_termобязанругаться,ане«проглатывать»байт.assert_eq!(etf::decode_term(&hello),Err(EtfError::UnknownTag{tag:0x83,at:0}));}#[test]fnhello_term_full_tree_matches_capture(){letvalue=decode_framed("HELLO#1",HELLO_HEX);letexpected=map(vec![("d",map(vec![("_trace",EtfValue::List(vec![text(r#"["gateway-prd-arm-us-east1-d-04m5",{"micros":0.0}]"#,)]),),("heartbeat_interval",int(41_250)),]),),("op",int(10)),("s",atom("nil")),("t",atom("nil")),]);assert_eq!(value,expected);//Точечно:`_trace`—списокизоднойстроки,сердцебиение—41250мс.assert_eq!(value.get("d").and_then(|d|d.get("heartbeat_interval")),Some(&int(41_250)));assert_eq!(value.get("d").and_then(|d|d.get("_trace")).and_then(EtfValue::as_list).map(<[EtfValue]>::len),Some(1));}#[test]fnheartbeat_ack_keeps_atom_nil_and_int_op(){letvalue=decode_framed("HEARTBEATACK#6",ACK_HEX);//Полноедерево:`d`—атом-строка"nil",НЕNIL_EXT.letexpected=map(vec![("d",atom("nil")),("op",int(11)),("s",atom("nil")),("t",atom("nil")),]);assert_eq!(value,expected);assert_eq!(value.get("d"),Some(&atom("nil")));assert_ne!(value.get("d"),Some(&EtfValue::Nil),"атомnil≠NIL_EXT");assert_eq!(value.get("d").and_then(EtfValue::as_atom),Some("nil"));assert_eq!(value.get("d").and_then(EtfValue::as_str),None,"этоатом,небинарник");assert_eq!(value.get("op").and_then(EtfValue::as_int),Some(11));}#[test]fnpresence_update_snowflakes_and_real_nil_activities(){letvalue=decode_framed("PRESENCE_UPDATE#18",PRESENCE_HEX);letd=value.get("d").expect("d");assert_eq!(value.get("op").and_then(EtfValue::as_int),Some(0));assert_eq!(value.get("s").and_then(EtfValue::as_int),Some(13));assert_eq!(value.get("t"),Some(&atom("PRESENCE_UPDATE")));assert_eq!(d.get("guild_id").and_then(EtfValue::as_int),Some(1_014_537_851_418_980_372));assert_eq!(d.get("user").and_then(|u|u.get("id")).and_then(EtfValue::as_int),Some(702_520_807_447_855_184));//activitiesпришлиНАСТОЯЩИМNIL_EXT(0x6a),анеатомом"nil".assert_eq!(d.get("activities"),Some(&EtfValue::Nil));assert_eq!(d.get("status"),Some(&atom("online")));assert_eq!(d.get("processed_at_timestamp").and_then(EtfValue::as_int),Some(0));letclient_status=d.get("client_status").expect("client_status");assert_eq!(client_status.get("mobile"),Some(&atom("online")));assert_eq!(client_status.get("vr"),Some(&atom("idle")));}#[test]fnmessage_ack_binary_keys_are_found_by_get(){letvalue=decode_framed("MESSAGE_ACK#46",MESSAGE_ACK_HEX);letd=value.get("d").expect("d");//Ключивнутри`d`—бинарники(0x6d),поэтому`get`обязанискатьипоStr.forkeyin["channel_id","flags","last_viewed","message_id","version"]{let(k,_)=d.as_map().expect("map").iter().find(|(k,_)|k.as_str()==Some(key)).unwrap_or_else(||panic!("ключ{key}ненайден"));assert_eq!(k.as_atom(),None,"ключ{key}—бинарник,неатом");}assert_eq!(d.get("channel_id").and_then(EtfValue::as_int),Some(1_293_192_721_237_938_187));assert_eq!(d.get("flags").and_then(EtfValue::as_int),Some(0));assert_eq!(d.get("last_viewed").and_then(EtfValue::as_int),Some(4_310));assert_eq!(d.get("message_id").and_then(EtfValue::as_int),Some(1_561_348_877_573_947_515));assert_eq!(d.get("version").and_then(EtfValue::as_int),Some(128_950));assert_eq!(value.get("op").and_then(EtfValue::as_int),Some(0));assert_eq!(value.get("s").and_then(EtfValue::as_int),Some(38));assert_eq!(value.get("t"),Some(&atom("MESSAGE_ACK")));}#[test]fnguild_member_list_update_groups_ops_and_string_id(){letvalue=decode_framed("GUILD_MEMBER_LIST_UPDATE#75",MEMBER_LIST_HEX);letd=value.get("d").expect("d");assert_eq!(d.get("id"),Some(&text("1659606647")),"idпришёлбинарником");assert_eq!(d.get("guild_id").and_then(EtfValue::as_int),Some(1_014_537_851_418_980_372));assert_eq!(d.get("member_count").and_then(EtfValue::as_int),Some(24_228));assert_eq!(d.get("online_count").and_then(EtfValue::as_int),Some(708));letgroups=d.get("groups").and_then(EtfValue::as_list).expect("groups");assert_eq!(groups.len(),2);assert_eq!(groups[0].get("id").and_then(EtfValue::as_int),Some(1_062_745_847_512_715_385));assert_eq!(groups[0].get("count").and_then(EtfValue::as_int),Some(3));assert_eq!(groups[1].get("id"),Some(&atom("online")),"второйid—атом");assert_eq!(groups[1].get("count").and_then(EtfValue::as_int),Some(12));letops=d.get("ops").and_then(EtfValue::as_list).expect("ops");assert_eq!(ops.len(),1);assert_eq!(ops[0].get("index").and_then(EtfValue::as_int),Some(11));assert_eq!(ops[0].get("op"),Some(&atom("DELETE")));assert_eq!(value.get("op").and_then(EtfValue::as_int),Some(0));assert_eq!(value.get("s").and_then(EtfValue::as_int),Some(58));assert_eq!(value.get("t"),Some(&atom("GUILD_MEMBER_LIST_UPDATE")));}#[test]fntwo_terms_back_to_back_split_by_consumed(){letmutstream=unhex(HELLO_HEX);stream.extend(unhex(ACK_HEX));let(hello,first)=etf::decode(&stream).expect("терм1");assert_eq!(first,138);let(ack,second)=etf::decode(&stream[first..]).expect("терм2");assert_eq!(second,43);assert_eq!(hello,decode_framed("HELLO#1",HELLO_HEX));assert_eq!(ack,decode_framed("HEARTBEATACK#6",ACK_HEX));assert_eq!(first+second,stream.len());}#[test]fnsmall_big_int_reads_sign_before_digits(){//§2.5спеки:`[110][n:u8][sign:u8][nбайтLE]`;знак—ДОцифр.letcases:[(i64,&str,i64);3]=[(1_014_537_851_418_980_372,"6e0800143004f5cc5c140e",-1_467_272_931_325_252_608),(384_299_970_632_876_032,"6e08000000c484c94e5505",-6_147_072_113_468_506_112),(1_176_785_373_989_445_703,"6e08004720841110c85410",-6_109_150_561_945_274_112,),];for(expected,src,wrong)incases{let(value,consumed)=etf::decode_term(&unhex(src)).expect(src);assert_eq!(consumed,unhex(src).len());assert_eq!(value,int(expected),"{src}");assert_ne!(value,int(wrong),"{src}:разбор«знакпослецифр»далбы{wrong}");assert!(expected>0,"{src}:snowflakeположительный");}//Тотжеbig-intвформатеLARGE_BIG_EXT(111)—поддержан,взахватеневстречался.letlarge=unhex("6f0000000800143004f5cc5c140e");assert_eq!(etf::decode_term(&large),Ok((int(1_014_537_851_418_980_372),14)));}#[test]fnatom_nil_is_a_string_and_not_nil_ext(){let(from_atom,atom_len)=etf::decode_term(&unhex("6400036e696c")).expect("атомnil");let(from_nil,nil_len)=etf::decode_term(&unhex("6a")).expect("NIL_EXT");assert_eq!(from_atom,atom("nil"));assert_eq!(atom_len,6);assert_eq!(from_nil,EtfValue::Nil);assert_eq!(nil_len,1);assert_ne!(from_atom,from_nil,"атомnil—неnull");assert_eq!(from_atom.as_atom(),Some("nil"));assert_eq!(from_atom.as_str(),None);assert_eq!(from_nil.as_atom(),None);}#[test]fnlist_tail_is_nil_ext_only(){//РеальныйхвостLIST_EXT—NIL_EXT;Intнаместехвостаобязанломатьразбор.letok=etf::decode_term(&unhex("6c0000000161016a")).expect("хвостNIL");assert_eq!(ok,(EtfValue::List(vec![int(1)]),8));matchetf::decode_term(&unhex("6c0000000161016102")){Err(EtfError::ListTailNotNil{tail_tag,..})=>assert_eq!(tail_tag,0x61),other=>panic!("ожидалсяListTailNotNil,получено{other:?}"),}}