   189	/// Берёт первый `h` из ответа `Inhibit`, закрывает лишние fd; без fd — ошибка.
   190	fn take_inhibitor(values: &[Value], fds: Vec<RawFd>) -> Result<SleepInhibitor, DbusError> {
   191	    let chosen = values.iter().find_map(|value| match value {
   192	        Value::UnixFd(raw) => Some(*raw),
   193	        _ => None,
   194	    });
   195	    let Some(chosen) = chosen else {
   196	        fd::close_all(&fds);
   197	        return Err(DbusError::Protocol("Inhibit reply without unix fd"));
   198	    };
   199	    let mut kept = false;
   200	    for raw in fds {
   201	        if !kept && raw == chosen {
   202	            kept = true;
   203	        } else {
   204	            fd::close_fd(raw);
   205	        }
   206	    }
   207	    if !kept {
   208	        // Ответ ссылался на fd, которого нет в очереди: закрывать больше нечего.
   209	        return Err(DbusError::Protocol("Inhibit fd is not in the message"));
   210	    }
   211	    Ok(SleepInhibitor { fd: chosen })
   212	}
