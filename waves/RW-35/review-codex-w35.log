   145	/// Собирает сообщение и список fd для `SCM_RIGHTS`.
   146	///
   147	/// Каждое значение `h` (`Value::UnixFd`) получает индекс в порядке появления в теле
   148	/// (0, 1, …); возвращённый вектор fd передаётся в [`super::fd::send_with_fds`].
   149	/// Не больше [`fd::MAX_FDS_PER_MESSAGE`] fd на сообщение.
   150	pub fn build_with_fds(
   151	    kind: MessageType,
   152	    serial: u32,
   153	    fields: &[(u8, Value)],
   154	    signature: &str,
   155	    body: &[Value],
   156	) -> Result<(Vec<u8>, Vec<RawFd>), DbusError> {
   157	    if serial == 0 {
   158	        return Err(DbusError::Protocol("serial must be non-zero"));
   159	    }
   160	
   161	    let mut writer = Writer {
   162	        buffer: vec![0u8; 16],
   163	        fds: Vec::new(),
   164	    };
   165	    writer.buffer[0] = b'l';
   166	    writer.buffer[1] = kind.code();
   167	    // Флаг 0x1 (NO_REPLY_EXPECTED) у всех сообщений, кроме method call — как у libgio:
   168	    // ответа не ждут ни return, ни error, ни signal.
   169	    writer.buffer[2] = if kind == MessageType::MethodCall {
   170	        0
   171	    } else {
   172	        1
   173	    };
   174	    writer.buffer[3] = 1; // protocol version
   175	    writer.buffer[8..12].copy_from_slice(&serial.to_le_bytes());
   176	    // Длина массива полей заголовка (`a(yv)`) лежит в 12..16; данные начинаются с 16.
   177	    for (code, value) in fields {
   178	        let field_type =
   179	            field_type(*code).ok_or(DbusError::Protocol("unsupported header field code"))?;
   180	        writer.align(8)?;
   181	        writer.buffer.push(*code);
   182	        writer.signature(field_type);
   183	        writer.value(field_type, value)?;
   184	    }
   185	
   186	    // D-Bus требует поле UNIX_FDS, если к сообщению приложены fd (и запрещает его без fd).
   187	    let fd_count = fds_in_body(body).len();
   188	    if fd_count > 0 {
   189	        let declared = u32::try_from(fd_count)
   190	            .map_err(|_| DbusError::Protocol("too many unix fds in message"))?;
   191	        writer.align(8)?;
   192	        writer.buffer.push(FIELD_UNIX_FDS);
   193	        writer.signature("u");
   194	        writer.value("u", &Value::U32(declared))?;
   195	    }
   196	
   197	    let fields_len = u32::try_from(writer.buffer.len() - 16)
   198	        .map_err(|_| DbusError::Protocol("header too large"))?;
   199	    writer.buffer[12..16].copy_from_slice(&fields_len.to_le_bytes());
   200	    if writer.buffer.len() > MAX_HEADER_BYTES {
   201	        return Err(DbusError::Protocol("header too large"));
   202	    }
   203	
   204	    writer.align(8)?;
   205	    let body_offset = writer.buffer.len();
   206	    write_body(&mut writer, signature, body)?;
   207	    let body_len = u32::try_from(writer.buffer.len() - body_offset)
   208	        .map_err(|_| DbusError::Protocol("body too large"))?;
   209	    if body_len as usize > MAX_BODY_BYTES {
   210	        return Err(DbusError::Protocol("body too large"));
   211	    }
   212	    writer.buffer[4..8].copy_from_slice(&body_len.to_le_bytes());
   213	    Ok((writer.buffer, writer.fds))
   214	}
