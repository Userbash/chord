   251	    /// ([`Value::UnixFd`]) и в векторе (тот же порядок и те же номера: вектор — удобный
   252	    /// список, а не дополнительное владение). Закрывайте каждый fd ровно один раз
   253	    /// ([`fd::close_fd`]); при ошибке вызова полученные fd уже закрыты.
   254	    pub fn call_with_fds(
   255	        &mut self,
   256	        destination: &str,
   257	        path: &str,
   258	        interface: &str,
   259	        member: &str,
