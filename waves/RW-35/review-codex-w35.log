    49	/// Адрес шины D-Bus.
    50	///
    51	/// Поддерживаются `unix:path=…` и `unix:abstract=…` (в т.ч. в списке адресов через `;` —
    52	/// берётся первый поддерживаемый). `tcp:` и прочие схемы возвращают `None`: их в этой
    53	/// карточке нет. Percent-кодирование (`%2F`) не декодируется — байты имени берутся как есть.
    54	#[derive(Debug, Clone, PartialEq, Eq)]
    55	pub enum BusAddress {
    56	    /// `unix:path=/run/user/1000/bus` — путь файлового сокета.
    57	    Path(PathBuf),
    58	    /// `unix:abstract=name` — имя в abstract-пространстве Linux (сырые байты).
    59	    Abstract(Vec<u8>),
    60	}
    61	
    62	impl BusAddress {
    63	    /// Разбирает значение `DBUS_SESSION_BUS_ADDRESS`.
    64	    ///
    65	    /// Записи списка перебираются по порядку; запись с неподдерживаемой схемой, пустым
    66	    /// значением, NUL внутри значения или слишком длинным abstract-именем пропускается.
    67	    pub fn parse(value: &str) -> Option<Self> {
    68	        for entry in value.split(';') {
    69	            let Some(rest) = entry.strip_prefix("unix:") else {
    70	                continue;
    71	            };
    72	            for field in rest.split(',') {
    73	                if let Some(path) = field.strip_prefix("path=") {
    74	                    if let Some(address) = Self::from_path(path) {
    75	                        return Some(address);
    76	                    }
    77	                    // `unix:path=` без значения — запись невалидна, пробуем следующий адрес.
    78	                    break;
    79	                }
    80	                if let Some(name) = field.strip_prefix("abstract=") {
    81	                    if let Some(address) = Self::from_abstract_name(name) {
    82	                        return Some(address);
    83	                    }
    84	                    break;
    85	                }
    86	            }
    87	        }
    88	        None
    89	    }
    90	
    91	    /// Адрес из переменной окружения `DBUS_SESSION_BUS_ADDRESS`.
    92	    pub fn from_env() -> Option<Self> {
    93	        std::env::var("DBUS_SESSION_BUS_ADDRESS")
    94	            .ok()
    95	            .and_then(|value| Self::parse(&value))
    96	    }
    97	
    98	    /// Путь unix-сокета шины; `None` для abstract-адреса.
    99	    pub fn path(&self) -> Option<&Path> {
   100	        match self {
   101	            Self::Path(path) => Some(path),
   102	            Self::Abstract(_) => None,
   103	        }
   104	    }
   105	
   106	    /// Имя abstract-сокета (сырые байты); `None` для path-адреса.
   107	    pub fn abstract_name(&self) -> Option<&[u8]> {
   108	        match self {
   109	            Self::Abstract(name) => Some(name),
   110	            Self::Path(_) => None,
   111	        }
   112	    }
   113	
   114	    fn from_path(value: &str) -> Option<Self> {
   115	        if value.is_empty() || value.contains('\0') {
   116	            return None;
   117	        }
   118	        Some(Self::Path(PathBuf::from(value)))
   119	    }
   120	
   121	    fn from_abstract_name(value: &str) -> Option<Self> {
   122	        let bytes = value.as_bytes();
   123	        if bytes.is_empty() || bytes.len() > MAX_ABSTRACT_NAME_BYTES || bytes.contains(&0) {
   124	            return None;
   125	        }
   126	        Some(Self::Abstract(bytes.to_vec()))
   127	    }
   128	}
