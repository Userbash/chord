    64	/// `org.freedesktop.ScreenSaver`: ингибитор гашения экрана в звонке.
    65	#[derive(Debug)]
    66	pub struct ScreenSaver {
    67	    connection: Connection,
    68	}
    69	
    70	impl ScreenSaver {
    71	    /// Подключается к шине (AUTH EXTERNAL + `Hello`), ничего не вызывая.
    72	    pub fn connect(address: &BusAddress) -> Result<Self, DbusError> {
    73	        Ok(Self {
    74	            connection: Connection::connect(address)?,
    75	        })
    76	    }
    77	
    78	    /// `Inhibit(app_name, reason) -> cookie`: серверный cookie для снятия ингибитора.
    79	    ///
    80	    /// Пустые `app_name`/`reason` отвергаются локально (`DbusError::Protocol`): такие
    81	    /// вызовы бессмысленны для сервиса и не должны уходить на шину.
    82	    pub fn inhibit(&mut self, app_name: &str, reason: &str) -> Result<u32, DbusError> {
    83	        if app_name.is_empty() {
    84	            return Err(DbusError::Protocol("empty app_name"));
    85	        }
    86	        if reason.is_empty() {
    87	            return Err(DbusError::Protocol("empty reason"));
    88	        }
    89	        let body = [
    90	            Value::String(app_name.to_owned()),
    91	            Value::String(reason.to_owned()),
    92	        ];
    93	        let reply = self.call(INHIBIT_METHOD, INHIBIT_SIGNATURE, &body)?;
    94	        match reply.into_iter().next() {
    95	            Some(Value::U32(cookie)) => Ok(cookie),
    96	            _ => Err(DbusError::Protocol("Inhibit reply is not a u32 cookie")),
    97	        }
    98	    }
    99	
   100	    /// `UnInhibit(cookie)`: снимает ингибитор.
   101	    ///
   102	    /// Если сервис не знает `UnInhibit` (`UnknownMethod`/`UnknownInterface`), пробуется
   103	    /// вариант `Uninhibit` — регистр в имени метода различается между реализациями.
   104	    /// Неизвестный cookie возвращается сервером как `DbusError::Remote`, не паника.
   105	    pub fn uninhibit(&mut self, cookie: u32) -> Result<(), DbusError> {
   106	        let body = [Value::U32(cookie)];
   107	        match self.call(UNINHIBIT_METHOD, "u", &body) {
   108	            Ok(_) => Ok(()),
   109	            Err(DbusError::Remote { name, .. }) if is_unknown_member(&name) => {
   110	                self.call(UNINHIBIT_FALLBACK_METHOD, "u", &body)?;
   111	                Ok(())
   112	            }
   113	            Err(error) => Err(error),
   114	        }
   115	    }
   116	
   117	    /// `IsActive() -> b`: активен ли сейчас скринсейвер/блокировка.
   118	    pub fn is_active(&mut self) -> Result<bool, DbusError> {
   119	        let reply = self.call(IS_ACTIVE_METHOD, "", &[])?;
   120	        match reply.into_iter().next() {
   121	            Some(Value::Bool(active)) => Ok(active),
   122	            _ => Err(DbusError::Protocol("IsActive reply is not a bool")),
   123	        }
   124	    }
   125	
   126	    /// `GetSessionIdleTime() -> u` в секундах.
   127	    ///
   128	    /// `Ok(None)` — метод или интерфейс не поддержан (`UnknownMethod`/`UnknownInterface`):
   129	    /// это штатная ситуация вне KDE, а не ошибка. Прочие ошибки остаются `Err`.
   130	    pub fn idle_seconds(&mut self) -> Result<Option<u64>, DbusError> {
   131	        match self.call(IDLE_METHOD, "", &[]) {
   132	            Ok(reply) => match reply.into_iter().next() {
   133	                Some(Value::U32(seconds)) => Ok(Some(u64::from(seconds))),
   134	                _ => Err(DbusError::Protocol("GetSessionIdleTime reply is not a u32")),
   135	            },
   136	            Err(DbusError::Remote { name, .. }) if is_unknown_member(&name) => Ok(None),
   137	            Err(error) => Err(error),
   138	        }
   139	    }
   140	
   141	    fn call(
   142	        &mut self,
   143	        member: &str,
   144	        signature: &str,
   145	        body: &[Value],
   146	    ) -> Result<Vec<Value>, DbusError> {
   147	        self.connection.call_typed(
   148	            SCREENSAVER_DESTINATION,
   149	            SCREENSAVER_PATH,
   150	            SCREENSAVER_INTERFACE,
   151	            member,
   152	            signature,
   153	            body,
   154	        )
   155	    }
