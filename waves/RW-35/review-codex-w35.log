   266	    /// Вызов с явной сигнатурой тела — нужен для пустых контейнеров (`a{sv}`, `a(ss)`).
   267	    ///
   268	    /// Ответ с fd — `Protocol` после закрытия этих fd (см. [`Self::call`]).
   269	    pub(crate) fn call_typed(
   270	        &mut self,
   271	        destination: &str,
   272	        path: &str,
   273	        interface: &str,
   274	        member: &str,
   275	        signature: &str,
   276	        body: &[Value],
   277	    ) -> Result<Vec<Value>, DbusError> {
   278	        let (values, fds) =
   279	            self.call_typed_with_fds(destination, path, interface, member, signature, body)?;
   280	        if fds.is_empty() {
   281	            return Ok(values);
   282	        }
   283	        fd::close_all(&fds);
