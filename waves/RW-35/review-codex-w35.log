   575	/// Отделяет первый полный тип сигнатуры от остатка.
   576	fn take_type(signature: &str) -> Result<(&str, &str), DbusError> {
   577	    let bytes = signature.as_bytes();
   578	    let first = *bytes
   579	        .first()
   580	        .ok_or(DbusError::Protocol("empty signature"))?;
   581	    match first {
   582	        b'y' | b'b' | b'u' | b'i' | b'h' | b's' | b'o' | b'g' | b'v' => {
   583	            Ok((&signature[..1], &signature[1..]))
   584	        }
   585	        b'a' => {
   586	            let (inner, rest) = take_type(&signature[1..])?;
   587	            let end = 1 + inner.len();
   588	            Ok((&signature[..end], rest))
   589	        }
   590	        b'(' => {
   591	            let mut depth = 0usize;
   592	            for (index, byte) in bytes.iter().enumerate() {
   593	                match byte {
   594	                    b'(' => depth += 1,
   595	                    b')' => {
   596	                        depth = depth.saturating_sub(1);
   597	                        if depth == 0 {
   598	                            return Ok((&signature[..=index], &signature[index + 1..]));
   599	                        }
   600	                    }
   601	                    _ => {}
   602	                }
   603	            }
   604	            Err(DbusError::Protocol("unbalanced struct signature"))
   605	        }
   606	        b'{' => {
   607	            let (key, after_key) = take_type(&signature[1..])?;
   608	            let (value, _) = take_type(after_key)?;
   609	            let end = 1 + key.len() + value.len() + 1;
   610	            if bytes.get(end - 1) != Some(&b'}') {
   611	                return Err(DbusError::Protocol("unbalanced dict signature"));
   612	            }
   613	            Ok((&signature[..end], &signature[end..]))
   614	        }
   615	        _ => Err(DbusError::Protocol("unsupported type in signature")),
   616	    }
   617	}
   618	
   619	fn dict_types(entry: &str) -> Result<(&str, &str), DbusError> {
   620	    if !entry.starts_with('{') || !entry.ends_with('}') {
   621	        return Err(DbusError::Protocol("not a dict entry signature"));
   622	    }
   623	    let inner = &entry[1..entry.len() - 1];
   624	    let (key, rest) = take_type(inner)?;
   625	    let (value, tail) = take_type(rest)?;
   626	    if !tail.is_empty() {
   627	        return Err(DbusError::Protocol("dict entry has extra types"));
   628	    }
   629	    Ok((key, value))
   630	}
