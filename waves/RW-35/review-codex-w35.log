   248	fn unique_suffix() -> u64 {
   249	    use std::sync::atomic::{AtomicU64, Ordering};
   250	    static COUNTER: AtomicU64 = AtomicU64::new(0);
   251	    let nanos = std::time::SystemTime::now()
   252	        .duration_since(std::time::UNIX_EPOCH)
   253	        .map(|duration| duration.as_nanos() as u64)
   254	        .unwrap_or(0);
   255	    nanos ^ (COUNTER.fetch_add(1, Ordering::Relaxed) << 32)
   256	}
