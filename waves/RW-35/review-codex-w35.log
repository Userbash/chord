   265	    /// Следующее событие сна/пробуждения.
   266	    ///
   267	    /// Чужие сигналы и `PrepareForSleep` с неожиданным телом пропускаются (не ошибка);
   268	    /// таймаут ожидания — `Ok(None)`. Битое/закрытое соединение — `DbusError`.
   269	    pub fn next_event(&mut self, timeout: Duration) -> Result<Option<PowerEvent>, DbusError> {
   270	        let deadline = std::time::Instant::now() + timeout;
   271	        loop {
   272	            let remaining = deadline.saturating_duration_since(std::time::Instant::now());
   273	            if remaining.is_zero() {
   274	                return Ok(None);
   275	            }
