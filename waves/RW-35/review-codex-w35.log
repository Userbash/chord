   126	///
   127	/// Вариант без fd: тело с `h` отвергается — иначе fd потерялись бы молча.
   128	/// Для `h` используйте [`build_with_fds`].
   129	pub fn build(
   130	    kind: MessageType,
   131	    serial: u32,
   132	    fields: &[(u8, Value)],
   133	    signature: &str,
   134	    body: &[Value],
   135	) -> Result<Vec<u8>, DbusError> {
   136	    let (bytes, fds) = build_with_fds(kind, serial, fields, signature, body)?;
   137	    if !fds.is_empty() {
   138	        return Err(DbusError::Protocol(
   139	            "body contains unix fds; use build_with_fds",
   140	        ));
   141	    }
   142	    Ok(bytes)
