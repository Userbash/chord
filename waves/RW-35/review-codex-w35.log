    80	struct JsonParser<'a> {
    81	    bytes: &'a [u8],
    82	    pos: usize,
    83	}
    84	
    85	impl JsonParser<'_> {
    86	    fn skip_ws(&mut self) {
    87	        while matches!(self.bytes.get(self.pos), Some(b' ' | b'\n' | b'\r' | b'\t')) {
    88	            self.pos += 1;
    89	        }
    90	    }
    91	
    92	    fn expect(&mut self, byte: u8) -> Result<(), String> {
    93	        if self.bytes.get(self.pos) == Some(&byte) {
    94	            self.pos += 1;
    95	            Ok(())
    96	        } else {
    97	            Err(format!(
    98	                "ожидался {:?} на позиции {}",
    99	                byte as char, self.pos
   100	            ))
   101	        }
   102	    }
   103	
   104	    fn value(&mut self) -> Result<Json, String> {
   105	        self.skip_ws();
   106	        match self.bytes.get(self.pos).copied() {
   107	            Some(b'{') => self.object(),
   108	            Some(b'[') => self.array(),
   109	            Some(b'"') => Ok(Json::Str(self.string()?)),
   110	            Some(b't') => self.literal("true", Json::Bool(true)),
   111	            Some(b'f') => self.literal("false", Json::Bool(false)),
   112	            Some(b'n') => self.literal("null", Json::Null),
   113	            Some(byte) if byte == b'-' || byte.is_ascii_digit() => self.number(),
   114	            other => Err(format!(
   115	                "неожиданный байт {other:?} на позиции {}",
   116	                self.pos
   117	            )),
   118	        }
   119	    }
   120	
   121	    fn literal(&mut self, text: &str, value: Json) -> Result<Json, String> {
   122	        if self.bytes[self.pos..].starts_with(text.as_bytes()) {
   123	            self.pos += text.len();
   124	            Ok(value)
   125	        } else {
   126	            Err(format!("ожидался литерал {text} на позиции {}", self.pos))
   127	        }
   128	    }
   129	
   130	    fn number(&mut self) -> Result<Json, String> {
   131	        let start = self.pos;
   132	        if self.bytes.get(self.pos) == Some(&b'-') {
   133	            self.pos += 1;
   134	        }
   135	        while matches!(self.bytes.get(self.pos), Some(byte) if byte.is_ascii_digit()) {
   136	            self.pos += 1;
   137	        }
   138	        if self.bytes.get(self.pos) == Some(&b'.') {
   139	            self.pos += 1;
   140	            while matches!(self.bytes.get(self.pos), Some(byte) if byte.is_ascii_digit()) {
   141	                self.pos += 1;
   142	            }
   143	        }
   144	        let text =
   145	            std::str::from_utf8(&self.bytes[start..self.pos]).map_err(|err| err.to_string())?;
   146	        text.parse::<f64>()
   147	            .map(Json::Num)
   148	            .map_err(|err| format!("число {text:?}: {err}"))
   149	    }
   150	
   151	    fn string(&mut self) -> Result<String, String> {
   152	        self.expect(b'"')?;
   153	        let mut out = String::new();
   154	        loop {
   155	            let byte = *self
   156	                .bytes
   157	                .get(self.pos)
   158	                .ok_or_else(|| "незакрытая строка".to_string())?;
   159	            self.pos += 1;
   160	            match byte {
   161	                b'"' => return Ok(out),
   162	                b'\\' => {
   163	                    let escape = *self
   164	                        .bytes
   165	                        .get(self.pos)
   166	                        .ok_or_else(|| "оборванный escape".to_string())?;
   167	                    self.pos += 1;
   168	                    match escape {
   169	                        b'"' => out.push('"'),
   170	                        b'\\' => out.push('\\'),
   171	                        b'/' => out.push('/'),
   172	                        b'b' => out.push('\u{0008}'),
   173	                        b'f' => out.push('\u{000C}'),
   174	                        b'n' => out.push('\n'),
   175	                        b'r' => out.push('\r'),
   176	                        b't' => out.push('\t'),
   177	                        b'u' => {
   178	                            let hex = self
   179	                                .bytes
   180	                                .get(self.pos..self.pos + 4)
   181	                                .ok_or_else(|| "короткий \\u".to_string())?;
   182	                            self.pos += 4;
   183	                            let code = u32::from_str_radix(
   184	                                std::str::from_utf8(hex).map_err(|err| err.to_string())?,
   185	                                16,
   186	                            )
   187	                            .map_err(|err| err.to_string())?;
   188	                            out.push(char::from_u32(code).ok_or_else(|| "плохой \\u".to_string())?);
   189	                        }
   190	                        other => return Err(format!("неизвестный escape {other:?}")),
   191	                    }
   192	                }
   193	                byte if byte < 0x20 => return Err(format!("control-байт {byte:?} в строке")),
   194	                byte if byte < 0x80 => out.push(byte as char),
   195	                _ => {
   196	                    // UTF-8: возвращаемся к началу последовательности и читаем её целиком.
   197	                    self.pos -= 1;
   198	                    let rest = std::str::from_utf8(&self.bytes[self.pos..])
   199	                        .map_err(|err| err.to_string())?;
   200	                    let ch = rest
   201	                        .chars()
   202	                        .next()
   203	                        .ok_or_else(|| "пустая строка".to_string())?;
   204	                    out.push(ch);
   205	                    self.pos += ch.len_utf8();
   206	                }
   207	            }
   208	        }
   209	    }
