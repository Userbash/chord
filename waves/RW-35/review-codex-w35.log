            Some(Value::String(name)) if !name.is_empty() => name,
            _ => return Err(DbusError::Protocol("Hello reply without unique name")),
        };
        connection.unique_name = name;
        Ok(connection)
    }

    /// Уникальное имя соединения на шине (`:1.x`).
    pub fn unique_name(&self) -> &str {
