   232	    /// (`Protocol`) — такой вызов не уходит на шину. Любая ошибка (`ERROR`, нет fd,
   233	    /// обрыв) возвращает `Err`, уже полученные fd закрываются.
   234	    pub fn inhibit_sleep(&mut self, why: &str) -> Result<SleepInhibitor, DbusError> {
   235	        if why.is_empty() {
   236	            return Err(DbusError::Protocol("empty why"));
   237	        }
