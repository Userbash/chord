   288	
   289	    fn call_typed_with_fds(
   290	        &mut self,
   291	        destination: &str,
   292	        path: &str,
   293	        interface: &str,
   294	        member: &str,
   295	        signature: &str,
   296	        body: &[Value],
   297	    ) -> Result<(Vec<Value>, Vec<RawFd>), DbusError> {
   298	        let serial = self.next_serial();
   299	        let mut fields = vec![
   300	            (message::FIELD_PATH, Value::String(path.to_owned())),
   301	            (
   302	                message::FIELD_INTERFACE,
   303	                Value::String(interface.to_owned()),
   304	            ),
   305	            (message::FIELD_MEMBER, Value::String(member.to_owned())),
   306	            (
   307	                message::FIELD_DESTINATION,
   308	                Value::String(destination.to_owned()),
   309	            ),
   310	        ];
   311	        if !signature.is_empty() {
   312	            fields.push((
   313	                message::FIELD_SIGNATURE,
   314	                Value::String(signature.to_owned()),
   315	            ));
   316	        }
   317	
   318	        let (bytes, fds) =
   319	            message::build_with_fds(MessageType::MethodCall, serial, &fields, signature, body)?;
   320	        if !fds.is_empty() && !self.unix_fd {
   321	            // Шина не согласовала SCM_RIGHTS: fd потерялись бы молча. Владение остаётся
   322	            // у вызывающего (значения `Value::UnixFd`), поэтому не закрываем.
   323	            return Err(DbusError::Protocol(
   324	                "unix fd passing is not negotiated with the bus",
   325	            ));
   326	        }
   327	        fd::send_with_fds(&self.stream, &bytes, &fds)?;
   328	        self.await_reply(serial)
   329	    }
   330	
   331	    /// Подписка на сигналы по правилу `AddMatch`.
   332	    pub fn add_match(&mut self, rule: &str) -> Result<(), DbusError> {
   333	        self.call(
   334	            "org.freedesktop.DBus",
   335	            "/org/freedesktop/DBus",
   336	            "org.freedesktop.DBus",
   337	            "AddMatch",
   338	            &[('s', Value::String(rule.to_owned()))],
   339	        )?;
   340	        Ok(())
   341	    }
   342	
   343	    /// Следующий сигнал (уже пришедшие отдаются из очереди).
   344	    pub fn next_signal(&mut self, timeout: Duration) -> Result<Signal, DbusError> {
   345	        loop {
   346	            if let Some(signal) = self.pending.pop_front() {
   347	                return Ok(signal);
   348	            }
   349	            let message = self.read_message(timeout)?;
   350	            match message.kind {
   351	                MessageType::Signal => return Ok(signal_from(message)),
   352	                // Ответы на уже завершённые вызовы и чужие method call'ы игнорируются:
   353	                // сервер не должен присылать их в этот момент, но падать из-за них нельзя.
   354	                // Возможные fd в их теле закрываются — иначе утечка.
   355	                MessageType::MethodReturn | MessageType::Error | MessageType::MethodCall => {
   356	                    message::close_fds_in_body(&message.body);
   357	                    continue;
   358	                }
   359	            }
   360	        }
   361	    }
   362	
   363	    fn await_reply(&mut self, serial: u32) -> Result<(Vec<Value>, Vec<RawFd>), DbusError> {
   364	        loop {
   365	            let message = self.read_message(CALL_TIMEOUT)?;
   366	            match message.kind {
   367	                MessageType::Signal => self.pending.push_back(signal_from(message)),
   368	                MessageType::MethodCall => message::close_fds_in_body(&message.body),
   369	                MessageType::MethodReturn => {
   370	                    if message.reply_serial() == Some(serial) {
   371	                        let fds = message::fds_in_body(&message.body);
   372	                        return Ok((message.body, fds));
   373	                    }
   374	                    // Ответ на чужой/завершённый вызов: fd из него закрываем.
   375	                    message::close_fds_in_body(&message.body);
   376	                }
   377	                MessageType::Error => {
   378	                    if message.reply_serial() == Some(serial) {
   379	                        let name = message.error_name().unwrap_or("<unknown error>").to_owned();
   380	                        let text = match message.body.first() {
   381	                            Some(Value::String(text)) => text.clone(),
   382	                            _ => String::new(),
   383	                        };
   384	                        message::close_fds_in_body(&message.body);
   385	                        return Err(DbusError::Remote {
   386	                            name,
   387	                            message: text,
   388	                        });
   389	                    }
   390	                    message::close_fds_in_body(&message.body);
   391	                }
   392	            }
   393	        }
   394	    }
   395	
   396	    fn read_message(&mut self, timeout: Duration) -> Result<message::Message, DbusError> {
   397	        self.stream
   398	            .set_read_timeout(Some(timeout))
   399	            .map_err(DbusError::Io)?;
   400	
   401	        let mut fds: Vec<RawFd> = Vec::new();
   402	        let mut header = [0u8; 16];
   403	        fd::recv_exact_with_fds(&self.stream, &mut header, &mut fds)?;
   404	        if header[0] != b'l' {
   405	            fd::close_all(&fds);
   406	            return Err(DbusError::Protocol("only little-endian is supported"));
   407	        }
   408	        let body_len = u32::from_le_bytes([header[4], header[5], header[6], header[7]]) as usize;
