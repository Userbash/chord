   183	impl Connection {
   184	    /// Подключается к шине, проходит AUTH EXTERNAL, согласует передачу unix-fd и
   185	    /// регистрируется через `Hello`.
   186	    ///
   187	    /// `Path` — обычный `UnixStream::connect`; `Abstract` — `SocketAddr::from_abstract_name`
   188	    /// + `UnixStream::connect_addr` (stable `std`, без `unsafe`).
   189	    pub fn connect(address: &BusAddress) -> Result<Self, DbusError> {
   190	        let stream = open_stream(address)?;
   191	        stream
   192	            .set_read_timeout(Some(auth::AUTH_TIMEOUT))
   193	            .map_err(DbusError::Io)?;
   194	        let unix_fd = authenticate_with_fds(&stream)?;
   195	
   196	        let mut connection = Self {
   197	            stream,
   198	            unique_name: String::new(),
   199	            serial: 0,
   200	            pending: VecDeque::new(),
   201	            unix_fd,
   202	        };
