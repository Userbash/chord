   354	/// Сигнатура значения (для [`super::Connection::call`]); `None` для пустых контейнеров,
   355	/// тип элемента которых из значения не выводится.
   356	pub(crate) fn signature_of_value(value: &Value) -> Option<String> {
   357	    Some(match value {
   358	        Value::Byte(_) => "y".to_owned(),
   359	        Value::Bool(_) => "b".to_owned(),
   360	        Value::U32(_) => "u".to_owned(),
   361	        Value::I32(_) => "i".to_owned(),
   362	        Value::String(_) => "s".to_owned(),
   363	        Value::UnixFd(_) => "h".to_owned(),
   364	        Value::Variant(_) => "v".to_owned(),
   365	        Value::Struct(items) => {
   366	            let mut signature = String::from("(");
   367	            for item in items {
   368	                signature.push_str(&signature_of_value(item)?);
   369	            }
   370	            signature.push(')');
   371	            signature
   372	        }
   373	        Value::Array(items) => format!("a{}", signature_of_value(items.first()?)?),
   374	        Value::Dict(entries) => {
   375	            let (key, value) = entries.first()?;
   376	            format!(
   377	                "a{{{}{}}}",
   378	                signature_of_value(key)?,
   379	                signature_of_value(value)?
   380	            )
   381	        }
   382	    })
   383	}
   384	
   385	fn field_type(code: u8) -> Option<&'static str> {
   386	    match code {
   387	        FIELD_PATH => Some("o"),
   388	        FIELD_INTERFACE | FIELD_MEMBER | FIELD_ERROR_NAME | FIELD_DESTINATION | FIELD_SENDER => {
   389	            Some("s")
   390	        }
   391	        FIELD_REPLY_SERIAL => Some("u"),
   392	        FIELD_SIGNATURE => Some("g"),
   393	        FIELD_UNIX_FDS => Some("u"),
   394	        _ => None,
   395	    }
   396	}
   397	
   398	fn write_body(writer: &mut Writer, signature: &str, body: &[Value]) -> Result<(), DbusError> {
   399	    let mut rest = signature;
   400	    let mut index = 0usize;
   401	    while !rest.is_empty() {
   402	        let (item, tail) = take_type(rest)?;
   403	        let value = body
   404	            .get(index)
   405	            .ok_or(DbusError::Protocol("body has fewer values than signature"))?;
   406	        writer.value(item, value)?;
   407	        rest = tail;
   408	        index += 1;
   409	    }
   410	    if index != body.len() {
   411	        return Err(DbusError::Protocol("body has more values than signature"));
   412	    }
   413	    Ok(())
   414	}
   415	
   416	struct Writer {
   417	    buffer: Vec<u8>,
   418	    /// fd в порядке появления `h` в теле; индекс `h` — позиция в этом векторе.
   419	    fds: Vec<RawFd>,
   420	}

