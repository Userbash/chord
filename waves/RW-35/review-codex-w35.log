   216	/// Разбирает сообщение без fd: любое `h` → `Protocol` (индекс некуда разрешить).
   217	pub fn parse(bytes: &[u8]) -> Result<Message, DbusError> {
   218	    parse_with_fds(bytes, Vec::new())
   219	}
   220	
   221	/// Разбирает сообщение, разрешая `h` в реальные fd из `fds`.
   222	///
   223	/// Владелец `fds` после вызова — этот разбор:
   224	/// - ошибка → все fd закрываются (дескрипторы не текут);
   225	/// - успех → fd, на которые не ссылается ни один `h`, закрываются, остальные живут в
   226	///   [`Value::UnixFd`] и принадлежат вызывающему;
   227	/// - повторный `h` на тот же индекс → `Protocol` (fd не клонируется).
   228	pub fn parse_with_fds(bytes: &[u8], fds: Vec<RawFd>) -> Result<Message, DbusError> {
   229	    let mut used = vec![false; fds.len()];
   230	    match parse_inner(bytes, &fds, &mut used) {
   231	        Ok(message) => {
   232	            for (index, raw) in fds.iter().enumerate() {
   233	                if !used[index] {
   234	                    fd::close_fd(*raw);
   235	                }
   236	            }
   237	            Ok(message)
   238	        }
   239	        Err(error) => {
   240	            fd::close_all(&fds);
   241	            Err(error)
   242	        }
   243	    }
   244	}
   245	
   246	fn parse_inner(bytes: &[u8], fds: &[RawFd], used: &mut [bool]) -> Result<Message, DbusError> {
   247	    if bytes.len() < 16 {
   248	        return Err(DbusError::Protocol("short header"));
   249	    }
   250	    if bytes[0] != b'l' {
   251	        return Err(DbusError::Protocol("only little-endian is supported"));
   252	    }
   253	    let kind =
   254	        MessageType::from_code(bytes[1]).ok_or(DbusError::Protocol("unknown message type"))?;
   255	    let body_len = u32::from_le_bytes([bytes[4], bytes[5], bytes[6], bytes[7]]) as usize;
   256	    let serial = u32::from_le_bytes([bytes[8], bytes[9], bytes[10], bytes[11]]);
   257	    let fields_len = u32::from_le_bytes([bytes[12], bytes[13], bytes[14], bytes[15]]) as usize;
   258	    if fields_len > MAX_HEADER_BYTES || body_len > MAX_BODY_BYTES {
   259	        return Err(DbusError::Protocol("message too large"));
   260	    }
   261	
   262	    let fields_end = 16usize
   263	        .checked_add(fields_len)
   264	        .ok_or(DbusError::Protocol("header length overflow"))?;
   265	    if fields_end > bytes.len() {
   266	        return Err(DbusError::Protocol("truncated header fields"));
   267	    }
   268	
   269	    let fields = {
   270	        let mut cursor = Cursor {
   271	            bytes,
   272	            position: 16,
   273	            end: fields_end,
   274	            fds,
   275	            used,
   276	        };
   277	        let mut fields = Vec::new();
   278	        while cursor.position < fields_end {
   279	            cursor.align(8)?;
   280	            if cursor.position >= fields_end {
   281	                break;
   282	            }
   283	            let code = cursor.byte()?;
   284	            let value = cursor.variant_value()?;
   285	            fields.push((code, value));
   286	        }
   287	        if cursor.position != fields_end {
   288	            return Err(DbusError::Protocol("header fields length mismatch"));
   289	        }
   290	        fields
   291	    };
   292	
   293	    let body_offset = (fields_end + 7) & !7;
   294	    let body_end = body_offset
   295	        .checked_add(body_len)
   296	        .ok_or(DbusError::Protocol("body length overflow"))?;
   297	    if body_end > bytes.len() {
   298	        return Err(DbusError::Protocol("truncated body"));
   299	    }
   300	    if body_end != bytes.len() {
   301	        return Err(DbusError::Protocol("trailing bytes after body"));
   302	    }
   303	
   304	    let signature = match fields
   305	        .iter()
   306	        .find(|(code, _)| *code == FIELD_SIGNATURE)
   307	        .map(|(_, value)| value)
   308	    {
   309	        None => String::new(),
   310	        Some(Value::String(signature)) => signature.clone(),
   311	        Some(_) => return Err(DbusError::Protocol("SIGNATURE field is not a signature")),
   312	    };
   313	
   314	    let mut cursor = Cursor {
   315	        bytes,
   316	        position: body_offset,
   317	        end: body_end,
   318	        fds,
   319	        used,
   320	    };
   321	    let mut body = Vec::new();
   322	    let mut rest = signature.as_str();
   323	    while !rest.is_empty() {
   324	        let (item, tail) = take_type(rest)?;
   325	        body.push(cursor.value(item)?);
   326	        rest = tail;
   327	    }
   328	    if cursor.position != body_end {
   329	        return Err(DbusError::Protocol("body not fully consumed"));
   330	    }
   331	
   332	    let message = Message {
   333	        kind,
   334	        serial,
   335	        fields,
   336	        signature,
   337	        body,
   338	    };
   339	    // Поле UNIX_FDS обязано совпадать с реально приложенным числом fd (спека D-Bus):
   340	    // иначе индексы `h` могли бы ссылаться на чужие/потерянные дескрипторы.
   341	    let declared = match message.field(FIELD_UNIX_FDS) {
   342	        None => 0,
   343	        Some(Value::U32(count)) => *count as usize,
   344	        Some(_) => return Err(DbusError::Protocol("UNIX_FDS field is not a u32")),
   345	    };
   346	    if declared != fds.len() {
   347	        return Err(DbusError::Protocol(
   348	            "UNIX_FDS count does not match ancillary fds",
   349	        ));
   350	    }
   351	    Ok(message)
   352	}
