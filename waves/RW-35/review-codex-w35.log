     1	//! P6-06: питание и idle через freedesktop D-Bus (headless).
     2	//!
     3	//! Три независимых части, каждая — самостоятельная freedesktop-реализация, а не перенос
     4	//! нативного `discord_utils` (wire-совместимость не заявляется, `RE-POWER.md` §3):
     5	//!
     6	//! - [`ScreenSaver`] (`org.freedesktop.ScreenSaver`, сессионная шина) — не гасить экран
     7	//!   во время звонка: `Inhibit`/`UnInhibit`/`IsActive`, плюс KDE-метод
     8	//!   `GetSessionIdleTime` (на других окружениях может отсутствовать — `Ok(None)`).
     9	//! - [`PowerMonitor`] (`org.freedesktop.login1.Manager`, системная шина) — события
    10	//!   `PrepareForSleep(b)`: `true` → [`PowerEvent::GoingToSleep`], `false` →
    11	//!   [`PowerEvent::WakingUp`].
    12	//! - [`IdlePolicy`] — авто-статус `online/idle/dnd` по времени бездействия. Точные пороги
    13	//!   в RE клиента не подтверждены, поэтому [`IdlePolicy::DEFAULT`] — конфигурация с явной
    14	//!   пометкой, а не «факт» Discord.
    15	//! - [`PowerMonitor::inhibit_sleep`] — fd-ингибитор сна: `login1.Manager.Inhibit(ssss) -> h`
    16	//!   через SCM_RIGHTS, владение fd — [`SleepInhibitor`] (`Drop` → `close`).
    17	//!
    18	//! Ограничения (осознанные, в бэклоге): Wayland `ext-idle-notify-v1` и X11 `XScreenSaver`
    19	//! без клиентских библиотек недоступны; live-проверка только читает состояние и по флагу
    20	//! `DISCORD_LAB_POWER_LIVE=1` ставит ингибитор на время теста (в CI флаг выключен).
    21	//! Только `std` + [`crate::dbus`] + `libc` (изоляция `unsafe` — `dbus/fd.rs`).
    22	
    23	use std::os::fd::RawFd;
    24	use std::time::Duration;
    25	
    26	use crate::dbus::{BusAddress, Connection, DbusError, Signal, Value, fd};
    27	
    28	/// Well-known имя сервиса скринсейвера (сессионная шина).
    29	pub const SCREENSAVER_DESTINATION: &str = "org.freedesktop.ScreenSaver";
    30	/// Путь объекта скринсейвера.
    31	pub const SCREENSAVER_PATH: &str = "/org/freedesktop/ScreenSaver";
    32	/// Интерфейс скринсейвера.
    33	pub const SCREENSAVER_INTERFACE: &str = "org.freedesktop.ScreenSaver";
    34	/// `Inhibit(application_name: s, reason_for_inhibit: s) -> cookie: u`.
    35	pub const INHIBIT_METHOD: &str = "Inhibit";
    36	/// Сигнатура `Inhibit`.
    37	pub const INHIBIT_SIGNATURE: &str = "ss";
    38	/// Каноническое имя снятия ингибитора.
    39	pub const UNINHIBIT_METHOD: &str = "UnInhibit";
    40	/// Вариант имени, который встречается у части сервисов; используется только как fallback.
    41	pub const UNINHIBIT_FALLBACK_METHOD: &str = "Uninhibit";
    42	/// `IsActive() -> b`.
    43	pub const IS_ACTIVE_METHOD: &str = "IsActive";
    44	/// `GetSessionIdleTime() -> u` (KDE; метод не входит в базовую спеку freedesktop).
    45	pub const IDLE_METHOD: &str = "GetSessionIdleTime";
    46	
    47	/// Well-known имя systemd-logind (системная шина).
    48	pub const LOGIN1_DESTINATION: &str = "org.freedesktop.login1";
    49	/// Путь объекта менеджера logind.
    50	pub const LOGIN1_PATH: &str = "/org/freedesktop/login1";
    51	/// Интерфейс менеджера logind.
    52	pub const LOGIN1_INTERFACE: &str = "org.freedesktop.login1.Manager";
    53	/// Сигнал `PrepareForSleep(b)`: `true` — уходим в сон, `false` — проснулись.
    54	pub const SLEEP_SIGNAL: &str = "PrepareForSleep";
    55	/// Метод `Inhibit` менеджера logind.
    56	pub const SLEEP_INHIBIT_METHOD: &str = "Inhibit";
    57	/// Что ингибируем: только сон.
    58	pub const SLEEP_INHIBIT_WHAT: &str = "sleep";
    59	/// `who` для журнала logind.
