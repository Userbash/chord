    61	def read_all(fd):
    62	    """Читает fd до EOF (для fd, пришедших от клиента)."""
    63	    chunks = []
    64	    while True:
    65	        chunk = os.read(fd, 4096)
    66	        if not chunk:
    67	            break
    68	        chunks.append(chunk)
    69	    return b"".join(chunks)
