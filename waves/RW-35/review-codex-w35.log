   254	    /// `AddMatch` на `PrepareForSleep` менеджера logind.
   255	    pub fn subscribe(&mut self) -> Result<(), DbusError> {
   256	        // sender не фиксируется: шина приписывает сигналы уникальному имени отправителя,
   257	        // а path/interface/member клиент проверяет сам в `sleep_event`.
   258	        let rule = format!(
   259	            "type='signal',path='{LOGIN1_PATH}',interface='{LOGIN1_INTERFACE}',\
   260	             member='{SLEEP_SIGNAL}'"
   261	        );
   262	        self.connection.add_match(&rule)
