   211	    fn array(&mut self) -> Result<Json, String> {
   212	        self.expect(b'[')?;
   213	        let mut items = Vec::new();
   214	        self.skip_ws();
   215	        if self.bytes.get(self.pos) == Some(&b']') {
   216	            self.pos += 1;
   217	            return Ok(Json::Arr(items));
   218	        }
   219	        loop {
   220	            items.push(self.value()?);
   221	            self.skip_ws();
   222	            match self.bytes.get(self.pos) {
   223	                Some(b',') => self.pos += 1,
   224	                Some(b']') => {
   225	                    self.pos += 1;
   226	                    return Ok(Json::Arr(items));
   227	                }
   228	                other => return Err(format!("ожидался ',' или ']', получено {other:?}")),
   229	            }
   230	        }
   231	    }
   232	
   233	    fn object(&mut self) -> Result<Json, String> {
   234	        self.expect(b'{')?;
   235	        let mut entries = Vec::new();
   236	        self.skip_ws();
   237	        if self.bytes.get(self.pos) == Some(&b'}') {
   238	            self.pos += 1;
   239	            return Ok(Json::Obj(entries));
   240	        }
   241	        loop {
   242	            self.skip_ws();
   243	            let key = self.string()?;
   244	            self.skip_ws();
   245	            self.expect(b':')?;
   246	            let value = self.value()?;
   247	            entries.push((key, value));
   248	            self.skip_ws();
   249	            match self.bytes.get(self.pos) {
   250	                Some(b',') => self.pos += 1,
   251	                Some(b'}') => {
   252	                    self.pos += 1;
   253	                    return Ok(Json::Obj(entries));
   254	                }
   255	                other => return Err(format!("ожидался ',' или '}}', получено {other:?}")),
   256	            }
   257	        }
   258	    }
   259	}
