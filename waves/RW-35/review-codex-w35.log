   565	const fn alignment_of(signature: &str) -> usize {
   566	    match signature.as_bytes()[0] {
   567	        b'n' | b'q' => 2,
   568	        b'u' | b'i' | b'h' | b's' | b'o' | b'a' => 4,
   569	        b'x' | b't' | b'd' | b'(' | b'{' => 8,
   570	        // y, b, g, v
   571	        _ => 1,
   572	    }
   573	}
