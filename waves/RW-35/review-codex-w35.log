    53	def make_memfd(name, payload):
    54	    """Создаёт memfd с данными и возвращает его на чтение с начала."""
    55	    fd = os.memfd_create(name, flags=0)
    56	    os.write(fd, payload)
    57	    os.lseek(fd, 0, os.SEEK_SET)
    58	    return fd
