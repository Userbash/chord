    88	    @dbus.service.method(LOGIN1_IFACE, in_signature="ssss", out_signature="h")
    89	    def Inhibit(self, what, who, why, mode):
    90	        # Журнал пишется до ответа: тест видит аргументы даже при ERROR.
    91	        self._log("Inhibit", str(what), str(who), str(why), str(mode))
    92	        if self._inhibit_mode == "error":
    93	            raise dbus.exceptions.DBusException(
    94	                "mock inhibit denied",
