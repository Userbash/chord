   212	            Some(Value::String(name)) if !name.is_empty() => name,
   213	            _ => return Err(DbusError::Protocol("Hello reply without unique name")),
   214	        };
   215	        connection.unique_name = name;
   216	        Ok(connection)
   217	    }
