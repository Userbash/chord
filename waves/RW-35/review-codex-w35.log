    51	            Self::MethodCall => 1,
    52	            Self::MethodReturn => 2,
    53	            Self::Error => 3,
    54	            Self::Signal => 4,
    55	        }
    56	    }
    57	
    58	    /// Разбор кода типа; неизвестный код → `None`.
    59	    pub fn from_code(code: u8) -> Option<Self> {
    60	        match code {
    61	            1 => Some(Self::MethodCall),
    62	            2 => Some(Self::MethodReturn),
    63	            3 => Some(Self::Error),
    64	            4 => Some(Self::Signal),
    65	            _ => None,
    66	        }
    67	    }
