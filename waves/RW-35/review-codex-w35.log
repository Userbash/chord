     6	//! изолирована здесь: [`super::message`] и [`super::Connection`] видят только безопасные
     7	//! функции и [`std::os::fd::RawFd`].
     8	//!
     9	//! Ограничения (осознанные):
    10	//! - Linux/Unix: `SCM_RIGHTS`, `MSG_CTRUNC`, `sendmsg`/`recvmsg`;
    11	//! - принимается не больше [`MAX_FDS_PER_MESSAGE`] fd на сообщение (столько же по умолчанию
    12	//!   допускает `dbus-daemon`); лишние → `MSG_CTRUNC` → [`super::DbusError::Protocol`],
    13	//!   уже доставленные fd закрываются;
    14	//! - отправка — не больше `SCM_MAX_FD` (253) fd одним сообщением;
    15	//! - fd не наследуются через `fork`/`exec`: владение остаётся у процесса-получателя.
    16	
    17	#![allow(unsafe_code)]
    18	
    19	use std::io::ErrorKind;
    20	use std::mem::size_of;
    21	use std::os::fd::{AsRawFd, RawFd};
    22	use std::os::unix::net::UnixStream;
    23	
    24	use super::DbusError;
    25	
    26	/// Максимум fd, принимаемых в одном сообщении.
    27	///
    28	/// Совпадает с дефолтным лимитом `dbus-daemon` (`max_message_unix_fds`); сообщение с
    29	/// большим числом fd приходит с `MSG_CTRUNC` и отвергается как `Protocol`.
    30	pub const MAX_FDS_PER_MESSAGE: usize = 16;
    31	
    32	/// Предел ядра Linux на число fd в одном `sendmsg` (`SCM_MAX_FD`).
    33	const SCM_MAX_FD: usize = 253;
    34	
    35	const INT_BYTES: usize = size_of::<libc::c_int>();
    36	
    37	/// Буфер ancillary для приёма: `cmsghdr` + ровно [`MAX_FDS_PER_MESSAGE`] fd.
    38	///
    39	/// Ровно по лимиту (а не с запасом), чтобы сообщение с бо́льшим числом fd гарантированно
    40	/// приходило с `MSG_CTRUNC` и отвергалось, а не «влезало наполовину».
    41	const CONTROL_BYTES: usize = 16 + MAX_FDS_PER_MESSAGE * INT_BYTES;
    42	/// Буфер ancillary для отправки: до [`SCM_MAX_FD`] fd.
    43	const SEND_CONTROL_BYTES: usize = 16 + SCM_MAX_FD * INT_BYTES + 8;
    44	
    45	/// Выровненный под `cmsghdr` буфер: `cmsghdr` требует выравнивания `size_t`.
    46	#[repr(align(8))]
    47	struct ControlBuffer([u8; CONTROL_BYTES]);
    48	
    49	#[repr(align(8))]
    50	struct SendControlBuffer([u8; SEND_CONTROL_BYTES]);
    51	
    52	/// Закрывает fd ровно один раз; отрицательные значения игнорируются.
    53	///
    54	/// Повторный `close` уже закрытого fd — ошибка `EBADF`, которую здесь некому обработать
    55	/// (владелец вызывает функцию ровно один раз); поэтому значение `fd < 0` не трогается.
    56	pub fn close_fd(fd: RawFd) {
    57	    if fd < 0 {
    58	        return;
    59	    }
    60	    // SAFETY: `close(2)` принимает любой целочисленный fd; недействительный fd даёт EBADF,
    61	    // памяти не касается. Владение fd передано вызывающему (см. контракт `UnixFd`).
    62	    unsafe {
    63	        libc::close(fd);
    64	    }
    65	}
    66	
    67	/// Закрывает все fd из среза (порядок сохраняется, повторы закрываются как отдельные).
    68	pub fn close_all(fds: &[RawFd]) {
    69	    for fd in fds {
    70	        close_fd(*fd);
    71	    }
    72	}
    73	
    74	/// Отправляет `bytes` одним сообщением, приложив `fds` через `SCM_RIGHTS`.
    75	///
    76	/// `bytes` обязаны быть непустыми: ancillary-данные прикрепляются к первому байту.
    77	/// Частичная отправка повторяется; fd прикладываются только к первому `sendmsg`
    78	/// (иначе ядро продублировало бы их). Ошибка отправки не закрывает `fds` — ими
    79	/// по-прежнему владеет вызывающий.
    80	pub fn send_with_fds(stream: &UnixStream, bytes: &[u8], fds: &[RawFd]) -> Result<(), DbusError> {
    81	    if fds.len() > SCM_MAX_FD {
    82	        return Err(DbusError::Protocol("too many unix fds to send"));
    83	    }
    84	    if bytes.is_empty() {
    85	        return if fds.is_empty() {
    86	            Ok(())
    87	        } else {
    88	            Err(DbusError::Protocol("empty message with unix fds"))
    89	        };
    90	    }
    91	
    92	    let mut control = SendControlBuffer([0u8; SEND_CONTROL_BYTES]);
    93	    let mut iov = libc::iovec {
    94	        iov_base: bytes.as_ptr() as *mut libc::c_void,
    95	        iov_len: bytes.len(),
    96	    };
    97	    let mut message: libc::msghdr = {
    98	        // SAFETY: `msghdr` — POD; нулевая инициализация корректна, поля заполняются ниже.
    99	        unsafe { std::mem::zeroed() }
   100	    };
   101	    message.msg_iov = &mut iov;
   102	    message.msg_iovlen = 1;
   103	
   104	    if !fds.is_empty() {
   105	        let payload = fds.len() * INT_BYTES;
   106	        let payload_u32 =
   107	            u32::try_from(payload).map_err(|_| DbusError::Protocol("unix fd payload too large"))?;
   108	        // SAFETY: буфер выровнен и вмещает `CMSG_SPACE(payload)`; cmsg_len/CMSG_DATA
   109	        // вычисляются для этого же буфера, копирование не выходит за payload.
   110	        let control_len = unsafe {
   111	            let header = control.0.as_mut_ptr() as *mut libc::cmsghdr;
   112	            (*header).cmsg_level = libc::SOL_SOCKET;
   113	            (*header).cmsg_type = libc::SCM_RIGHTS;
   114	            (*header).cmsg_len = libc::CMSG_LEN(payload_u32) as usize;
   115	            std::ptr::copy_nonoverlapping(
   116	                fds.as_ptr() as *const u8,
   117	                libc::CMSG_DATA(header),
   118	                payload,
   119	            );
   120	            // SAFETY: `CMSG_SPACE` — чистая функция от длины; значение влезает в буфер.
   121	            libc::CMSG_SPACE(payload_u32) as usize
   122	        };
   123	        message.msg_control = control.0.as_mut_ptr() as *mut libc::c_void;
   124	        message.msg_controllen = control_len;
   125	    }
   126	
   127	    let mut sent_total = 0usize;
   128	    while sent_total < bytes.len() {
   129	        // SAFETY: `message` указывает на живой `iov` и (опционально) control-буфер;
   130	        // сокет валиден; MSG_NOSIGNAL исключает SIGPIPE.
   131	        let sent = unsafe { libc::sendmsg(stream.as_raw_fd(), &message, libc::MSG_NOSIGNAL) };
   132	        if sent < 0 {
   133	            let error = std::io::Error::last_os_error();
   134	            match error.kind() {
   135	                ErrorKind::Interrupted => continue,
   136	                ErrorKind::WouldBlock | ErrorKind::TimedOut => return Err(DbusError::Timeout),
   137	                _ => return Err(DbusError::Io(error)),
   138	            }
   139	        }
   140	        if sent == 0 {
   141	            return Err(DbusError::Protocol("short send"));
   142	        }
   143	        let sent = sent as usize;
   144	        sent_total += sent;
   145	        // fd уже отправлены с первым успешным sendmsg: очищаем ancillary.
   146	        message.msg_control = std::ptr::null_mut();
   147	        message.msg_controllen = 0;
   148	        // SAFETY: `sent <= iov.iov_len` (sendmsg не отправляет больше запрошенного),
   149	        // сдвиг остаётся внутри исходного среза.
   150	        iov.iov_base = unsafe { (iov.iov_base as *mut u8).add(sent) } as *mut libc::c_void;
   151	        iov.iov_len -= sent;
   152	    }
   153	    Ok(())
   154	}
   155	
   156	/// Читает ровно `buffer.len()` байт, собирая пришедшие `SCM_RIGHTS` fd в `fds`.
   157	///
   158	/// При `MSG_CTRUNC`, неожиданном/битом ancillary или обрыве соединения возвращает
   159	/// `DbusError::Protocol`/`Timeout`/`Io`, **закрывая** уже собранные fd и очищая `fds`:
   160	/// наружу не отдаётся ни одного «осиротевшего» дескриптора.
   161	pub fn recv_exact_with_fds(
   162	    stream: &UnixStream,
   163	    buffer: &mut [u8],
   164	    fds: &mut Vec<RawFd>,
   165	) -> Result<(), DbusError> {
   166	    let mut filled = 0usize;
   167	    while filled < buffer.len() {
   168	        let mut control = ControlBuffer([0u8; CONTROL_BYTES]);
   169	        let mut iov = libc::iovec {
   170	            iov_base: buffer[filled..].as_mut_ptr() as *mut libc::c_void,
   171	            iov_len: buffer.len() - filled,
   172	        };
   173	        let mut message: libc::msghdr = {
   174	            // SAFETY: `msghdr` — POD; нулевая инициализация корректна, поля заполняются ниже.
   175	            unsafe { std::mem::zeroed() }
   176	        };
   177	        message.msg_iov = &mut iov;
   178	        message.msg_iovlen = 1;
   179	        message.msg_control = control.0.as_mut_ptr() as *mut libc::c_void;
   180	        message.msg_controllen = CONTROL_BYTES as _;
   181	
   182	        // SAFETY: `message` описывает живой буфер `buffer[filled..]` и control-буфер
   183	        // ровно заявленной длины; сокет валиден.
   184	        let received = unsafe { libc::recvmsg(stream.as_raw_fd(), &mut message, 0) };
   185	        if received < 0 {
   186	            let error = std::io::Error::last_os_error();
   187	            match error.kind() {
   188	                ErrorKind::Interrupted => continue,
   189	                ErrorKind::WouldBlock | ErrorKind::TimedOut => {
   190	                    return Err(discard(fds, DbusError::Timeout));
   191	                }
   192	                _ => return Err(discard(fds, DbusError::Io(error))),
   193	            }
   194	        }
   195	        if received == 0 {
   196	            return Err(discard(fds, DbusError::Protocol("truncated message")));
   197	        }
   198	        // Ancillary мог быть обрезан (`MSG_CTRUNC`), но доставленные cmsg всё равно
   199	        // разбираем: их fd обязаны быть закрыты, иначе утечка.
   200	        // SAFETY: `msg_control`/`msg_controllen` заполнены ядром; обход cmsg ограничен
   201	        // этими полями (CMSG_FIRSTHDR/CMSG_NXTHDR).
   202	        unsafe {
   203	            let mut header = libc::CMSG_FIRSTHDR(&message);
   204	            while !header.is_null() {
   205	                if (*header).cmsg_level != libc::SOL_SOCKET
   206	                    || (*header).cmsg_type != libc::SCM_RIGHTS
   207	                {
   208	                    return Err(discard(
   209	                        fds,
   210	                        DbusError::Protocol("unexpected ancillary data"),
   211	                    ));
   212	                }
   213	                let length = (*header).cmsg_len as usize;
   214	                let header_len = libc::CMSG_LEN(0) as usize;
   215	                if length < header_len || !(length - header_len).is_multiple_of(INT_BYTES) {
   216	                    return Err(discard(
   217	                        fds,
   218	                        DbusError::Protocol("malformed ancillary data"),
   219	                    ));
   220	                }
   221	                let count = (length - header_len) / INT_BYTES;
   222	                let data = libc::CMSG_DATA(header);
   223	                for index in 0..count {
   224	                    let mut raw: libc::c_int = 0;
   225	                    std::ptr::copy_nonoverlapping(
   226	                        data.add(index * INT_BYTES),
   227	                        &mut raw as *mut libc::c_int as *mut u8,
   228	                        INT_BYTES,
   229	                    );
   230	                    if raw < 0 {
   231	                        return Err(discard(fds, DbusError::Protocol("invalid unix fd")));
   232	                    }
   233	                    fds.push(raw);
   234	                }
   235	                header = libc::CMSG_NXTHDR(&message, header);
   236	            }
   237	        }
   238	        if message.msg_flags & libc::MSG_CTRUNC != 0 {
   239	            return Err(discard(fds, DbusError::Protocol("control data truncated")));
   240	        }
   241	        if fds.len() > MAX_FDS_PER_MESSAGE {
   242	            return Err(discard(
   243	                fds,
   244	                DbusError::Protocol("too many unix fds in message"),
   245	            ));
   246	        }
   247	
   248	        filled += received as usize;
   249	    }
   250	    Ok(())
   251	}
   252	
   253	/// Закрывает собранные fd и очищает вектор, чтобы вызывающий не увидел «висящих» fd.
   254	fn discard(fds: &mut Vec<RawFd>, error: DbusError) -> DbusError {
   255	    close_all(fds);
   256	    fds.clear();
   257	    error
   258	}

