   438	/// AUTH EXTERNAL + `NEGOTIATE_UNIX_FD` + `BEGIN`.
   439	///
   440	/// [`auth::authenticate`] отправляет `BEGIN` сразу после `OK` и потому не оставляет места
   441	/// для согласования fd. Повторяем ту же последовательность здесь (файл `auth.rs` — чужая
   442	/// зона в матрице W35a), добавляя шаг `NEGOTIATE_UNIX_FD`: без `AGREE_UNIX_FD` шина не
   443	/// пересылает `SCM_RIGHTS` (спека D-Bus, раздел «Authentication»).
   444	///
   445	/// Возвращает `true`, если шина согласилась принимать/передавать unix-fd. Ответ `ERROR`
   446	/// на `NEGOTIATE_UNIX_FD` не фатален: соединение работает без fd.
   447	fn authenticate_with_fds(stream: &UnixStream) -> Result<bool, DbusError> {
   448	    let uid = auth::current_uid()?;
   449	    let mut request = Vec::with_capacity(32);
   450	    request.push(0u8); // credentials byte: без него шина не читает команды
   451	    request.extend_from_slice(auth::external_auth_line(uid).as_bytes());
   452	    request.extend_from_slice(b"\r\n");
   453	
   454	    let mut writer = stream;
   455	    writer.write_all(&request).map_err(DbusError::Io)?;
   456	
   457	    let reply = read_auth_line(stream)?;
   458	    if reply.starts_with("REJECTED") {
   459	        return Err(DbusError::Auth("EXTERNAL auth rejected"));
   460	    }
   461	    if reply.starts_with("ERROR") {
   462	        return Err(DbusError::Auth("auth error"));
   463	    }
   464	    if !reply.starts_with("OK ") {
   465	        return Err(DbusError::Protocol("unexpected auth reply"));
   466	    }
   467	
   468	    writer
   469	        .write_all(b"NEGOTIATE_UNIX_FD\r\n")
   470	        .map_err(DbusError::Io)?;
   471	    let unix_fd = match read_auth_line(stream)?.as_str() {
   472	        "AGREE_UNIX_FD" => true,
   473	        reply if reply.starts_with("ERROR") => false,
   474	        _ => return Err(DbusError::Protocol("unexpected NEGOTIATE_UNIX_FD reply")),
   475	    };
   476	
   477	    writer.write_all(b"BEGIN\r\n").map_err(DbusError::Io)?;
   478	    Ok(unix_fd)
   479	}
   480	
   481	/// Строка auth-протокола до `\n` (с отбросом `\r`), не длиннее [`MAX_AUTH_LINE`].
   482	fn read_auth_line(stream: &UnixStream) -> Result<String, DbusError> {
   483	    let mut reader = stream;
   484	    let mut bytes = Vec::with_capacity(64);
   485	    let mut byte = [0u8; 1];
   486	    loop {
   487	        match reader.read(&mut byte) {
   488	            Ok(0) => return Err(DbusError::Protocol("auth connection closed")),
   489	            Ok(_) => {
   490	                if byte[0] == b'\n' {
   491	                    break;
   492	                }
   493	                if bytes.len() >= MAX_AUTH_LINE {
   494	                    return Err(DbusError::Protocol("auth reply too long"));
   495	                }
   496	                bytes.push(byte[0]);
   497	            }
   498	            Err(error)
   499	                if error.kind() == ErrorKind::WouldBlock || error.kind() == ErrorKind::TimedOut =>
   500	            {
   501	                return Err(DbusError::Timeout);
   502	            }
   503	            Err(error) => return Err(DbusError::Io(error)),
   504	        }
   505	    }
   506	    if bytes.last() == Some(&b'\r') {
   507	        bytes.pop();
   508	    }
   509	    String::from_utf8(bytes).map_err(|_| DbusError::Protocol("auth reply is not utf-8"))
   510	}
