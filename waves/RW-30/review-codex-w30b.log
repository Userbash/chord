     1	//! P6-02: уведомления рабочего стола через `org.freedesktop.Notifications`.
     2	//!
     3	//! Discord на Linux **не загружает** нативный модуль уведомлений (`RE-NOTIFICATIONS.md` §1),
     4	//! поэтому здесь самостоятельный D-Bus-клиент по спецификации freedesktop — не перенос
     5	//! нативного модуля и не wire-совместимость с Electron (`RE-NOTIFICATIONS.md` §3).
     6	//!
     7	//! Поддержано: `Notify`, `CloseNotification`, `GetCapabilities`, `GetServerInformation`,
     8	//! `AddMatch` + события `ActionInvoked`/`NotificationClosed`.
     9	//! `hints` намеренно пустой `a{sv}`: полный набор хинтов (urgency, image-path, …) —
    10	//! отдельное расширение, когда появится UI-потребитель.
    11	//! DND/группировка/история — уровень приложения (P6-01/P3), не этого модуля.
    12	
    13	use std::time::Duration;
    14	
    15	use crate::dbus::{BusAddress, Connection, DbusError, Value};
    16	
    17	/// Well-known имя сервиса уведомлений.
    18	pub const DESTINATION: &str = "org.freedesktop.Notifications";
    19	/// Путь объекта сервиса уведомлений.
    20	pub const PATH: &str = "/org/freedesktop/Notifications";
    21	/// Интерфейс сервиса уведомлений.
    22	pub const INTERFACE: &str = "org.freedesktop.Notifications";
    23	/// Сигнатура тела `Notify` по спецификации freedesktop.
    24	///
    25	/// `actions` на проводе — `as` (плоский список парами id/label), хотя в модели это
    26	/// `Vec<(String, String)>`; `hints` — пустой `a{sv}`.
    27	pub const NOTIFY_SIGNATURE: &str = "susssasa{sv}i";
    28	/// Таймаут ожидания события (`next_event`).
    29	pub const EVENT_TIMEOUT: Duration = Duration::from_secs(5);
    30	
    31	/// Уведомление к отправке.
    32	#[derive(Debug, Clone, Default, PartialEq, Eq)]
    33	pub struct Notification {
    34	    pub app_name: String,
    35	    pub summary: String,
    36	    pub body: String,
    37	    pub replaces_id: u32,
    38	    /// Пары (id действия, подпись) — на проводе разворачиваются в `as`.
    39	    pub actions: Vec<(String, String)>,
    40	    /// -1 — таймаут сервера по умолчанию.
    41	    pub timeout_ms: i32,
    42	}
    43	
    44	/// Событие уведомления, пришедшее сигналом.
    45	#[derive(Debug, Clone, PartialEq, Eq)]
    46	pub enum NotificationEvent {
    47	    Action { id: u32, action: String },
    48	    Closed { id: u32, reason: u32 },
    49	}
    50	
    51	/// Клиент сервиса уведомлений.
    52	#[derive(Debug)]
    53	pub struct Notifier {
    54	    connection: Connection,
    55	}
    56	
    57	impl Notifier {
    58	    /// Подключается к шине (AUTH EXTERNAL + `Hello`), но ничего не отправляет.
    59	    pub fn connect(address: &BusAddress) -> Result<Self, DbusError> {
    60	        Ok(Self {
    61	            connection: Connection::connect(address)?,
    62	        })
    63	    }
    64	
    65	    /// `GetCapabilities() -> as`.
    66	    pub fn capabilities(&mut self) -> Result<Vec<String>, DbusError> {
    67	        let body = self.call("GetCapabilities", "", &[])?;
    68	        let Some(Value::Array(items)) = body.into_iter().next() else {
    69	            return Err(DbusError::Protocol("GetCapabilities reply is not an array"));
    70	        };
    71	        let mut capabilities = Vec::with_capacity(items.len());
    72	        for item in items {
    73	            match item {
    74	                Value::String(capability) => capabilities.push(capability),
    75	                _ => {
    76	                    return Err(DbusError::Protocol("GetCapabilities item is not a string"));
    77	                }
    78	            }
    79	        }
    80	        Ok(capabilities)
    81	    }
    82	
    83	    /// `GetServerInformation() -> ssss`: имя, вендор, версия, версия спецификации.
    84	    ///
    85	    /// По D-Bus несколько возвращаемых значений — это последовательность типов тела
    86	    /// (`ssss`), а не struct: struct-обёртки в теле ответа нет.
    87	    pub fn server_information(&mut self) -> Result<(String, String, String, String), DbusError> {
    88	        let body = self.call("GetServerInformation", "", &[])?;
    89	        let mut values: [String; 4] = Default::default();
    90	        if body.len() != 4 {
    91	            return Err(DbusError::Protocol(
    92	                "GetServerInformation reply does not have 4 values",
    93	            ));
    94	        }
    95	        for (slot, item) in values.iter_mut().zip(body) {
    96	            match item {
    97	                Value::String(text) => *slot = text,
    98	                _ => {
    99	                    return Err(DbusError::Protocol(
   100	                        "GetServerInformation field is not a string",
   101	                    ));
   102	                }
   103	            }
   104	        }
   105	        let [name, vendor, version, specification] = values;
   106	        Ok((name, vendor, version, specification))
   107	    }
   108	
   109	    /// `Notify(...) -> u`: серверный id уведомления.
   110	    ///
   111	    /// `app_name` и `summary` обязаны быть непустыми (иначе `DbusError::Protocol`):
   112	    /// пустой заголовок серверы обычно отбрасывают, и пользователь не увидит уведомление.
   113	    pub fn notify(&mut self, notification: &Notification) -> Result<u32, DbusError> {
   114	        if notification.app_name.is_empty() {
   115	            return Err(DbusError::Protocol("empty app_name"));
   116	        }
   117	        if notification.summary.is_empty() {
   118	            return Err(DbusError::Protocol("empty summary"));
   119	        }
   120	
   121	        let mut actions = Vec::with_capacity(notification.actions.len() * 2);
   122	        for (action_id, label) in &notification.actions {
   123	            if action_id.is_empty() {
   124	                return Err(DbusError::Protocol("empty action id"));
   125	            }
   126	            actions.push(Value::String(action_id.clone()));
   127	            actions.push(Value::String(label.clone()));
   128	        }
   129	
   130	        let body = vec![
   131	            Value::String(notification.app_name.clone()),
   132	            Value::U32(notification.replaces_id),
   133	            Value::String(String::new()), // app_icon: иконки в этой карточке не рисуются
   134	            Value::String(notification.summary.clone()),
   135	            Value::String(notification.body.clone()),
   136	            Value::Array(actions),
   137	            Value::Dict(Vec::new()), // hints: пустой a{sv}
   138	            Value::I32(notification.timeout_ms),
   139	        ];
   140	
   141	        let reply = self.call("Notify", NOTIFY_SIGNATURE, &body)?;
   142	        match reply.into_iter().next() {
   143	            Some(Value::U32(id)) => Ok(id),
   144	            _ => Err(DbusError::Protocol("Notify reply is not a u32 id")),
   145	        }
   146	    }
   147	
   148	    /// `CloseNotification(u)`.
   149	    pub fn close(&mut self, id: u32) -> Result<(), DbusError> {
   150	        self.call("CloseNotification", "u", &[Value::U32(id)])?;
   151	        Ok(())
   152	    }
   153	
   154	    /// Подписка на `ActionInvoked` и `NotificationClosed`.
   155	    pub fn listen_actions(&mut self) -> Result<(), DbusError> {
   156	        for member in ["ActionInvoked", "NotificationClosed"] {
   157	            let rule = format!("type='signal',interface='{INTERFACE}',member='{member}'");
   158	            self.connection.add_match(&rule)?;
   159	        }
   160	        Ok(())
   161	    }
   162	
   163	    /// Следующее событие уведомления; чужие сигналы и сигналы с неожиданным телом
   164	    /// пропускаются (не ошибка).
   165	    pub fn next_event(&mut self) -> Result<NotificationEvent, DbusError> {
   166	        loop {
   167	            let signal = self.connection.next_signal(EVENT_TIMEOUT)?;
   168	            if signal.interface != INTERFACE {
   169	                continue;
   170	            }
   171	            let event = match signal.member.as_str() {
   172	                "ActionInvoked" => action_event(&signal.body),
   173	                "NotificationClosed" => closed_event(&signal.body),
   174	                _ => None,
   175	            };
   176	            if let Some(event) = event {
   177	                return Ok(event);
   178	            }
   179	        }
   180	    }
   181	
   182	    fn call(
   183	        &mut self,
   184	        member: &str,
   185	        signature: &str,
   186	        body: &[Value],
   187	    ) -> Result<Vec<Value>, DbusError> {
   188	        self.connection
   189	            .call_typed(DESTINATION, PATH, INTERFACE, member, signature, body)
   190	    }
   191	}
   192	
   193	fn action_event(body: &[Value]) -> Option<NotificationEvent> {
   194	    // Сигнатура `us`: тело — два значения подряд (без struct-обёртки).
   195	    match body {
   196	        [Value::U32(id), Value::String(action)] => Some(NotificationEvent::Action {
   197	            id: *id,
   198	            action: action.clone(),
   199	        }),
   200	        _ => None,
   201	    }
   202	}
   203	
   204	fn closed_event(body: &[Value]) -> Option<NotificationEvent> {
   205	    // Сигнатура `uu`.
   206	    match body {
   207	        [Value::U32(id), Value::U32(reason)] => Some(NotificationEvent::Closed {
   208	            id: *id,
   209	            reason: *reason,
   210	        }),
   211	        _ => None,
   212	    }
   213	}

