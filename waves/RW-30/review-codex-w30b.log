    74	struct JsonParser<'a> {
    75	    bytes: &'a [u8],
    76	    pos: usize,
    77	}
    78	
    79	impl JsonParser<'_> {
    80	    fn skip_ws(&mut self) {
    81	        while matches!(self.bytes.get(self.pos), Some(b' ' | b'\n' | b'\r' | b'\t')) {
    82	            self.pos += 1;
    83	        }
    84	    }
    85	
    86	    fn expect(&mut self, byte: u8) -> Result<(), String> {
    87	        if self.bytes.get(self.pos) == Some(&byte) {
    88	            self.pos += 1;
    89	            Ok(())
    90	        } else {
    91	            Err(format!(
    92	                "ожидался {:?} на позиции {}",
    93	                byte as char, self.pos
    94	            ))
    95	        }
    96	    }
    97	
    98	    fn value(&mut self) -> Result<Json, String> {
    99	        self.skip_ws();
   100	        match self.bytes.get(self.pos).copied() {
   101	            Some(b'{') => self.object(),
   102	            Some(b'[') => self.array(),
   103	            Some(b'"') => Ok(Json::Str(self.string()?)),
   104	            Some(b't') => self.literal("true", Json::Bool(true)),
   105	            Some(b'f') => self.literal("false", Json::Bool(false)),
   106	            Some(b'n') => self.literal("null", Json::Null),
   107	            Some(byte) if byte == b'-' || byte.is_ascii_digit() => self.number(),
   108	            other => Err(format!(
   109	                "неожиданный байт {other:?} на позиции {}",
   110	                self.pos
   111	            )),
   112	        }
   113	    }
   114	
   115	    fn literal(&mut self, text: &str, value: Json) -> Result<Json, String> {
   116	        if self.bytes[self.pos..].starts_with(text.as_bytes()) {
   117	            self.pos += text.len();
   118	            Ok(value)
   119	        } else {
   120	            Err(format!("ожидался литерал {text} на позиции {}", self.pos))
   121	        }
   122	    }
   123	
   124	    fn number(&mut self) -> Result<Json, String> {
   125	        let start = self.pos;
   126	        if self.bytes.get(self.pos) == Some(&b'-') {
   127	            self.pos += 1;
   128	        }
   129	        while matches!(self.bytes.get(self.pos), Some(byte) if byte.is_ascii_digit()) {
   130	            self.pos += 1;
   131	        }
   132	        if self.bytes.get(self.pos) == Some(&b'.') {
   133	            self.pos += 1;
   134	            while matches!(self.bytes.get(self.pos), Some(byte) if byte.is_ascii_digit()) {
   135	                self.pos += 1;
   136	            }
   137	        }
   138	        let text =
   139	            std::str::from_utf8(&self.bytes[start..self.pos]).map_err(|err| err.to_string())?;
   140	        text.parse::<f64>()
   141	            .map(Json::Num)
   142	            .map_err(|err| format!("число {text:?}: {err}"))
   143	    }
   144	
   145	    fn string(&mut self) -> Result<String, String> {
   146	        self.expect(b'"')?;
   147	        let mut out = String::new();
   148	        loop {
   149	            let byte = *self
   150	                .bytes
   151	                .get(self.pos)
   152	                .ok_or_else(|| "незакрытая строка".to_string())?;
   153	            self.pos += 1;
   154	            match byte {
   155	                b'"' => return Ok(out),
   156	                b'\\' => {
   157	                    let escape = *self
   158	                        .bytes
   159	                        .get(self.pos)
   160	                        .ok_or_else(|| "оборванный escape".to_string())?;
   161	                    self.pos += 1;
   162	                    match escape {
   163	                        b'"' => out.push('"'),
   164	                        b'\\' => out.push('\\'),
   165	                        b'/' => out.push('/'),
   166	                        b'b' => out.push('\u{0008}'),
   167	                        b'f' => out.push('\u{000C}'),
   168	                        b'n' => out.push('\n'),
   169	                        b'r' => out.push('\r'),
   170	                        b't' => out.push('\t'),
   171	                        b'u' => {
   172	                            let hex = self
   173	                                .bytes
   174	                                .get(self.pos..self.pos + 4)
   175	                                .ok_or_else(|| "короткий \\u".to_string())?;
   176	                            self.pos += 4;
   177	                            let code = u32::from_str_radix(
   178	                                std::str::from_utf8(hex).map_err(|err| err.to_string())?,
   179	                                16,
   180	                            )
   181	                            .map_err(|err| err.to_string())?;
   182	                            out.push(char::from_u32(code).ok_or_else(|| "плохой \\u".to_string())?);
   183	                        }
   184	                        other => return Err(format!("неизвестный escape {other:?}")),
   185	                    }
   186	                }
   187	                byte if byte < 0x20 => return Err(format!("control-байт {byte:?} в строке")),
   188	                byte if byte < 0x80 => out.push(byte as char),
   189	                _ => {
   190	                    // UTF-8: возвращаемся к началу последовательности и читаем её целиком.
   191	                    self.pos -= 1;
   192	                    let rest = std::str::from_utf8(&self.bytes[self.pos..])
   193	                        .map_err(|err| err.to_string())?;
   194	                    let ch = rest
   195	                        .chars()
   196	                        .next()
   197	                        .ok_or_else(|| "пустая строка".to_string())?;
   198	                    out.push(ch);
   199	                    self.pos += ch.len_utf8();
   200	                }
   201	            }
   202	        }
   203	    }
   204	
   205	    fn array(&mut self) -> Result<Json, String> {
   206	        self.expect(b'[')?;
   207	        let mut items = Vec::new();
   208	        self.skip_ws();
   209	        if self.bytes.get(self.pos) == Some(&b']') {
   210	            self.pos += 1;
   211	            return Ok(Json::Arr(items));
   212	        }
   213	        loop {
   214	            items.push(self.value()?);
   215	            self.skip_ws();
   216	            match self.bytes.get(self.pos) {
   217	                Some(b',') => self.pos += 1,
   218	                Some(b']') => {
   219	                    self.pos += 1;
   220	                    return Ok(Json::Arr(items));
   221	                }
   222	                other => return Err(format!("ожидался ',' или ']', получено {other:?}")),
   223	            }
   224	        }
   225	    }
   226	
   227	    fn object(&mut self) -> Result<Json, String> {
   228	        self.expect(b'{')?;
   229	        let mut entries = Vec::new();
   230	        self.skip_ws();
   231	        if self.bytes.get(self.pos) == Some(&b'}') {
   232	            self.pos += 1;
   233	            return Ok(Json::Obj(entries));
   234	        }
   235	        loop {
   236	            self.skip_ws();
   237	            let key = self.string()?;
   238	            self.skip_ws();
   239	            self.expect(b':')?;
   240	            let value = self.value()?;
   241	            entries.push((key, value));
   242	            self.skip_ws();
   243	            match self.bytes.get(self.pos) {
   244	                Some(b',') => self.pos += 1,
   245	                Some(b'}') => {
   246	                    self.pos += 1;
   247	                    return Ok(Json::Obj(entries));
   248	                }
   249	                other => return Err(format!("ожидался ',' или '}}', получено {other:?}")),
   250	            }
   251	        }
   252	    }
   253	}
