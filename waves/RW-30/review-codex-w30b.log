   270	fn hex_decode(text: &str) -> Vec<u8> {
   271	    assert_eq!(text.len() % 2, 0, "нечётная hex-строка");
   272	    let mut out = Vec::with_capacity(text.len() / 2);
   273	    for chunk in text.as_bytes().chunks(2) {
   274	        let pair = std::str::from_utf8(chunk).expect("hex ascii");
   275	        out.push(u8::from_str_radix(pair, 16).expect("hex pair"));
   276	    }
   277	    out
   278	}
   279	
   280	fn hex_encode(bytes: &[u8]) -> String {
   281	    let mut out = String::with_capacity(bytes.len() * 2);
   282	    for byte in bytes {
   283	        out.push_str(&format!("{byte:02x}"));
   284	    }
   285	    out
   286	}
