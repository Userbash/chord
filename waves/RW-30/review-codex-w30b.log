        [sys.executable, "-c", "import dbus, gi"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if probe.returncode != 0:
        return "нет python3-dbus/gi"
    return None


