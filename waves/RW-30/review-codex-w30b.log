   114	#[derive(Debug, Clone, PartialEq)]
   115	pub struct Signal {
   116	    pub path: String,
   117	    pub interface: String,
   118	    pub member: String,
   119	    pub body: Vec<Value>,
   120	}
   121	
   122	/// Соединение с шиной: AUTH EXTERNAL, `Hello`, вызовы и сигналы.
   123	#[derive(Debug)]
   124	pub struct Connection {
   125	    stream: UnixStream,
   126	    unique_name: String,
   127	    serial: u32,
   128	    pending: VecDeque<Signal>,
   129	}
   130	
   131	impl Connection {
   132	    /// Подключается к шине, проходит AUTH EXTERNAL и регистрируется через `Hello`.
   133	    pub fn connect(address: &BusAddress) -> Result<Self, DbusError> {
   134	        let stream = UnixStream::connect(address.path()).map_err(DbusError::Io)?;
   135	        stream
   136	            .set_read_timeout(Some(auth::AUTH_TIMEOUT))
   137	            .map_err(DbusError::Io)?;
   138	        auth::authenticate(&stream)?;
   139	
   140	        let mut connection = Self {
   141	            stream,
   142	            unique_name: String::new(),
   143	            serial: 0,
   144	            pending: VecDeque::new(),
   145	        };
   146	        let reply = connection.call_typed(
   147	            "org.freedesktop.DBus",
   148	            "/org/freedesktop/DBus",
   149	            "org.freedesktop.DBus",
   150	            "Hello",
   151	            "",
   152	            &[],
   153	        )?;
   154	        let name = match reply.into_iter().next() {
   155	            Some(Value::String(name)) if !name.is_empty() => name,
   156	            _ => return Err(DbusError::Protocol("Hello reply without unique name")),
   157	        };
   158	        connection.unique_name = name;
   159	        Ok(connection)
   160	    }
   161	
   162	    /// Уникальное имя соединения на шине (`:1.x`).
   163	    pub fn unique_name(&self) -> &str {
   164	        &self.unique_name
   165	    }
   166	
   167	    /// Вызов метода.
   168	    ///
   169	    /// `body` — пары «код типа, значение». Код — первый символ типа (`s`, `u`, `i`, `b`,
   170	    /// `y`, `a`, `(`, `v`); полный тип контейнера выводится из значения. Пустой массив или
   171	    /// пустой словарь неоднозначны (D-Bus не хранит тип элемента для пустого массива),
   172	    /// поэтому для них используйте типизированные обёртки из [`crate::notifications`]
   173	    /// (внутри — вызов с явной сигнатурой).
   174	    pub fn call(
   175	        &mut self,
   176	        destination: &str,
   177	        path: &str,
   178	        interface: &str,
   179	        member: &str,
   180	        body: &[(char, Value)],
   181	    ) -> Result<Vec<Value>, DbusError> {
   182	        let mut signature = String::new();
   183	        let mut values = Vec::with_capacity(body.len());
   184	        for (code, value) in body {
   185	            let fragment = message::signature_of_value(value)
   186	                .ok_or(DbusError::Protocol("empty container has no element type"))?;
   187	            if !fragment.starts_with(*code) {
   188	                return Err(DbusError::Protocol("type code does not match value"));
   189	            }
   190	            signature.push_str(&fragment);
   191	            values.push(value.clone());
   192	        }
   193	        self.call_typed(destination, path, interface, member, &signature, &values)
   194	    }
   195	
   196	    /// Вызов с явной сигнатурой тела — нужен для пустых контейнеров (`a{sv}`, `a(ss)`).
   197	    pub(crate) fn call_typed(
   198	        &mut self,
   199	        destination: &str,
   200	        path: &str,
   201	        interface: &str,
   202	        member: &str,
   203	        signature: &str,
   204	        body: &[Value],
   205	    ) -> Result<Vec<Value>, DbusError> {
   206	        let serial = self.next_serial();
   207	        let mut fields = vec![
   208	            (message::FIELD_PATH, Value::String(path.to_owned())),
   209	            (
   210	                message::FIELD_INTERFACE,
   211	                Value::String(interface.to_owned()),
   212	            ),
   213	            (message::FIELD_MEMBER, Value::String(member.to_owned())),
   214	            (
   215	                message::FIELD_DESTINATION,
   216	                Value::String(destination.to_owned()),
   217	            ),
   218	        ];
   219	        if !signature.is_empty() {
   220	            fields.push((
   221	                message::FIELD_SIGNATURE,
   222	                Value::String(signature.to_owned()),
   223	            ));
   224	        }
   225	
   226	        let bytes = message::build(MessageType::MethodCall, serial, &fields, signature, body)?;
   227	        self.stream.write_all(&bytes).map_err(DbusError::Io)?;
   228	        self.await_reply(serial)
   229	    }
   230	
   231	    /// Подписка на сигналы по правилу `AddMatch`.
   232	    pub fn add_match(&mut self, rule: &str) -> Result<(), DbusError> {
   233	        self.call(
   234	            "org.freedesktop.DBus",
   235	            "/org/freedesktop/DBus",
   236	            "org.freedesktop.DBus",
   237	            "AddMatch",
   238	            &[('s', Value::String(rule.to_owned()))],
   239	        )?;
   240	        Ok(())
   241	    }
   242	
   243	    /// Следующий сигнал (уже пришедшие отдаются из очереди).
   244	    pub fn next_signal(&mut self, timeout: Duration) -> Result<Signal, DbusError> {
   245	        loop {
   246	            if let Some(signal) = self.pending.pop_front() {
   247	                return Ok(signal);
   248	            }
   249	            let message = self.read_message(timeout)?;
   250	            match message.kind {
   251	                MessageType::Signal => return Ok(signal_from(message)),
   252	                // Ответы на уже завершённые вызовы и чужие method call'ы игнорируются:
   253	                // сервер не должен присылать их в этот момент, но падать из-за них нельзя.
   254	                MessageType::MethodReturn | MessageType::Error | MessageType::MethodCall => {
   255	                    continue;
   256	                }
   257	            }
   258	        }
   259	    }
   260	
   261	    fn await_reply(&mut self, serial: u32) -> Result<Vec<Value>, DbusError> {
   262	        loop {
   263	            let message = self.read_message(CALL_TIMEOUT)?;
   264	            match message.kind {
   265	                MessageType::Signal => self.pending.push_back(signal_from(message)),
   266	                MessageType::MethodCall => continue,
   267	                MessageType::MethodReturn => {
   268	                    if message.reply_serial() == Some(serial) {
   269	                        return Ok(message.body);
   270	                    }
   271	                }
   272	                MessageType::Error => {
   273	                    if message.reply_serial() == Some(serial) {
   274	                        let name = message.error_name().unwrap_or("<unknown error>").to_owned();
   275	                        let text = match message.body.first() {
   276	                            Some(Value::String(text)) => text.clone(),
   277	                            _ => String::new(),
   278	                        };
   279	                        return Err(DbusError::Remote {
   280	                            name,
   281	                            message: text,
   282	                        });
   283	                    }
   284	                }
   285	            }
   286	        }
   287	    }
   288	
   289	    fn read_message(&mut self, timeout: Duration) -> Result<message::Message, DbusError> {
   290	        self.stream
   291	            .set_read_timeout(Some(timeout))
   292	            .map_err(DbusError::Io)?;
   293	
   294	        let mut header = [0u8; 16];
   295	        read_exact(&mut self.stream, &mut header)?;
   296	        if header[0] != b'l' {
   297	            return Err(DbusError::Protocol("only little-endian is supported"));
   298	        }
   299	        let body_len = u32::from_le_bytes([header[4], header[5], header[6], header[7]]) as usize;
   300	        let fields_len =
   301	            u32::from_le_bytes([header[12], header[13], header[14], header[15]]) as usize;
   302	        if fields_len > MAX_HEADER_BYTES {
   303	            return Err(DbusError::Protocol("header too large"));
   304	        }
   305	        if body_len > MAX_BODY_BYTES {
   306	            return Err(DbusError::Protocol("body too large"));
   307	        }
   308	
   309	        let fields_end = 16 + fields_len;
   310	        let body_offset = (fields_end + 7) & !7;
   311	        let mut bytes = vec![0u8; body_offset + body_len];
   312	        bytes[..16].copy_from_slice(&header);
   313	        read_exact(&mut self.stream, &mut bytes[16..])?;
   314	        message::parse(&bytes)
   315	    }
   316	
   317	    fn next_serial(&mut self) -> u32 {
   318	        self.serial = self.serial.wrapping_add(1);
   319	        if self.serial == 0 {
   320	            self.serial = 1;
   321	        }
   322	        self.serial
   323	    }
   324	}
   325	
   326	fn signal_from(message: message::Message) -> Signal {
   327	    Signal {
   328	        path: message.path().unwrap_or("").to_owned(),
   329	        interface: message.interface().unwrap_or("").to_owned(),
   330	        member: message.member().unwrap_or("").to_owned(),
   331	        body: message.body,
   332	    }
   333	}
   334	
   335	fn read_exact(stream: &mut UnixStream, buffer: &mut [u8]) -> Result<(), DbusError> {
   336	    match stream.read_exact(buffer) {
   337	        Ok(()) => Ok(()),
   338	        // Обрезанный пакет (пир закрыл сокет посреди сообщения) — нарушение протокола.
   339	        Err(error) if error.kind() == ErrorKind::UnexpectedEof => {
   340	            Err(DbusError::Protocol("truncated message"))
   341	        }
   342	        Err(error)
   343	            if error.kind() == ErrorKind::WouldBlock || error.kind() == ErrorKind::TimedOut =>
   344	        {
   345	            Err(DbusError::Timeout)
   346	        }
   347	        Err(error) => Err(DbusError::Io(error)),
   348	    }
   349	}

