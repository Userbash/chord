     1	//! Контракт P6-02: `org.freedesktop.Notifications` через собственный D-Bus-клиент.
     2	//!
     3	//! Независимый оракул — приватный `dbus-daemon` (`--session --print-address --fork`) и
     4	//! мок-сервис `waves/RW-30/dbus/mock_service.py` на **libdbus** (`python3-dbus`), который
     5	//! отвечает на вызовы, пишет журнал (TSV) и эмитит сигналы. Rust-код здесь — только клиент,
     6	//! поэтому совпадение поведения не может быть «подогнано» под свою же реализацию.
     7	//!
     8	//! Skip-aware: нет `dbus-daemon`, `python3-dbus`/`gi` или мок не поднялся → тест печатает
     9	//! `SKIP: <причина>` и завершается успешно (окружение недоступно, а не падение).
    10	//!
    11	//! Live-сервис на сессионной шине не трогается: `n16` только читает возможности и лишь при
    12	//! `DISCORD_LAB_LIVE_NOTIFY=1`; уведомления наружу не отправляются.
    13	
    14	use discord_platform::dbus::{BusAddress, Connection, DbusError, Value};
    15	use discord_platform::notifications::{Notification, NotificationEvent, Notifier};
    16	use std::fs;
    17	use std::path::{Path, PathBuf};
    18	use std::process::{Child, Command, Stdio};
    19	use std::time::{Duration, Instant};
    20	
    21	const SKIP_NO_DAEMON: &str = "нет dbus-daemon";
    22	const SKIP_NO_PYTHON: &str = "нет python3 с модулями dbus и gi";
    23	const MOCK_DESTINATION: &str = "lab.Mock";
    24	const MOCK_PATH: &str = "/lab/Mock";
    25	const MOCK_INTERFACE: &str = "lab.Mock.Notifications";
    26	
    27	/// Приватная шина + мок-сервис; всё убирается в `Drop`.
    28	struct Harness {
    29	    address: String,
    30	    journal: PathBuf,
    31	    dir: PathBuf,
    32	    daemon_pid: u32,
    33	    mock: Child,
    34	}
    35	
    36	impl Harness {
    37	    fn start(extra_mock_args: &[&str]) -> Result<Self, String> {
    38	        if !command_exists("dbus-daemon") {
    39	            return Err(SKIP_NO_DAEMON.to_owned());
    40	        }
    41	        if !python_dbus_available() {
    42	            return Err(SKIP_NO_PYTHON.to_owned());
    43	        }
    44	
    45	        let dir = std::env::temp_dir().join(format!(
    46	            "discord-lab-w30b-{}-{}",
    47	            std::process::id(),
    48	            unique_suffix()
    49	        ));
    50	        fs::create_dir_all(&dir).map_err(|err| format!("tempdir {}: {err}", dir.display()))?;
    51	
    52	        let started = Command::new("dbus-daemon")
    53	            .args(["--session", "--print-address=1", "--print-pid=1", "--fork"])
    54	            .output()
    55	            .map_err(|err| format!("запуск dbus-daemon: {err}"))?;
    56	        if !started.status.success() {
    57	            return Err(format!(
    58	                "dbus-daemon завершился: {}",
    59	                String::from_utf8_lossy(&started.stderr).trim()
    60	            ));
    61	        }
    62	        let stdout = String::from_utf8_lossy(&started.stdout).into_owned();
    63	        let mut lines = stdout.lines().filter(|line| !line.trim().is_empty());
    64	        let address = lines
    65	            .next()
    66	            .ok_or_else(|| "dbus-daemon не напечатал адрес".to_owned())?
    67	            .trim()
    68	            .to_owned();
    69	        let daemon_pid: u32 = lines
    70	            .next()
    71	            .ok_or_else(|| "dbus-daemon не напечатал pid".to_owned())?
    72	            .trim()
    73	            .parse()
    74	            .map_err(|err| format!("pid dbus-daemon: {err}"))?;
    75	
    76	        let journal = dir.join("journal.tsv");
    77	        let mut mock = Command::new("python3")
    78	            .arg(repo_path("waves/RW-30/dbus/mock_service.py"))
    79	            .arg("--address")
    80	            .arg(&address)
    81	            .arg("--log")
    82	            .arg(&journal)
    83	            .args(extra_mock_args)
    84	            .stdout(Stdio::null())
    85	            .stderr(Stdio::piped())
    86	            .spawn()
    87	            .map_err(|err| format!("запуск mock_service.py: {err}"))?;
    88	
    89	        let deadline = Instant::now() + Duration::from_secs(10);
    90	        loop {
    91	            if fs::read_to_string(&journal)
    92	                .map(|text| text.contains("READY"))
    93	                .unwrap_or(false)
    94	            {
    95	                break;
    96	            }
    97	            if let Ok(Some(status)) = mock.try_wait() {
    98	                let stderr = read_child_stderr(&mut mock);
    99	                return Err(format!("мок-сервис завершился ({status}): {stderr}"));
   100	            }
   101	            if Instant::now() > deadline {
   102	                return Err("мок-сервис не поднялся за 10 с".to_owned());
   103	            }
   104	            std::thread::sleep(Duration::from_millis(50));
   105	        }
   106	
   107	        Ok(Self {
   108	            address,
   109	            journal,
   110	            dir,
   111	            daemon_pid,
   112	            mock,
   113	        })
   114	    }
   115	
   116	    fn bus_address(&self) -> BusAddress {
   117	        BusAddress::parse(&self.address).expect("адрес приватного демона")
   118	    }
   119	
   120	    fn journal(&self) -> Vec<Vec<String>> {
   121	        fs::read_to_string(&self.journal)
   122	            .unwrap_or_default()
   123	            .lines()
   124	            .map(|line| line.split('\t').map(str::to_owned).collect())
   125	            .collect()
   126	    }
   127	
   128	    fn journal_member(&self, member: &str) -> Vec<Vec<String>> {
   129	        self.journal()
   130	            .into_iter()
   131	            .filter(|fields| fields.first().map(String::as_str) == Some(member))
   132	            .collect()
   133	    }
   134	
   135	    /// Ждёт появления `count` записей журнала (мок пишет их асинхронно).
   136	    fn wait_for_member(&self, member: &str, count: usize) -> Vec<Vec<String>> {
   137	        let deadline = Instant::now() + Duration::from_secs(5);
   138	        loop {
   139	            let records = self.journal_member(member);
   140	            if records.len() >= count || Instant::now() > deadline {
   141	                return records;
   142	            }
   143	            std::thread::sleep(Duration::from_millis(20));
   144	        }
   145	    }
   146	
   147	    fn kill_daemon(&mut self) {
   148	        let _ = Command::new("kill")
   149	            .arg(self.daemon_pid.to_string())
   150	            .status();
   151	        self.daemon_pid = 0;
   152	    }
   153	}
   154	
   155	impl Drop for Harness {
   156	    fn drop(&mut self) {
   157	        let _ = self.mock.kill();
   158	        let _ = self.mock.wait();
   159	        if self.daemon_pid != 0 {
   160	            let _ = Command::new("kill")
   161	                .arg(self.daemon_pid.to_string())
   162	                .status();
   163	        }
   164	        let _ = fs::remove_dir_all(&self.dir);
   165	    }
   166	}
