   350	#[test]
   351	fn n01_bus_address_parse_accepts_path_and_rejects_abstract() {
   352	    let plain = BusAddress::parse("unix:path=/run/user/1000/bus").expect("unix:path");
   353	    assert_eq!(plain.path(), Path::new("/run/user/1000/bus"));
   354	
   355	    // abstract-сокеты не поддерживаются и документированы как None.
   356	    assert_eq!(BusAddress::parse("unix:abstract=/tmp/dbus-abc"), None);
   357	    assert_eq!(BusAddress::parse("tcp:host=localhost,port=1234"), None);
   358	    assert_eq!(BusAddress::parse(""), None);
   359	    assert_eq!(BusAddress::parse("unix:path="), None);
   360	    assert_eq!(BusAddress::parse("мусор"), None);
   361	
   362	    // Список адресов: берётся первый поддерживаемый.
   363	    let list = BusAddress::parse("unix:abstract=/tmp/abstract;unix:path=/tmp/real");
   364	    assert_eq!(
   365	        list.map(|address| address.path().to_path_buf()),
   366	        Some(PathBuf::from("/tmp/real"))
   367	    );
   368	
   369	    // guid и прочие ключи в той же записи не мешают.
   370	    let with_guid = BusAddress::parse("unix:guid=abc,path=/tmp/a").expect("path после guid");
   371	    assert_eq!(with_guid.path(), Path::new("/tmp/a"));
   372	
   373	    // `from_env` — ровно разбор DBUS_SESSION_BUS_ADDRESS (если переменная задана).
   374	    match std::env::var("DBUS_SESSION_BUS_ADDRESS") {
   375	        Ok(value) => {
   376	            let from_env = BusAddress::from_env().expect("адрес из env");
   377	            let parsed = BusAddress::parse(&value).expect("разбор env-адреса");
   378	            assert_eq!(from_env.path(), parsed.path());
   379	        }
   380	        Err(_) => println!("SKIP: DBUS_SESSION_BUS_ADDRESS не задан, from_env не проверяется"),
   381	    }
   382	}
