   168	fn read_child_stderr(child: &mut Child) -> String {
   169	    use std::io::Read as _;
   170	    let mut text = String::new();
   171	    if let Some(stderr) = child.stderr.as_mut() {
   172	        let _ = stderr.read_to_string(&mut text);
   173	    }
   174	    text.trim().to_owned()
   175	}
