     1	//! P6-02: минимальный D-Bus-клиент на `std` (без `zbus`/`notify-rust`, без `unsafe`).
     2	//!
     3	//! Оракул — спецификация D-Bus (wire-формат, little-endian, выравнивание) и независимые
     4	//! реализации: libgio (`fixtures/dbus/wire.json`) и libdbus-мок на приватном
     5	//! `dbus-daemon` (`waves/RW-30/dbus/mock_service.py`).
     6	//!
     7	//! Что поддержано: `unix:path`-адреса, AUTH EXTERNAL (hex uid), `Hello`, вызовы методов,
     8	//! ответы/ошибки, `AddMatch` и сигналы, очередь сигналов, пришедших во время `call`.
     9	//!
    10	//! Ограничения (документированы, не заявляются как поддержка):
    11	//! - только little-endian (`l`); big-endian сообщения → `DbusError::Protocol`;
    12	//! - `unix:abstract=` и `tcp:` адреса не поддерживаются (`BusAddress::parse` → `None`);
    13	//! - percent-кодирование в адресе (`%2F`) не декодируется;
    14	//! - типы `x`/`t`/`d`/`h`/`n`/`q` и unix-fd не поддержаны (нет в [`Value`]);
    15	//! - вызовы не ограничены по вложенности, но размеры сообщений ограничены
    16	//!   [`MAX_HEADER_BYTES`]/[`MAX_BODY_BYTES`].
    17	
    18	pub mod auth;
    19	pub mod message;
    20	
    21	use std::collections::VecDeque;
    22	use std::io::{ErrorKind, Read, Write};
    23	use std::os::unix::net::UnixStream;
    24	use std::path::{Path, PathBuf};
    25	use std::time::Duration;
    26	
    27	pub use message::MessageType;
    28	
    29	/// Максимальный размер полей заголовка: защита от мусорной длины из сокета.
    30	pub const MAX_HEADER_BYTES: usize = 1 << 20;
    31	/// Максимальный размер тела сообщения.
    32	pub const MAX_BODY_BYTES: usize = 16 << 20;
    33	/// Таймаут ожидания ответа на метод (сервис может активироваться через шину).
    34	pub const CALL_TIMEOUT: Duration = Duration::from_secs(10);
    35	
    36	/// Адрес шины D-Bus.
    37	///
    38	/// Поддерживается только `unix:path=…` (в т.ч. в списке адресов через `;` — берётся первый
    39	/// поддерживаемый). `unix:abstract=…` и `tcp:` возвращают `None`: абстрактные сокеты в этой
    40	/// карточке не реализуются.
    41	#[derive(Debug, Clone, PartialEq, Eq)]
    42	pub struct BusAddress {
    43	    path: PathBuf,
    44	}
    45	
    46	impl BusAddress {
    47	    /// Разбирает значение `DBUS_SESSION_BUS_ADDRESS`.
    48	    pub fn parse(value: &str) -> Option<Self> {
    49	        for entry in value.split(';') {
    50	            let Some(rest) = entry.strip_prefix("unix:") else {
    51	                continue;
    52	            };
    53	            for field in rest.split(',') {
    54	                let Some(path) = field.strip_prefix("path=") else {
    55	                    continue;
    56	                };
    57	                if path.is_empty() {
    58	                    // `unix:path=` без значения — запись невалидна, пробуем следующий адрес.
    59	                    break;
    60	                }
    61	                return Some(Self {
    62	                    path: PathBuf::from(path),
    63	                });
    64	            }
    65	        }
    66	        None
    67	    }
    68	
    69	    /// Адрес из переменной окружения `DBUS_SESSION_BUS_ADDRESS`.
    70	    pub fn from_env() -> Option<Self> {
    71	        std::env::var("DBUS_SESSION_BUS_ADDRESS")
    72	            .ok()
    73	            .and_then(|value| Self::parse(&value))
    74	    }
    75	
    76	    /// Путь unix-сокета шины.
    77	    pub fn path(&self) -> &Path {
    78	        &self.path
    79	    }
    80	}
