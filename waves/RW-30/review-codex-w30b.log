    87	    /// Ошибка ввода-вывода сокета.
    88	    Io(std::io::Error),
    89	    /// Отказ аутентификации (`REJECTED`/`ERROR`/нет uid).
    90	    Auth(&'static str),
    91	    /// Нарушение wire-формата или контракта вызова.
    92	    Protocol(&'static str),
    93	    /// `ERROR`-ответ сервера.
    94	    Remote { name: String, message: String },
    95	    /// Истёк таймаут ожидания ответа или сигнала.
    96	    Timeout,
    97	}
    98	
    99	/// Значение D-Bus (подмножество типов, нужное уведомлениям).
   100	#[derive(Debug, Clone, PartialEq)]
   101	pub enum Value {
   102	    Byte(u8),
   103	    Bool(bool),
   104	    U32(u32),
   105	    I32(i32),
   106	    String(String),
   107	    Array(Vec<Value>),
   108	    Struct(Vec<Value>),
   109	    Dict(Vec<(Value, Value)>),
   110	    Variant(Box<Value>),
   111	}
