    Notification {
        app_name: "Discord Lab".to_owned(),
        summary: "Alice".to_owned(),
        body: "hello".to_owned(),
        // -1 — «таймаут сервера по умолчанию» (derive(Default) даёт 0, поэтому явно).
        timeout_ms: -1,
        ..Notification::default()
    }
}

