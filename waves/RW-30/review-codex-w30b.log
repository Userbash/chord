   117	/// Собирает сообщение: заголовок (поля в переданном порядке) и тело по сигнатуре.
   118	pub fn build(
   119	    kind: MessageType,
   120	    serial: u32,
   121	    fields: &[(u8, Value)],
   122	    signature: &str,
   123	    body: &[Value],
   124	) -> Result<Vec<u8>, DbusError> {
   125	    if serial == 0 {
   126	        return Err(DbusError::Protocol("serial must be non-zero"));
   127	    }
   128	
   129	    let mut writer = Writer {
   130	        buffer: vec![0u8; 16],
   131	    };
   132	    writer.buffer[0] = b'l';
   133	    writer.buffer[1] = kind.code();
   134	    // Флаг 0x1 (NO_REPLY_EXPECTED) у всех сообщений, кроме method call — как у libgio:
   135	    // ответа не ждут ни return, ни error, ни signal.
   136	    writer.buffer[2] = if kind == MessageType::MethodCall {
   137	        0
   138	    } else {
   139	        1
   140	    };
   141	    writer.buffer[3] = 1; // protocol version
   142	    writer.buffer[8..12].copy_from_slice(&serial.to_le_bytes());
   143	    // Длина массива полей заголовка (`a(yv)`) лежит в 12..16; данные начинаются с 16.
   144	    for (code, value) in fields {
   145	        let field_type =
   146	            field_type(*code).ok_or(DbusError::Protocol("unsupported header field code"))?;
   147	        writer.align(8)?;
   148	        writer.buffer.push(*code);
   149	        writer.signature(field_type);
   150	        writer.value(field_type, value)?;
   151	    }
   152	
   153	    let fields_len = u32::try_from(writer.buffer.len() - 16)
   154	        .map_err(|_| DbusError::Protocol("header too large"))?;
   155	    writer.buffer[12..16].copy_from_slice(&fields_len.to_le_bytes());
   156	    if writer.buffer.len() > MAX_HEADER_BYTES {
   157	        return Err(DbusError::Protocol("header too large"));
   158	    }
   159	
   160	    writer.align(8)?;
   161	    let body_offset = writer.buffer.len();
   162	    write_body(&mut writer, signature, body)?;
   163	    let body_len = u32::try_from(writer.buffer.len() - body_offset)
   164	        .map_err(|_| DbusError::Protocol("body too large"))?;
   165	    if body_len as usize > MAX_BODY_BYTES {
   166	        return Err(DbusError::Protocol("body too large"));
   167	    }
   168	    writer.buffer[4..8].copy_from_slice(&body_len.to_le_bytes());
   169	    Ok(writer.buffer)
   170	}
   171	
   172	/// Разбирает сообщение целиком. Любое расхождение с форматом (`truncated`, лишние байты,
   173	/// big-endian, неизвестный тип) — `DbusError::Protocol`, паники нет.
   174	pub fn parse(bytes: &[u8]) -> Result<Message, DbusError> {
   175	    if bytes.len() < 16 {
   176	        return Err(DbusError::Protocol("short header"));
   177	    }
   178	    if bytes[0] != b'l' {
   179	        return Err(DbusError::Protocol("only little-endian is supported"));
   180	    }
   181	    let kind =
   182	        MessageType::from_code(bytes[1]).ok_or(DbusError::Protocol("unknown message type"))?;
   183	    let body_len = u32::from_le_bytes([bytes[4], bytes[5], bytes[6], bytes[7]]) as usize;
   184	    let serial = u32::from_le_bytes([bytes[8], bytes[9], bytes[10], bytes[11]]);
   185	    let fields_len = u32::from_le_bytes([bytes[12], bytes[13], bytes[14], bytes[15]]) as usize;
   186	    if fields_len > MAX_HEADER_BYTES || body_len > MAX_BODY_BYTES {
   187	        return Err(DbusError::Protocol("message too large"));
   188	    }
   189	
   190	    let fields_end = 16usize
   191	        .checked_add(fields_len)
   192	        .ok_or(DbusError::Protocol("header length overflow"))?;
   193	    if fields_end > bytes.len() {
   194	        return Err(DbusError::Protocol("truncated header fields"));
   195	    }
   196	
   197	    let mut cursor = Cursor {
   198	        bytes,
   199	        position: 16,
   200	        end: fields_end,
   201	    };
   202	    let mut fields = Vec::new();
   203	    while cursor.position < fields_end {
   204	        cursor.align(8)?;
   205	        if cursor.position >= fields_end {
   206	            break;
   207	        }
   208	        let code = cursor.byte()?;
   209	        let value = cursor.variant_value()?;
   210	        fields.push((code, value));
   211	    }
   212	    if cursor.position != fields_end {
   213	        return Err(DbusError::Protocol("header fields length mismatch"));
   214	    }
   215	
   216	    let body_offset = (fields_end + 7) & !7;
   217	    let body_end = body_offset
   218	        .checked_add(body_len)
   219	        .ok_or(DbusError::Protocol("body length overflow"))?;
   220	    if body_end > bytes.len() {
   221	        return Err(DbusError::Protocol("truncated body"));
   222	    }
   223	    if body_end != bytes.len() {
   224	        return Err(DbusError::Protocol("trailing bytes after body"));
   225	    }
   226	
   227	    let signature = match fields
   228	        .iter()
   229	        .find(|(code, _)| *code == FIELD_SIGNATURE)
   230	        .map(|(_, value)| value)
   231	    {
   232	        None => String::new(),
   233	        Some(Value::String(signature)) => signature.clone(),
   234	        Some(_) => return Err(DbusError::Protocol("SIGNATURE field is not a signature")),
   235	    };
   236	
   237	    let mut cursor = Cursor {
   238	        bytes,
   239	        position: body_offset,
   240	        end: body_end,
   241	    };
   242	    let mut body = Vec::new();
   243	    let mut rest = signature.as_str();
   244	    while !rest.is_empty() {
   245	        let (item, tail) = take_type(rest)?;
   246	        body.push(cursor.value(item)?);
   247	        rest = tail;
   248	    }
   249	    if cursor.position != body_end {
   250	        return Err(DbusError::Protocol("body not fully consumed"));
   251	    }
   252	
   253	    Ok(Message {
   254	        kind,
   255	        serial,
   256	        fields,
   257	        signature,
   258	        body,
   259	    })
   260	}
   261	
   262	/// Сигнатура значения (для [`super::Connection::call`]); `None` для пустых контейнеров,
   263	/// тип элемента которых из значения не выводится.
   264	pub(crate) fn signature_of_value(value: &Value) -> Option<String> {
   265	    Some(match value {
   266	        Value::Byte(_) => "y".to_owned(),
   267	        Value::Bool(_) => "b".to_owned(),
   268	        Value::U32(_) => "u".to_owned(),
   269	        Value::I32(_) => "i".to_owned(),
   270	        Value::String(_) => "s".to_owned(),
   271	        Value::Variant(_) => "v".to_owned(),
   272	        Value::Struct(items) => {
   273	            let mut signature = String::from("(");
   274	            for item in items {
   275	                signature.push_str(&signature_of_value(item)?);
   276	            }
   277	            signature.push(')');
   278	            signature
   279	        }
   280	        Value::Array(items) => format!("a{}", signature_of_value(items.first()?)?),
   281	        Value::Dict(entries) => {
   282	            let (key, value) = entries.first()?;
   283	            format!(
   284	                "a{{{}{}}}",
   285	                signature_of_value(key)?,
   286	                signature_of_value(value)?
   287	            )
   288	        }
   289	    })
   290	}
   291	
   292	fn field_type(code: u8) -> Option<&'static str> {
   293	    match code {
   294	        FIELD_PATH => Some("o"),
   295	        FIELD_INTERFACE | FIELD_MEMBER | FIELD_ERROR_NAME | FIELD_DESTINATION | FIELD_SENDER => {
   296	            Some("s")
   297	        }
   298	        FIELD_REPLY_SERIAL => Some("u"),
   299	        FIELD_SIGNATURE => Some("g"),
   300	        _ => None,
   301	    }
   302	}
   303	
   304	fn write_body(writer: &mut Writer, signature: &str, body: &[Value]) -> Result<(), DbusError> {
   305	    let mut rest = signature;
   306	    let mut index = 0usize;
   307	    while !rest.is_empty() {
   308	        let (item, tail) = take_type(rest)?;
   309	        let value = body
   310	            .get(index)
   311	            .ok_or(DbusError::Protocol("body has fewer values than signature"))?;
   312	        writer.value(item, value)?;
   313	        rest = tail;
   314	        index += 1;
   315	    }
   316	    if index != body.len() {
   317	        return Err(DbusError::Protocol("body has more values than signature"));
   318	    }
   319	    Ok(())
   320	}
   321	
   322	struct Writer {
   323	    buffer: Vec<u8>,
   324	}
   325	
   326	impl Writer {
   327	    fn align(&mut self, alignment: usize) -> Result<(), DbusError> {
   328	        while !self.buffer.len().is_multiple_of(alignment) {
   329	            self.buffer.push(0);
   330	        }
   331	        Ok(())
   332	    }
   333	
   334	    fn signature(&mut self, signature: &str) {
   335	        let length = signature.len().min(u8::MAX as usize);
   336	        self.buffer.push(length as u8);
   337	        self.buffer
   338	            .extend_from_slice(&signature.as_bytes()[..length]);
   339	        self.buffer.push(0);
   340	    }
   341	
   342	    fn string(&mut self, text: &str) -> Result<(), DbusError> {
   343	        self.align(4)?;
   344	        let length =
   345	            u32::try_from(text.len()).map_err(|_| DbusError::Protocol("string too long"))?;
   346	        self.buffer.extend_from_slice(&length.to_le_bytes());
   347	        self.buffer.extend_from_slice(text.as_bytes());
   348	        self.buffer.push(0);
   349	        Ok(())
   350	    }
   351	
   352	    fn value(&mut self, signature: &str, value: &Value) -> Result<(), DbusError> {
   353	        let Some(first) = signature.as_bytes().first().copied() else {
   354	            return Err(DbusError::Protocol("empty type signature"));
   355	        };
   356	        match (first, value) {
   357	            (b'y', Value::Byte(byte)) => self.buffer.push(*byte),
   358	            (b'b', Value::Bool(flag)) => {
   359	                self.align(4)?;
   360	                self.buffer
   361	                    .extend_from_slice(&u32::from(*flag).to_le_bytes());
   362	            }
   363	            (b'u', Value::U32(number)) => {
   364	                self.align(4)?;
   365	                self.buffer.extend_from_slice(&number.to_le_bytes());
   366	            }
   367	            (b'i', Value::I32(number)) => {
   368	                self.align(4)?;
   369	                self.buffer.extend_from_slice(&number.to_le_bytes());
   370	            }
   371	            (b's' | b'o', Value::String(text)) => self.string(text)?,
   372	            // `g` — сигнатура: длина один байт и выравнивание 1, а не строка.
   373	            (b'g', Value::String(text)) => self.signature(text),
   374	            (b'v', Value::Variant(inner)) => self.variant(inner)?,
   375	            (b'a', Value::Array(items)) => {
   376	                let (element, tail) = take_type(&signature[1..])?;
   377	                if !tail.is_empty() {
   378	                    return Err(DbusError::Protocol("array is not the last type"));
   379	                }
   380	                if element.starts_with('{') {
   381	                    return Err(DbusError::Protocol("expected dict value"));
   382	                }
   383	                self.align(4)?;
   384	                let length_position = self.buffer.len();
   385	                self.buffer.extend_from_slice(&[0u8; 4]);
   386	                self.align(alignment_of(element))?;
   387	                let data_start = self.buffer.len();
   388	                for item in items {
   389	                    self.value(element, item)?;
   390	                }
   391	                let data_len = u32::try_from(self.buffer.len() - data_start)
   392	                    .map_err(|_| DbusError::Protocol("array too long"))?;
   393	                self.buffer[length_position..length_position + 4]
   394	                    .copy_from_slice(&data_len.to_le_bytes());
   395	            }
   396	            (b'a', Value::Dict(entries)) => {
   397	                let (element, tail) = take_type(&signature[1..])?;
   398	                if !tail.is_empty() {
   399	                    return Err(DbusError::Protocol("array is not the last type"));
   400	                }
   401	                if !element.starts_with('{') {
   402	                    return Err(DbusError::Protocol("expected array value"));
   403	                }
   404	                let (key_type, value_type) = dict_types(element)?;
   405	                self.align(4)?;
   406	                let length_position = self.buffer.len();
   407	                self.buffer.extend_from_slice(&[0u8; 4]);
   408	                self.align(8)?;
   409	                let data_start = self.buffer.len();
   410	                for (key, item) in entries {
   411	                    self.align(8)?;
   412	                    self.value(key_type, key)?;
   413	                    self.value(value_type, item)?;
   414	                }
   415	                let data_len = u32::try_from(self.buffer.len() - data_start)
   416	                    .map_err(|_| DbusError::Protocol("dict too long"))?;
   417	                self.buffer[length_position..length_position + 4]
   418	                    .copy_from_slice(&data_len.to_le_bytes());
   419	            }
   420	            (b'(', Value::Struct(items)) => {
   421	                if !signature.ends_with(')') {
   422	                    return Err(DbusError::Protocol("unbalanced struct signature"));
   423	                }
   424	                self.align(8)?;
   425	                let inner = &signature[1..signature.len() - 1];
   426	                let mut rest = inner;
   427	                let mut index = 0usize;
   428	                while !rest.is_empty() {
   429	                    let (item, tail) = take_type(rest)?;
   430	                    let value = items.get(index).ok_or(DbusError::Protocol(
   431	                        "struct has fewer fields than signature",
   432	                    ))?;
   433	                    self.value(item, value)?;
   434	                    rest = tail;
   435	                    index += 1;
   436	                }
   437	                if index != items.len() {
   438	                    return Err(DbusError::Protocol("struct has more fields than signature"));
   439	                }
   440	            }
   441	            _ => return Err(DbusError::Protocol("value does not match signature")),
   442	        }
   443	        Ok(())
   444	    }
   445	
   446	    fn variant(&mut self, value: &Value) -> Result<(), DbusError> {
   447	        let signature = signature_of_value(value).ok_or(DbusError::Protocol(
   448	            "variant of empty container has no type",
   449	        ))?;
   450	        self.signature(&signature);
   451	        let (item, tail) = take_type(&signature)?;
   452	        if !tail.is_empty() {
   453	            return Err(DbusError::Protocol("variant signature has extra types"));
   454	        }
   455	        self.value(item, value)
   456	    }
   457	}
   458	
   459	const fn alignment_of(signature: &str) -> usize {
   460	    match signature.as_bytes()[0] {
   461	        b'n' | b'q' => 2,
   462	        b'u' | b'i' | b's' | b'o' | b'a' => 4,
   463	        b'x' | b't' | b'd' | b'(' | b'{' => 8,
   464	        // y, b, g, v
   465	        _ => 1,
   466	    }
   467	}
   468	
   469	/// Отделяет первый полный тип сигнатуры от остатка.
   470	fn take_type(signature: &str) -> Result<(&str, &str), DbusError> {
   471	    let bytes = signature.as_bytes();
   472	    let first = *bytes
   473	        .first()
   474	        .ok_or(DbusError::Protocol("empty signature"))?;
   475	    match first {
   476	        b'y' | b'b' | b'u' | b'i' | b's' | b'o' | b'g' | b'v' => {
   477	            Ok((&signature[..1], &signature[1..]))
   478	        }
   479	        b'a' => {
   480	            let (inner, rest) = take_type(&signature[1..])?;
   481	            let end = 1 + inner.len();
   482	            Ok((&signature[..end], rest))
   483	        }
   484	        b'(' => {
   485	            let mut depth = 0usize;
   486	            for (index, byte) in bytes.iter().enumerate() {
   487	                match byte {
   488	                    b'(' => depth += 1,
   489	                    b')' => {
   490	                        depth = depth.saturating_sub(1);
   491	                        if depth == 0 {
   492	                            return Ok((&signature[..=index], &signature[index + 1..]));
   493	                        }
   494	                    }
   495	                    _ => {}
   496	                }
   497	            }
   498	            Err(DbusError::Protocol("unbalanced struct signature"))
   499	        }
   500	        b'{' => {
   501	            let (key, after_key) = take_type(&signature[1..])?;
   502	            let (value, _) = take_type(after_key)?;
   503	            let end = 1 + key.len() + value.len() + 1;
   504	            if bytes.get(end - 1) != Some(&b'}') {
   505	                return Err(DbusError::Protocol("unbalanced dict signature"));
   506	            }
   507	            Ok((&signature[..end], &signature[end..]))
   508	        }
   509	        _ => Err(DbusError::Protocol("unsupported type in signature")),
   510	    }
   511	}
   512	
   513	fn dict_types(entry: &str) -> Result<(&str, &str), DbusError> {
   514	    if !entry.starts_with('{') || !entry.ends_with('}') {
   515	        return Err(DbusError::Protocol("not a dict entry signature"));
   516	    }
   517	    let inner = &entry[1..entry.len() - 1];
   518	    let (key, rest) = take_type(inner)?;
   519	    let (value, tail) = take_type(rest)?;
   520	    if !tail.is_empty() {
   521	        return Err(DbusError::Protocol("dict entry has extra types"));
   522	    }
   523	    Ok((key, value))
   524	}
   525	
   526	struct Cursor<'a> {
   527	    bytes: &'a [u8],
   528	    position: usize,
   529	    end: usize,
   530	}
   531	
   532	impl<'a> Cursor<'a> {
   533	    fn align(&mut self, alignment: usize) -> Result<(), DbusError> {
   534	        let remainder = self.position % alignment;
   535	        if remainder != 0 {
   536	            self.position += alignment - remainder;
   537	        }
   538	        if self.position > self.end {
   539	            return Err(DbusError::Protocol("truncated padding"));
   540	        }
   541	        Ok(())
   542	    }
   543	
   544	    fn byte(&mut self) -> Result<u8, DbusError> {
   545	        if self.position >= self.end {
   546	            return Err(DbusError::Protocol("read past field boundary"));
   547	        }
   548	        let byte = *self
   549	            .bytes
   550	            .get(self.position)
   551	            .ok_or(DbusError::Protocol("unexpected end of message"))?;
   552	        self.position += 1;
   553	        Ok(byte)
   554	    }
   555	
   556	    fn u32(&mut self) -> Result<u32, DbusError> {
   557	        if self.position + 4 > self.end {
   558	            return Err(DbusError::Protocol("u32 past field boundary"));
   559	        }
   560	        let slice = self
   561	            .bytes
   562	            .get(self.position..self.position + 4)
   563	            .ok_or(DbusError::Protocol("truncated u32"))?;
   564	        self.position += 4;
   565	        Ok(u32::from_le_bytes([slice[0], slice[1], slice[2], slice[3]]))
   566	    }
   567	
   568	    fn string(&mut self) -> Result<String, DbusError> {
   569	        self.align(4)?;
   570	        let length = self.u32()? as usize;
   571	        let slice = self
   572	            .bytes
   573	            .get(self.position..self.position + length)
   574	            .ok_or(DbusError::Protocol("truncated string"))?;
   575	        if self.position + length + 1 > self.end {
   576	            return Err(DbusError::Protocol("string past field boundary"));
   577	        }
   578	        if self.bytes.get(self.position + length) != Some(&0) {
   579	            return Err(DbusError::Protocol("string is not NUL-terminated"));
   580	        }
   581	        let text = std::str::from_utf8(slice)
   582	            .map_err(|_| DbusError::Protocol("string is not utf-8"))?
   583	            .to_owned();
   584	        self.position += length + 1;
   585	        Ok(text)
   586	    }
   587	
   588	    fn signature_string(&mut self) -> Result<String, DbusError> {
   589	        let length = self.byte()? as usize;
   590	        let slice = self
   591	            .bytes
   592	            .get(self.position..self.position + length)
   593	            .ok_or(DbusError::Protocol("truncated signature"))?;
   594	        if self.position + length + 1 > self.end {
   595	            return Err(DbusError::Protocol("signature past field boundary"));
   596	        }
   597	        if self.bytes.get(self.position + length) != Some(&0) {
   598	            return Err(DbusError::Protocol("signature is not NUL-terminated"));
   599	        }
   600	        let text = std::str::from_utf8(slice)
   601	            .map_err(|_| DbusError::Protocol("signature is not utf-8"))?
   602	            .to_owned();
   603	        self.position += length + 1;
   604	        Ok(text)
   605	    }
   606	
   607	    /// Читает вариант (сигнатура + значение) и возвращает внутреннее значение.
   608	    fn variant_value(&mut self) -> Result<Value, DbusError> {
   609	        let signature = self.signature_string()?;
   610	        if signature.is_empty() {
   611	            return Err(DbusError::Protocol("empty variant signature"));
   612	        }
   613	        let (item, tail) = take_type(&signature)?;
   614	        if !tail.is_empty() {
   615	            return Err(DbusError::Protocol("variant signature has extra types"));
   616	        }
   617	        self.value(item)
   618	    }
   619	
   620	    fn value(&mut self, signature: &str) -> Result<Value, DbusError> {
   621	        let first = *signature
   622	            .as_bytes()
   623	            .first()
   624	            .ok_or(DbusError::Protocol("empty type signature"))?;
   625	        Ok(match first {
   626	            b'y' => Value::Byte(self.byte()?),
   627	            b'b' => {
   628	                self.align(4)?;
   629	                match self.u32()? {
   630	                    0 => Value::Bool(false),
   631	                    1 => Value::Bool(true),
   632	                    _ => return Err(DbusError::Protocol("bool is not 0/1")),
   633	                }
   634	            }
   635	            b'u' => {
   636	                self.align(4)?;
   637	                Value::U32(self.u32()?)
   638	            }
   639	            b'i' => {
   640	                self.align(4)?;
   641	                Value::I32(self.u32()? as i32)
   642	            }
   643	            b's' | b'o' => Value::String(self.string()?),
   644	            b'g' => Value::String(self.signature_string()?),
   645	            b'v' => Value::Variant(Box::new(self.variant_value()?)),
   646	            b'a' => {
   647	                self.align(4)?;
   648	                let length = self.u32()? as usize;
   649	                let (element, tail) = take_type(&signature[1..])?;
   650	                if !tail.is_empty() {
   651	                    return Err(DbusError::Protocol("array is not the last type"));
   652	                }
   653	                self.align(alignment_of(element))?;
   654	                let data_start = self.position;
   655	                let data_end = data_start
   656	                    .checked_add(length)
   657	                    .ok_or(DbusError::Protocol("array length overflow"))?;
   658	                if data_end > self.end {
   659	                    return Err(DbusError::Protocol("truncated array"));
   660	                }
   661	
   662	                if element.starts_with('{') {
   663	                    let (key_type, value_type) = dict_types(element)?;
   664	                    let mut entries = Vec::new();
   665	                    while self.position < data_end {
   666	                        self.align(8)?;
   667	                        if self.position >= data_end {
   668	                            break;
   669	                        }
   670	                        let key = self.value(key_type)?;
   671	                        let value = self.value(value_type)?;
   672	                        entries.push((key, value));
   673	                    }
   674	                    if self.position != data_end {
   675	                        return Err(DbusError::Protocol("dict length mismatch"));
   676	                    }
   677	                    Value::Dict(entries)
   678	                } else {
   679	                    let mut items = Vec::new();
   680	                    while self.position < data_end {
   681	                        let start = self.position;
   682	                        let item = self.value(element)?;
   683	                        if self.position == start {
   684	                            return Err(DbusError::Protocol("array element did not advance"));
   685	                        }
   686	                        items.push(item);
   687	                    }
   688	                    if self.position != data_end {
   689	                        return Err(DbusError::Protocol("array length mismatch"));
   690	                    }
   691	                    Value::Array(items)
   692	                }
   693	            }
   694	            b'(' => {
   695	                if !signature.ends_with(')') {
   696	                    return Err(DbusError::Protocol("unbalanced struct signature"));
   697	                }
   698	                self.align(8)?;
   699	                let inner = &signature[1..signature.len() - 1];
   700	                let mut items = Vec::new();
   701	                let mut rest = inner;
   702	                while !rest.is_empty() {
   703	                    let (item, tail) = take_type(rest)?;
   704	                    items.push(self.value(item)?);
   705	                    rest = tail;
   706	                }
   707	                Value::Struct(items)
   708	            }
   709	            _ => return Err(DbusError::Protocol("unsupported type in body")),
   710	        })
   711	    }
   712	}

