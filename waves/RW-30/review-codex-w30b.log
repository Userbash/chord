    29	
    30	/// Тип сообщения D-Bus.
    31	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    32	pub enum MessageType {
    33	    MethodCall,
    34	    MethodReturn,
    35	    Error,
    36	    Signal,
    37	}
    38	
    39	impl MessageType {
    40	    /// Код типа в заголовке.
    41	    pub fn code(self) -> u8 {
    42	        match self {
    43	            Self::MethodCall => 1,
    44	            Self::MethodReturn => 2,
    45	            Self::Error => 3,
    46	            Self::Signal => 4,
    47	        }
    48	    }
