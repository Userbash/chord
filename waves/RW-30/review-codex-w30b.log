     1	//! Аутентификация D-Bus: `AUTH EXTERNAL <hex>` по unix-сокету.
     2	//!
     3	//! UID берётся без `unsafe` и без внешних крейтов — из `/proc/self/status` (`Uid:`).
     4	//! Оракул — спецификация D-Bus и reference-реализация (libdbus): клиент отправляет `\0`,
     5	//! затем `AUTH EXTERNAL <hex>\r\n`, ожидает `OK <guid>`, отправляет `BEGIN\r\n`.
     6	//! Идентичность EXTERNAL — **десятичная запись uid, закодированная в hex**: для uid 1000
     7	//! аргумент — `31303030` («1000» в ASCII-hex), а не `3e8`.
     8	
     9	use std::io::{Read, Write};
    10	use std::os::unix::net::UnixStream;
    11	use std::time::Duration;
    12	
    13	use super::DbusError;
    14	
    15	/// Таймаут рукопожатия аутентификации.
    16	pub const AUTH_TIMEOUT: Duration = Duration::from_secs(5);
    17	/// Предел длины строки ответа шины (защита от мусора в сокете).
    18	const MAX_LINE: usize = 1024;
    19	
    20	/// Строка `AUTH EXTERNAL` для uid: десятичная запись uid, закодированная в hex.
    21	///
    22	/// Пример: uid 1000 → `AUTH EXTERNAL 31303030` (hex от ASCII-строки «1000»).
    23	pub fn external_auth_line(uid: u32) -> String {
    24	    let decimal = uid.to_string();
    25	    let mut hex = String::with_capacity(decimal.len() * 2);
    26	    for byte in decimal.as_bytes() {
    27	        hex.push_str(&format!("{byte:02x}"));
    28	    }
    29	    format!("AUTH EXTERNAL {hex}")
    30	}
    31	
    32	/// Текущий effective uid процесса.
    33	pub fn current_uid() -> Result<u32, DbusError> {
    34	    let status = std::fs::read_to_string("/proc/self/status").map_err(DbusError::Io)?;
    35	    parse_uid(&status).ok_or(DbusError::Auth("no Uid line in /proc/self/status"))
    36	}
    37	
    38	/// Разбирает первую строку `Uid:` из `/proc/self/status` (effective uid — второй столбец).
    39	pub fn parse_uid(status: &str) -> Option<u32> {
    40	    let line = status.lines().find(|line| line.starts_with("Uid:"))?;
    41	    let mut fields = line["Uid:".len()..].split_whitespace();
    42	    let real = fields.next()?.parse().ok()?;
    43	    let effective = fields.next().and_then(|value| value.parse().ok());
    44	    Some(effective.unwrap_or(real))
    45	}
    46	
    47	/// Проходит рукопожатие на уже подключённом сокете.
    48	///
    49	/// Сокет должен быть в блокирующем режиме (таймаут выставляет вызывающая сторона).
    50	pub fn authenticate(stream: &UnixStream) -> Result<(), DbusError> {
    51	    let uid = current_uid()?;
    52	    let mut request = Vec::with_capacity(32);
    53	    request.push(0u8); // credentials byte: без него шина не читает команды
    54	    request.extend_from_slice(external_auth_line(uid).as_bytes());
    55	    request.extend_from_slice(b"\r\n");
    56	
    57	    let mut writer = stream;
    58	    writer.write_all(&request).map_err(DbusError::Io)?;
    59	
    60	    let reply = read_line(stream)?;
    61	    if reply.starts_with("OK ") {
    62	        writer.write_all(b"BEGIN\r\n").map_err(DbusError::Io)?;
    63	        return Ok(());
    64	    }
    65	    if reply.starts_with("REJECTED") {
    66	        return Err(DbusError::Auth("EXTERNAL auth rejected"));
    67	    }
    68	    if reply.starts_with("ERROR") {
    69	        return Err(DbusError::Auth("auth error"));
    70	    }
    71	    Err(DbusError::Protocol("unexpected auth reply"))
    72	}
    73	
    74	fn read_line(stream: &UnixStream) -> Result<String, DbusError> {
    75	    let mut reader = stream;
    76	    let mut bytes = Vec::with_capacity(64);
    77	    let mut byte = [0u8; 1];
    78	    loop {
    79	        match reader.read(&mut byte) {
    80	            Ok(0) => return Err(DbusError::Protocol("auth connection closed")),
    81	            Ok(_) => {
    82	                if byte[0] == b'\n' {
    83	                    break;
    84	                }
    85	                if bytes.len() >= MAX_LINE {
    86	                    return Err(DbusError::Protocol("auth reply too long"));
    87	                }
    88	                bytes.push(byte[0]);
    89	            }
    90	            Err(error)
    91	                if error.kind() == std::io::ErrorKind::WouldBlock
    92	                    || error.kind() == std::io::ErrorKind::TimedOut =>
    93	            {
    94	                return Err(DbusError::Timeout);
    95	            }
    96	            Err(error) => return Err(DbusError::Io(error)),
    97	        }
    98	    }
    99	    if bytes.last() == Some(&b'\r') {
   100	        bytes.pop();
   101	    }
   102	    String::from_utf8(bytes).map_err(|_| DbusError::Protocol("auth reply is not utf-8"))
   103	}

