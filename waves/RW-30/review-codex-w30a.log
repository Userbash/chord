   370	fn d12_generated_table_invariants() {
   371	    assert_eq!(DURATION_ROW_COUNT, 31 * 3 * 8, "строк таблицы");
   372	    assert_eq!(DURATION_JOIN_COUNT, 31 * 3, "join-строк таблицы");
   373	    assert_eq!(DURATION_PATTERN_COUNT, 31 * 3 * 8 * 6, "паттернов (6 категорий)");
   374	
   375	    // Разделители: либо все три непустые, либо все три пустые (локали без пробелов).
   376	    // Набор пустых троек зафиксирован по ICU 78 и проверяется независимо от реализации.
   377	    let empty_joins = [
   378	        ("ja", "narrow"),
   379	        ("zh-CN", "long"),
   380	        ("zh-CN", "short"),
   381	        ("zh-CN", "narrow"),
   382	        ("zh-TW", "narrow"),
   383	    ];
   384	    for (locale, style) in locale_style_rows() {
   385	        let style_name = match style {
   386	            DurationStyle::Long => "long",
   387	            DurationStyle::Short => "short",
   388	            DurationStyle::Narrow => "narrow",
   389	        };
   390	        let one = format_duration(locale, &duration(&[("days", 2)]), style);
   391	        let two = format_duration(locale, &duration(&[("days", 2), ("hours", 3)]), style);
   392	        let three = format_duration(
   393	            locale,
   394	            &duration(&[("days", 2), ("hours", 3), ("minutes", 4)]),
   395	            style,
   396	        );
   397	        assert!(!one.contains('{'), "{locale}/{style_name}: {one}");
   398	        assert!(two.starts_with(&one), "{locale}/{style_name}: {two} vs {one}");
   399	        assert!(three.starts_with(&one), "{locale}/{style_name}: {three} vs {one}");
   400	        let has_empty = empty_joins.contains(&(locale, style_name));
   401	        let hours_only = format_duration(locale, &duration(&[("hours", 3)]), style);
   402	        let adjacent = format!("{one}{hours_only}");
   403	        if has_empty {
   404	            assert_eq!(two, adjacent, "{locale}/{style_name}: пустой join2");
   405	        } else {
   406	            assert_ne!(two, adjacent, "{locale}/{style_name}: join2 потерян");
   407	        }
   408	    }
   409	}
