   317	#[test]
   318	fn d11_full_oracle_matches_icu_exactly() {
   319	    let document = discord_json::parse(ORACLE).expect("oracle fixture is valid JSON");
   320	    let object = document.as_object().expect("oracle object");
   321	    let locales = object
   322	        .get("locales")
   323	        .and_then(discord_json::JsonValue::as_array)
   324	        .expect("oracle locales");
   325	    assert_eq!(locales.len(), 31, "включённых локалей");
   326	    let cases = object
   327	        .get("cases")
   328	        .and_then(discord_json::JsonValue::as_array)
   329	        .expect("oracle cases");
   330	    assert!(cases.len() >= 4_000, "кейсов: {}", cases.len());
   331	    let counts = object
   332	        .get("counts")
   333	        .and_then(discord_json::JsonValue::as_object)
   334	        .expect("oracle counts");
   335	    let meta = |name: &str| {
   336	        counts
   337	            .get(name)
   338	            .and_then(discord_json::JsonValue::as_u64)
   339	            .unwrap_or_else(|| panic!("oracle count {name}"))
   340	    };
   341	    assert_eq!(meta("rows"), DURATION_ROW_COUNT as u64);
   342	    assert_eq!(meta("joins"), DURATION_JOIN_COUNT as u64);
   343	    assert_eq!(meta("patterns"), DURATION_PATTERN_COUNT as u64);
   344	    assert!(meta("randomCases") >= 2_000, "случайных кейсов: {}", meta("randomCases"));
   345	    assert_eq!(meta("edgeCases") + meta("randomCases"), meta("cases"));
   346	    assert_eq!(meta("cases"), cases.len() as u64);
   347	
   348	    let mut seen_locales = std::collections::BTreeSet::new();
   349	    let mut seen_styles = std::collections::BTreeSet::new();
   350	    for case in cases {
   351	        let field = |name: &str| {
   352	            case.as_object()
   353	                .and_then(|case| case.get(name))
   354	                .and_then(discord_json::JsonValue::as_str)
   355	                .unwrap_or_else(|| panic!("oracle field {name}"))
   356	        };
   357	        let locale = field("locale");
   358	        let style_name = field("style");
   359	        let expected = field("expected");
   360	        seen_locales.insert(locale.to_owned());
   361	        seen_styles.insert(style_name.to_owned());
   362	        let actual = format_duration(locale, &oracle_duration(case), style(style_name));
   363	        assert_eq!(actual, expected, "{locale}/{style_name}: {case:?}");
   364	    }
   365	    assert_eq!(seen_locales.len(), 31, "локали в кейсах: {seen_locales:?}");
   366	    assert_eq!(seen_styles.len(), 3, "стили в кейсах: {seen_styles:?}");
   367	}
