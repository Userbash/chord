    25	/// Duration value, mirroring the fields of `Intl.DurationFormat`'s duration argument.
    26	#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
    27	pub struct Duration {
    28	    pub years: u64,
    29	    pub months: u64,
    30	    pub weeks: u64,
    31	    pub days: u64,
    32	    pub hours: u64,
    33	    pub minutes: u64,
    34	    pub seconds: u64,
    35	    pub milliseconds: u64,
    36	}
    37	
    38	/// Duration style, mirroring `Intl.DurationFormat`'s `style` option.
    39	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    40	pub enum DurationStyle {
    41	    Long,
    42	    Short,
    43	    Narrow,
    44	}
    45	
    46	impl DurationStyle {
    47	    const fn as_str(self) -> &'static str {
    48	        match self {
    49	            Self::Long => "long",
    50	            Self::Short => "short",
    51	            Self::Narrow => "narrow",
    52	        }
    53	    }
    54	}
    55	
    56	impl Duration {
    57	    /// Units in contract order: `(table key, value)`.
    58	    const fn units(&self) -> [(&'static str, u64); 8] {
    59	        [
    60	            ("year", self.years),
    61	            ("month", self.months),
    62	            ("week", self.weeks),
    63	            ("day", self.days),
    64	            ("hour", self.hours),
    65	            ("minute", self.minutes),
    66	            ("second", self.seconds),
    67	            ("millisecond", self.milliseconds),
    68	        ]
    69	    }
    70	}
    71	
    72	/// Number of frozen table rows (31 enabled locales × 3 styles × 8 units).
    73	pub const DURATION_ROW_COUNT: usize = DURATION_ROWS.len();
    74	/// Number of frozen separator rows (31 enabled locales × 3 styles).
    75	pub const DURATION_JOIN_COUNT: usize = DURATION_JOINS.len();
    76	/// Number of frozen unit patterns (rows × 6 CLDR categories).
    77	pub const DURATION_PATTERN_COUNT: usize = DURATION_ROW_COUNT * 6;
    78	
    79	fn row(locale: &str, style: DurationStyle, unit: &str) -> Option<&'static DurationRow> {
    80	    DURATION_ROWS
    81	        .binary_search_by(|candidate| {
    82	            (candidate.locale, candidate.style, candidate.unit).cmp(&(
    83	                locale,
    84	                style.as_str(),
    85	                unit,
    86	            ))
    87	        })
    88	        .ok()
    89	        .map(|index| &DURATION_ROWS[index])
    90	}
    91	
    92	fn joins(locale: &str, style: DurationStyle) -> Option<&'static DurationJoin> {
    93	    DURATION_JOINS
    94	        .binary_search_by(|candidate| {
    95	            (candidate.locale, candidate.style).cmp(&(locale, style.as_str()))
    96	        })
    97	        .ok()
    98	        .map(|index| &DURATION_JOINS[index])
    99	}
   100	
   101	fn render_unit(row: &DurationRow, value: u64) -> String {
   102	    let category = plural_category_integer(row.locale, value, PluralType::Cardinal).as_str();
   103	    let template = row
   104	        .patterns
   105	        .iter()
   106	        .find(|(candidate, _)| *candidate == category)
   107	        .or_else(|| row.patterns.iter().find(|(candidate, _)| *candidate == "other"))
   108	        .map(|(_, template)| *template);
   109	    let number = format_integer_unsigned(value, row.locale);
   110	    match template {
   111	        Some(template) => template.replace("{0}", &number),
   112	        // Generated rows always carry all six categories; keep a deterministic
   113	        // per-unit fallback instead of panicking if a future table loses one.
   114	        None => format!("{number} {}", row.unit),
   115	    }
   116	}
   117	
   118	fn join_chunks(chunks: &[String], joins: &DurationJoin) -> String {
   119	    match chunks {
   120	        [] => String::new(),
   121	        [only] => only.clone(),
   122	        [first, second] => {
   123	            let mut out = String::with_capacity(first.len() + joins.join2.len() + second.len());
   124	            out.push_str(first);
   125	            out.push_str(joins.join2);
   126	            out.push_str(second);
   127	            out
   128	        }
   129	        [first, rest @ ..] => {
   130	            let Some((last, middle)) = rest.split_last() else {
   131	                return first.clone();
   132	            };
   133	            let mut out = String::with_capacity(
   134	                chunks.iter().map(String::len).sum::<usize>()
   135	                    + joins.join_middle.len() * middle.len(),
   136	            );
   137	            out.push_str(first);
   138	            for chunk in middle {
   139	                out.push_str(joins.join_middle);
   140	                out.push_str(chunk);
   141	            }
   142	            out.push_str(joins.join_last);
   143	            out.push_str(last);
   144	            out
   145	        }
   146	    }
   147	}
   148	
   149	/// Format `duration` in `locale` using `style`.
   150	///
   151	/// Unknown or disabled locales fall back to `en-US`; a missing table row falls back
   152	/// to the `en-US` row for the same style/unit, then to `"{n} {unit}"`. Zero units are
   153	/// omitted, an all-zero duration is the empty string. Output never contains NNBSP or
   154	/// NBSP (they are normalized to a plain space) and the function never panics.
   155	#[must_use]
   156	pub fn format_duration(locale: &str, duration: &Duration, style: DurationStyle) -> String {
   157	    let resolved = canonical_locale(locale)
   158	        .filter(|code| is_enabled(code))
   159	        .unwrap_or(DEFAULT_LOCALE);
   160	
   161	    let mut chunks: Vec<String> = Vec::with_capacity(8);
   162	    for (unit, value) in duration.units() {
   163	        if value == 0 {
   164	            continue;
   165	        }
   166	        let row = row(resolved, style, unit).or_else(|| row(DEFAULT_LOCALE, style, unit));
   167	        chunks.push(match row {
   168	            Some(row) => render_unit(row, value),
   169	            None => format!("{} {unit}", format_integer_unsigned(value, resolved)),
   170	        });
   171	    }
   172	
   173	    let rendered = if chunks.is_empty() {
   174	        String::new()
   175	    } else if let Some(joins) = joins(resolved, style).or_else(|| joins(DEFAULT_LOCALE, style)) {
   176	        join_chunks(&chunks, joins)
   177	    } else {
   178	        chunks.join(", ")
   179	    };
   180	    rendered.replace(['\u{202f}', '\u{a0}'], " ")
   181	}

