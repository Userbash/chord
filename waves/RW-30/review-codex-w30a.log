            "en-US",
            &duration(&[("days", u64::MAX)]),
            DurationStyle::Long
        ),
        "18,446,744,073,709,551,615 days"
    );
    assert_eq!(
        format_duration(
            "ru",
            &duration(&[("days", u64::MAX)]),
            DurationStyle::Long
