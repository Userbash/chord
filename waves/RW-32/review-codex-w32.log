    73	/// Skip-aware проверка наличия библиотеки (среда, а не падение).
    74	fn hunspell_available() -> bool {
    75	    const CANDIDATES: [&str; 6] = [
    76	        "/usr/lib/libhunspell-1.7.so",
    77	        "/usr/lib/x86_64-linux-gnu/libhunspell-1.7.so",
    78	        "/usr/lib/libhunspell.so",
    79	        "/usr/local/lib/libhunspell-1.7.so",
    80	        "/lib/libhunspell-1.7.so",
    81	        "/lib/x86_64-linux-gnu/libhunspell-1.7.so",
    82	    ];
    83	    if CANDIDATES.iter().any(|path| Path::new(path).is_file()) {
    84	        return true;
    85	    }
    86	    println!("SKIP: {SKIP_NO_LIB}");
    87	    false
    88	}
