   545	// =================================================================================
   546	// W32b (P6-02b): hints `a{sv}`. Оракул — `waves/RW-32/dbus/mock_hints.py` на libdbus:
   547	// журнал `Notify` пишет `ключ:сигнатура:значение` в порядке провода, поэтому неверный
   548	// тип варианта, ключ, пропуск пустой строки или порядок видны как расхождение строки.
   549	// =================================================================================
   550	
   551	const HINTS_SKIP_NO_DAEMON: &str = "нет dbus-daemon";
   552	const HINTS_SKIP_NO_PYTHON: &str = "нет python3 с модулями dbus и gi";
   553	
   554	/// Приватная шина + мок hints; отличается от `Harness` только скриптом мока
   555	/// (`waves/RW-32/dbus/mock_hints.py`) и префиксом временного каталога.
   556	struct HintsHarness {
   557	    address: String,
   558	    journal: PathBuf,
   559	    dir: PathBuf,
   560	    daemon_pid: u32,
   561	    mock: Child,
   562	}
   563	
   564	impl HintsHarness {
   565	    fn start(extra_mock_args: &[&str]) -> Result<Self, String> {
   566	        if !command_exists("dbus-daemon") {
   567	            return Err(HINTS_SKIP_NO_DAEMON.to_owned());
   568	        }
   569	        if !python_dbus_available() {
   570	            return Err(HINTS_SKIP_NO_PYTHON.to_owned());
   571	        }
   572	
   573	        let dir = std::env::temp_dir().join(format!(
   574	            "discord-lab-w32b-{}-{}",
   575	            std::process::id(),
   576	            unique_suffix()
   577	        ));
   578	        fs::create_dir_all(&dir).map_err(|err| format!("tempdir {}: {err}", dir.display()))?;
   579	
   580	        let started = Command::new("dbus-daemon")
   581	            .args(["--session", "--print-address=1", "--print-pid=1", "--fork"])
   582	            .output()
   583	            .map_err(|err| format!("запуск dbus-daemon: {err}"))?;
   584	        if !started.status.success() {
   585	            return Err(format!(
   586	                "dbus-daemon завершился: {}",
   587	                String::from_utf8_lossy(&started.stderr).trim()
   588	            ));
   589	        }
   590	        let stdout = String::from_utf8_lossy(&started.stdout).into_owned();
   591	        let mut lines = stdout.lines().filter(|line| !line.trim().is_empty());
   592	        let address = lines
   593	            .next()
   594	            .ok_or_else(|| "dbus-daemon не напечатал адрес".to_owned())?
   595	            .trim()
   596	            .to_owned();
   597	        let daemon_pid: u32 = lines
   598	            .next()
   599	            .ok_or_else(|| "dbus-daemon не напечатал pid".to_owned())?
   600	            .trim()
   601	            .parse()
   602	            .map_err(|err| format!("pid dbus-daemon: {err}"))?;
   603	
   604	        let journal = dir.join("journal.tsv");
   605	        let mut mock = Command::new("python3")
   606	            .arg(repo_path("waves/RW-32/dbus/mock_hints.py"))
   607	            .arg("--address")
   608	            .arg(&address)
   609	            .arg("--log")
   610	            .arg(&journal)
   611	            .args(extra_mock_args)
   612	            .stdout(Stdio::null())
   613	            .stderr(Stdio::piped())
   614	            .spawn()
   615	            .map_err(|err| format!("запуск mock_hints.py: {err}"))?;
   616	
   617	        let deadline = Instant::now() + Duration::from_secs(10);
   618	        loop {
   619	            if fs::read_to_string(&journal)
   620	                .map(|text| text.contains("READY"))
   621	                .unwrap_or(false)
   622	            {
   623	                break;
   624	            }
   625	            if let Ok(Some(status)) = mock.try_wait() {
   626	                let stderr = read_child_stderr(&mut mock);
   627	                return Err(format!("мок-сервис завершился ({status}): {stderr}"));
   628	            }
   629	            if Instant::now() > deadline {
   630	                return Err("мок-сервис не поднялся за 10 с".to_owned());
   631	            }
   632	            std::thread::sleep(Duration::from_millis(50));
   633	        }
   634	
   635	        Ok(Self {
   636	            address,
   637	            journal,
   638	            dir,
   639	            daemon_pid,
   640	            mock,
   641	        })
   642	    }
   643	
   644	    fn bus_address(&self) -> BusAddress {
   645	        BusAddress::parse(&self.address).expect("адрес приватного демона")
   646	    }
   647	
   648	    fn journal_member(&self, member: &str) -> Vec<Vec<String>> {
   649	        fs::read_to_string(&self.journal)
   650	            .unwrap_or_default()
   651	            .lines()
   652	            .map(|line| line.split('\t').map(str::to_owned).collect::<Vec<String>>())
   653	            .filter(|fields| fields.first().map(String::as_str) == Some(member))
   654	            .collect()
   655	    }
   656	
   657	    fn wait_for_member(&self, member: &str, count: usize) -> Vec<Vec<String>> {
   658	        let deadline = Instant::now() + Duration::from_secs(5);
   659	        loop {
   660	            let records = self.journal_member(member);
   661	            if records.len() >= count || Instant::now() > deadline {
   662	                return records;
   663	            }
   664	            std::thread::sleep(Duration::from_millis(20));
   665	        }
   666	    }
   667	}
   668	
   669	impl Drop for HintsHarness {
   670	    fn drop(&mut self) {
   671	        let _ = self.mock.kill();
   672	        let _ = self.mock.wait();
   673	        if self.daemon_pid != 0 {
   674	            let _ = Command::new("kill")
   675	                .arg(self.daemon_pid.to_string())
   676	                .status();
   677	        }
   678	        let _ = fs::remove_dir_all(&self.dir);
   679	    }
   680	}
   681	
   682	macro_rules! hints_harness {
   683	    ($extra:expr) => {
   684	        match HintsHarness::start($extra) {
   685	            Ok(harness) => harness,
   686	            Err(reason) => {
   687	                println!("SKIP: {reason}");
   688	                return;
   689	            }
   690	        }
   691	    };
   692	}
   693	
   694	/// Запись журнала `Notify` по индексу (ждёт, пока мок допишет).
   695	fn hints_notify_record(harness: &HintsHarness, index: usize) -> Vec<String> {
   696	    let records = harness.wait_for_member("Notify", index + 1);
   697	    records.get(index).cloned().unwrap_or_else(|| {
   698	        panic!(
   699	            "журнал Notify: ожидалась запись #{index}, есть {}",
   700	            records.len()
   701	        )
   702	    })
   703	}
   704	
   705	/// Поле `hints` журнала: `ключ:сигнатура:значение|…` (пусто для пустого `a{sv}`).
   706	fn hints_field(record: &[String]) -> &str {
   707	    record.get(9).map(String::as_str).unwrap_or("")
   708	}
   709	
   710	// --- q01: notify без hints → пустой a{sv} (0 записей, не null) --------------------
   711	
   712	#[test]
   713	fn q01_notify_without_hints_sends_empty_dict() {
   714	    let harness = hints_harness!(&[]);
   715	    let mut notifier = Notifier::connect(&harness.bus_address()).expect("Notifier::connect");
   716	
   717	    let id = notifier
