     5	//! через **libgio** (`Gio.DBusMessage.to_blob()`), а не Rust-кодом W30b: байты
     6	//! сравниваются побайтово, порядок заголовочных полей берётся из фикстуры.
     7	//! `fixtures/dbus/notifications.json` фиксирует сигнатуры настоящего libdbus-сервиса
     8	//! (`mock_service.py` на приватном `dbus-daemon`).
     9	
    10	use discord_platform::dbus::message::{self, FIELD_REPLY_SERIAL, FIELD_SIGNATURE, MessageType};
    11	use discord_platform::dbus::{BusAddress, DbusError, Value, auth};
