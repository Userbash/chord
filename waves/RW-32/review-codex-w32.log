   108	fn non_empty(value: &Option<String>) -> Option<&str> {
   109	    match value.as_deref() {
   110	        Some(text) if !text.is_empty() => Some(text),
   111	        _ => None,
   112	    }
   113	}
   114	
   115	fn variant_entry(key: &str, value: Value) -> (Value, Value) {
   116	    (
   117	        Value::String(key.to_owned()),
   118	        Value::Variant(Box::new(value)),
   119	    )
   120	}
