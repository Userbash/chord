   131	pub struct Notifier {
   132	    connection: Connection,
   133	}
   134	
   135	impl Notifier {
   136	    /// Подключается к шине (AUTH EXTERNAL + `Hello`), но ничего не отправляет.
   137	    pub fn connect(address: &BusAddress) -> Result<Self, DbusError> {
   138	        Ok(Self {
   139	            connection: Connection::connect(address)?,
   140	        })
   141	    }
   142	
   143	    /// `GetCapabilities() -> as`.
   144	    pub fn capabilities(&mut self) -> Result<Vec<String>, DbusError> {
   145	        let body = self.call("GetCapabilities", "", &[])?;
   146	        let Some(Value::Array(items)) = body.into_iter().next() else {
   147	            return Err(DbusError::Protocol("GetCapabilities reply is not an array"));
   148	        };
   149	        let mut capabilities = Vec::with_capacity(items.len());
   150	        for item in items {
   151	            match item {
   152	                Value::String(capability) => capabilities.push(capability),
   153	                _ => {
   154	                    return Err(DbusError::Protocol("GetCapabilities item is not a string"));
   155	                }
   156	            }
   157	        }
   158	        Ok(capabilities)
   159	    }
   160	
   161	    /// `GetServerInformation() -> ssss`: имя, вендор, версия, версия спецификации.
   162	    ///
   163	    /// По D-Bus несколько возвращаемых значений — это последовательность типов тела
   164	    /// (`ssss`), а не struct: struct-обёртки в теле ответа нет.
   165	    pub fn server_information(&mut self) -> Result<(String, String, String, String), DbusError> {
   166	        let body = self.call("GetServerInformation", "", &[])?;
   167	        let mut values: [String; 4] = Default::default();
   168	        if body.len() != 4 {
   169	            return Err(DbusError::Protocol(
   170	                "GetServerInformation reply does not have 4 values",
   171	            ));
   172	        }
   173	        for (slot, item) in values.iter_mut().zip(body) {
   174	            match item {
   175	                Value::String(text) => *slot = text,
   176	                _ => {
   177	                    return Err(DbusError::Protocol(
   178	                        "GetServerInformation field is not a string",
   179	                    ));
   180	                }
   181	            }
   182	        }
   183	        let [name, vendor, version, specification] = values;
   184	        Ok((name, vendor, version, specification))
   185	    }
   186	
   187	    /// `Notify(...) -> u`: серверный id уведомления, hints пустые (`a{sv}` с 0 записей).
   188	    ///
   189	    /// Эквивалент `notify_with_hints(notification, &Hints::default())`.
   190	    pub fn notify(&mut self, notification: &Notification) -> Result<u32, DbusError> {
   191	        self.notify_with_hints(notification, &Hints::default())
   192	    }
   193	
   194	    /// `Notify(...) -> u` с hints (`a{sv}`): `urgency`, `category`, `desktop-entry`,
   195	    /// `resident`. Порядок записей фиксирован, пустые строки не отправляются.
   196	    ///
   197	    /// `app_name` и `summary` обязаны быть непустыми (иначе `DbusError::Protocol`):
   198	    /// пустой заголовок серверы обычно отбрасывают, и пользователь не увидит уведомление.
   199	    pub fn notify_with_hints(
   200	        &mut self,
   201	        notification: &Notification,
   202	        hints: &Hints,
   203	    ) -> Result<u32, DbusError> {
   204	        if notification.app_name.is_empty() {
   205	            return Err(DbusError::Protocol("empty app_name"));
   206	        }
   207	        if notification.summary.is_empty() {
   208	            return Err(DbusError::Protocol("empty summary"));
   209	        }
   210	
   211	        let mut actions = Vec::with_capacity(notification.actions.len() * 2);
   212	        for (action_id, label) in &notification.actions {
   213	            if action_id.is_empty() {
   214	                return Err(DbusError::Protocol("empty action id"));
   215	            }
   216	            actions.push(Value::String(action_id.clone()));
   217	            actions.push(Value::String(label.clone()));
   218	        }
   219	
   220	        let body = vec![
   221	            Value::String(notification.app_name.clone()),
   222	            Value::U32(notification.replaces_id),
   223	            Value::String(String::new()), // app_icon: иконки в этой карточке не рисуются
   224	            Value::String(notification.summary.clone()),
   225	            Value::String(notification.body.clone()),
   226	            Value::Array(actions),
   227	            hints.to_dbus(), // a{sv}: пустой Hints → 0 записей, не null
   228	            Value::I32(notification.timeout_ms),
   229	        ];
   230	
   231	        let reply = self.call("Notify", NOTIFY_SIGNATURE, &body)?;
   232	        match reply.into_iter().next() {
   233	            Some(Value::U32(id)) => Ok(id),
   234	            _ => Err(DbusError::Protocol("Notify reply is not a u32 id")),
   235	        }
   236	    }
   237	
   238	    /// `CloseNotification(u)`.
   239	    pub fn close(&mut self, id: u32) -> Result<(), DbusError> {
   240	        self.call("CloseNotification", "u", &[Value::U32(id)])?;
   241	        Ok(())
   242	    }
   243	
   244	    /// Подписка на `ActionInvoked` и `NotificationClosed`.
   245	    pub fn listen_actions(&mut self) -> Result<(), DbusError> {
   246	        for member in ["ActionInvoked", "NotificationClosed"] {
   247	            let rule = format!("type='signal',interface='{INTERFACE}',member='{member}'");
   248	            self.connection.add_match(&rule)?;
   249	        }
   250	        Ok(())
   251	    }
   252	
   253	    /// Следующее событие уведомления; чужие сигналы и сигналы с неожиданным телом
   254	    /// пропускаются (не ошибка).
   255	    pub fn next_event(&mut self) -> Result<NotificationEvent, DbusError> {
   256	        loop {
   257	            let signal = self.connection.next_signal(EVENT_TIMEOUT)?;
   258	            if signal.interface != INTERFACE {
   259	                continue;
   260	            }
   261	            let event = match signal.member.as_str() {
   262	                "ActionInvoked" => action_event(&signal.body),
   263	                "NotificationClosed" => closed_event(&signal.body),
   264	                _ => None,
   265	            };
   266	            if let Some(event) = event {
   267	                return Ok(event);
   268	            }
   269	        }
   270	    }
   271	
   272	    fn call(
   273	        &mut self,
   274	        member: &str,
   275	        signature: &str,
   276	        body: &[Value],
   277	    ) -> Result<Vec<Value>, DbusError> {
   278	        self.connection
   279	            .call_typed(DESTINATION, PATH, INTERFACE, member, signature, body)
   280	    }

