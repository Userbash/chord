    93	
    94	    /// `hunspell_spell` != 0; слово с NUL не может быть C-строкой → `false`.
    95	    pub(crate) fn check(&mut self, word: &str) -> bool {
    96	        let Some(c_word) = c_string(word) else {
    97	            return false;
    98	        };
    99	        // SAFETY: `raw` — живой handle, принадлежащий `self`; `c_word` валиден на время вызова;
   100	        // функция только читает слово и состояние словаря.
   101	        unsafe { hunspell_spell(self.raw.as_ptr(), c_word.as_ptr()) != 0 }
   102	    }
   103	
   104	    /// Варианты исправления (не больше `limit`), в порядке hunspell. Список освобождается.
   105	    pub(crate) fn suggest(&mut self, word: &str, limit: usize) -> Vec<String> {
   106	        if limit == 0 {
   107	            return Vec::new();
   108	        }
   109	        let Some(c_word) = c_string(word) else {
   110	            return Vec::new();
   111	        };
   112	        let mut list: *mut *mut c_char = ptr::null_mut();
   113	        // SAFETY: `raw` — живой handle; `&mut list` — корректный out-параметр (массив строк);
   114	        // `c_word` валиден на время вызова. Возвращается число строк и владение массивом.
   115	        let count = unsafe { hunspell_suggest(self.raw.as_ptr(), &mut list, c_word.as_ptr()) };
   116	        if count <= 0 || list.is_null() {
   117	            return Vec::new();
   118	        }
   119	        let count_usize = usize::try_from(count).unwrap_or(0);
   120	        let mut suggestions = Vec::new();
   121	        // SAFETY: hunspell вернул массив из `count` валидных указателей на C-строки; массив
   122	        // принадлежит нам до `hunspell_free_list` и не меняется во время чтения.
   123	        let entries = unsafe { slice::from_raw_parts(list, count_usize) };
   124	        for entry in entries.iter().take(limit) {
   125	            if entry.is_null() {
   126	                continue;
   127	            }
   128	            // SAFETY: каждый элемент массива — NUL-терминированная строка, выделенная hunspell;
   129	            // копируем её в `String` до освобождения списка.
   130	            let text = unsafe { CStr::from_ptr(*entry) }
   131	                .to_string_lossy()
   132	                .into_owned();
   133	            suggestions.push(text);
   134	        }
   135	        // SAFETY: `list` — тот же массив, что вернул hunspell_suggest, и ещё не освобождён;
   136	        // `count` — исходное число элементов (а не длина усечённого `suggestions`).
   137	        unsafe { hunspell_free_list(self.raw.as_ptr(), &mut list, count) };
   138	        suggestions
   139	    }
   140	
   141	    /// `hunspell_add`: 0 — успех.
   142	    pub(crate) fn add(&mut self, word: &str) -> bool {
   143	        let Some(c_word) = c_string(word) else {
   144	            return false;
   145	        };
   146	        // SAFETY: `raw` — живой handle; `c_word` валиден на время вызова; функция копирует
   147	        // слово в рантайм-словарь.
   148	        unsafe { hunspell_add(self.raw.as_ptr(), c_word.as_ptr()) == 0 }
   149	    }
   150	
   151	    /// `hunspell_remove`: 0 — успех.
   152	    pub(crate) fn remove(&mut self, word: &str) -> bool {
   153	        let Some(c_word) = c_string(word) else {
   154	            return false;
   155	        };
   156	        // SAFETY: `raw` — живой handle; `c_word` валиден на время вызова; функция помечает
   157	        // слово удалённым в рантайм-словаре.
   158	        unsafe { hunspell_remove(self.raw.as_ptr(), c_word.as_ptr()) == 0 }
   159	    }
   160	}
   161	
   162	impl Drop for Handle {
   163	    fn drop(&mut self) {
   164	        // SAFETY: `raw` создан `hunspell_create` и ещё не уничтожен; `Handle` не `Clone`,
   165	        // владение единственное, поэтому `hunspell_destroy` вызывается ровно один раз.
   166	        unsafe { hunspell_destroy(self.raw.as_ptr()) };
   167	    }
   168	}
   169	
   170	/// C-строка без внутренних NUL; `None` — слово не представимо в C (не обрезаем молча).
   171	fn c_string(text: &str) -> Option<CString> {
   172	    CString::new(text).ok()
   173	}

