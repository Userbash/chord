   104	impl SpellChecker {
   105	    /// Загружает словарь `.aff` + `.dic`. Ошибки — значением, без паники.
   106	    pub fn new(aff: &Path, dic: &Path) -> Result<Self, SpellError> {
   107	        // Порядок важен: NUL проверяется до существования файла (h12).
   108	        let aff_text = path_text(aff)?;
   109	        let dic_text = path_text(dic)?;
