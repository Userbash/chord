   571	
   572	#[test]
   573	fn n14_parse_rejects_truncated_and_corrupt_messages_without_panic() {
   574	    let bytes = golden_message("notify_call");
   575	
   576	    for cut in [
   577	        0usize,
   578	        1,
   579	        8,
   580	        15,
   581	        16,
   582	        17,
   583	        32,
   584	        bytes.len() / 2,
   585	        bytes.len() - 1,
   586	    ] {
   587	        let result = message::parse(&bytes[..cut]);
   588	        assert!(
   589	            matches!(result, Err(DbusError::Protocol(_))),
   590	            "обрезание {cut}: {result:?}"
   591	        );
   592	    }
   593	
   594	    let mut big_endian = bytes.clone();
   595	    big_endian[0] = b'B';
   596	    assert!(matches!(
   597	        message::parse(&big_endian),
   598	        Err(DbusError::Protocol(_))
   599	    ));
   600	
   601	    let mut unknown_type = bytes.clone();
   602	    unknown_type[1] = 9;
   603	    assert!(matches!(
   604	        message::parse(&unknown_type),
   605	        Err(DbusError::Protocol(_))
   606	    ));
   607	
   608	    let mut trailing = bytes.clone();
   609	    trailing.push(0);
   610	    assert!(
   611	        matches!(message::parse(&trailing), Err(DbusError::Protocol(_))),
   612	        "лишний байт после тела должен быть Protocol"
   613	    );
   614	
   615	    let mut bad_body_len = bytes.clone();
   616	    bad_body_len[4..8].copy_from_slice(&0x00ff_ffffu32.to_le_bytes());
   617	    assert!(matches!(
   618	        message::parse(&bad_body_len),
   619	        Err(DbusError::Protocol(_))
   620	    ));
   621	
   622	    assert!(matches!(
   623	        message::parse(b"GET / HTTP/1.1\r\n\r\n"),
   624	        Err(DbusError::Protocol(_))
   625	    ));
   626	}
