   183	fn command_exists(name: &str) -> bool {
   184	    Command::new("sh")
   185	        .arg("-c")
   186	        .arg(format!("command -v {name}"))
   187	        .stdout(Stdio::null())
   188	        .stderr(Stdio::null())
   189	        .status()
   190	        .map(|status| status.success())
   191	        .unwrap_or(false)
   192	}
   193	
   194	fn python_dbus_available() -> bool {
   195	    Command::new("python3")
   196	        .args(["-c", "import dbus, gi"])
   197	        .stdout(Stdio::null())
   198	        .stderr(Stdio::null())
   199	        .status()
   200	        .map(|status| status.success())
   201	        .unwrap_or(false)
   202	}
   203	
   204	fn unique_suffix() -> u64 {
   205	    use std::sync::atomic::{AtomicU64, Ordering};
   206	    static COUNTER: AtomicU64 = AtomicU64::new(0);
   207	    let nanos = std::time::SystemTime::now()
   208	        .duration_since(std::time::UNIX_EPOCH)
   209	        .map(|duration| duration.as_nanos() as u64)
   210	        .unwrap_or(0);
   211	    nanos ^ (COUNTER.fetch_add(1, Ordering::Relaxed) << 32)
   212	}
