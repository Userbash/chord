   811	#[test]
   812	fn q08_hints_dict_matches_libgio_bytes_and_round_trips() {
   813	    let golden = load_fixture("hints.json");
   814	    assert_eq!(
   815	        golden.get("hints_signature").and_then(Json::as_str),
   816	        Some("a{sv}"),
   817	        "hints — именно a{{sv}}"
   818	    );
   819	    assert_eq!(
   820	        golden.get("signature").and_then(Json::as_str),
   821	        Some(notifications::NOTIFY_SIGNATURE),
   822	        "сигнатура Notify не меняется"
   823	    );
   824	
   825	    let cases = golden
   826	        .get("cases")
   827	        .and_then(Json::as_arr)
   828	        .expect("hints.json: cases");
   829	    assert!(
   830	        cases.len() >= 5,
   831	        "ожидались наборы empty/urgency/category/desktop-entry+resident/all, есть {}",
   832	        cases.len()
   833	    );
   834	
   835	    for case in cases {
   836	        let name = case.get("name").and_then(Json::as_str).expect("case.name");
   837	        let items = case
   838	            .get("hints")
   839	            .and_then(Json::as_arr)
   840	            .expect("case.hints");
   841	        let hints = json_hints(items);
   842	        let expected = json_hints_value(items);
   843	
   844	        // Структура, типы вариантов и порядок записей: urgency, category, desktop-entry,
   845	        // resident (в фикстуре dict уже в этом порядке).
   846	        assert_eq!(hints.to_dbus(), expected, "{name}: форма a{{sv}}");
   847	        assert_eq!(
   848	            hints.to_dbus(),
   849	            hints.to_dbus(),
   850	            "{name}: порядок записей нестабилен"
   851	        );
   852	
   853	        let hex = case
   854	            .get("notify_hex")
   855	            .and_then(Json::as_str)
   856	            .expect("case.notify_hex");
   857	        let bytes = hex_decode(hex);
   858	        let libgio = message::parse(&bytes)
   859	            .unwrap_or_else(|err| panic!("{name}: байты libgio не разобраны: {err:?}"));
   860	        assert_eq!(libgio.kind, MessageType::MethodCall);
   861	        assert_eq!(libgio.member(), Some("Notify"));
   862	        assert_eq!(
   863	            libgio.signature,
   864	            notifications::NOTIFY_SIGNATURE,
   865	            "{name}: сигнатура вызова"
   866	        );
   867	        assert_eq!(
   868	            libgio.body.get(6),
   869	            Some(&expected),
   870	            "{name}: libdbus/libgio демаршалит другой a{{sv}}"
   871	        );
   872	
   873	        // Сборка нашего сообщения из разобранных полей заголовка и нашего `a{sv}`:
   874	        // побайтовое совпадение с libgio проверяет выравнивание и порядок записей.
   875	        let body = hints_notify_body(&golden, &hints);
   876	        let rebuilt = message::build(
   877	            MessageType::MethodCall,
   878	            libgio.serial,
   879	            &libgio.fields,
   880	            &libgio.signature,
   881	            &body,
   882	        )
   883	        .unwrap_or_else(|err| panic!("{name}: сборка сообщения: {err:?}"));
   884	        assert_eq!(
   885	            hex_encode(&rebuilt),
   886	            hex_encode(&bytes),
   887	            "{name}: байты a{{sv}} расходятся с libgio"
   888	        );
   889	
   890	        let round_trip = message::parse(&rebuilt).expect("разбор собранного сообщения");
   891	        assert_eq!(round_trip.body, body, "{name}: round-trip тела");
   892	        assert_eq!(
   893	            round_trip.body.get(6),
   894	            Some(&expected),
   895	            "{name}: round-trip a{{sv}}"
   896	        );
   897	    }
   898	}

