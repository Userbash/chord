    80	
    81	impl Hints {
    82	    /// Собирает `a{sv}`: только заданные непустые значения, порядок фиксирован —
    83	    /// `urgency`, `category`, `desktop-entry`, `resident`.
    84	    pub fn to_dbus(&self) -> Value {
    85	        let mut entries: Vec<(Value, Value)> = Vec::new();
    86	        if let Some(urgency) = self.urgency {
    87	            entries.push(variant_entry("urgency", Value::Byte(urgency.code())));
    88	        }
    89	        if let Some(category) = non_empty(&self.category) {
    90	            entries.push(variant_entry(
    91	                "category",
    92	                Value::String(category.to_owned()),
    93	            ));
    94	        }
    95	        if let Some(desktop_entry) = non_empty(&self.desktop_entry) {
    96	            entries.push(variant_entry(
    97	                "desktop-entry",
    98	                Value::String(desktop_entry.to_owned()),
    99	            ));
   100	        }
   101	        if let Some(resident) = self.resident {
   102	            entries.push(variant_entry("resident", Value::Bool(resident)));
   103	        }
   104	        Value::Dict(entries)
   105	    }
   106	}
