   109	fn rss_kilobytes() -> Option<u64> {
   110	    let status = fs::read_to_string("/proc/self/status").ok()?;
   111	    status.lines().find_map(|line| {
   112	        let rest = line.strip_prefix("VmRSS:")?;
   113	        rest.split_whitespace().next()?.parse().ok()
   114	    })
   115	}
