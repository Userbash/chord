   453	#[test]
   454	fn n04_header_body_boundary_is_aligned_and_padded_with_zeroes() {
   455	    for (name, bytes) in golden_messages() {
   456	        assert!(bytes.len() >= 16, "{name}: короткое сообщение");
   457	        let body_len = u32::from_le_bytes(bytes[4..8].try_into().expect("body len")) as usize;
   458	        let fields_len = u32::from_le_bytes(bytes[12..16].try_into().expect("fields len")) as usize;
   459	        let fields_end = 16 + fields_len;
   460	        let body_offset = (fields_end + 7) & !7;
   461	
   462	        assert_eq!(body_offset % 8, 0, "{name}: тело не выровнено по 8");
   463	        assert!(
   464	            bytes[fields_end..body_offset].iter().all(|byte| *byte == 0),
   465	            "{name}: padding между заголовком и телом не нулевой"
   466	        );
   467	        assert_eq!(
   468	            bytes.len(),
   469	            body_offset + body_len,
   470	            "{name}: длина сообщения не совпадает с body_len"
   471	        );
   472	    }
   473	
   474	    // `a(ss)` из golden: два элемента-структуры идут с шагом 8, пары доходят целиком.
   475	    let parsed = message::parse(&golden_message("pairs_signal")).expect("pairs_signal");
   476	    assert_eq!(parsed.signature, "a(ss)");
   477	    assert_eq!(
   478	        parsed.body,
   479	        vec![Value::Array(vec![
   480	            Value::Struct(vec![
   481	                Value::String("a".to_owned()),
   482	                Value::String("b".to_owned()),
   483	            ]),
   484	            Value::Struct(vec![
   485	                Value::String("c".to_owned()),
   486	                Value::String("d".to_owned()),
   487	            ]),
   488	        ])]
   489	    );
   490	}
