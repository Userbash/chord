---waves/RW-32/dbus/mock_hints.py
     1	#!/usr/bin/env python3
     2	"""Мок-сервер `org.freedesktop.Notifications` на libdbus для контрактных тестов W32b.
     3	
     4	Отличие от `waves/RW-30/dbus/mock_service.py` (он не меняется): журнал `Notify`
     5	дополнительно фиксирует содержимое `a{sv}` — порядок ключей и **тип варианта** каждого
     6	значения. Это независимый оракул демаршалинга: hints разбирает libdbus (python3-dbus),
     7	а не Rust-код W32b, поэтому неверный тип варианта (`u` вместо `y`, `s` вместо `b`)
     8	виден в журнале.
     9	
    10	CLI:
    11	    mock_hints.py --address <unix:path=...> --log <file> [--fail-notify]
    12	                  [--next-id 101] [--capabilities body,actions,persistence]
    13	
    14	Журнал вызовов — TSV-строки (первое поле — член вызова):
    15	    READY
    16	    GetCapabilities
    17	    GetServerInformation
    18	    Notify\t<app_name>\t<replaces_id>\t<app_icon>\t<summary>\t<body>\t<hints_len>\t<actions>\t<timeout>\t<hints>
    19	    CloseNotification\t<id>
    20	    EmitAction\t<id>\t<action>
    21	    EmitClosed\t<id>\t<reason>
    22	    EmitForeign\t<id>
    23	
    24	`<hints>` — записи в порядке провода через `|`, каждая `ключ:сигнатура:значение`
    25	(например `urgency:y:2|category:s:email.arrived|resident:b:1`). Пустой `a{sv}` — пустое
    26	поле. `<hints_len>` — число записей (для проверки «dict 0 записей, не null»).
    27	
    28	Управляющий интерфейс `lab.Mock.Notifications` на `/lab/Mock`: `EmitAction(u, s)`,
    29	`EmitClosed(u, u)`, `EmitForeign(u)`.
    30	"""
    31	
    32	import argparse
    33	import os
    34	import sys
    35	
    36	import dbus
    37	import dbus.lowlevel
    38	import dbus.service
    39	from dbus.mainloop.glib import DBusGMainLoop
    40	from gi.repository import GLib
    41	
    42	DESTINATION = "org.freedesktop.Notifications"
    43	PATH = "/org/freedesktop/Notifications"
    44	IFACE = "org.freedesktop.Notifications"
    45	CONTROL_PATH = "/lab/Mock"
    46	CONTROL_IFACE = "lab.Mock.Notifications"
    47	CONTROL_DESTINATION = "lab.Mock"
    48	
    49	
    50	def _variant_signature(value):
    51	    """D-Bus-сигнатура значения из `a{sv}` (libdbus отдаёт типизированные обёртки).
    52	
    53	    Проверки идут от наследников `int`: `dbus.Boolean`/`dbus.Byte` тоже int, поэтому
    54	    порядок важен. Неизвестный тип → `?` (тест увидит расхождение, а не молчание).
    55	    """
    56	    if isinstance(value, dbus.Boolean):
    57	        return "b"
    58	    if isinstance(value, dbus.Byte):
    59	        return "y"
    60	    if isinstance(value, dbus.String):
    61	        return "s"
    62	    if isinstance(value, dbus.ObjectPath):
    63	        return "o"
    64	    if isinstance(value, dbus.Signature):
    65	        return "g"
    66	    if isinstance(value, dbus.Int16):
    67	        return "n"
    68	    if isinstance(value, dbus.UInt16):
    69	        return "q"
    70	    if isinstance(value, dbus.Int32):
    71	        return "i"
    72	    if isinstance(value, dbus.UInt32):
    73	        return "u"
    74	    if isinstance(value, dbus.Int64):
    75	        return "x"
    76	    if isinstance(value, dbus.UInt64):
    77	        return "t"
    78	    if isinstance(value, dbus.Double):
    79	        return "d"
    80	    return "?"
    81	
    82	
    83	def _format_hint_value(value, signature):
    84	    if signature == "b":
    85	        # dbus.Boolean — наследник int; в журнале нужен стабильный 0/1, а не True/False.
    86	        return "1" if bool(value) else "0"
    87	    if signature in ("y", "n", "q", "i", "u", "x", "t"):
    88	        return str(int(value))
    89	    return str(value)
    90	
    91	
    92	def format_hints(hints):
    93	    """`a{sv}` → `ключ:сигнатура:значение|…` в порядке провода (dict python 3.7+ упорядочен)."""
    94	    parts = []
    95	    for key, value in hints.items():
    96	        signature = _variant_signature(value)
    97	        parts.append("%s:%s:%s" % (key, signature, _format_hint_value(value, signature)))
    98	    return "|".join(parts)
    99	
   100	
   101	class MockNotifications(dbus.service.Object):
   102	    def __init__(self, bus, log_path, fail_notify, next_id, capabilities):
   103	        super().__init__(bus, PATH)
   104	        self._bus = bus
   105	        self._log_path = log_path
   106	        self._fail_notify = fail_notify
   107	        self._next_id = next_id
   108	        self._capabilities = capabilities
   109	        self._control = MockControl(bus, self)
   110	
   111	    def _log(self, *fields):
   112	        with open(self._log_path, "a", encoding="utf-8") as handle:
   113	            handle.write("\t".join(str(field) for field in fields) + "\n")
   114	            handle.flush()
   115	            os.fsync(handle.fileno())
   116	
   117	    @staticmethod
   118	    def _format_actions(actions):
   119	        # Спека freedesktop: `as` — плоский список парами (id, label, id, label, …).
   120	        flat = [str(item) for item in actions]
   121	        pairs = []
   122	        for index in range(0, len(flat) - 1, 2):
   123	            pairs.append("%s:%s" % (flat[index], flat[index + 1]))
   124	        return "|".join(pairs)
   125	
   126	    @dbus.service.method(IFACE, in_signature="susssasa{sv}i", out_signature="u")
   127	    def Notify(self, app_name, replaces_id, app_icon, summary, body, actions, hints, expire_timeout):
   128	        self._log(
   129	            "Notify",
   130	            app_name,
   131	            int(replaces_id),
   132	            app_icon,
   133	            summary,
   134	            body,
   135	            len(hints),
   136	            self._format_actions(actions),
   137	            int(expire_timeout),
   138	            format_hints(hints),
   139	        )
   140	        if self._fail_notify:
   141	            raise dbus.exceptions.DBusException(
   142	                "mock rejected notification",
   143	                name="org.freedesktop.Notifications.Error.MockRejected",
   144	            )
   145	        if int(replaces_id) != 0:
   146	            return dbus.UInt32(int(replaces_id))
   147	        self._next_id += 1
   148	        return dbus.UInt32(self._next_id - 1)
   149	
   150	    @dbus.service.method(IFACE, in_signature="u", out_signature="")
   151	    def CloseNotification(self, notification_id):
   152	        self._log("CloseNotification", int(notification_id))
   153	
   154	    @dbus.service.method(IFACE, in_signature="", out_signature="as")
   155	    def GetCapabilities(self):
   156	        self._log("GetCapabilities")
   157	        return dbus.Array(self._capabilities, signature="s")
   158	
   159	    @dbus.service.method(IFACE, in_signature="", out_signature="ssss")
   160	    def GetServerInformation(self):
   161	        self._log("GetServerInformation")
   162	        return dbus.String("MockNotify"), dbus.String("discord-lab"), dbus.String("1.0"), dbus.String("1.2")
   163	
   164	    @dbus.service.signal(IFACE, signature="us")
   165	    def ActionInvoked(self, notification_id, action_key):
   166	        pass
   167	
   168	    @dbus.service.signal(IFACE, signature="uu")
   169	    def NotificationClosed(self, notification_id, reason):
   170	        pass
   171	
   172	    def emit_action(self, notification_id, action_key):
   173	        self._log("EmitAction", notification_id, action_key)
   174	        self.ActionInvoked(dbus.UInt32(notification_id), dbus.String(action_key))
   175	
   176	    def emit_closed(self, notification_id, reason):
   177	        self._log("EmitClosed", notification_id, reason)
   178	        self.NotificationClosed(dbus.UInt32(notification_id), dbus.UInt32(reason))
   179	
   180	    def emit_foreign(self, notification_id):
   181	        self._log("EmitForeign", notification_id)
   182	        ping = dbus.lowlevel.SignalMessage(CONTROL_PATH, "lab.Mock.Ping", "Ping")
   183	        ping.append(dbus.String("foreign"), signature="s")
   184	        self._bus.send_message(ping)
   185	
   186	        bogus = dbus.lowlevel.SignalMessage(PATH, IFACE, "ActionInvoked")
   187	        bogus.append(dbus.String("not-a-struct"), signature="s")
   188	        self._bus.send_message(bogus)
   189	
   190	
   191	class MockControl(dbus.service.Object):
   192	    def __init__(self, bus, notifications):
   193	        super().__init__(bus, CONTROL_PATH)
   194	        self._notifications = notifications
   195	
   196	    @dbus.service.method(CONTROL_IFACE, in_signature="us", out_signature="")
   197	    def EmitAction(self, notification_id, action_key):
   198	        self._notifications.emit_action(int(notification_id), str(action_key))
   199	
   200	    @dbus.service.method(CONTROL_IFACE, in_signature="uu", out_signature="")
   201	    def EmitClosed(self, notification_id, reason):
   202	        self._notifications.emit_closed(int(notification_id), int(reason))
   203	
   204	    @dbus.service.method(CONTROL_IFACE, in_signature="u", out_signature="")
   205	    def EmitForeign(self, notification_id):
   206	        self._notifications.emit_foreign(int(notification_id))
   207	
   208	
   209	def main(argv):
   210	    parser = argparse.ArgumentParser(description="Мок org.freedesktop.Notifications на libdbus (hints)")
   211	    parser.add_argument("--address", required=True, help="адрес приватной сессионной шины")
   212	    parser.add_argument("--log", required=True, help="файл журнала вызовов (TSV)")
   213	    parser.add_argument("--fail-notify", action="store_true", help="Notify отвечает D-Bus-ошибкой")
   214	    parser.add_argument("--next-id", type=int, default=100, help="первый выданный id уведомления")
   215	    parser.add_argument(
   216	        "--capabilities",
   217	        default="body,actions,persistence,icon-static",
   218	        help="список возможностей через запятую",
   219	    )
   220	    args = parser.parse_args(argv)
   221	
   222	    if os.path.exists(args.log):
   223	        os.remove(args.log)
   224	
   225	    DBusGMainLoop(set_as_default=True)
   226	    bus = dbus.bus.BusConnection(args.address)
   227	    capabilities = [item for item in args.capabilities.split(",") if item]
   228	    MockNotifications(bus, args.log, args.fail_notify, args.next_id, capabilities)
   229	
   230	    name = dbus.service.BusName(DESTINATION, bus=bus)
   231	    assert name is not None
   232	    control_name = dbus.service.BusName(CONTROL_DESTINATION, bus=bus)
   233	    assert control_name is not None
   234	
   235	    with open(args.log, "a", encoding="utf-8") as handle:
   236	        handle.write("READY\n")
   237	        handle.flush()
   238	        os.fsync(handle.fileno())
   239	
   240	    GLib.MainLoop().run()
   241	    return 0
   242	
   243	
   244	if __name__ == "__main__":
   245	    sys.exit(main(sys.argv[1:]))
---waves/RW-32/dbus/gen-hints.py
     1	#!/usr/bin/env python3
     2	"""Фиксирует эталон для `hints` (`a{sv}`) в `fixtures/dbus/hints.json` (W32b).
     3	
     4	Два независимых оракула (Rust-код W32b в них не участвует):
     5	
     6	1. **libgio**: полные байты method call `Notify(susssasa{sv}i)` для каждого набора hints
     7	   (`Gio.DBusMessage.to_blob()`). Rust-тест собирает то же сообщение нашим маршалером и
     8	   сравнивает hex побайтово — это проверка выравнивания `a{sv}`, сигнатур вариантов и
     9	   порядка записей.
    10	2. **libdbus**: приватный `dbus-daemon` + `mock_hints.py`; Gio-клиент отправляет те же
    11	   наборы, журнал мока (`ключ:сигнатура:значение`) попадает в фикстуру как снимок того,
    12	   что libdbus реально демаршалил.
    13	
    14	Запуск: `python3 waves/RW-32/dbus/gen-hints.py` (из корня репозитория).
    15	Сеть не используется. Если `dbus-daemon`/`python3-dbus` недоступны, байты libgio всё равно
    16	пишутся, журнал пропускается с пояснением (код выхода 0).
    17	"""
    18	
    19	import json
    20	import os
    21	import shutil
    22	import subprocess
    23	import sys
    24	import tempfile
    25	import time
    26	
    27	SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
    28	REPO_ROOT = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "..", ".."))
    29	FIXTURES = os.path.join(REPO_ROOT, "fixtures", "dbus")
    30	MOCK = os.path.join(SCRIPT_DIR, "mock_hints.py")
    31	FIXTURE = os.path.join(FIXTURES, "hints.json")
    32	
    33	DESTINATION = "org.freedesktop.Notifications"
    34	PATH = "/org/freedesktop/Notifications"
    35	SIGNATURE = "susssasa{sv}i"
    36	NOTIFY_ID = 100
    37	
    38	# Общие поля Notify для всех эталонных сообщений (hints — единственная переменная).
    39	APP_NAME = "Discord Lab"
    40	SUMMARY = "Alice"
    41	BODY = "hello"
    42	ACTIONS = ["open", "Open", "reply", "Reply"]
    43	TIMEOUT = -1
    44	SERIAL = 7
    45	
    46	# Порядок записей в наборе — тот же, что требует контракт: urgency, category,
    47	# desktop-entry, resident. libgio сериализует dict в порядке вставки python.
    48	CASES = [
    49	    {"name": "empty", "hints": []},
    50	    {"name": "urgency_low", "hints": [("urgency", "y", 0)]},
    51	    {"name": "urgency_normal", "hints": [("urgency", "y", 1)]},
    52	    {"name": "urgency_critical", "hints": [("urgency", "y", 2)]},
    53	    {"name": "category", "hints": [("category", "s", "email.arrived")]},
    54	    {
    55	        "name": "desktop_entry_resident",
    56	        "hints": [("desktop-entry", "s", "discord-lab"), ("resident", "b", True)],
    57	    },
    58	    {"name": "resident_false", "hints": [("resident", "b", False)]},
    59	    {
    60	        "name": "all",
    61	        "hints": [
    62	            ("urgency", "y", 2),
    63	            ("category", "s", "im.received"),
    64	            ("desktop-entry", "s", "discord-lab"),
    65	            ("resident", "b", True),
    66	        ],
    67	    },
    68	]
    69	
    70	
    71	def variant_payload(hints):
    72	    """Список (key, signature, value) → dict for GLib `a{sv}`."""
    73	    import gi
    74	
    75	    gi.require_version("Gio", "2.0")
    76	    from gi.repository import GLib
    77	
    78	    return {key: GLib.Variant(signature, value) for key, signature, value in hints}
    79	
