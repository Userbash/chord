   367	// Компиляционное утверждение `!Send + !Sync`: при реализации Send/Sync у `SpellChecker`
   368	// эти impl'ы станут неоднозначными и тест перестанет компилироваться.
   369	trait AmbiguousIfSend<A> {
   370	    fn probe() {}
   371	}
   372	impl<T: ?Sized> AmbiguousIfSend<()> for T {}
   373	impl<T: ?Sized + Send> AmbiguousIfSend<u8> for T {}
   374	
   375	trait AmbiguousIfSync<A> {
   376	    fn probe() {}
   377	}
   378	impl<T: ?Sized> AmbiguousIfSync<()> for T {}
   379	impl<T: ?Sized + Sync> AmbiguousIfSync<u8> for T {}
   380	
   381	#[test]
   382	fn h13_not_send_sync_and_tokenize_never_panics() {
   383	    let _ = <SpellChecker as AmbiguousIfSend<_>>::probe;
   384	    let _ = <SpellChecker as AmbiguousIfSync<_>>::probe;
   385	
   386	    // Произвольный Unicode не должен паниковать на границах char/байтов.
   387	    for text in [
   388	        "🦀🦀 hello 🦀",
   389	        "日本語 テスト",
   390	        "e\u{0301}cole",
   391	        "\u{fffd}\u{fffd}",
   392	        "''--",
   393	        "`unclosed",
   394	        "https://",
   395	        "<@>",
   396	        "<#",
   397	        ":a:",
   398	        "а-б'в",
   399	    ] {
   400	        let tokens = tokenize(text);
   401	        for token in tokens {
   402	            assert!(token.start < token.end);
   403	            assert_eq!(&text[token.start..token.end], token.text);
   404	        }
   405	    }
   406	    assert_eq!(texts("🦀hello🦀"), vec!["hello"]);
   407	    assert_eq!(texts("日本語"), vec!["日本語"]);
   408	}
