    75	struct JsonParser<'a> {
    76	    bytes: &'a [u8],
    77	    pos: usize,
    78	}
    79	
    80	impl JsonParser<'_> {
    81	    fn skip_ws(&mut self) {
    82	        while matches!(self.bytes.get(self.pos), Some(b' ' | b'\n' | b'\r' | b'\t')) {
    83	            self.pos += 1;
    84	        }
    85	    }
    86	
    87	    fn expect(&mut self, byte: u8) -> Result<(), String> {
    88	        if self.bytes.get(self.pos) == Some(&byte) {
    89	            self.pos += 1;
    90	            Ok(())
    91	        } else {
    92	            Err(format!(
    93	                "ожидался {:?} на позиции {}",
    94	                byte as char, self.pos
    95	            ))
    96	        }
    97	    }
    98	
    99	    fn value(&mut self) -> Result<Json, String> {
   100	        self.skip_ws();
   101	        match self.bytes.get(self.pos).copied() {
   102	            Some(b'{') => self.object(),
   103	            Some(b'[') => self.array(),
   104	            Some(b'"') => Ok(Json::Str(self.string()?)),
   105	            Some(b't') => self.literal("true", Json::Bool(true)),
   106	            Some(b'f') => self.literal("false", Json::Bool(false)),
   107	            Some(b'n') => self.literal("null", Json::Null),
   108	            Some(byte) if byte == b'-' || byte.is_ascii_digit() => self.number(),
   109	            other => Err(format!(
   110	                "неожиданный байт {other:?} на позиции {}",
   111	                self.pos
   112	            )),
   113	        }
   114	    }
   115	
   116	    fn literal(&mut self, text: &str, value: Json) -> Result<Json, String> {
   117	        if self.bytes[self.pos..].starts_with(text.as_bytes()) {
   118	            self.pos += text.len();
   119	            Ok(value)
   120	        } else {
   121	            Err(format!("ожидался литерал {text} на позиции {}", self.pos))
   122	        }
   123	    }
   124	
   125	    fn number(&mut self) -> Result<Json, String> {
   126	        let start = self.pos;
   127	        if self.bytes.get(self.pos) == Some(&b'-') {
   128	            self.pos += 1;
   129	        }
   130	        while matches!(self.bytes.get(self.pos), Some(byte) if byte.is_ascii_digit()) {
   131	            self.pos += 1;
   132	        }
   133	        if self.bytes.get(self.pos) == Some(&b'.') {
   134	            self.pos += 1;
   135	            while matches!(self.bytes.get(self.pos), Some(byte) if byte.is_ascii_digit()) {
   136	                self.pos += 1;
   137	            }
   138	        }
   139	        let text =
   140	            std::str::from_utf8(&self.bytes[start..self.pos]).map_err(|err| err.to_string())?;
   141	        text.parse::<f64>()
   142	            .map(Json::Num)
   143	            .map_err(|err| format!("число {text:?}: {err}"))
   144	    }
   145	
   146	    fn string(&mut self) -> Result<String, String> {
   147	        self.expect(b'"')?;
   148	        let mut out = String::new();
   149	        loop {
   150	            let byte = *self
   151	                .bytes
   152	                .get(self.pos)
   153	                .ok_or_else(|| "незакрытая строка".to_string())?;
   154	            self.pos += 1;
   155	            match byte {
   156	                b'"' => return Ok(out),
   157	                b'\\' => {
   158	                    let escape = *self
   159	                        .bytes
   160	                        .get(self.pos)
   161	                        .ok_or_else(|| "оборванный escape".to_string())?;
   162	                    self.pos += 1;
   163	                    match escape {
   164	                        b'"' => out.push('"'),
   165	                        b'\\' => out.push('\\'),
   166	                        b'/' => out.push('/'),
   167	                        b'b' => out.push('\u{0008}'),
   168	                        b'f' => out.push('\u{000C}'),
   169	                        b'n' => out.push('\n'),
   170	                        b'r' => out.push('\r'),
   171	                        b't' => out.push('\t'),
   172	                        b'u' => {
   173	                            let hex = self
   174	                                .bytes
   175	                                .get(self.pos..self.pos + 4)
   176	                                .ok_or_else(|| "короткий \\u".to_string())?;
   177	                            self.pos += 4;
   178	                            let code = u32::from_str_radix(
   179	                                std::str::from_utf8(hex).map_err(|err| err.to_string())?,
   180	                                16,
   181	                            )
   182	                            .map_err(|err| err.to_string())?;
   183	                            out.push(char::from_u32(code).ok_or_else(|| "плохой \\u".to_string())?);
   184	                        }
   185	                        other => return Err(format!("неизвестный escape {other:?}")),
   186	                    }
   187	                }
   188	                byte if byte < 0x20 => return Err(format!("control-байт {byte:?} в строке")),
   189	                byte if byte < 0x80 => out.push(byte as char),
   190	                _ => {
   191	                    // UTF-8: возвращаемся к началу последовательности и читаем её целиком.
   192	                    self.pos -= 1;
   193	                    let rest = std::str::from_utf8(&self.bytes[self.pos..])
   194	                        .map_err(|err| err.to_string())?;
   195	                    let ch = rest
   196	                        .chars()
   197	                        .next()
   198	                        .ok_or_else(|| "пустая строка".to_string())?;
   199	                    out.push(ch);
   200	                    self.pos += ch.len_utf8();
   201	                }
   202	            }
   203	        }
   204	    }
   205	
   206	    fn array(&mut self) -> Result<Json, String> {
   207	        self.expect(b'[')?;
   208	        let mut items = Vec::new();
   209	        self.skip_ws();
   210	        if self.bytes.get(self.pos) == Some(&b']') {
   211	            self.pos += 1;
   212	            return Ok(Json::Arr(items));
   213	        }
   214	        loop {
   215	            items.push(self.value()?);
   216	            self.skip_ws();
   217	            match self.bytes.get(self.pos) {
   218	                Some(b',') => self.pos += 1,
   219	                Some(b']') => {
   220	                    self.pos += 1;
   221	                    return Ok(Json::Arr(items));
   222	                }
   223	                other => return Err(format!("ожидался ',' или ']', получено {other:?}")),
   224	            }
   225	        }
   226	    }
   227	
   228	    fn object(&mut self) -> Result<Json, String> {
   229	        self.expect(b'{')?;
   230	        let mut entries = Vec::new();
   231	        self.skip_ws();
   232	        if self.bytes.get(self.pos) == Some(&b'}') {
   233	            self.pos += 1;
   234	            return Ok(Json::Obj(entries));
   235	        }
   236	        loop {
   237	            self.skip_ws();
   238	            let key = self.string()?;
   239	            self.skip_ws();
   240	            self.expect(b':')?;
   241	            let value = self.value()?;
   242	            entries.push((key, value));
   243	            self.skip_ws();
   244	            match self.bytes.get(self.pos) {
   245	                Some(b',') => self.pos += 1,
   246	                Some(b'}') => {
   247	                    self.pos += 1;
   248	                    return Ok(Json::Obj(entries));
   249	                }
   250	                other => return Err(format!("ожидался ',' или '}}', получено {other:?}")),
   251	            }
   252	        }
   253	    }
   254	}
