   131	pub struct Notifier {
   132	    connection: Connection,
   133	}
   134	
   135	impl Notifier {
   136	    /// Подключается к шине (AUTH EXTERNAL + `Hello`), но ничего не отправляет.
   137	    pub fn connect(address: &BusAddress) -> Result<Self, DbusError> {
   138	        Ok(Self {
   139	            connection: Connection::connect(address)?,
   140	        })
   141	    }
   142	
   143	    /// `GetCapabilities() -> as`.
   144	    pub fn capabilities(&mut self) -> Result<Vec<String>, DbusError> {
   145	        let body = self.call("GetCapabilities", "", &[])?;
   146	        let Some(Value::Array(items)) = body.into_iter().next() else {
   147	            return Err(DbusError::Protocol("GetCapabilities reply is not an array"));
   148	        };
   149	        let mut capabilities = Vec::with_capacity(items.len());
   150	        for item in items {
   151	            match item {
   152	                Value::String(capability) => capabilities.push(capability),
   153	                _ => {
   154	                    return Err(DbusError::Protocol("GetCapabilities item is not a string"));
   155	                }
   156	            }
   157	        }
   158	        Ok(capabilities)
   159	    }
   160	
   161	    /// `GetServerInformation() -> ssss`: имя, вендор, версия, версия спецификации.
   162	    ///
   163	    /// По D-Bus несколько возвращаемых значений — это последовательность типов тела
   164	    /// (`ssss`), а не struct: struct-обёртки в теле ответа нет.
   165	    pub fn server_information(&mut self) -> Result<(String, String, String, String), DbusError> {
   166	        let body = self.call("GetServerInformation", "", &[])?;
   167	        let mut values: [String; 4] = Default::default();
   168	        if body.len() != 4 {
   169	            return Err(DbusError::Protocol(
   170	                "GetServerInformation reply does not have 4 values",
   171	            ));
   172	        }
   173	        for (slot, item) in values.iter_mut().zip(body) {
   174	            match item {
   175	                Value::String(text) => *slot = text,
   176	                _ => {
   177	                    return Err(DbusError::Protocol(
   178	                        "GetServerInformation field is not a string",
   179	                    ));
   180	                }
   181	            }
   182	        }
   183	        let [name, vendor, version, specification] = values;
   184	        Ok((name, vendor, version, specification))
   185	    }
   186	
   187	    /// `Notify(...) -> u`: серверный id уведомления, hints пустые (`a{sv}` с 0 записей).
   188	    ///
   189	    /// Эквивалент `notify_with_hints(notification, &Hints::default())`.
   190	    pub fn notify(&mut self, notification: &Notification) -> Result<u32, DbusError> {
   191	        self.notify_with_hints(notification, &Hints::default())
   192	    }
   193	
   194	    /// `Notify(...) -> u` с hints (`a{sv}`): `urgency`, `category`, `desktop-entry`,
   195	    /// `resident`. Порядок записей фиксирован, пустые строки не отправляются.
   196	    ///
