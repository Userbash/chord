   351	#[test]
   352	fn n01_bus_address_parse_accepts_path_and_rejects_abstract() {
   353	    let plain = BusAddress::parse("unix:path=/run/user/1000/bus").expect("unix:path");
   354	    assert_eq!(plain.path(), Path::new("/run/user/1000/bus"));
   355	
   356	    // abstract-сокеты не поддерживаются и документированы как None.
   357	    assert_eq!(BusAddress::parse("unix:abstract=/tmp/dbus-abc"), None);
   358	    assert_eq!(BusAddress::parse("tcp:host=localhost,port=1234"), None);
   359	    assert_eq!(BusAddress::parse(""), None);
   360	    assert_eq!(BusAddress::parse("unix:path="), None);
   361	    assert_eq!(BusAddress::parse("мусор"), None);
   362	
   363	    // Список адресов: берётся первый поддерживаемый.
   364	    let list = BusAddress::parse("unix:abstract=/tmp/abstract;unix:path=/tmp/real");
   365	    assert_eq!(
   366	        list.map(|address| address.path().to_path_buf()),
   367	        Some(PathBuf::from("/tmp/real"))
   368	    );
   369	
   370	    // guid и прочие ключи в той же записи не мешают.
   371	    let with_guid = BusAddress::parse("unix:guid=abc,path=/tmp/a").expect("path после guid");
   372	    assert_eq!(with_guid.path(), Path::new("/tmp/a"));
   373	
   374	    // `from_env` — ровно разбор DBUS_SESSION_BUS_ADDRESS (если переменная задана).
   375	    match std::env::var("DBUS_SESSION_BUS_ADDRESS") {
   376	        Ok(value) => {
   377	            let from_env = BusAddress::from_env().expect("адрес из env");
   378	            let parsed = BusAddress::parse(&value).expect("разбор env-адреса");
   379	            assert_eq!(from_env.path(), parsed.path());
   380	        }
   381	        Err(_) => println!("SKIP: DBUS_SESSION_BUS_ADDRESS не задан, from_env не проверяется"),
   382	    }
   383	}
