   710	// --- q08: hints `a{sv}` — байты libgio и round-trip ------------------------------
   711	
   712	/// Собирает `Hints` из эталонного набора `fixtures/dbus/hints.json`.
   713	fn json_hints(items: &[Json]) -> Hints {
   714	    let mut hints = Hints::default();
   715	    for item in items {
   716	        let key = item.get("key").and_then(Json::as_str).expect("hints.key");
   717	        let signature = item
   718	            .get("signature")
   719	            .and_then(Json::as_str)
   720	            .expect("hints.signature");
   721	        let value = item.get("value").expect("hints.value");
   722	        match (key, signature) {
   723	            ("urgency", "y") => {
   724	                hints.urgency = Some(match value.as_u64() {
   725	                    Some(0) => Urgency::Low,
   726	                    Some(1) => Urgency::Normal,
   727	                    Some(2) => Urgency::Critical,
   728	                    other => panic!("{key}: неожиданная urgency {other:?}"),
   729	                });
   730	            }
   731	            ("category", "s") => hints.category = value.as_str().map(str::to_owned),
   732	            ("desktop-entry", "s") => hints.desktop_entry = value.as_str().map(str::to_owned),
   733	            ("resident", "b") => {
   734	                hints.resident = Some(match value {
   735	                    Json::Bool(flag) => *flag,
   736	                    other => panic!("{key}: ожидался bool, получено {other:?}"),
   737	                });
   738	            }
   739	            other => panic!("неизвестная запись hints: {other:?}"),
   740	        }
   741	    }
   742	    hints
   743	}
   744	
   745	/// Ожидаемый `a{sv}` из фикстуры: ключи, порядок и **типы вариантов** заданы оракулом.
   746	fn json_hints_value(items: &[Json]) -> Value {
   747	    let mut entries = Vec::new();
   748	    for item in items {
   749	        let key = item.get("key").and_then(Json::as_str).expect("hints.key");
   750	        let signature = item
   751	            .get("signature")
   752	            .and_then(Json::as_str)
   753	            .expect("hints.signature");
   754	        let value = item.get("value").expect("hints.value");
   755	        let inner = match signature {
   756	            "y" => Value::Byte(
   757	                u8::try_from(value.as_u64().expect("hints.y")).expect("hints.y в диапазоне u8"),
   758	            ),
   759	            "s" => Value::String(value.as_str().expect("hints.s").to_owned()),
   760	            "b" => Value::Bool(match value {
   761	                Json::Bool(flag) => *flag,
   762	                other => panic!("{key}: ожидался bool, получено {other:?}"),
   763	            }),
   764	            other => panic!("{key}: неизвестная сигнатура варианта {other:?}"),
   765	        };
   766	        entries.push((
   767	            Value::String(key.to_owned()),
   768	            Value::Variant(Box::new(inner)),
   769	        ));
   770	    }
   771	    Value::Dict(entries)
   772	}
   773	
   774	/// Тело `Notify`, собранное из тех же общих полей, что и golden в `hints.json`.
   775	fn hints_notify_body(golden: &Json, hints: &Hints) -> Vec<Value> {
   776	    let notify = golden.get("notify").expect("hints.json: notify");
   777	    let text = |key: &str| {
   778	        notify
   779	            .get(key)
   780	            .and_then(Json::as_str)
   781	            .unwrap_or_else(|| panic!("hints.json: notify.{key}"))
   782	            .to_owned()
   783	    };
   784	    let actions = notify
   785	        .get("actions")
   786	        .and_then(Json::as_arr)
   787	        .expect("hints.json: notify.actions")
   788	        .iter()
   789	        .map(|item| Value::String(item.as_str().expect("notify.action").to_owned()))
   790	        .collect();
   791	    let timeout_ms = match notify
   792	        .get("timeout_ms")
   793	        .expect("hints.json: notify.timeout_ms")
   794	    {
   795	        Json::Num(value) => *value as i32,
   796	        other => panic!("timeout_ms: {other:?}"),
   797	    };
   798	
   799	    vec![
   800	        Value::String(text("app_name")),
   801	        Value::U32(0),                // replaces_id
   802	        Value::String(String::new()), // app_icon
   803	        Value::String(text("summary")),
   804	        Value::String(text("body")),
   805	        Value::Array(actions),
   806	        hints.to_dbus(),
   807	        Value::I32(timeout_ms),
   808	    ]
   809	}
