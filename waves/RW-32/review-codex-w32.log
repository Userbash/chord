   198	    /// пустой заголовок серверы обычно отбрасывают, и пользователь не увидит уведомление.
   199	    pub fn notify_with_hints(
   200	        &mut self,
   201	        notification: &Notification,
   202	        hints: &Hints,
   203	    ) -> Result<u32, DbusError> {
   204	        if notification.app_name.is_empty() {
   205	            return Err(DbusError::Protocol("empty app_name"));
   206	        }
   207	        if notification.summary.is_empty() {
   208	            return Err(DbusError::Protocol("empty summary"));
   209	        }
   210	
   211	        let mut actions = Vec::with_capacity(notification.actions.len() * 2);
   212	        for (action_id, label) in &notification.actions {
   213	            if action_id.is_empty() {
   214	                return Err(DbusError::Protocol("empty action id"));
   215	            }
   216	            actions.push(Value::String(action_id.clone()));
   217	            actions.push(Value::String(label.clone()));
   218	        }
   219	
   220	        let body = vec![
   221	            Value::String(notification.app_name.clone()),
   222	            Value::U32(notification.replaces_id),
   223	            Value::String(String::new()), // app_icon: иконки в этой карточке не рисуются
   224	            Value::String(notification.summary.clone()),
   225	            Value::String(notification.body.clone()),
   226	            Value::Array(actions),
   227	            hints.to_dbus(), // a{sv}: пустой Hints → 0 записей, не null
   228	            Value::I32(notification.timeout_ms),
   229	        ];
   230	
   231	        let reply = self.call("Notify", NOTIFY_SIGNATURE, &body)?;
   232	        match reply.into_iter().next() {
   233	            Some(Value::U32(id)) => Ok(id),
   234	            _ => Err(DbusError::Protocol("Notify reply is not a u32 id")),
   235	        }
   236	    }
   237	
   238	    /// `CloseNotification(u)`.
   239	    pub fn close(&mut self, id: u32) -> Result<(), DbusError> {
   240	        self.call("CloseNotification", "u", &[Value::U32(id)])?;
   241	        Ok(())
   242	    }
   243	
   244	    /// Подписка на `ActionInvoked` и `NotificationClosed`.
   245	    pub fn listen_actions(&mut self) -> Result<(), DbusError> {
   246	        for member in ["ActionInvoked", "NotificationClosed"] {
   247	            let rule = format!("type='signal',interface='{INTERFACE}',member='{member}'");
   248	            self.connection.add_match(&rule)?;
   249	        }
   250	        Ok(())
   251	    }
   252	
   253	    /// Следующее событие уведомления; чужие сигналы и сигналы с неожиданным телом
   254	    /// пропускаются (не ошибка).
   255	    pub fn next_event(&mut self) -> Result<NotificationEvent, DbusError> {
   256	        loop {
   257	            let signal = self.connection.next_signal(EVENT_TIMEOUT)?;
   258	            if signal.interface != INTERFACE {
   259	                continue;
   260	            }
   261	            let event = match signal.member.as_str() {
   262	                "ActionInvoked" => action_event(&signal.body),
   263	                "NotificationClosed" => closed_event(&signal.body),
   264	                _ => None,
   265	            };
   266	            if let Some(event) = event {
   267	                return Ok(event);
   268	            }
   269	        }
   270	    }
   271	
   272	    fn call(
   273	        &mut self,
   274	        member: &str,
   275	        signature: &str,
   276	        body: &[Value],
