   256	// --- вспомогательные функции теста ----------------------------------------------
   257	
   258	fn fixture_path(name: &str) -> PathBuf {
   259	    Path::new(env!("CARGO_MANIFEST_DIR"))
   260	        .join("../../../fixtures/dbus")
   261	        .join(name)
   262	}
   263	
   264	fn load_fixture(name: &str) -> Json {
   265	    let path = fixture_path(name);
   266	    let text = std::fs::read_to_string(&path)
   267	        .unwrap_or_else(|err| panic!("фикстура {}: {err}", path.display()));
   268	    Json::parse(&text).unwrap_or_else(|err| panic!("JSON {}: {err}", path.display()))
   269	}
   270	
   271	fn hex_decode(text: &str) -> Vec<u8> {
   272	    assert_eq!(text.len() % 2, 0, "нечётная hex-строка");
   273	    let mut out = Vec::with_capacity(text.len() / 2);
   274	    for chunk in text.as_bytes().chunks(2) {
   275	        let pair = std::str::from_utf8(chunk).expect("hex ascii");
   276	        out.push(u8::from_str_radix(pair, 16).expect("hex pair"));
   277	    }
   278	    out
   279	}
   280	
   281	fn hex_encode(bytes: &[u8]) -> String {
   282	    let mut out = String::with_capacity(bytes.len() * 2);
   283	    for byte in bytes {
   284	        out.push_str(&format!("{byte:02x}"));
   285	    }
   286	    out
   287	}
