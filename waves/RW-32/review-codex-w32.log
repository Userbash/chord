   641	            .find(|method| method.get("member").and_then(Json::as_str) == Some(name))
   642	            .unwrap_or_else(|| panic!("нет метода {name}"))
   643	    };
   644	
   645	    let notify = method("Notify");
   646	    assert_eq!(
   647	        notify.get("signature").and_then(Json::as_str),
   648	        Some(notifications::NOTIFY_SIGNATURE)
   649	    );
   650	    assert_eq!(
   651	        notify.get("reply_signature").and_then(Json::as_str),
   652	        Some("u")
   653	    );
   654	    assert_eq!(
   655	        method("GetCapabilities")
   656	            .get("reply_signature")
   657	            .and_then(Json::as_str),
   658	        Some("as")
   659	    );
   660	    assert_eq!(
   661	        method("GetServerInformation")
   662	            .get("reply_signature")
   663	            .and_then(Json::as_str),
   664	        Some("ssss")
   665	    );
   666	    assert_eq!(
   667	        method("CloseNotification")
   668	            .get("signature")
   669	            .and_then(Json::as_str),
   670	        Some("u")
   671	    );
   672	
   673	    // Отсутствие поддержки `actions`/`body` в golden нет: мок объявляет capabilities,
   674	    // и клиент обязан отдавать их без искажений.
   675	    let capabilities = method("GetCapabilities")
   676	        .get("reply")
   677	        .and_then(Json::as_arr)
   678	        .expect("GetCapabilities.reply");
   679	    let declared: Vec<&str> = capabilities.iter().filter_map(Json::as_str).collect();
   680	    for required in ["body", "actions", "persistence"] {
   681	        assert!(
   682	            declared.contains(&required),
   683	            "мок не объявил {required}: {declared:?}"
   684	        );
   685	    }
   686	
   687	    // Ответ того же вида, собранный нашим кодом, разбирается обратно без потерь.
   688	    let body = vec![Value::Array(
   689	        declared
   690	            .iter()
   691	            .map(|item| Value::String((*item).to_owned()))
   692	            .collect(),
   693	    )];
   694	    let reply = message::build(
   695	        MessageType::MethodReturn,
   696	        4,
   697	        &[
   698	            (FIELD_SIGNATURE, Value::String("as".to_owned())),
   699	            (FIELD_REPLY_SERIAL, Value::U32(0)),
   700	        ],
   701	        "as",
   702	        &body,
   703	    )
   704	    .expect("сборка MethodReturn");
   705	    let parsed = message::parse(&reply).expect("разбор MethodReturn");
   706	    assert_eq!(parsed.reply_serial(), Some(0));
   707	    assert_eq!(parsed.body, body);
   708	}
