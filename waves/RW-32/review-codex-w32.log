   387	#[test]
   388	fn n02b_external_auth_line_uses_hex_uid_from_proc_status() {
   389	    let output = Command::new("id").arg("-u").output().expect("id -u");
   390	    assert!(output.status.success(), "id -u завершился неуспешно");
   391	    let expected: u32 = String::from_utf8_lossy(&output.stdout)
   392	        .trim()
   393	        .parse()
   394	        .expect("uid из id -u");
   395	
   396	    assert_eq!(
   397	        auth::current_uid().expect("uid из /proc/self/status"),
   398	        expected
   399	    );
   400	    // Идентичность EXTERNAL — десятичная запись uid в hex (libdbus: 1000 → "31303030").
   401	    let decimal_hex: String = expected
   402	        .to_string()
   403	        .bytes()
   404	        .map(|byte| format!("{byte:02x}"))
   405	        .collect();
   406	    assert_eq!(
   407	        auth::external_auth_line(expected),
   408	        format!("AUTH EXTERNAL {decimal_hex}")
   409	    );
   410	    assert_eq!(auth::external_auth_line(1000), "AUTH EXTERNAL 31303030");
   411	    assert_eq!(auth::parse_uid("Name:\troot\nUid:\t0\t0\t0\t0\n"), Some(0));
   412	    assert_eq!(
   413	        auth::parse_uid("Uid:\t1000\t1000\t1000\t1000\n"),
   414	        Some(1000)
   415	    );
   416	    assert_eq!(auth::parse_uid("Name:\tx\n"), None);
   417	}
