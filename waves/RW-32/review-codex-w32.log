   229	/// Разбивает текст на слова с байтовыми смещениями. Не паникует на любом Unicode.
   230	///
   231	/// URL/e-mail определяются по непустому токену между пробелами: если он содержит `://`
   232	/// или `@`, токен пропускается целиком. Обратные кавычки, `<@…>`/`<#…>` и `:emoji:`
   233	/// пропускаются посимвольно, поэтому слова рядом с ними сохраняются.
   234	pub fn tokenize(text: &str) -> Vec<Token> {
   235	    let positions: Vec<(usize, char)> = text.char_indices().collect();
   236	    let mut tokens = Vec::new();
   237	    let mut index = 0;
   238	
   239	    while index < positions.len() {
   240	        let (start, character) = positions[index];
   241	
   242	        if character.is_whitespace() {
   243	            index += 1;
   244	            continue;
   245	        }
   246	
   247	        if character == '`' {
   248	            index += 1;
   249	            while index < positions.len() && positions[index].1 != '`' {
   250	                index += 1;
   251	            }
   252	            // Закрывающая кавычка (если есть) тоже пропускается.
   253	            if index < positions.len() {
   254	                index += 1;
   255	            }
   256	            continue;
   257	        }
   258	
   259	        if character == '<' && is_mention_start(&positions, index) {
   260	            index += 2;
   261	            while index < positions.len()
   262	                && positions[index].1 != '>'
   263	                && !positions[index].1.is_whitespace()
   264	            {
   265	                index += 1;
   266	            }
   267	            if index < positions.len() && positions[index].1 == '>' {
   268	                index += 1;
   269	            }
   270	            continue;
   271	        }
   272	
   273	        if character == ':'
   274	            && let Some(after) = emoji_end(&positions, index)
   275	        {
   276	            index = after;
   277	            continue;
   278	        }
   279	
   280	        if !character.is_alphabetic() {
   281	            index += 1;
   282	            continue;
   283	        }
   284	
   285	        let chunk_end = chunk_end(&positions, index);
   286	        let chunk_end_byte = byte_at(&positions, chunk_end, text);
   287	        let chunk = &text[start..chunk_end_byte];
   288	        if chunk.contains("://") || chunk.contains('@') {
   289	            index = chunk_end;
   290	            continue;
   291	        }
   292	
   293	        let mut cursor = index + 1;
   294	        while cursor < positions.len() {
   295	            let current = positions[cursor].1;
   296	            let next_is_letter = positions
   297	                .get(cursor + 1)
   298	                .is_some_and(|(_, next)| next.is_alphabetic());
   299	            let word_char =
   300	                current.is_alphabetic() || (current == '\'' || current == '-') && next_is_letter;
   301	            if word_char {
   302	                cursor += 1;
   303	            } else {
   304	                break;
   305	            }
   306	        }
   307	        let end = byte_at(&positions, cursor, text);
   308	        tokens.push(Token {
   309	            text: text[start..end].to_owned(),
   310	            start,
   311	            end,
   312	        });
   313	        index = cursor;
   314	    }
   315	
   316	    tokens
   317	}
   318	
   319	/// `<` + `@`/`#` — начало упоминания или канала.
   320	fn is_mention_start(positions: &[(usize, char)], index: usize) -> bool {
   321	    positions
   322	        .get(index + 1)
   323	        .is_some_and(|(_, next)| *next == '@' || *next == '#')
   324	}
   325	
   326	/// Конец whitespace-токена (индекс в `positions`, не байтовое смещение).
   327	fn chunk_end(positions: &[(usize, char)], start: usize) -> usize {
   328	    let mut end = start;
   329	    while end < positions.len() && !positions[end].1.is_whitespace() {
   330	        end += 1;
   331	    }
   332	    end
   333	}
   334	
   335	/// Байтовое смещение для индекса `positions`; за концом — длина текста.
   336	fn byte_at(positions: &[(usize, char)], index: usize, text: &str) -> usize {
   337	    positions.get(index).map_or(text.len(), |(byte, _)| *byte)
   338	}
   339	
   340	/// `:shortcode:` → индекс сразу после закрывающего `:`; `None`, если это не emoji.
   341	fn emoji_end(positions: &[(usize, char)], start: usize) -> Option<usize> {
   342	    let mut index = start + 1;
   343	    let mut length = 0;
   344	    while index < positions.len() {
   345	        let character = positions[index].1;
   346	        if character == ':' {
   347	            return (length >= 2).then_some(index + 1);
   348	        }
   349	        let valid = character.is_ascii_alphanumeric()
   350	            || character == '_'
   351	            || character == '+'
   352	            || character == '-';
   353	        if !valid {
   354	            return None;
   355	        }
   356	        length += 1;
   357	        index += 1;
   358	    }
   359	    None
   360	}

