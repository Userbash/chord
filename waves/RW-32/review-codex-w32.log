   146	/// UTF-8 путь без NUL. NUL — отдельная ошибка, а не молчаливое обрезание.
   147	fn path_text(path: &Path) -> Result<&str, SpellError> {
   148	    let text = path.to_str().ok_or_else(|| SpellError::InvalidPath {
   149	        path: path.display().to_string(),
   150	    })?;
   151	    if text.contains('\0') {
   152	        return Err(SpellError::Nul {
   153	            path: path.display().to_string(),
   154	        });
   155	    }
   156	    Ok(text)
   157	}
   158	
   159	/// `.aff` должен существовать, быть обычным непустым файлом.
   160	fn validate_aff(path: &Path) -> Result<(), SpellError> {
   161	    let metadata = std::fs::metadata(path).map_err(|error| missing(path, &error))?;
   162	    if !metadata.is_file() {
   163	        return Err(SpellError::Missing {
   164	            path: path.display().to_string(),
   165	            reason: "не обычный файл".to_owned(),
   166	        });
   167	    }
   168	    if metadata.len() == 0 {
   169	        return Err(SpellError::InvalidDictionary {
   170	            path: path.display().to_string(),
   171	            reason: "aff-файл пуст".to_owned(),
   172	        });
   173	    }
   174	    Ok(())
   175	}
   176	
   177	/// `.dic` должен существовать, быть обычным файлом с положительным числом в заголовке.
   178	fn validate_dic(path: &Path) -> Result<(), SpellError> {
   179	    let metadata = std::fs::metadata(path).map_err(|error| missing(path, &error))?;
   180	    if !metadata.is_file() {
   181	        return Err(SpellError::Missing {
   182	            path: path.display().to_string(),
   183	            reason: "не обычный файл".to_owned(),
   184	        });
   185	    }
   186	    if metadata.len() == 0 {
   187	        return Err(SpellError::InvalidDictionary {
   188	            path: path.display().to_string(),
   189	            reason: "dic-файл пуст".to_owned(),
   190	        });
   191	    }
   192	    let file = File::open(path).map_err(|error| missing(path, &error))?;
   193	    let mut header = String::new();
   194	    let read = BufReader::new(file)
   195	        .read_line(&mut header)
   196	        .map_err(|error| SpellError::InvalidDictionary {
   197	            path: path.display().to_string(),
   198	            reason: format!("заголовок не читается как UTF-8/ASCII: {error}"),
   199	        })?;
   200	    if read == 0 {
   201	        return Err(SpellError::InvalidDictionary {
   202	            path: path.display().to_string(),
   203	            reason: "dic-файл пуст".to_owned(),
   204	        });
   205	    }
   206	    let header = header.trim_start_matches('\u{feff}').trim();
   207	    let count = header
   208	        .parse::<usize>()
   209	        .map_err(|_| SpellError::InvalidDictionary {
   210	            path: path.display().to_string(),
   211	            reason: format!("заголовок dic не число: {header:?}"),
   212	        })?;
   213	    if count == 0 {
   214	        return Err(SpellError::InvalidDictionary {
   215	            path: path.display().to_string(),
   216	            reason: "заголовок dic: 0 слов".to_owned(),
   217	        });
   218	    }
   219	    Ok(())
   220	}
   221	
   222	fn missing(path: &Path, error: &std::io::Error) -> SpellError {
   223	    SpellError::Missing {
   224	        path: path.display().to_string(),
   225	        reason: error.to_string(),
   226	    }
   227	}
