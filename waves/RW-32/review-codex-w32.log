    69	#[derive(Debug, Clone, Default, PartialEq, Eq)]
    70	pub struct Hints {
    71	    /// `urgency` (вариант `y`).
    72	    pub urgency: Option<Urgency>,
    73	    /// `category` (вариант `s`); пустая строка не отправляется.
    74	    pub category: Option<String>,
    75	    /// `desktop-entry` (вариант `s`); пустая строка не отправляется.
