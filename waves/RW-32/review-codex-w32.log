   113	            aff: aff.display().to_string(),
   114	            dic: dic.display().to_string(),
   115	            reason: error.to_string(),
   116	        })?;
   117	        Ok(Self {
   118	            handle,
   119	            aff: aff.to_path_buf(),
   120	            dic: dic.to_path_buf(),
   121	            _not_send_sync: PhantomData,
   122	        })
   123	    }
