   494	#[test]
   495	fn n05_parse_recovers_header_fields_and_body() {
   496	    let call = message::parse(&golden_message("notify_call")).expect("notify_call");
   497	    assert_eq!(call.kind, MessageType::MethodCall);
   498	    assert_eq!(call.serial, 7);
   499	    assert_eq!(call.path(), Some("/org/freedesktop/Notifications"));
   500	    assert_eq!(call.interface(), Some("org.freedesktop.Notifications"));
   501	    assert_eq!(call.member(), Some("Notify"));
   502	    assert_eq!(call.destination(), Some("org.freedesktop.Notifications"));
   503	    assert_eq!(call.signature, "susssasa{sv}i");
   504	    assert_eq!(call.reply_serial(), None);
   505	    assert_eq!(call.error_name(), None);
   506	    assert_eq!(
   507	        call.body,
   508	        vec![
   509	            Value::String("Discord Lab".to_owned()),
   510	            Value::U32(0),
   511	            Value::String(String::new()),
   512	            Value::String("Alice".to_owned()),
   513	            Value::String("hello".to_owned()),
   514	            Value::Array(vec![
   515	                Value::String("open".to_owned()),
   516	                Value::String("Open".to_owned()),
   517	            ]),
   518	            Value::Dict(Vec::new()),
   519	            Value::I32(-1),
   520	        ]
   521	    );
   522	
   523	    let signal = message::parse(&golden_message("action_invoked_signal")).expect("signal");
   524	    assert_eq!(signal.kind, MessageType::Signal);
   525	    assert_eq!(signal.serial, 3);
   526	    assert_eq!(signal.path(), Some("/org/freedesktop/Notifications"));
   527	    assert_eq!(signal.interface(), Some("org.freedesktop.Notifications"));
   528	    assert_eq!(signal.member(), Some("ActionInvoked"));
   529	    // Тело сигнала `ActionInvoked` — `us`: два значения подряд, без struct-обёртки.
   530	    assert_eq!(signal.signature, "us");
   531	    assert_eq!(
   532	        signal.body,
   533	        vec![Value::U32(100), Value::String("open".to_owned()),]
   534	    );
   535	
   536	    let reply = message::parse(&golden_message("capabilities_reply")).expect("reply");
   537	    assert_eq!(reply.kind, MessageType::MethodReturn);
   538	    assert_eq!(reply.reply_serial(), Some(7));
   539	    assert_eq!(reply.signature, "as");
   540	    assert_eq!(
   541	        reply.body,
   542	        vec![Value::Array(vec![
   543	            Value::String("body".to_owned()),
   544	            Value::String("actions".to_owned()),
   545	            Value::String("persistence".to_owned()),
   546	            Value::String("icon-static".to_owned()),
   547	        ])]
   548	    );
   549	
   550	    let error = message::parse(&golden_message("error_reply")).expect("error");
   551	    assert_eq!(error.kind, MessageType::Error);
   552	    assert_eq!(error.reply_serial(), Some(7));
   553	    assert_eq!(
   554	        error.error_name(),
   555	        Some("org.freedesktop.Notifications.Error.MockRejected")
   556	    );
   557	    assert_eq!(
   558	        error.body,
   559	        vec![Value::String("mock rejected notification".to_owned())]
   560	    );
   561	
   562	    // Поле SIGNATURE разбирается как тип `g`, а не как обычная строка.
   563	    assert_eq!(
   564	        call.field(FIELD_SIGNATURE),
   565	        Some(&Value::String("susssasa{sv}i".to_owned()))
   566	    );
   567	    assert_eq!(golden_attr("notify_call", "signature"), call.signature);
   568	}
