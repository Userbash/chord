## HttpRequest Debug exposes headers
/// Запрос: метод, target (путь с query), поля и тело.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct HttpRequest {
    /// HTTP-метод.
    pub method: HttpMethod,
    /// Путь относительно базы (`/users/@me`) или с query.
    pub target: String,
    /// Поля в порядке отправки.
    pub headers: Vec<(String, String)>,
    /// Тело запроса (пусто — тела нет).
    pub body: Vec<u8>,
}


## ApiAuth default = empty strings
/// Шесть auth-заголовков в owned-виде (значения живут в клиенте).
#[derive(Clone, Default, PartialEq, Eq)]
pub struct ApiAuth {
impl Default for ApiConfig {
    fn default() -> Self {
        Self {
            base: API_V9_BASE.to_string(),
            auth: ApiAuth::default(),
            http: HttpClientConfig::default(),
            retry: ApiRetryPolicy::default(),
        }
    }
}
