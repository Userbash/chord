   115	/// Hash an internal message id and return the first six base64 characters of its LE digest.
   116	#[must_use]
   117	pub fn message_key(id: &str) -> String {
   118	    const B64: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
   119	    let bytes = xxh64(id.as_bytes(), 0).to_le_bytes();
   120	    let mut out = String::with_capacity(8);
   121	    for chunk in bytes.chunks(3) {
   122	        let n = (u32::from(chunk[0]) << 16)
   123	            | (u32::from(*chunk.get(1).unwrap_or(&0)) << 8)
   124	            | u32::from(*chunk.get(2).unwrap_or(&0));
   125	        out.push(B64[((n >> 18) & 63) as usize] as char);
   126	        out.push(B64[((n >> 12) & 63) as usize] as char);
   127	        if chunk.len() > 1 {
   128	            out.push(B64[((n >> 6) & 63) as usize] as char);
   129	        }
   130	        if chunk.len() > 2 {
   131	            out.push(B64[(n & 63) as usize] as char);
   132	        }
   133	    }
   134	    out.truncate(MESSAGE_KEY_LEN);
   135	    out
   136	}
