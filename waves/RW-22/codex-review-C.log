   630	
   631	impl VoiceServerUpdate {
   632	    pub fn parse(input: &str) -> Result<Self, VoiceError> {
   633	        let root = discord_json::parse(input)
   634	            .map_err(|_| VoiceError::invalid("invalid voice server JSON"))?;
   635	        let data = root.get("d").unwrap_or(&root);
   636	        let update = Self {
   637	            token: nonempty_string(data, "token")?,
   638	            guild_id: nonempty_string(data, "guild_id")?,
   639	            endpoint: nonempty_string(data, "endpoint")?,
   640	        };
   641	        update.validate_endpoint()?;
   642	        Ok(update)
   643	    }
   644	
   645	    pub fn websocket_url(&self) -> Result<String, VoiceError> {
   646	        self.validate_endpoint()?;
   647	        let host = self
   648	            .endpoint
   649	            .strip_prefix("wss://")
   650	            .unwrap_or(&self.endpoint);
   651	        let host = host
   652	            .strip_suffix("/?v=9")
   653	            .unwrap_or(host)
   654	            .trim_end_matches('/');
   655	        Ok(format!("wss://{host}/?v=9"))
   656	    }
   657	
   658	    fn validate_endpoint(&self) -> Result<(), VoiceError> {
   659	        let endpoint = &self.endpoint;
   660	        if endpoint.chars().any(char::is_whitespace) || endpoint.chars().any(char::is_control) {
   661	            return Err(VoiceError::invalid("invalid voice endpoint"));
   662	        }
   663	        let host = if let Some(host) = endpoint.strip_prefix("wss://") {
   664	            host.strip_suffix("/?v=9")
   665	                .unwrap_or(host)
   666	                .trim_end_matches('/')
   667	        } else {
   668	            if endpoint.contains("://") {
   669	                return Err(VoiceError::invalid("unsupported voice endpoint scheme"));
   670	            }
   671	            endpoint
   672	        };
   673	        if host.is_empty()
   674	            || host.contains(['/', '@', '?', '#'])
   675	            || host.starts_with(':')
   676	            || host.ends_with(':')
   677	        {
   678	            return Err(VoiceError::invalid("invalid voice endpoint host"));
   679	        }
   680	        Ok(())
   681	    }
   682	}
