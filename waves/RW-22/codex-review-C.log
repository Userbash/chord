   112	/// Builds a relative route path, validating the sole supported path parameter.
   113	pub fn path(kind: ResourceKind, application_id: Option<&str>) -> Result<String, ResourceError> {
   114	    let entry = resource(kind);
   115	    let parts = match (kind, application_id) {
   116	        (ResourceKind::ApplicationEntitlements, None) => return Err(ResourceError::MissingId),
   117	        (ResourceKind::ApplicationEntitlements, Some(id)) => {
   118	            if id.is_empty() || id.len() > 20 || !id.bytes().all(|byte| byte.is_ascii_digit()) {
   119	                return Err(ResourceError::InvalidId);
   120	            }
   121	            vec![id]
   122	        }
   123	        (_, Some(_)) => return Err(ResourceError::UnexpectedId),
   124	        (_, None) => Vec::new(),
   125	    };
   126	
   127	    let route =
   128	        routes::find(HttpMethod::Get, entry.path_template).ok_or(ResourceError::RouteNotFound)?;
   129	    routes::render_path(route, &parts).map_err(|_| ResourceError::RouteRender)
   130	}
