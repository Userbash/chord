    33	#[test]
    34	fn catalog_matches_d02_and_get_routes() {
    35	    assert_eq!(RESOURCES.len(), EXPECTED.len());
    36	    for (kind, template, statuses) in EXPECTED {
    37	        let record = resource(kind);
    38	        assert_eq!(record.kind, kind);
