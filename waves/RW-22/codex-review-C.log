   945	    #[test]
   946	    fn markdown_is_safe_and_handles_unclosed_markers() {
   947	        use super::{parse_markdown, render_markdown};
   948	        for (src, expected) in [
   949	            ("**bold**", "**bold**"),
   950	            ("*em*", "*em*"),
   951	            ("__u__", "__u__"),
   952	            ("~~x~~", "~~x~~"),
   953	            ("||s||", "||s||"),
   954	            ("`c`", "`c`"),
   955	            ("[x](https://a.test)", "[x](https://a.test)"),
   956	            (r#"\*"#, "*"),
   957	        ] {
   958	            assert_eq!(render_markdown(&parse_markdown(src)), expected);
   959	        }
   960	        assert_eq!(
   961	            render_markdown(&parse_markdown("[x](javascript:alert(1))")),
   962	            "x"
   963	        );
   964	        assert_eq!(
   965	            render_markdown(&parse_markdown(
   966	                "[x](https://safe.test) [y](javascript:alert(1))"
   967	            )),
   968	            "[x](https://safe.test) y"
   969	        );
   970	        for input in ["```\n", "```", "```\nbody", "```rs\n"] {
   971	            let _ = parse_markdown(input);
   972	        }
   973	        assert_eq!(
