    99	pub fn resource(kind: ResourceKind) -> &'static ReadOnlyResource {
   100	    match kind {
   101	        ResourceKind::Quest => &RESOURCES[0],
   102	        ResourceKind::QuestDecision => &RESOURCES[1],
   103	        ResourceKind::QuestGetDecisions => &RESOURCES[2],
   104	        ResourceKind::Promotion => &RESOURCES[3],
