   789	          "bold":[8,"$b",[[0,"ok"]]], "select":[5,"x",{"a":[0,"A"],"other":[0,"?"]}],
   790	          "exact0":[6,"n",{"=0":[[0,"ноль"]],"other":[[0,"другое"]]},0,"cardinal"],
   791	          "offset":[6,"n",{"one":[[7],[0," one"]],"other":[[7],[0," other"]]},2,"cardinal"],
   792	          "en_plural":[6,"n",{"one":[[0,"one"]],"other":[[0,"other"]]},0,"cardinal"]
   793	        }"#).unwrap();
   794	        let cat = Catalog::parse(&json).unwrap();
   795	        assert_eq!(cat.len(), 7);
   796	        assert!(cat.get("hello").is_some());
   797	        let mut i = I18n::new("en-US");
   798	        i.insert_catalog("ru", cat).unwrap();
   799	        i.set_locale("ru").unwrap();
   800	        let args = BTreeMap::from([("name".into(), Value::Str("Мир".into()))]);
   801	        assert_eq!(i.translate("hello", &args).unwrap(), "Привет Мир");
   802	        assert!(matches!(
   803	            i.translate("missing", &args),
   804	            Err(super::TranslateError::MissingMessage { .. })
   805	        ));
   806	        assert!(matches!(
   807	            i.translate("hello", &BTreeMap::new()),
   808	            Err(super::TranslateError::MissingArgument { .. })
   809	        ));
   810	        for (n, expected) in [
   811	            (1, "1 игра"),
   812	            (2, "2 игры"),
   813	            (5, "5 игр"),
   814	            (11, "11 игр"),
   815	            (21, "21 игра"),
   816	            (22, "22 игры"),
   817	            (101, "101 игра"),
   818	        ] {
   819	            assert_eq!(
   820	                i.translate("count", &BTreeMap::from([("n".into(), Value::Int(n))]))
   821	                    .unwrap(),
   822	                expected
   823	            );
   824	        }
   825	        let exact_args = |n| BTreeMap::from([("n".into(), Value::Int(n))]);
   826	        assert_eq!(i.translate("exact0", &exact_args(0)).unwrap(), "ноль");
   827	        assert_eq!(i.translate("exact0", &exact_args(1)).unwrap(), "другое");
   828	        assert_eq!(i.translate("offset", &exact_args(3)).unwrap(), "1 one");
   829	        assert_eq!(i.translate("offset", &exact_args(2)).unwrap(), "0 other");
   830	        assert_eq!(i.translate("offset", &exact_args(4)).unwrap(), "2 other");
   831	
   832	        let en_json = discord_json::parse(
   833	            r#"{"p":[6,"n",{"one":[[0,"one"]],"other":[[0,"other"]]},0,"cardinal"]}"#,
   834	        )
   835	        .unwrap();
   836	        let mut en = I18n::new("en-US");
   837	        en.insert_catalog("en-US", Catalog::parse(&en_json).unwrap())
   838	            .unwrap();
   839	        assert_eq!(
   840	            en.translate("p", &BTreeMap::from([("n".into(), Value::Int(1))]))
   841	                .unwrap(),
   842	            "one"
   843	        );
   844	        assert_eq!(
   845	            en.translate("p", &BTreeMap::from([("n".into(), Value::Int(2))]))
   846	                .unwrap(),
   847	            "other"
   848	        );
   849	
   850	        assert_eq!(i.translate("bold", &BTreeMap::new()).unwrap(), "**ok**");
   851	        for (tag, expected) in [
   852	            ("$i", "*ok*"),
   853	            ("$del", "~~ok~~"),
   854	            ("$code", "`ok`"),
   855	            ("$p", "ok\n\n"),
   856	            ("$link", "ok"),
