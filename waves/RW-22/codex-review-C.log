   138	/// Resolve requested language against enabled available locales.
   139	#[must_use]
   140	pub fn resolve_locale(requested: &str, available: &[&str]) -> String {
   141	    let enabled = |s: &&str| !DISABLED_LOCALES.iter().any(|d| d.eq_ignore_ascii_case(s));
   142	    let available: Vec<&str> = available.iter().copied().filter(enabled).collect();
   143	    let find = |name: &str| available.iter().find(|s| **s == name).copied();
   144	    if !requested.is_empty() {
   145	        if let Some(v) = find(requested) {
   146	            return v.into();
   147	        }
   148	        if let Some(v) = available.iter().find(|s| s.eq_ignore_ascii_case(requested)) {
   149	            return (*v).into();
   150	        }
   151	        if let Some(lang) = requested.split('-').next() {
   152	            let found = available.iter().find(|s| s.eq_ignore_ascii_case(lang));
   153	            if let Some(v) = found {
   154	                return (*v).into();
   155	            }
   156	        }
   157	    }
   158	    find(DEFAULT_LOCALE).unwrap_or(DEFAULT_LOCALE).into()
   159	}
