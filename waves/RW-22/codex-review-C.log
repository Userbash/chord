   331	/// Parsed RTC signaling frame.
   332	#[derive(Debug, Clone, PartialEq)]
   333	pub struct VoiceFrame {
   334	    pub op: VoiceOp,
   335	    pub payload: VoicePayload,
   336	    pub seq: Option<u64>,
   337	}
   338	
   339	/// Parse an internal RTC payload of the form `{ "op": ..., "d": ... }`.
   340	pub fn parse_frame(input: &str) -> Result<VoiceFrame, VoiceError> {
   341	    let root = discord_json::parse(input).map_err(|_| VoiceError::invalid("invalid voice JSON"))?;
   342	    let raw_op = required_u64(&root, "op")?
   343	        .try_into()
   344	        .map_err(|_| VoiceError::invalid("invalid voice op"))?;
   345	    let op = VoiceOp::from_u8(raw_op);
   346	    let data = root
   347	        .get("d")
   348	        .ok_or_else(|| VoiceError::invalid("missing voice payload"))?;
   349	    let seq = optional_u64(&root, "seq")?;
   350	    let payload = match op {
   351	        VoiceOp::Hello => VoicePayload::Hello(Hello {
   352	            version: required_u64(data, "v")?
   353	                .try_into()
   354	                .map_err(|_| VoiceError::invalid("invalid Hello version"))?,
   355	            heartbeat_interval_ms: required_u64(data, "heartbeat_interval")?,
   356	        }),
   357	        VoiceOp::Identify => VoicePayload::Identify(parse_identify(data)?),
   358	        VoiceOp::SelectProtocol => VoicePayload::SelectProtocol(parse_select_protocol(data)?),
   359	        VoiceOp::Ready => VoicePayload::Ready(parse_ready(data)?),
   360	        VoiceOp::SessionDescription => {
   361	            VoicePayload::SessionDescription(parse_session_description(data)?)
   362	        }
   363	        other => VoicePayload::Other {
   364	            op: other,
   365	            raw: data.clone(),
   366	        },
   367	    };
   368	    Ok(VoiceFrame { op, payload, seq })
   369	}
   370	
   371	fn parse_identify(data: &JsonValue) -> Result<Identify, VoiceError> {
   372	    let max_dave_protocol_version = required_u64(data, "max_dave_protocol_version")?
   373	        .try_into()
   374	        .map_err(|_| VoiceError::invalid("invalid DAVE version"))?;
   375	    let video = required_bool(data, "video")?;
   376	    if max_dave_protocol_version != 1 || !video {
   377	        return Err(VoiceError::invalid("unsupported Identify parameters"));
   378	    }
   379	    Ok(Identify {
   380	        server_id: nonempty_string(data, "server_id")?,
   381	        channel_id: nonempty_string(data, "channel_id")?,
   382	        user_id: nonempty_string(data, "user_id")?,
   383	        session_id: nonempty_string(data, "session_id")?,
   384	        token: nonempty_string(data, "token")?,
   385	        max_dave_protocol_version,
   386	        video,
   387	        streams: parse_streams(data.get("streams"))?,
   388	    })
   389	}
   390	
   391	fn parse_select_protocol(data: &JsonValue) -> Result<SelectProtocol, VoiceError> {
   392	    let protocol = nonempty_string(data, "protocol")?;
   393	    let nested = data
   394	        .get("data")
   395	        .ok_or_else(|| VoiceError::invalid("missing protocol data"))?;
   396	    let codecs_value = data
   397	        .get("codecs")
   398	        .and_then(JsonValue::as_array)
   399	        .ok_or_else(|| VoiceError::invalid("missing codecs"))?;
   400	    let codecs = codecs_value
   401	        .iter()
   402	        .map(|codec| {
   403	            Ok(Codec {
   404	                name: nonempty_string(codec, "name")?,
   405	                kind: nonempty_string(codec, "type")?,
   406	                priority: required_u64(codec, "priority")?,
   407	                payload_type: required_u64(codec, "payload_type")?
   408	                    .try_into()
   409	                    .map_err(|_| VoiceError::invalid("invalid codec payload type"))?,
   410	            })
   411	        })
   412	        .collect::<Result<Vec<_>, VoiceError>>()?;
   413	    if !codecs
   414	        .iter()
