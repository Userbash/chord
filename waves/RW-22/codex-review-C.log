    95	echo "ci: OK"
     1	#!/usr/bin/env bash
     2	# P8-03: release-артефакт без публикации.
     3	#
     4	# Кладёт бинарь и SHA256SUMS в rust/dist/. Сеть не нужна; по умолчанию cargo --offline.
     5	set -euo pipefail
     6	
     7	ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
     8	RUST_DIR="$ROOT/rust"
     9	DIST="$RUST_DIR/dist"
    10	OFFLINE=(--offline)
    11	DRY_RUN=0
    12	
    13	usage() {
    14	    cat <<'EOF'
    15	Использование: scripts/release.sh [--dry-run] [--online] [--output DIR]
    16	  --dry-run    напечатать план, не собирать и не создавать файлы
    17	  --online     не добавлять --offline к cargo build (CI-раннер)
    18	  --output DIR каталог артефакта (по умолчанию rust/dist)
    19	EOF
    20	}
    21	
    22	while [[ "$#" -gt 0 ]]; do
    23	    case "$1" in
    24	        --dry-run) DRY_RUN=1; shift ;;
    25	        --online) OFFLINE=(); shift ;;
    26	        --output)
    27	            [[ "$#" -ge 2 ]] || { echo "release: --output требует путь" >&2; exit 1; }
    28	            DIST="$2"; shift 2 ;;
    29	        -h|--help) usage; exit 0 ;;
    30	        *) echo "release: неизвестный аргумент: $1" >&2; usage >&2; exit 1 ;;
    31	    esac
    32	done
    33	
    34	BIN="$RUST_DIR/target/release/discord-rs"
    35	
    36	if [[ "$DRY_RUN" == 1 ]]; then
    37	    echo "release: dry-run (сеть, cargo и запись файлов не выполняются)"
    38	    printf '+ cargo build %s--release -p discord-app --manifest-path %s\n' \
    39	        "${OFFLINE[*]:+${OFFLINE[*]} }" "$RUST_DIR/Cargo.toml"
    40	    echo "+ install -m 0755 $BIN $DIST/discord-rs"
    41	    echo "+ sha256sum $DIST/discord-rs > $DIST/SHA256SUMS"
    42	    exit 0
    43	fi
    44	
    45	mkdir -p "$DIST"
    46	printf 'release: cargo build %s--release -p discord-app\n' "${OFFLINE[*]:+${OFFLINE[*]} }"
    47	cargo build "${OFFLINE[@]}" --release -p discord-app --manifest-path "$RUST_DIR/Cargo.toml"
    48	
    49	if [[ ! -x "$BIN" ]]; then
    50	    echo "release: не найден бинарь $BIN" >&2
    51	    exit 1
    52	fi
    53	install -m 0755 "$BIN" "$DIST/discord-rs"
    54	(cd "$DIST" && sha256sum discord-rs > SHA256SUMS)
    55	echo "release: артефакт $DIST/discord-rs"
    56	echo "release: checksum $DIST/SHA256SUMS"

