    31	/// xxHash64, seedable and implemented without unsafe code.
    32	#[must_use]
    33	pub fn xxh64(input: &[u8], seed: u64) -> u64 {
    34	    const P1: u64 = 11_400_714_785_074_694_791;
    35	    const P2: u64 = 14_029_467_366_897_019_727;
    36	    const P3: u64 = 1_609_587_929_392_839_161;
    37	    const P4: u64 = 9_650_029_242_287_828_579;
    38	    const P5: u64 = 2_870_177_450_012_600_261;
    39	    fn round(acc: u64, lane: u64) -> u64 {
    40	        acc.wrapping_add(lane.wrapping_mul(P2))
    41	            .rotate_left(31)
    42	            .wrapping_mul(P1)
    43	    }
    44	    fn merge(acc: u64, val: u64) -> u64 {
    45	        (acc ^ round(0, val)).wrapping_mul(P1).wrapping_add(P4)
    46	    }
    47	    let mut i = 0;
    48	    let mut h;
    49	    if input.len() >= 32 {
    50	        let (mut v1, mut v2, mut v3, mut v4) = (
    51	            seed.wrapping_add(P1).wrapping_add(P2),
    52	            seed.wrapping_add(P2),
    53	            seed,
    54	            seed.wrapping_sub(P1),
    55	        );
    56	        while i + 32 <= input.len() {
    57	            v1 = round(
    58	                v1,
    59	                u64::from_le_bytes(input[i..i + 8].try_into().expect("8 bytes")),
    60	            );
    61	            v2 = round(
    62	                v2,
    63	                u64::from_le_bytes(input[i + 8..i + 16].try_into().expect("8 bytes")),
    64	            );
    65	            v3 = round(
    66	                v3,
    67	                u64::from_le_bytes(input[i + 16..i + 24].try_into().expect("8 bytes")),
    68	            );
    69	            v4 = round(
    70	                v4,
    71	                u64::from_le_bytes(input[i + 24..i + 32].try_into().expect("8 bytes")),
    72	            );
    73	            i += 32;
    74	        }
    75	        h = v1
    76	            .rotate_left(1)
    77	            .wrapping_add(v2.rotate_left(7))
    78	            .wrapping_add(v3.rotate_left(12))
    79	            .wrapping_add(v4.rotate_left(18));
    80	        h = merge(merge(merge(merge(h, v1), v2), v3), v4);
    81	    } else {
    82	        h = seed.wrapping_add(P5);
    83	    }
    84	    h = h.wrapping_add(input.len() as u64);
    85	    while i + 8 <= input.len() {
    86	        let k = round(
    87	            0,
    88	            u64::from_le_bytes(input[i..i + 8].try_into().expect("8 bytes")),
    89	        );
    90	        h = (h ^ k).rotate_left(27).wrapping_mul(P1).wrapping_add(P4);
    91	        i += 8;
    92	    }
    93	    if i + 4 <= input.len() {
    94	        h = (h ^ u64::from(u32::from_le_bytes(
    95	            input[i..i + 4].try_into().expect("4 bytes"),
    96	        ))
    97	        .wrapping_mul(P1))
    98	        .rotate_left(23)
    99	        .wrapping_mul(P2)
   100	        .wrapping_add(P3);
   101	        i += 4;
   102	    }
   103	    for b in &input[i..] {
   104	        h = (h ^ u64::from(*b).wrapping_mul(P5))
   105	            .rotate_left(11)
   106	            .wrapping_mul(P1);
   107	    }
   108	    h ^= h >> 33;
   109	    h = h.wrapping_mul(P2);
   110	    h ^= h >> 29;
   111	    h = h.wrapping_mul(P3);
   112	    h ^ (h >> 32)
   113	}
