   620	
   621	impl fmt::Debug for VoiceServerUpdate {
   622	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   623	        f.debug_struct("VoiceServerUpdate")
   624	            .field("token", &"<redacted>")
   625	            .field("guild_id", &"<redacted>")
   626	            .field("endpoint", &self.endpoint)
   627	            .finish()
   628	    }
