     1	#!/usr/bin/env bash
     2	# T-HARN-06 / P8-03: локальный CI-контракт.
     3	#
     4	# По умолчанию работает офлайн (репозиторий уже собран, сеть не нужна) и не публикует
     5	# артефакты. `--online` разрешает cargo-сеть только для CI-раннера; `--dry-run` печатает
     6	# план, ничего не запуская; `--skip-release` оставляет сборку бинарника отдельной джобе.
     7	set -euo pipefail
     8	
     9	ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    10	RUST_DIR="$ROOT/rust"
    11	OFFLINE=(--offline)
    12	DRY_RUN=0
    13	SKIP_RELEASE=0
    14	
    15	usage() {
    16	    cat <<'EOF'
    17	Использование: scripts/ci.sh [--dry-run] [--online] [--skip-release]
    18	  --dry-run       напечатать план и выйти (cargo/сеть не запускаются)
    19	  --online        не добавлять --offline к cargo-командам (только для CI-раннера)
    20	  --skip-release  не собирать release-артефакт в этой джобе
    21	EOF
    22	}
    23	
    24	for arg in "$@"; do
    25	    case "$arg" in
    26	        --dry-run) DRY_RUN=1 ;;
    27	        --online) OFFLINE=() ;;
    28	        --skip-release) SKIP_RELEASE=1 ;;
    29	        -h|--help) usage; exit 0 ;;
    30	        *) echo "ci: неизвестный аргумент: $arg" >&2; usage >&2; exit 1 ;;
    31	    esac
    32	done
    33	
    34	run() {
    35	    if [[ "$DRY_RUN" == 1 ]]; then
    36	        printf '+ %s\n' "$*"
    37	    else
    38	        printf 'ci: %s\n' "$*"
    39	        "$@"
    40	    fi
    41	}
    42	
    43	cargo_run() {
    44	    local subcommand="$1"
    45	    shift
    46	    if [[ "$DRY_RUN" == 1 ]]; then
    47	        printf '+ cargo %s %s %s\n' "$subcommand" "${OFFLINE[*]}" "$*"
    48	    else
    49	        printf 'ci: cargo %s %s %s\n' "$subcommand" "${OFFLINE[*]}" "$*"
    50	        cargo "$subcommand" "${OFFLINE[@]}" "$@"
    51	    fi
    52	}
    53	
    54	if [[ "$DRY_RUN" == 1 ]]; then
    55	    echo "ci: dry-run (сеть и cargo не запускаются)"
    56	fi
    57	
    58	# 1. Форматирование
    59	run cargo fmt --manifest-path "$RUST_DIR/Cargo.toml" --all -- --check
    60	
    61	# 2. Линты: warnings — ошибки, все targets/features
    62	cargo_run clippy --manifest-path "$RUST_DIR/Cargo.toml" \
    63	    --workspace --all-targets --all-features -- -D warnings
    64	
    65	# 3. Тесты workspace
    66	cargo_run test --manifest-path "$RUST_DIR/Cargo.toml" --workspace
    67	
    68	# 4. Микробенчмарк ETF (T-HARN-04 — отдельная карточка, здесь smoke производительности)
    69	cargo_run run --manifest-path "$RUST_DIR/Cargo.toml" \
    70	    --release -p discord-codec --example etf_bench -- --iterations 2000
    71	
    72	# 5. cargo-deny: если инструмент не установлен, это явный skip, а не молчаливый успех.
    73	if [[ "$DRY_RUN" == 1 ]]; then
    74	    echo '+ cargo deny check (cwd=rust, если cargo-deny установлен; иначе SKIP)'
    75	elif command -v cargo-deny >/dev/null 2>&1; then
    76	    echo "ci: cargo deny check (cwd=rust)"
    77	    (cd "$RUST_DIR" && cargo deny check)
    78	else
    79	    echo "ci: SKIP cargo-deny: инструмент не установлен (P8-04/SBOM остаётся отдельной карточкой)" >&2
    80	fi
    81	
    82	# 6. Release-артефакт: сборка + sha256, без публикации.
    83	if [[ "$SKIP_RELEASE" == 1 ]]; then
    84	    echo "ci: SKIP release artifact (--skip-release)"
    85	elif [[ "$DRY_RUN" == 1 ]]; then
    86	    echo '+ bash scripts/release.sh --dry-run'
    87	else
    88	    release_args=()
    89	    if [[ "${#OFFLINE[@]}" == 0 ]]; then
    90	        release_args+=(--online)
    91	    fi
    92	    bash "$ROOT/scripts/release.sh" "${release_args[@]}"
    93	fi
    94	
    95	echo "ci: OK"

