   294	/// Parsed payload for a voice signaling frame.
   295	///
   296	/// `Other` хранит исходный payload для диагностики, но `Debug` намеренно скрывает его:
   297	/// неизвестный op может содержать token/secret.
   298	#[derive(Clone, PartialEq)]
   299	pub enum VoicePayload {
   300	    Hello(Hello),
   301	    Identify(Identify),
   302	    SelectProtocol(SelectProtocol),
   303	    Ready(Ready),
   304	    SessionDescription(SessionDescription),
   305	    Other { op: VoiceOp, raw: JsonValue },
   306	}
   307	
   308	impl fmt::Debug for VoicePayload {
   309	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
   310	        match self {
   311	            Self::Hello(value) => formatter.debug_tuple("Hello").field(value).finish(),
   312	            Self::Identify(value) => formatter.debug_tuple("Identify").field(value).finish(),
   313	            Self::SelectProtocol(value) => formatter
   314	                .debug_tuple("SelectProtocol")
   315	                .field(value)
   316	                .finish(),
   317	            Self::Ready(value) => formatter.debug_tuple("Ready").field(value).finish(),
   318	            Self::SessionDescription(value) => formatter
   319	                .debug_tuple("SessionDescription")
   320	                .field(value)
   321	                .finish(),
   322	            Self::Other { op, raw: _ } => formatter
   323	                .debug_struct("Other")
   324	                .field("op", op)
   325	                .field("raw", &"<redacted>")
   326	                .finish(),
   327	        }
   328	    }
   329	}
