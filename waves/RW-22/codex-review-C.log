   692	            return Ok(region.to_owned());
   693	        }
   694	        return Err(VoiceError::invalid("manual region is unavailable"));
   695	    }
   696	    if samples.is_empty() {
   697	        return geo
   698	            .first()
   699	            .cloned()
   700	            .ok_or_else(|| VoiceError::invalid("no voice regions available"));

