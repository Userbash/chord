   203	/// Outgoing Select Protocol payload.
   204	#[derive(Debug, Clone, PartialEq, Eq)]
   205	pub struct SelectProtocol {
   206	    pub protocol: String,
   207	    pub address: String,
   208	    pub port: u16,
   209	    pub mode: String,
   210	    pub codecs: Vec<Codec>,
   211	}
   212	
   213	impl SelectProtocol {
   214	    /// Serialize the outgoing op1 frame (`{"op":1,"d":...}`) without redaction.
   215	    #[must_use]
   216	    pub fn to_json(&self) -> String {
   217	        let codecs = self
   218	            .codecs
   219	            .iter()
   220	            .map(|codec| {
   221	                object(vec![
   222	                    ("name", JsonValue::String(codec.name.clone())),
   223	                    ("type", JsonValue::String(codec.kind.clone())),
   224	                    ("priority", json_u64(codec.priority)),
   225	                    ("payload_type", json_u64(u64::from(codec.payload_type))),
   226	                ])
   227	            })
   228	            .collect();
   229	        let data = object(vec![
   230	            ("address", JsonValue::String(self.address.clone())),
   231	            ("port", json_u64(u64::from(self.port))),
   232	            ("mode", JsonValue::String(self.mode.clone())),
   233	        ]);
   234	        let payload = object(vec![
   235	            ("protocol", JsonValue::String(self.protocol.clone())),
   236	            ("data", data),
   237	            // RE capture дублирует address/port/mode на верхнем уровне d.
   238	            ("address", JsonValue::String(self.address.clone())),
   239	            ("port", json_u64(u64::from(self.port))),
   240	            ("mode", JsonValue::String(self.mode.clone())),
   241	            ("codecs", JsonValue::Array(codecs)),
   242	        ]);
   243	        discord_json::to_json_string(&object(vec![("op", json_u64(1)), ("d", payload)]))
   244	    }
   245	}
