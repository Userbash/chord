    81	
    82	impl fmt::Display for ResourceError {
    83	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
    84	        let message = match self {
    85	            Self::MissingId => "missing application id",
    86	            Self::InvalidId => "invalid application id",
    87	            Self::UnexpectedId => "unexpected application id",
    88	            Self::RouteNotFound => "resource GET route not found",
    89	            Self::RouteRender => "resource path could not be rendered",
    90	        };
    91	        formatter.write_str(message)
    92	    }
    93	}
