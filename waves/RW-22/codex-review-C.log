   426	        args: &BTreeMap<String, Value>,
   427	    ) -> Result<String, TranslateError> {
   428	        let (cat, locale) = if let Some(c) = self
   429	            .catalogs
   430	            .get(&self.current)
   431	            .filter(|c| c.get(key).is_some())
   432	        {
   433	            (c, self.current.as_str())
   434	        } else if let Some(c) = self
   435	            .catalogs
   436	            .get(&self.default)
   437	            .filter(|c| c.get(key).is_some())
   438	        {
   439	            (c, self.default.as_str())
   440	        } else {
   441	            return Err(TranslateError::MissingMessage {
   442	                key: key.into(),
   443	                locale: self.current.clone(),
   444	            });
   445	        };
   446	        render_ast(cat.get(key).expect("checked"), args, None, locale)
   447	    }
   448	}
   449	fn render_ast(
   450	    ast: &Ast,
   451	    args: &BTreeMap<String, Value>,
   452	    plural: Option<f64>,
   453	    locale: &str,
   454	) -> Result<String, TranslateError> {
   455	    Ok(match ast {
   456	        Ast::Literal(s) => s.clone(),
   457	        Ast::Sequence(v) => v
   458	            .iter()
   459	            .map(|x| render_ast(x, args, plural, locale))
   460	            .collect::<Result<Vec<_>, _>>()?
   461	            .concat(),
   462	        Ast::Argument(n) => args
   463	            .get(n)
   464	            .ok_or_else(|| TranslateError::MissingArgument { name: n.clone() })?
   465	            .display(),
   466	        Ast::Number(n) => {
   467	            let value = args
   468	                .get(n)
   469	                .ok_or_else(|| TranslateError::MissingArgument { name: n.clone() })?;
   470	            match value {
   471	                Value::Int(number) => format_number(*number as f64, locale),
   472	                Value::Float(number) => format_number(*number, locale),
   473	                Value::Str(text) => text.clone(),
   474	            }
   475	        }
   476	        Ast::Date(_) => return Err(TranslateError::UnsupportedNode { node: "date" }),
   477	        Ast::Time(_) => return Err(TranslateError::UnsupportedNode { node: "time" }),
   478	        Ast::Pound => plural
   479	            .map(|n| format_number(n, locale))
   480	            .unwrap_or_else(|| "#".into()),
   481	        Ast::Select(n, opts) => {
   482	            let val = args
   483	                .get(n)
   484	                .ok_or_else(|| TranslateError::MissingArgument { name: n.clone() })?
   485	                .display();
   486	            let b = opts
   487	                .get(&val)
   488	                .or_else(|| opts.get("other"))
   489	                .ok_or_else(|| TranslateError::MissingBranch { name: n.clone() })?;
   490	            render_ast(&Ast::Sequence(b.clone()), args, plural, locale)?
   491	        }
   492	        Ast::Plural(n, opts, offset, kind) => {
   493	            let v = args
   494	                .get(n)
   495	                .ok_or_else(|| TranslateError::MissingArgument { name: n.clone() })?
   496	                .number()
   497	                .ok_or_else(|| TranslateError::MissingArgument { name: n.clone() })?;
   498	            let exact = format!("={v:.0}");
   499	            let adjusted = v - *offset as f64;
   500	            let integer = adjusted.fract() == 0.0;
   501	            let cat = if !integer {
   502	                // CLDR: дробные значения не попадают в one/few/many и идут в other.
   503	                "other"
   504	            } else if kind == "ordinal" {
   505	                let x = adjusted as i64;
   506	                if x % 10 == 1 && x % 100 != 11 {
   507	                    "one"
   508	                } else if x % 10 == 2 && x % 100 != 12 {
   509	                    "two"
   510	                } else if x % 10 == 3 && x % 100 != 13 {
   511	                    "few"
   512	                } else {
   513	                    "other"
   514	                }
   515	            } else if locale.starts_with("ru") {
   516	                let x = adjusted.abs() as i64;
   517	                if x % 10 == 1 && x % 100 != 11 {
   518	                    "one"
   519	                } else if (2..=4).contains(&(x % 10)) && !(12..=14).contains(&(x % 100)) {
   520	                    "few"
   521	                } else {
   522	                    "many"
   523	                }
   524	            } else if adjusted == 1.0 {
   525	                "one"
   526	            } else {
   527	                "other"
   528	            };
   529	            let exact = if integer { Some(exact) } else { None };
   530	            let b = exact
   531	                .as_ref()
   532	                .and_then(|key| opts.get(key))
   533	                .or_else(|| opts.get(cat))
   534	                .or_else(|| opts.get("other"))
   535	                .ok_or_else(|| TranslateError::MissingBranch { name: n.clone() })?;
   536	            render_ast(
   537	                &Ast::Sequence(b.clone()),
   538	                args,
   539	                Some(v - *offset as f64),
   540	                locale,
   541	            )?
   542	        }
   543	        Ast::Tag(tag, kids, _) => {
   544	            let body = render_ast(&Ast::Sequence(kids.clone()), args, plural, locale)?;
   545	            match tag.as_str() {
   546	                "$b" => format!("**{body}**"),
   547	                "$i" => format!("*{body}*"),
   548	                "$del" => format!("~~{body}~~"),
   549	                "$code" => format!("`{body}`"),
   550	                "$p" => format!("{body}\n\n"),
   551	                "$link" => body,
   552	                _ if !tag.starts_with('$') => body,
   553	                _ => return Err(TranslateError::UnknownTag { name: tag.clone() }),
   554	            }
   555	        }
   556	    })
   557	}
   558	fn format_number(n: f64, locale: &str) -> String {
   559	    let raw = if n.fract() == 0.0 {
   560	        format!("{n:.0}")
   561	    } else {
   562	        n.to_string()
   563	    };
   564	    let (whole, fraction) = raw.split_once('.').unwrap_or((&raw, ""));
   565	    let (sign, digits) = whole.strip_prefix('-').map_or(("", whole), |v| ("-", v));
   566	    let (group_separator, decimal_separator) = if locale.starts_with("ru") {
   567	        ('\u{00a0}', ',')
   568	    } else {
   569	        (',', '.')
   570	    };
   571	    let mut grouped = String::new();
   572	    for (i, ch) in digits.chars().enumerate() {
   573	        if i > 0 && (digits.len() - i) % 3 == 0 {
   574	            grouped.push(group_separator);
   575	        }
   576	        grouped.push(ch);
   577	    }
   578	    if fraction.is_empty() {
   579	        format!("{sign}{grouped}")
   580	    } else {
   581	        format!("{sign}{grouped}{decimal_separator}{fraction}")
   582	    }
   583	}
   584	
   585	#[derive(Debug, Clone, PartialEq, Eq)]
   586	pub enum MarkdownNode {
   587	    Text(String),
   588	    Markup(String, String),
   589	    Link(String, String),
   590	    Sequence(Vec<MarkdownNode>),
   590	    Sequence(Vec<MarkdownNode>),
   591	}
   592	/// Parse a safe subset of Discord markdown into a bounded syntax tree.
   593	#[must_use]
   594	pub fn parse_markdown(input: &str) -> MarkdownNode {
   595	    parse_md(input, 0)
   596	}
   597	fn parse_md(s: &str, depth: usize) -> MarkdownNode {
   598	    if depth > 32 {
   599	        return MarkdownNode::Text(s.into());
   600	    }
   601	    let patterns = [
   602	        ("**", "**"),
   603	        ("__", "__"),
   604	        ("~~", "~~"),
   605	        ("||", "||"),
   606	        ("*", "*"),
   607	        ("_", "_"),
   608	        ("`", "`"),
   609	    ];
   610	    let mut nodes = Vec::new();
   611	    let mut i = 0;
   612	    let mut text = String::new();
   613	    while i < s.len() {
   614	        let rest = &s[i..];
   615	        if let Some((consumed, node)) = parse_fence(rest) {
   616	            push_text(&mut nodes, &mut text);
   617	            nodes.push(node);
   618	            i += consumed;
   619	            continue;
   620	        }
   621	        if rest.starts_with('\\') && rest.len() > 1 {
   622	            let ch = rest[1..].chars().next().unwrap();
   623	            text.push(ch);
   624	            i += 1 + ch.len_utf8();
   625	            continue;
   626	        }
   627	        if let Some((consumed, node)) = parse_link(rest) {
   628	            push_text(&mut nodes, &mut text);
   629	            nodes.push(node);
   630	            i += consumed;
   631	            continue;
   632	        }
   633	        if let Some((consumed, node)) = parse_markup(rest, &patterns, depth) {
   634	            push_text(&mut nodes, &mut text);
   635	            nodes.push(node);
   636	            i += consumed;
   637	            continue;
   638	        }
   639	        let ch = rest.chars().next().unwrap();
   640	        text.push(ch);
   641	        i += ch.len_utf8();
   642	    }
   643	    push_text(&mut nodes, &mut text);
   644	    MarkdownNode::Sequence(nodes)
   645	}
   646	
   647	fn push_text(nodes: &mut Vec<MarkdownNode>, text: &mut String) {
   648	    if !text.is_empty() {
   649	        nodes.push(MarkdownNode::Text(std::mem::take(text)));
   650	    }
   651	}
   652	
   653	fn parse_fence(rest: &str) -> Option<(usize, MarkdownNode)> {
   654	    let after = rest.strip_prefix("```")?;
   655	    let open_end = after.find('\n')? + 3;
   656	    let close = rest[open_end + 1..].find("```")?;
   657	    let end = open_end + 1 + close;
   658	    let lang = rest[3..open_end].trim();
   659	    let body = rest[open_end + 1..end].trim_end_matches('\n');
   660	    let text = if lang.is_empty() {
   661	        body.into()
   662	    } else {
   663	        format!("{lang}\n{body}")
   664	    };
   665	    Some((end + 3, MarkdownNode::Markup("```".into(), text)))
   666	}
   667	
   668	fn parse_link(rest: &str) -> Option<(usize, MarkdownNode)> {
   669	    let after = rest.strip_prefix('[')?;
   670	    let mid = after.find("](")? + 1;
   671	    let start = mid + 2;
   672	    let mut depth = 0usize;
   673	    let mut end = None;
   674	    for (offset, ch) in rest[start..].char_indices() {
   675	        match ch {
   676	            '(' => depth += 1,
   677	            ')' if depth == 0 => {
   678	                end = Some(start + offset);
   679	                break;
   680	            }
   681	            ')' => depth -= 1,
   682	            _ => {}
   683	        }
   684	    }
   685	    let end = end?;
   686	    let label = &rest[1..mid];
   687	    let url = &rest[mid + 2..end];
   688	    let node = if safe_url(url) {
   689	        MarkdownNode::Link(label.into(), url.into())
   690	    } else {
   691	        MarkdownNode::Text(label.into())
   692	    };
   693	    Some((end + 1, node))
   694	}
   695	
   696	fn parse_markup(
   697	    rest: &str,
   698	    patterns: &[(&str, &str)],
   699	    depth: usize,
   700	) -> Option<(usize, MarkdownNode)> {
   701	    for (open, close) in patterns {
   702	        let Some(after) = rest.strip_prefix(*open) else {
   703	            continue;
   704	        };
   705	        let Some(end) = after.find(*close) else {
   706	            continue;
   707	        };
   708	        let inner = &after[..end];
   709	        if inner.is_empty() {
   710	            continue;
   711	        }
   712	        let node =
   713	            MarkdownNode::Markup((*open).into(), render_markdown(&parse_md(inner, depth + 1)));
   714	        return Some((open.len() + end + close.len(), node));
   715	    }
   716	    None
   717	}
   718	fn safe_url(url: &str) -> bool {
   719	    let lower = url.trim().to_ascii_lowercase();
   720	    ["http://", "https://", "mailto:"]
   721	        .iter()
   722	        .any(|p| lower.starts_with(p))
   723	}
   724	/// Render markdown as normalized markdown, dropping unsafe link destinations.
   725	#[must_use]
   726	pub fn render_markdown(node: &MarkdownNode) -> String {
   727	    match node {
   728	        MarkdownNode::Text(s) => s.clone(),
   729	        MarkdownNode::Markup(m, s) if m == "```" => format!("{m}{s}\n{m}"),
   730	        MarkdownNode::Markup(m, s) => format!("{m}{s}{m}"),
   731	        MarkdownNode::Link(t, u) => {
   732	            if safe_url(u) {
   733	                format!("[{t}]({u})")
   734	            } else {
   735	                t.clone()
   736	            }
   737	        }
   738	        MarkdownNode::Sequence(v) => v.iter().map(render_markdown).collect(),
   739	    }
   740	}
