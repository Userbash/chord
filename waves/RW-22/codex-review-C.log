   603	    match byte {
   604	        b'A'..=b'Z' => Some(byte - b'A'),
   605	        b'a'..=b'z' => Some(byte - b'a' + 26),
   606	        b'0'..=b'9' => Some(byte - b'0' + 52),
   607	        b'+' => Some(62),
   608	        b'/' => Some(63),
   609	        _ => None,
   610	    }
