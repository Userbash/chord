+fn catalog_and_paths_are_deterministic() {
+    assert!(!RESOURCES.is_empty());
+    for (kind, _, _) in EXPECTED {
+        assert_eq!(resource(kind), resource(kind));
+        assert_eq!(path(kind, if kind == ResourceKind::ApplicationEntitlements {
+            Some("42")
+        } else {
+            None
+        }), path(kind, if kind == ResourceKind::ApplicationEntitlements {
+            Some("42")
+        } else {
+            None
+        }));
+    }
+}

