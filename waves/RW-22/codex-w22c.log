+    match kind {
+        ResourceKind::Quest => &RESOURCES[0],
+        ResourceKind::QuestDecision => &RESOURCES[1],
+        ResourceKind::QuestGetDecisions => &RESOURCES[2],
+        ResourceKind::Promotion => &RESOURCES[3],
