+        assert!(matches!(left.kind, ResourceKind::Quest | ResourceKind::QuestDecision
+            | ResourceKind::QuestGetDecisions | ResourceKind::Promotion
+            | ResourceKind::Entitlements | ResourceKind::ApplicationEntitlements
+            | ResourceKind::Library | ResourceKind::SavedMessages));
+    }
+}
+
+#[test]
+fn path_renders_only_the_application_id() {
+    assert_eq!(
+        path(ResourceKind::ApplicationEntitlements, Some("12345678901234567890")),
+        Ok("/users/@me/applications/12345678901234567890/entitlements".to_owned())
+    );
+    for (kind, template, _) in EXPECTED {
+        if kind == ResourceKind::ApplicationEntitlements {
