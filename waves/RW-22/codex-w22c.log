+    ReadOnlyResource {
+        kind: ResourceKind::Entitlements,
+        path_template: "/users/@me/entitlements",
+        observed_statuses: &[200],
+    },
+    ReadOnlyResource {
+        kind: ResourceKind::ApplicationEntitlements,
+        path_template: "/users/@me/applications/{id}/entitlements",
+        observed_statuses: &[200],
+    },
+    ReadOnlyResource {
