   527	fn decode_base64(input: &str) -> Result<Vec<u8>, VoiceError> {
   528	    let bytes = input.as_bytes();
   529	    if bytes.is_empty() || !bytes.len().is_multiple_of(4) {
   530	        return Err(VoiceError::invalid("invalid base64 key"));
   531	    }
   532	    let mut output = Vec::with_capacity(bytes.len() / 4 * 3);
   533	    for (index, chunk) in bytes.chunks(4).enumerate() {
   534	        let last = index + 1 == bytes.len() / 4;
   535	        if chunk.len() != 4 {
   536	            return Err(VoiceError::invalid("invalid base64 key"));
   537	        }
   538	        let a =
   539	            base64_value(chunk[0]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32;
   540	        let b =
   541	            base64_value(chunk[1]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32;
   542	        let c_pad = chunk[2] == b'=';
   543	        let d_pad = chunk[3] == b'=';
   544	        if c_pad && (!d_pad || !last) || d_pad && !last {
   545	            return Err(VoiceError::invalid("invalid base64 key"));
   546	        }
   547	        let c = if c_pad {
   548	            0
   549	        } else {
   550	            base64_value(chunk[2]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32
   551	        };
   552	        let d = if d_pad {
   553	            0
   554	        } else {
   555	            base64_value(chunk[3]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32
   556	        };
   557	        if (c_pad && b & 0x0f != 0) || (d_pad && !c_pad && c & 0x03 != 0) {
   558	            return Err(VoiceError::invalid("invalid base64 key"));
   559	        }
   560	        let bits = (a << 18) | (b << 12) | (c << 6) | d;
   561	        output.push((bits >> 16) as u8);
   562	        if !c_pad {
   563	            output.push((bits >> 8) as u8);
   564	        }
   565	        if !d_pad {
   566	            output.push(bits as u8);
   567	        }
   568	    }
   569	    Ok(output)
   570	}
   571	
   572	fn base64_value(byte: u8) -> Option<u8> {
   573	    match byte {
   574	        b'A'..=b'Z' => Some(byte - b'A'),
   575	        b'a'..=b'z' => Some(byte - b'a' + 26),
   576	        b'0'..=b'9' => Some(byte - b'0' + 52),
   577	        b'+' => Some(62),
   578	        b'/' => Some(63),
   579	        _ => None,
   580	    }
   581	}
