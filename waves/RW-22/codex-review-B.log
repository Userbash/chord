    31	#[test]
    32	fn catalog_matches_d02_and_get_routes() {
    33	    assert_eq!(RESOURCES.len(), EXPECTED.len());
    34	    for (kind, template, statuses) in EXPECTED {
    35	        let record = resource(kind);
    36	        assert_eq!(record.kind, kind);
    37	        assert_eq!(record.path_template, template);
    38	        assert_eq!(record.observed_statuses, statuses);
    39	        let matching_routes: Vec<_> = routes::ROUTES
    40	            .iter()
    41	            .filter(|route| route.path == template)
    42	            .collect();
    43	        assert_eq!(matching_routes.len(), 1);
    44	        assert_eq!(matching_routes[0].method, HttpMethod::Get);
    45	        assert!(!record.path_template.contains('?'));
    46	        assert!(!record.path_template.contains("://"));
    47	    }
    48	
    49	    for (index, left) in RESOURCES.iter().enumerate() {
    50	        assert!(
    51	            !RESOURCES[index + 1..]
    52	                .iter()
    53	                .any(|right| right.kind == left.kind)
    54	        );
    55	        assert!(matches!(
    56	            left.kind,
    57	            ResourceKind::Quest
    58	                | ResourceKind::QuestDecision
    59	                | ResourceKind::QuestGetDecisions
    60	                | ResourceKind::Promotion
    61	                | ResourceKind::Entitlements
    62	                | ResourceKind::ApplicationEntitlements
    63	                | ResourceKind::Library
    64	                | ResourceKind::SavedMessages
    65	        ));
    66	    }
    67	}
    68	
    69	#[test]
    70	fn path_renders_only_the_application_id() {
    71	    assert_eq!(
    72	        path(
    73	            ResourceKind::ApplicationEntitlements,
    74	            Some("12345678901234567890")
    75	        ),
    76	        Ok("/users/@me/applications/12345678901234567890/entitlements".to_owned())
    77	    );
    78	    for (kind, template, _) in EXPECTED {
    79	        if kind == ResourceKind::ApplicationEntitlements {
    80	            continue;
    81	        }
    82	        assert_eq!(path(kind, None), Ok(template.to_owned()));
    83	        assert_eq!(path(kind, Some("1")), Err(ResourceError::UnexpectedId));
    84	    }
    85	    for invalid in ["", "abc", "1/2", "123456789012345678901", "１２"] {
    86	        assert_eq!(
    87	            path(ResourceKind::ApplicationEntitlements, Some(invalid)),
    88	            Err(ResourceError::InvalidId)
    89	        );
    90	    }
    91	    assert_eq!(
    92	        path(ResourceKind::ApplicationEntitlements, None),
    93	        Err(ResourceError::MissingId)
    94	    );
    95	}
    96	
    97	#[test]
    98	fn saved_messages_404_is_not_a_success_payload() {
    99	    assert_eq!(
   100	        resource(ResourceKind::SavedMessages).observed_statuses,
   101	        &[404]
   102	    );
   103	    assert_eq!(resource(ResourceKind::Quest).observed_statuses, &[200]);
   104	    assert!(path(ResourceKind::SavedMessages, None).is_ok());
   105	}
   106	
   107	#[test]
   108	fn errors_are_stable_and_do_not_disclose_input() {
   109	    for (error, expected) in [
   110	        (ResourceError::MissingId, "missing application id"),
   111	        (ResourceError::InvalidId, "invalid application id"),
   112	        (ResourceError::UnexpectedId, "unexpected application id"),
   113	    ] {
   114	        assert_eq!(error.to_string(), expected);
   115	        assert!(!error.to_string().contains("secret"));
   116	    }
   117	}
   118	
   119	#[test]
   120	fn catalog_and_paths_are_deterministic() {
   121	    assert!(!RESOURCES.is_empty());
   122	    for (kind, _, _) in EXPECTED {
   123	        assert_eq!(resource(kind), resource(kind));
