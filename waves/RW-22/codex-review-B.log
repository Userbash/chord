   698	fn object(fields: Vec<(&str, JsonValue)>) -> JsonValue {
   699	    JsonValue::Object(
   700	        fields
   701	            .into_iter()
   702	            .map(|(key, value)| (key.to_owned(), value))
   703	            .collect(),
   704	    )
   705	}
