   148	/// Поиск маршрута по методу и точному шаблону пути (`find(Get, "/channels/{id}/messages")`).
   149	///
   150	/// Совпадение точное: путь с базой `/api/v9`, префикс или другой метод не подходят.
   151	pub fn find(method: HttpMethod, path: &str) -> Option<&'static RouteSpec> {
   152	    ROUTES
   153	        .iter()
   154	        .find(|spec| spec.method == method && spec.path == path)
   155	}
   156	
   157	/// Ошибки рендера пути.
   158	#[derive(Debug, Clone, PartialEq, Eq)]
   159	pub enum PathRenderError {
   160	    /// Число частей не совпало с числом плейсхолдеров `{id}`/`{num}`.
   161	    PartsMismatch {
   162	        /// Сколько плейсхолдеров в шаблоне.
   163	        expected: usize,
   164	        /// Сколько частей передано.
   165	        got: usize,
   166	    },
   167	    /// Часть пустая или содержит `{`/`}`.
   168	    InvalidPart(String),
   169	}
   170	
   171	/// Подставляет части в плейсхолдеры `{id}`/`{num}` слева направо.
   172	///
   173	/// Порядок проверок контрактный: сначала число частей, затем допустимость каждой части,
   174	/// и только потом подстановка. Ошибки не поглощаются: любая некорректная часть — `Err`.
   175	pub fn render_path(spec: &RouteSpec, parts: &[&str]) -> Result<String, PathRenderError> {
   176	    let expected = placeholder_count(spec.path);
   177	    if parts.len() != expected {
   178	        return Err(PathRenderError::PartsMismatch {
   179	            expected,
   180	            got: parts.len(),
   181	        });
   182	    }
   183	    for part in parts {
   184	        if part.is_empty() || part.contains('{') || part.contains('}') {
   185	            return Err(PathRenderError::InvalidPart((*part).to_string()));
   186	        }
   187	    }
   188	
   189	    let mut rendered =
   190	        String::with_capacity(spec.path.len() + parts.iter().map(|part| part.len()).sum::<usize>());
   191	    let mut rest = spec.path;
   192	    for part in parts {
   193	        if let Some((position, placeholder)) = next_placeholder(rest) {
   194	            rendered.push_str(&rest[..position]);
   195	            rendered.push_str(part);
   196	            rest = &rest[position + placeholder.len()..];
   197	        }
   198	        // Недостижимо: число плейсхолдеров сверено с числом частей выше. Ветка без паники:
   199	        // если инвариант когда-нибудь нарушится, остаток шаблона добавится как есть.
   200	    }
   201	    rendered.push_str(rest);
   202	    Ok(rendered)
   203	}
   204	
   205	/// Плейсхолдеры шаблонов пути (набор зафиксирован оракулом D-02).
   206	const PLACEHOLDERS: [&str; 2] = ["{id}", "{num}"];
   207	
   208	/// Число плейсхолдеров `{id}`/`{num}` в шаблоне.
   209	fn placeholder_count(template: &str) -> usize {
   210	    PLACEHOLDERS
   211	        .iter()
   212	        .copied()
   213	        .map(|placeholder| template.matches(placeholder).count())
   214	        .sum()
   215	}
   216	
   217	/// Ближайший слева плейсхолдер `{id}`/`{num}`: позиция и литерал.
   218	fn next_placeholder(template: &str) -> Option<(usize, &'static str)> {
   219	    PLACEHOLDERS
   220	        .iter()
   221	        .copied()
   222	        .filter_map(|placeholder| {
   223	            template
   224	                .find(placeholder)
   225	                .map(|position| (position, placeholder))
   226	        })
   227	        .min_by_key(|(position, _)| *position)
   228	}
