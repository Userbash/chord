     1	//! Микробенчмарк ETF для CI-smoke (P8-03 / T-HARN-06).
     2	//!
     3	//! Не заменяет T-HARN-04: порог регрессии >10% и история — отдельная карточка P7-02.
     4	//! Здесь фиксируется воспроизводимый smoke: encode+decode типичного gateway-терма.
     5	//! Запуск: `cargo run --offline --release -p discord-codec --example etf_bench -- --iterations 2000`.
     6	
     7	use std::hint::black_box;
     8	use std::time::Instant;
     9	
    10	use discord_codec::{EtfValue, decode, encode_checked};
    11	
    12	fn sample() -> EtfValue {
    13	    EtfValue::Map(vec![
    14	        (EtfValue::Atom("op".into()), EtfValue::Int(dispatch_op())),
    15	        (
    16	            EtfValue::Atom("d".into()),
    17	            EtfValue::Map(vec![
    18	                (
    19	                    EtfValue::Atom("heartbeat_interval".into()),
    20	                    EtfValue::Int(13_750),
    21	                ),
    22	                (
    23	                    EtfValue::Atom("modes".into()),
    24	                    EtfValue::List(vec![
    25	                        EtfValue::Str("aead_aes256_gcm_rtpsize".into()),
    26	                        EtfValue::Str("aead_xchacha20_poly1305_rtpsize".into()),
    27	                    ]),
    28	                ),
    29	            ]),
    30	        ),
    31	    ])
    32	}
    33	
    34	fn dispatch_op() -> i64 {
    35	    2
    36	}
    37	
    38	fn main() {
    39	    let mut iterations = 2_000usize;
    40	    let mut args = std::env::args().skip(1);
    41	    while let Some(arg) = args.next() {
    42	        match arg.as_str() {
    43	            "--iterations" => {
    44	                iterations = args
    45	                    .next()
    46	                    .and_then(|value| value.parse().ok())
    47	                    .filter(|value| *value > 0)
    48	                    .expect("--iterations требует положительное число");
    49	            }
    50	            "-h" | "--help" => {
    51	                println!("etf_bench [--iterations N]");
    52	                return;
    53	            }
    54	            other => panic!("неизвестный аргумент: {other}"),
    55	        }
    56	    }
    57	
    58	    let value = sample();
    59	    let golden = encode_checked(&value).expect("sample encode");
    60	    let started = Instant::now();
    61	    let mut total_bytes = 0usize;
    62	    for _ in 0..iterations {
    63	        let bytes = encode_checked(black_box(&value)).expect("encode");
    64	        total_bytes = total_bytes.saturating_add(bytes.len());
    65	        let (decoded, used) = decode(black_box(&bytes)).expect("decode");
    66	        assert_eq!(used, bytes.len(), "decode consumed");
    67	        black_box(decoded);
    68	    }
    69	    let elapsed = started.elapsed();
    70	    let nanos = elapsed.as_nanos().max(1);
    71	    let ops_per_sec = (iterations as u128).saturating_mul(1_000_000_000) / nanos;
    72	    println!(
    73	        "etf_bench iterations={iterations} golden_bytes={} total_bytes={total_bytes} elapsed_ms={} ops_per_sec={ops_per_sec}",
    74	        golden.len(),
    75	        elapsed.as_millis()
    76	    );
    77	}
