   150	impl Identify {
   151	    /// Serialize the outgoing op0 frame (`{"op":0,"d":...}`) without redaction.
   152	    #[must_use]
   153	    pub fn to_json(&self) -> String {
   154	        let streams = self
   155	            .streams
   156	            .iter()
   157	            .map(|stream| {
   158	                let mut fields = vec![("type", JsonValue::String(stream.kind.clone()))];
   159	                if let Some(ssrc) = stream.ssrc {
   160	                    fields.push(("ssrc", json_u64(ssrc)));
   161	                }
   162	                if let Some(rtx_ssrc) = stream.rtx_ssrc {
   163	                    fields.push(("rtx_ssrc", json_u64(rtx_ssrc)));
   164	                }
   165	                if let Some(rid) = &stream.rid {
   166	                    fields.push(("rid", JsonValue::String(rid.clone())));
   167	                }
   168	                if let Some(quality) = stream.quality {
   169	                    fields.push(("quality", json_u64(u64::from(quality))));
   170	                }
   171	                if let Some(active) = stream.active {
   172	                    fields.push(("active", JsonValue::Bool(active)));
   173	                }
   174	                object(fields)
   175	            })
   176	            .collect();
   177	        let payload = object(vec![
   178	            ("server_id", JsonValue::String(self.server_id.clone())),
   179	            ("channel_id", JsonValue::String(self.channel_id.clone())),
   180	            ("user_id", JsonValue::String(self.user_id.clone())),
   181	            ("session_id", JsonValue::String(self.session_id.clone())),
   182	            ("token", JsonValue::String(self.token.clone())),
   183	            (
   184	                "max_dave_protocol_version",
   185	                json_u64(u64::from(self.max_dave_protocol_version)),
   186	            ),
   187	            ("video", JsonValue::Bool(self.video)),
   188	            ("streams", JsonValue::Array(streams)),
   189	        ]);
   190	        discord_json::to_json_string(&object(vec![("op", json_u64(0)), ("d", payload)]))
   191	    }
   192	}
