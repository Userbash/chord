    10	fn captured_payloads(path: &str) -> Vec<String> {
    11	    let contents = match std::fs::read_to_string(path) {
    12	        Ok(contents) => contents,
    13	        Err(error) => {
    14	            eprintln!("skip: capture unavailable at {path}: {error}");
    15	            return Vec::new();
    16	        }
    17	    };
    18	    contents
    19	        .lines()
    20	        .filter_map(|line| parse(line).ok())
    21	        .filter_map(|wrapper| {
    22	            wrapper
    23	                .get("payload")
    24	                .and_then(JsonValue::as_str)
    25	                .map(str::to_owned)
    26	        })
    27	        .collect()
    28	}
