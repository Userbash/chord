    72	/// Failure while validating or rendering a resource path.
    73	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    74	pub enum ResourceError {
    75	    MissingId,
    76	    InvalidId,
    77	    UnexpectedId,
    78	    RouteNotFound,
    79	    RouteRender,
    80	}
    81	
    82	impl fmt::Display for ResourceError {
    83	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
    84	        let message = match self {
    85	            Self::MissingId => "missing application id",
    86	            Self::InvalidId => "invalid application id",
    87	            Self::UnexpectedId => "unexpected application id",
    88	            Self::RouteNotFound => "resource GET route not found",
    89	            Self::RouteRender => "resource path could not be rendered",
    90	        };
    91	        formatter.write_str(message)
    92	    }
    93	}
    94	
    95	impl std::error::Error for ResourceError {}
    96	
    97	/// Returns the static catalog entry for `kind`.
    98	#[must_use]
    99	pub fn resource(kind: ResourceKind) -> &'static ReadOnlyResource {
   100	    match kind {
   101	        ResourceKind::Quest => &RESOURCES[0],
   102	        ResourceKind::QuestDecision => &RESOURCES[1],
   103	        ResourceKind::QuestGetDecisions => &RESOURCES[2],
   104	        ResourceKind::Promotion => &RESOURCES[3],
   105	        ResourceKind::Entitlements => &RESOURCES[4],
   106	        ResourceKind::ApplicationEntitlements => &RESOURCES[5],
   107	        ResourceKind::Library => &RESOURCES[6],
   108	        ResourceKind::SavedMessages => &RESOURCES[7],
   109	    }
   110	}
   111	
   112	/// Builds a relative route path, validating the sole supported path parameter.
   113	pub fn path(kind: ResourceKind, application_id: Option<&str>) -> Result<String, ResourceError> {
   114	    let entry = resource(kind);
   115	    let parts = match (kind, application_id) {
   116	        (ResourceKind::ApplicationEntitlements, None) => return Err(ResourceError::MissingId),
   117	        (ResourceKind::ApplicationEntitlements, Some(id)) => {
   118	            if id.is_empty() || id.len() > 20 || !id.bytes().all(|byte| byte.is_ascii_digit()) {
   119	                return Err(ResourceError::InvalidId);
   120	            }
   121	            vec![id]
   122	        }
   123	        (_, Some(_)) => return Err(ResourceError::UnexpectedId),
   124	        (_, None) => Vec::new(),
   125	    };
   126	
   127	    let route =
   128	        routes::find(HttpMethod::Get, entry.path_template).ok_or(ResourceError::RouteNotFound)?;
   129	    routes::render_path(route, &parts).map_err(|_| ResourceError::RouteRender)
   130	}
