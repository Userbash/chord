   290	/// Parsed payload for a voice signaling frame.
   291	#[derive(Debug, Clone, PartialEq)]
   292	pub enum VoicePayload {
   293	    Hello(Hello),
   294	    Identify(Identify),
   295	    SelectProtocol(SelectProtocol),
   296	    Ready(Ready),
   297	    SessionDescription(SessionDescription),
   298	    Other { op: VoiceOp, raw: JsonValue },
   299	}
   300	
   301	/// Parsed RTC signaling frame.
   302	#[derive(Debug, Clone, PartialEq)]
   303	pub struct VoiceFrame {
   304	    pub op: VoiceOp,
   305	    pub payload: VoicePayload,
   306	    pub seq: Option<u64>,
   307	}
   308	
   309	/// Parse an internal RTC payload of the form `{ "op": ..., "d": ... }`.
   310	pub fn parse_frame(input: &str) -> Result<VoiceFrame, VoiceError> {
   311	    let root = discord_json::parse(input).map_err(|_| VoiceError::invalid("invalid voice JSON"))?;
   312	    let raw_op = required_u64(&root, "op")?
   313	        .try_into()
   314	        .map_err(|_| VoiceError::invalid("invalid voice op"))?;
   315	    let op = VoiceOp::from_u8(raw_op);
   316	    let data = root
   317	        .get("d")
   318	        .ok_or_else(|| VoiceError::invalid("missing voice payload"))?;
   319	    let seq = optional_u64(&root, "seq")?;
   320	    let payload = match op {
   321	        VoiceOp::Hello => VoicePayload::Hello(Hello {
   322	            version: required_u64(data, "v")?
   323	                .try_into()
   324	                .map_err(|_| VoiceError::invalid("invalid Hello version"))?,
   325	            heartbeat_interval_ms: required_u64(data, "heartbeat_interval")?,
   326	        }),
   327	        VoiceOp::Identify => VoicePayload::Identify(parse_identify(data)?),
   328	        VoiceOp::SelectProtocol => VoicePayload::SelectProtocol(parse_select_protocol(data)?),
   329	        VoiceOp::Ready => VoicePayload::Ready(parse_ready(data)?),
   330	        VoiceOp::SessionDescription => {
   331	            VoicePayload::SessionDescription(parse_session_description(data)?)
   332	        }
   333	        other => VoicePayload::Other {
   334	            op: other,
   335	            raw: data.clone(),
   336	        },
   337	    };
   338	    Ok(VoiceFrame { op, payload, seq })
   339	}
   340	
   341	fn parse_identify(data: &JsonValue) -> Result<Identify, VoiceError> {
   342	    let max_dave_protocol_version = required_u64(data, "max_dave_protocol_version")?
   343	        .try_into()
   344	        .map_err(|_| VoiceError::invalid("invalid DAVE version"))?;
   345	    let video = required_bool(data, "video")?;
   346	    if max_dave_protocol_version != 1 || !video {
   347	        return Err(VoiceError::invalid("unsupported Identify parameters"));
   348	    }
   349	    Ok(Identify {
   350	        server_id: nonempty_string(data, "server_id")?,
   351	        channel_id: nonempty_string(data, "channel_id")?,
   352	        user_id: nonempty_string(data, "user_id")?,
   353	        session_id: nonempty_string(data, "session_id")?,
   354	        token: nonempty_string(data, "token")?,
   355	        max_dave_protocol_version,
   356	        video,
   357	        streams: parse_streams(data.get("streams"))?,
   358	    })
   359	}
   360	
   361	fn parse_select_protocol(data: &JsonValue) -> Result<SelectProtocol, VoiceError> {
   362	    let protocol = nonempty_string(data, "protocol")?;
   363	    let nested = data
   364	        .get("data")
   365	        .ok_or_else(|| VoiceError::invalid("missing protocol data"))?;
   366	    let codecs_value = data
   367	        .get("codecs")
   368	        .and_then(JsonValue::as_array)
   369	        .ok_or_else(|| VoiceError::invalid("missing codecs"))?;
   370	    let codecs = codecs_value
   371	        .iter()
   372	        .map(|codec| {
   373	            Ok(Codec {
   374	                name: nonempty_string(codec, "name")?,
   375	                kind: nonempty_string(codec, "type")?,
   376	                priority: required_u64(codec, "priority")?,
   377	                payload_type: required_u64(codec, "payload_type")?
   378	                    .try_into()
   379	                    .map_err(|_| VoiceError::invalid("invalid codec payload type"))?,
   380	            })
   381	        })
   382	        .collect::<Result<Vec<_>, VoiceError>>()?;
   383	    if !codecs
   384	        .iter()
   385	        .any(|codec| codec.name == "opus" && codec.payload_type == 120 && codec.priority == 1000)
   386	        || !codecs
   387	            .iter()
   388	            .any(|codec| codec.name == "AV1" && codec.payload_type == 101)
   389	    {
   390	        return Err(VoiceError::invalid("required codecs missing"));
   391	    }
   392	    Ok(SelectProtocol {
   393	        protocol,
   394	        address: nonempty_string(nested, "address")?,
   395	        port: required_u64(nested, "port")?
   396	            .try_into()
   397	            .map_err(|_| VoiceError::invalid("invalid protocol port"))?,
   398	        mode: nonempty_string(nested, "mode")?,
   399	        codecs,
   400	    })
   401	}
   402	
   403	fn parse_ready(data: &JsonValue) -> Result<Ready, VoiceError> {
   404	    Ok(Ready {
   405	        ssrc: required_u64(data, "ssrc")?,
   406	        port: required_u64(data, "port")?
   407	            .try_into()
   408	            .map_err(|_| VoiceError::invalid("invalid Ready port"))?,
   409	        ip: nonempty_string(data, "ip")?,
   410	        modes: required_strings(data, "modes")?,
   411	        experiments: required_strings(data, "experiments")?,
   412	        streams: parse_streams(data.get("streams"))?,
   413	    })
   414	}
   415	
   416	fn parse_session_description(data: &JsonValue) -> Result<SessionDescription, VoiceError> {
   417	    let secret_key = decode_base64(&nonempty_string(data, "secret_key")?)?;
   418	    if secret_key.len() != 32 {
   419	        return Err(VoiceError::invalid("secret_key must decode to 32 bytes"));
   420	    }
   421	    Ok(SessionDescription {
   422	        mode: nonempty_string(data, "mode")?,
   423	        secret_key,
   424	        media_session_id: nonempty_string(data, "media_session_id")?,
   425	        dave_protocol_version: required_u64(data, "dave_protocol_version")?
   426	            .try_into()
   427	            .map_err(|_| VoiceError::invalid("invalid DAVE version"))?,
   428	        secure_frames_version: required_u64(data, "secure_frames_version")?
   429	            .try_into()
   430	            .map_err(|_| VoiceError::invalid("invalid secure frames version"))?,
   431	        audio_codec: optional_string(data, "audio_codec")?,
   432	        video_codec: optional_string(data, "video_codec")?,
   433	    })
   434	}
   435	
   436	fn parse_streams(value: Option<&JsonValue>) -> Result<Vec<StreamSpec>, VoiceError> {
   437	    let values = value
   438	        .and_then(JsonValue::as_array)
   439	        .ok_or_else(|| VoiceError::invalid("missing streams"))?;
   440	    values
   441	        .iter()
   442	        .map(|stream| {
   443	            Ok(StreamSpec {
   444	                kind: stream
   445	                    .get("type")
   446	                    .and_then(JsonValue::as_str)
   447	                    .unwrap_or("")
   448	                    .to_owned(),
   449	                ssrc: optional_u64(stream, "ssrc")?,
   450	                rtx_ssrc: optional_u64(stream, "rtx_ssrc")?,
   451	                rid: optional_string(stream, "rid")?,
   452	                quality: optional_u64(stream, "quality")?
   453	                    .map(TryInto::try_into)
   454	                    .transpose()
   455	                    .map_err(|_| VoiceError::invalid("invalid stream quality"))?,
   456	                active: optional_bool(stream, "active")?,
   457	            })
   458	        })
   459	        .collect()
   460	}
   461	
   462	fn required_u64(value: &JsonValue, key: &str) -> Result<u64, VoiceError> {
   463	    value
   464	        .get(key)
   465	        .and_then(JsonValue::as_u64)
   466	        .ok_or_else(|| VoiceError::invalid("missing or invalid integer field"))
   467	}
   468	fn optional_u64(value: &JsonValue, key: &str) -> Result<Option<u64>, VoiceError> {
   469	    value
   470	        .get(key)
   471	        .map(|field| {
   472	            field
   473	                .as_u64()
   474	                .ok_or_else(|| VoiceError::invalid("invalid integer field"))
   475	        })
   476	        .transpose()
   477	}
   478	fn required_bool(value: &JsonValue, key: &str) -> Result<bool, VoiceError> {
   479	    value
   480	        .get(key)
   481	        .and_then(JsonValue::as_bool)
   482	        .ok_or_else(|| VoiceError::invalid("missing or invalid boolean field"))
   483	}
   484	fn optional_bool(value: &JsonValue, key: &str) -> Result<Option<bool>, VoiceError> {
   485	    value
   486	        .get(key)
   487	        .map(|field| {
   488	            field
   489	                .as_bool()
   490	                .ok_or_else(|| VoiceError::invalid("invalid boolean field"))
   491	        })
   492	        .transpose()
   493	}
   494	fn nonempty_string(value: &JsonValue, key: &str) -> Result<String, VoiceError> {
   495	    value
   496	        .get(key)
   497	        .and_then(JsonValue::as_str)
   498	        .filter(|text| !text.is_empty())
   499	        .map(str::to_owned)
   500	        .ok_or_else(|| VoiceError::invalid("missing or empty string field"))
   501	}
   502	fn optional_string(value: &JsonValue, key: &str) -> Result<Option<String>, VoiceError> {
   503	    value
   504	        .get(key)
   505	        .map(|field| {
   506	            field
   507	                .as_str()
   508	                .map(str::to_owned)
   509	                .ok_or_else(|| VoiceError::invalid("invalid string field"))
   510	        })
   511	        .transpose()
   512	}
   513	fn required_strings(value: &JsonValue, key: &str) -> Result<Vec<String>, VoiceError> {
   514	    value
   515	        .get(key)
   516	        .and_then(JsonValue::as_array)
   517	        .ok_or_else(|| VoiceError::invalid("missing string array"))?
   518	        .iter()
   519	        .map(|item| {
   520	            item.as_str()
   521	                .map(str::to_owned)
   522	                .ok_or_else(|| VoiceError::invalid("invalid string array item"))
   523	        })
   524	        .collect()
   525	}
   526	
   527	fn decode_base64(input: &str) -> Result<Vec<u8>, VoiceError> {
   528	    let bytes = input.as_bytes();
   529	    if bytes.is_empty() || !bytes.len().is_multiple_of(4) {
   530	        return Err(VoiceError::invalid("invalid base64 key"));
   531	    }
   532	    let mut output = Vec::with_capacity(bytes.len() / 4 * 3);
   533	    for (index, chunk) in bytes.chunks(4).enumerate() {
   534	        let last = index + 1 == bytes.len() / 4;
   535	        if chunk.len() != 4 {
   536	            return Err(VoiceError::invalid("invalid base64 key"));
   537	        }
   538	        let a =
   539	            base64_value(chunk[0]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32;
   540	        let b =
   541	            base64_value(chunk[1]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32;
   542	        let c_pad = chunk[2] == b'=';
   543	        let d_pad = chunk[3] == b'=';
   544	        if c_pad && (!d_pad || !last) || d_pad && !last {
   545	            return Err(VoiceError::invalid("invalid base64 key"));
   546	        }
   547	        let c = if c_pad {
   548	            0
   549	        } else {
   550	            base64_value(chunk[2]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32
   551	        };
   552	        let d = if d_pad {
   553	            0
   554	        } else {
   555	            base64_value(chunk[3]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32
   556	        };
   557	        if (c_pad && b & 0x0f != 0) || (d_pad && !c_pad && c & 0x03 != 0) {
   558	            return Err(VoiceError::invalid("invalid base64 key"));
   559	        }
   560	        let bits = (a << 18) | (b << 12) | (c << 6) | d;
   561	        output.push((bits >> 16) as u8);
   562	        if !c_pad {
   563	            output.push((bits >> 8) as u8);
   564	        }
   565	        if !d_pad {
   566	            output.push(bits as u8);
   567	        }
   568	    }
   569	    Ok(output)
   570	}
   571	
   572	fn base64_value(byte: u8) -> Option<u8> {
   573	    match byte {
   574	        b'A'..=b'Z' => Some(byte - b'A'),
   575	        b'a'..=b'z' => Some(byte - b'a' + 26),
   576	        b'0'..=b'9' => Some(byte - b'0' + 52),
   577	        b'+' => Some(62),
   578	        b'/' => Some(63),
   579	        _ => None,
   580	    }
   581	}
   582	
   583	/// Gateway `VOICE_SERVER_UPDATE`, with token redacted from `Debug`.
   584	#[derive(Clone, PartialEq, Eq)]
   585	pub struct VoiceServerUpdate {
   586	    pub token: String,
   587	    pub guild_id: String,
   588	    pub endpoint: String,
   589	}
   590	
   591	impl fmt::Debug for VoiceServerUpdate {
   592	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   593	        f.debug_struct("VoiceServerUpdate")
   594	            .field("token", &"<redacted>")
   595	            .field("guild_id", &"<redacted>")
   596	            .field("endpoint", &self.endpoint)
   597	            .finish()
   598	    }
   599	}
   600	
   601	impl VoiceServerUpdate {
   602	    pub fn parse(input: &str) -> Result<Self, VoiceError> {
   603	        let root = discord_json::parse(input)
   604	            .map_err(|_| VoiceError::invalid("invalid voice server JSON"))?;
   605	        let data = root.get("d").unwrap_or(&root);
   606	        let update = Self {
   607	            token: nonempty_string(data, "token")?,
   608	            guild_id: nonempty_string(data, "guild_id")?,
   609	            endpoint: nonempty_string(data, "endpoint")?,
   610	        };
   611	        update.validate_endpoint()?;
   612	        Ok(update)
   613	    }
   614	
   615	    pub fn websocket_url(&self) -> Result<String, VoiceError> {
   616	        self.validate_endpoint()?;
   617	        let host = self
   618	            .endpoint
   619	            .strip_prefix("wss://")
   620	            .unwrap_or(&self.endpoint);
   621	        Ok(format!("wss://{}/?v=9", host.trim_end_matches('/')))
   622	    }
   623	
   624	    fn validate_endpoint(&self) -> Result<(), VoiceError> {
   625	        let endpoint = &self.endpoint;
   626	        if endpoint.chars().any(char::is_whitespace) || endpoint.chars().any(char::is_control) {
   627	            return Err(VoiceError::invalid("invalid voice endpoint"));
   628	        }
   629	        let host = if let Some(host) = endpoint.strip_prefix("wss://") {
   630	            host.strip_suffix("/?v=9")
   631	                .unwrap_or(host)
   632	                .trim_end_matches('/')
   633	        } else {
   634	            if endpoint.contains("://") {
   635	                return Err(VoiceError::invalid("unsupported voice endpoint scheme"));
   636	            }
   637	            endpoint
   638	        };
   639	        if host.is_empty()
   640	            || host.contains(['/', '@', '?', '#'])
   641	            || host.starts_with(':')
   642	            || host.ends_with(':')
   643	        {
   644	            return Err(VoiceError::invalid("invalid voice endpoint host"));
   645	        }
   646	        Ok(())
   647	    }
   648	}
   649	
   650	/// Choose a region by measured latency, geographic order, then lexical order.
   651	pub fn select_region(
   652	    samples: &[(String, u32)],
   653	    geo: &[String],
   654	    manual: Option<&str>,
   655	) -> Result<String, VoiceError> {
   656	    if let Some(region) = manual {
   657	        if geo.iter().any(|item| item == region) || samples.iter().any(|(item, _)| item == region) {
   658	            return Ok(region.to_owned());
   659	        }
   660	        return Err(VoiceError::invalid("manual region is unavailable"));
   661	    }
   662	    if samples.is_empty() {
   663	        return geo
   664	            .first()
   665	            .cloned()
   666	            .ok_or_else(|| VoiceError::invalid("no voice regions available"));
   667	    }
   668	    let mut best: BTreeMap<&str, u32> = BTreeMap::new();
   669	    for (region, latency) in samples {
   670	        best.entry(region)
   671	            .and_modify(|current| *current = (*current).min(*latency))
   672	            .or_insert(*latency);
   673	    }
   674	    best.into_iter()
   675	        .min_by(|(left, left_latency), (right, right_latency)| {
   676	            left_latency
   677	                .cmp(right_latency)
   678	                .then_with(|| {
   679	                    geo.iter()
   680	                        .position(|item| item == left)
   681	                        .unwrap_or(usize::MAX)
   682	                        .cmp(
   683	                            &geo.iter()
   684	                                .position(|item| item == right)
   685	                                .unwrap_or(usize::MAX),
   686	                        )
   687	                })
   688	                .then_with(|| left.cmp(right))
   689	        })
   690	        .map(|(region, _)| region.to_owned())
   691	        .ok_or_else(|| VoiceError::invalid("no voice regions available"))
   692	}
