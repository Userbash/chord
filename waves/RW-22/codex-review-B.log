     9	
    10	/// HTTP-метод запроса (набор RFC 9110; в захвате D-02 наблюдались GET/POST/PUT/PATCH).
    11	#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
    12	pub enum HttpMethod {
    13	    Get,
    14	    Post,
    15	    Put,
    16	    Patch,
    17	    Delete,
    18	}
    19	
    20	impl HttpMethod {
    21	    /// Имя метода в проводе (`"GET"`, `"POST"`, …).
    22	    #[must_use]
    23	    pub fn as_str(self) -> &'static str {
    24	        match self {
    25	            HttpMethod::Get => "GET",
    26	            HttpMethod::Post => "POST",
    27	            HttpMethod::Put => "PUT",
    28	            HttpMethod::Patch => "PATCH",
    29	            HttpMethod::Delete => "DELETE",
    30	        }
    31	    }
    32	}
    33	
    34	/// Маршрут: метод, шаблон пути (относительный, без базы `/api/v9`) и ключи тела запроса.
    35	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    36	pub struct RouteSpec {
    37	    /// HTTP-метод запроса.
    38	    pub method: HttpMethod,
    39	    /// Шаблон пути относительно базы (без `/api/v9`).
    40	    pub path: &'static str,
    41	    /// Ключи тела запроса дословно из оракула; пусто — тела нет.
    42	    pub body_keys: &'static [&'static str],
    43	}
    44	
    45	/// Конструктор элемента каталога (приватный: состав каталога фиксирован оракулом).
    46	const fn route(
    47	    method: HttpMethod,
    48	    path: &'static str,
    49	    body_keys: &'static [&'static str],
    50	) -> RouteSpec {
    51	    RouteSpec {
    52	        method,
    53	        path,
    54	        body_keys,
    55	    }
    56	}
