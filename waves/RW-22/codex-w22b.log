 /// Наблюдавшиеся op-коды RTC-сигнализации (union сессий 1–2).
 pub const OBSERVED_RTC_OPS: [u8; 9] = [0, 1, 2, 3, 4, 6, 8, 15, 16];
 
+/// RTC signaling operation code.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum VoiceOp {
+    Identify,
+    SelectProtocol,
+    Ready,
+    Heartbeat,
+    SessionDescription,
+    HeartbeatAck,
+    Hello,
+    Unknown(u8),
+}
+
+impl VoiceOp {
+    #[must_use]
+    pub fn from_u8(raw: u8) -> Self {
+        match raw {
+            0 => Self::Identify,
+            1 => Self::SelectProtocol,
+            2 => Self::Ready,
+            3 => Self::Heartbeat,
+            4 => Self::SessionDescription,
+            6 => Self::HeartbeatAck,
+            8 => Self::Hello,
+            value => Self::Unknown(value),
+        }
+    }
+
+    #[must_use]
+    pub fn as_u8(self) -> u8 {
+        match self {
+            Self::Identify => 0,
+            Self::SelectProtocol => 1,
+            Self::Ready => 2,
+            Self::Heartbeat => 3,
+            Self::SessionDescription => 4,
+            Self::HeartbeatAck => 6,
+            Self::Hello => 8,
+            Self::Unknown(value) => value,
+        }
+    }
