+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Identify")
+            .field("server_id", &"<redacted>")
+            .field("channel_id", &"<redacted>")
+            .field("user_id", &"<redacted>")
+            .field("session_id", &"<redacted>")
+            .field("token", &"<redacted>")
+            .field("max_dave_protocol_version", &self.max_dave_protocol_version)
+            .field("video", &self.video)
+            .field("streams", &self.streams)
+            .finish()
+    }
+}
+
+/// Select Protocol codec.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Codec {
+    pub name: String,
+    pub kind: String,
+    pub priority: u64,
+    pub payload_type: u8,
+}
+
+/// Outgoing Select Protocol payload.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SelectProtocol {
+    pub protocol: String,
+    pub address: String,
+    pub port: u16,
+    pub mode: String,
+    pub codecs: Vec<Codec>,
+}
+
+/// RTC Ready payload.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Ready {
+    pub ssrc: u64,
+    pub port: u16,
+    pub ip: String,
+    pub modes: Vec<String>,
+    pub experiments: Vec<String>,
+    pub streams: Vec<StreamSpec>,
+}
+
+/// RTC Session Description payload.
+#[derive(Clone, PartialEq, Eq)]
+pub struct SessionDescription {
+    pub mode: String,
+    pub secret_key: Vec<u8>,
+    pub media_session_id: String,
+    pub dave_protocol_version: u8,
+    pub secure_frames_version: u8,
+    pub audio_codec: Option<String>,
+    pub video_codec: Option<String>,
+}
+
+impl fmt::Debug for SessionDescription {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("SessionDescription")
+            .field("mode", &self.mode)
+            .field("secret_key", &"<redacted>")
+            .field("media_session_id", &"<redacted>")
+            .field("dave_protocol_version", &self.dave_protocol_version)
+            .field("secure_frames_version", &self.secure_frames_version)
+            .field("audio_codec", &self.audio_codec)
+            .field("video_codec", &self.video_codec)
+            .finish()
+    }
+}
+
+impl fmt::Display for SessionDescription {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "SessionDescription(mode={}, secret_key=<redacted>, media_session_id=<redacted>)", self.mode)
+    }
+}
+
+/// Parsed payload for a voice signaling frame.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum VoicePayload {
+    Hello(Hello),
+    Identify(Identify),
+    SelectProtocol(SelectProtocol),
+    Ready(Ready),
+    SessionDescription(SessionDescription),
+    Other { op: VoiceOp, raw: JsonValue },
+}
+
+/// Parsed RTC signaling frame.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VoiceFrame {
+    pub op: VoiceOp,
+    pub payload: VoicePayload,
+    pub seq: Option<u64>,
+}
+
+/// Parse an internal RTC payload of the form `{ "op": ..., "d": ... }`.
+pub fn parse_frame(input: &str) -> Result<VoiceFrame, VoiceError> {
+    let root = discord_json::parse(input).map_err(|_| VoiceError::invalid("invalid voice JSON"))?;
+    let raw_op = required_u64(&root, "op")?.try_into().map_err(|_| VoiceError::invalid("invalid voice op"))?;
+    let op = VoiceOp::from_u8(raw_op);
+    let data = root.get("d").ok_or_else(|| VoiceError::invalid("missing voice payload"))?;
+    let seq = optional_u64(&root, "seq")?;
+    let payload = match op {
+        VoiceOp::Hello => VoicePayload::Hello(Hello {
+            version: required_u64(data, "v")?.try_into().map_err(|_| VoiceError::invalid("invalid Hello version"))?,
+            heartbeat_interval_ms: required_u64(data, "heartbeat_interval")?,
+        }),
+        VoiceOp::Identify => VoicePayload::Identify(parse_identify(data)?),
+        VoiceOp::SelectProtocol => VoicePayload::SelectProtocol(parse_select_protocol(data)?),
+        VoiceOp::Ready => VoicePayload::Ready(parse_ready(data)?),
+        VoiceOp::SessionDescription => VoicePayload::SessionDescription(parse_session_description(data)?),
+        other => VoicePayload::Other { op: other, raw: data.clone() },
+    };
+    Ok(VoiceFrame { op, payload, seq })
+}
+
+fn parse_identify(data: &JsonValue) -> Result<Identify, VoiceError> {
+    let max_dave_protocol_version = required_u64(data, "max_dave_protocol_version")?
+        .try_into().map_err(|_| VoiceError::invalid("invalid DAVE version"))?;
+    let video = required_bool(data, "video")?;
+    if max_dave_protocol_version != 1 || !video {
+        return Err(VoiceError::invalid("unsupported Identify parameters"));
+    }
+    Ok(Identify {
+        server_id: nonempty_string(data, "server_id")?,
+        channel_id: nonempty_string(data, "channel_id")?,
+        user_id: nonempty_string(data, "user_id")?,
+        session_id: nonempty_string(data, "session_id")?,
+        token: nonempty_string(data, "token")?,
+        max_dave_protocol_version,
+        video,
+        streams: parse_streams(data.get("streams"))?,
+    })
+}
+
+fn parse_select_protocol(data: &JsonValue) -> Result<SelectProtocol, VoiceError> {
+    let protocol = nonempty_string(data, "protocol")?;
+    let nested = data.get("data").ok_or_else(|| VoiceError::invalid("missing protocol data"))?;
+    let codecs_value = data.get("codecs").and_then(JsonValue::as_array).ok_or_else(|| VoiceError::invalid("missing codecs"))?;
+    let codecs = codecs_value.iter().map(|codec| Ok(Codec {
+        name: nonempty_string(codec, "name")?,
+        kind: nonempty_string(codec, "type")?,
+        priority: required_u64(codec, "priority")?,
+        payload_type: required_u64(codec, "payload_type")?.try_into().map_err(|_| VoiceError::invalid("invalid codec payload type"))?,
+    })).collect::<Result<Vec<_>, VoiceError>>()?;
+    if !codecs.iter().any(|codec| codec.name == "opus" && codec.payload_type == 120 && codec.priority == 1000)
+        || !codecs.iter().any(|codec| codec.name == "AV1" && codec.payload_type == 101)
+    {
+        return Err(VoiceError::invalid("required codecs missing"));
+    }
+    Ok(SelectProtocol {
+        protocol,
+        address: nonempty_string(nested, "address")?,
+        port: required_u64(nested, "port")?.try_into().map_err(|_| VoiceError::invalid("invalid protocol port"))?,
+        mode: nonempty_string(nested, "mode")?,
+        codecs,
+    })
+}
+
+fn parse_ready(data: &JsonValue) -> Result<Ready, VoiceError> {
+    Ok(Ready {
+        ssrc: required_u64(data, "ssrc")?,
+        port: required_u64(data, "port")?.try_into().map_err(|_| VoiceError::invalid("invalid Ready port"))?,
+        ip: nonempty_string(data, "ip")?,
+        modes: required_strings(data, "modes")?,
+        experiments: required_strings(data, "experiments")?,
+        streams: parse_streams(data.get("streams"))?,
+    })
+}
+
+fn parse_session_description(data: &JsonValue) -> Result<SessionDescription, VoiceError> {
+    let secret_key = decode_base64(&nonempty_string(data, "secret_key")?)?;
+    if secret_key.len() != 32 {
+        return Err(VoiceError::invalid("secret_key must decode to 32 bytes"));
+    }
+    Ok(SessionDescription {
+        mode: nonempty_string(data, "mode")?,
+        secret_key,
+        media_session_id: nonempty_string(data, "media_session_id")?,
+        dave_protocol_version: required_u64(data, "dave_protocol_version")?.try_into().map_err(|_| VoiceError::invalid("invalid DAVE version"))?,
+        secure_frames_version: required_u64(data, "secure_frames_version")?.try_into().map_err(|_| VoiceError::invalid("invalid secure frames version"))?,
+        audio_codec: optional_string(data, "audio_codec")?,
+        video_codec: optional_string(data, "video_codec")?,
+    })
+}
+
+fn parse_streams(value: Option<&JsonValue>) -> Result<Vec<StreamSpec>, VoiceError> {
+    let values = value.and_then(JsonValue::as_array).ok_or_else(|| VoiceError::invalid("missing streams"))?;
+    values.iter().map(|stream| Ok(StreamSpec {
+        kind: stream.get("type").and_then(JsonValue::as_str).unwrap_or("").to_owned(),
+        ssrc: optional_u64(stream, "ssrc")?,
+        rtx_ssrc: optional_u64(stream, "rtx_ssrc")?,
+        rid: optional_string(stream, "rid")?,
+        quality: optional_u64(stream, "quality")?.map(TryInto::try_into).transpose().map_err(|_| VoiceError::invalid("invalid stream quality"))?,
+        active: optional_bool(stream, "active")?,
+    })).collect()
+}
+
+fn required_u64(value: &JsonValue, key: &str) -> Result<u64, VoiceError> {
+    value.get(key).and_then(JsonValue::as_u64).ok_or_else(|| VoiceError::invalid("missing or invalid integer field"))
+}
+fn optional_u64(value: &JsonValue, key: &str) -> Result<Option<u64>, VoiceError> {
+    value.get(key).map(|field| field.as_u64().ok_or_else(|| VoiceError::invalid("invalid integer field"))).transpose()
+}
+fn required_bool(value: &JsonValue, key: &str) -> Result<bool, VoiceError> {
+    value.get(key).and_then(JsonValue::as_bool).ok_or_else(|| VoiceError::invalid("missing or invalid boolean field"))
+}
+fn optional_bool(value: &JsonValue, key: &str) -> Result<Option<bool>, VoiceError> {
+    value.get(key).map(|field| field.as_bool().ok_or_else(|| VoiceError::invalid("invalid boolean field"))).transpose()
+}
+fn nonempty_string(value: &JsonValue, key: &str) -> Result<String, VoiceError> {
+    value.get(key).and_then(JsonValue::as_str).filter(|text| !text.is_empty()).map(str::to_owned).ok_or_else(|| VoiceError::invalid("missing or empty string field"))
+}
+fn optional_string(value: &JsonValue, key: &str) -> Result<Option<String>, VoiceError> {
+    value.get(key).map(|field| field.as_str().map(str::to_owned).ok_or_else(|| VoiceError::invalid("invalid string field"))).transpose()
+}
+fn required_strings(value: &JsonValue, key: &str) -> Result<Vec<String>, VoiceError> {
+    value.get(key).and_then(JsonValue::as_array).ok_or_else(|| VoiceError::invalid("missing string array"))?.iter()
+        .map(|item| item.as_str().map(str::to_owned).ok_or_else(|| VoiceError::invalid("invalid string array item"))).collect()
+}
+
+fn decode_base64(input: &str) -> Result<Vec<u8>, VoiceError> {
+    let bytes = input.as_bytes();
+    if bytes.is_empty() || bytes.len() % 4 != 0 {
+        return Err(VoiceError::invalid("invalid base64 key"));
+    }
+    let mut output = Vec::with_capacity(bytes.len() / 4 * 3);
+    for (index, chunk) in bytes.chunks_exact(4).enumerate() {
+        let last = index + 1 == bytes.len() / 4;
+        let a = base64_value(chunk[0]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32;
+        let b = base64_value(chunk[1]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32;
+        let c_pad = chunk[2] == b'=';
+        let d_pad = chunk[3] == b'=';
+        if c_pad && (!d_pad || !last) || d_pad && !last {
+            return Err(VoiceError::invalid("invalid base64 key"));
+        }
+        let c = if c_pad { 0 } else { base64_value(chunk[2]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32 };
+        let d = if d_pad { 0 } else { base64_value(chunk[3]).ok_or_else(|| VoiceError::invalid("invalid base64 key"))? as u32 };
+        if (c_pad && b & 0x0f != 0) || (d_pad && !c_pad && c & 0x03 != 0) {
+            return Err(VoiceError::invalid("invalid base64 key"));
+        }
+        let bits = (a << 18) | (b << 12) | (c << 6) | d;
+        output.push((bits >> 16) as u8);
+        if !c_pad { output.push((bits >> 8) as u8); }
+        if !d_pad { output.push(bits as u8); }
+    }
+    Ok(output)
+}
+
+fn base64_value(byte: u8) -> Option<u8> {
+    match byte {
+        b'A'..=b'Z' => Some(byte - b'A'),
+        b'a'..=b'z' => Some(byte - b'a' + 26),
+        b'0'..=b'9' => Some(byte - b'0' + 52),
+        b'+' => Some(62),
+        b'/' => Some(63),
+        _ => None,
+    }
+}
+
+/// Gateway `VOICE_SERVER_UPDATE`, with token redacted from `Debug`.
+#[derive(Clone, PartialEq, Eq)]
+pub struct VoiceServerUpdate {
+    pub token: String,
+    pub guild_id: String,
+    pub endpoint: String,
+}
+
+impl fmt::Debug for VoiceServerUpdate {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("VoiceServerUpdate")
+            .field("token", &"<redacted>")
+            .field("guild_id", &"<redacted>")
+            .field("endpoint", &self.endpoint)
+            .finish()
+    }
+}
+
+impl VoiceServerUpdate {
+    pub fn parse(input: &str) -> Result<Self, VoiceError> {
+        let root = discord_json::parse(input).map_err(|_| VoiceError::invalid("invalid voice server JSON"))?;
+        let data = root.get("d").unwrap_or(&root);
+        let update = Self {
+            token: nonempty_string(data, "token")?,
+            guild_id: nonempty_string(data, "guild_id")?,
+            endpoint: nonempty_string(data, "endpoint")?,
+        };
+        update.validate_endpoint()?;
+        Ok(update)
+    }
+
+    pub fn websocket_url(&self) -> Result<String, VoiceError> {
+        self.validate_endpoint()?;
+        let host = self.endpoint.strip_prefix("wss://").unwrap_or(&self.endpoint);
+        Ok(format!("wss://{}/?v=9", host.trim_end_matches('/')))
+    }
+
+    fn validate_endpoint(&self) -> Result<(), VoiceError> {
+        let endpoint = &self.endpoint;
+        if endpoint.chars().any(char::is_whitespace) || endpoint.chars().any(char::is_control) {
+            return Err(VoiceError::invalid("invalid voice endpoint"));
+        }
+        let host = if let Some(host) = endpoint.strip_prefix("wss://") {
+            host.strip_suffix("/?v=9").unwrap_or(host).trim_end_matches('/')
+        } else {
+            if endpoint.contains("://") { return Err(VoiceError::invalid("unsupported voice endpoint scheme")); }
+            endpoint
+        };
+        if host.is_empty() || host.contains(['/', '@', '?', '#']) || host.starts_with(':') || host.ends_with(':') {
+            return Err(VoiceError::invalid("invalid voice endpoint host"));
+        }
+        Ok(())
+    }
+}
+
+/// Choose a region by measured latency, geographic order, then lexical order.
+pub fn select_region(samples: &[(String, u32)], geo: &[String], manual: Option<&str>) -> Result<String, VoiceError> {
+    if let Some(region) = manual {
+        if geo.iter().any(|item| item == region) || samples.iter().any(|(item, _)| item == region) {
+            return Ok(region.to_owned());
+        }
+        return Err(VoiceError::invalid("manual region is unavailable"));
+    }
+    if samples.is_empty() {
+        return geo.first().cloned().ok_or_else(|| VoiceError::invalid("no voice regions available"));
+    }
+    let mut best: BTreeMap<&str, u32> = BTreeMap::new();
+    for (region, latency) in samples {
+        best.entry(region).and_modify(|current| *current = (*current).min(*latency)).or_insert(*latency);
+    }
+    best.into_iter().min_by(|(left, left_latency), (right, right_latency)| {
+        left_latency.cmp(right_latency)
+            .then_with(|| geo.iter().position(|item| item == left).unwrap_or(usize::MAX).cmp(&geo.iter().position(|item| item == right).unwrap_or(usize::MAX)))
+            .then_with(|| left.cmp(right))
+    }).map(|(region, _)| region.to_owned()).ok_or_else(|| VoiceError::invalid("no voice regions available"))
+}
