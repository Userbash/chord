+#[test]
+fn voice_server_update_builds_valid_websocket_url_without_leaking_token() {
+    let update = VoiceServerUpdate::parse(r#"{"token":"private-token","guild_id":"123","endpoint":"c-fra19.discord.media:2053"}"#).unwrap();
+    assert_eq!(update.websocket_url().unwrap(), "wss://c-fra19.discord.media:2053/?v=9");
+    assert_eq!(VoiceServerUpdate::parse(r#"{"token":"t","guild_id":"g","endpoint":"wss://voice.example:2096"}"#).unwrap().websocket_url().unwrap(), "wss://voice.example:2096/?v=9");
+    assert!(!format!("{update:?}").contains("private-token"));
+    for endpoint in ["", " ", "http://voice.example", "ws://voice.example", "voice.example/@x", "voice.example?x"] {
+        let input = format!(r#"{{"token":"t","guild_id":"g","endpoint":"{endpoint}"}}"#);
+        assert!(VoiceServerUpdate::parse(&input).and_then(|value| value.websocket_url()).is_err(), "accepted {endpoint:?}");
+    }
+}
