+fn every_prefix_of_frame_is_panic_free() {
+    let padding = "x".repeat(12_000);
+    let frame = format!(r#"{{"op":4,"seq":1,"d":{{"mode":"aead_aes256_gcm_rtpsize","secret_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","media_session_id":"id","dave_protocol_version":1,"secure_frames_version":1,"padding":"{padding}"}}}}"#);
+    for end in 0..10_000 {
+        assert!(parse_frame(&frame[..end]).is_err(), "prefix {end} unexpectedly parsed");
+    }
+    for byte in 0..10_000usize {
+        let malformed = format!("{{\"op\":{},\"d\":{{}}}}", byte % 256);
+        let _ = parse_frame(&malformed);
+    }
+}
