    28	#[test]
    29	fn parses_scalars_arrays_and_objects() {
    30	    assert_eq!(parse("null").unwrap(), JsonValue::Null);
    31	    assert_eq!(parse("true").unwrap(), JsonValue::Bool(true));
    32	    assert_eq!(parse("false").unwrap(), JsonValue::Bool(false));
    33	    assert_eq!(
    34	        parse("\"текст\"").unwrap(),
    35	        JsonValue::String("текст".into())
    36	    );
    37	
    38	    let value = parse(r#"{"a":[1,-2,3.5,true,false,null,"x"],"b":{"c":"d"}}"#).unwrap();
    39	    let object = value.as_object().expect("object");
    40	    assert_eq!(object.len(), 2);
    41	    let array = object
    42	        .get("a")
    43	        .and_then(JsonValue::as_array)
    44	        .expect("array");
    45	    assert_eq!(array.len(), 7);
    46	    assert_eq!(array[0].as_i64(), Some(1));
    47	    assert_eq!(array[1].as_i64(), Some(-2));
    48	    assert_eq!(array[2].as_f64(), Some(3.5));
    49	    assert_eq!(object["b"].get("c").and_then(JsonValue::as_str), Some("d"));
    50	}
