   223	/// Сериализовать JSON-значение в компактную строку.
   224	///
   225	/// Строки экранируются по RFC 8259 (control-символы — `\u00XX`), не-ASCII остаётся UTF-8,
   226	/// числа печатаются в исходном лексическом виде. Функция не паникует и всегда возвращает
   227	/// валидный JSON для значения, полученного из [`parse`] или собранного из [`JsonValue`].
   228	#[must_use]
   229	pub fn to_json_string(value: &JsonValue) -> String {
   230	    let mut out = String::new();
   231	    write_json(value, &mut out);
   232	    out
   233	}
   234	
   235	fn write_json(value: &JsonValue, out: &mut String) {
   236	    match value {
   237	        JsonValue::Null => out.push_str("null"),
   238	        JsonValue::Bool(true) => out.push_str("true"),
   239	        JsonValue::Bool(false) => out.push_str("false"),
   240	        JsonValue::Number(number) => out.push_str(number.as_str()),
   241	        JsonValue::String(text) => write_json_string(text, out),
   242	        JsonValue::Array(values) => {
   243	            out.push('[');
   244	            for (index, value) in values.iter().enumerate() {
   245	                if index > 0 {
   246	                    out.push(',');
   247	                }
   248	                write_json(value, out);
   249	            }
   250	            out.push(']');
   251	        }
   252	        JsonValue::Object(values) => {
   253	            out.push('{');
   254	            for (index, (key, value)) in values.iter().enumerate() {
   255	                if index > 0 {
   256	                    out.push(',');
   257	                }
   258	                write_json_string(key, out);
   259	                out.push(':');
   260	                write_json(value, out);
   261	            }
   262	            out.push('}');
   263	        }
   264	    }
   265	}
   266	
   267	fn write_json_string(text: &str, out: &mut String) {
   268	    out.push('"');
   269	    for ch in text.chars() {
   270	        match ch {
   271	            '"' => out.push_str("\\\""),
   272	            '\\' => out.push_str("\\\\"),
   273	            '\u{8}' => out.push_str("\\b"),
   274	            '\u{c}' => out.push_str("\\f"),
   275	            '\n' => out.push_str("\\n"),
   276	            '\r' => out.push_str("\\r"),
   277	            '\t' => out.push_str("\\t"),
   278	            ch if ch < '\u{20}' => {
   279	                out.push_str("\\u00");
   280	                let byte = ch as u8;
   281	                out.push(char::from_digit(u32::from(byte >> 4), 16).unwrap_or('0'));
   282	                out.push(char::from_digit(u32::from(byte & 0x0f), 16).unwrap_or('0'));
   283	            }
   284	            ch => out.push(ch),
   285	        }
   286	    }
   287	    out.push('"');
   288	}
   289	
   290	/// Разобрать JSON-документ.
   291	///
   292	/// # Errors
   293	///
   294	/// Любое нарушение RFC 8259, duplicate keys, превышение [`MAX_DEPTH`]/[`MAX_NODES`] или
   295	/// непробельные байты после значения.
   296	pub fn parse(input: &str) -> Result<JsonValue, JsonError> {
   297	    let mut parser = Parser {
   298	        input,
   299	        bytes: input.as_bytes(),
   300	        pos: 0,
   301	        nodes: 0,
   302	    };
   303	    parser.skip_ws();
   304	    let value = parser.parse_value(0)?;
   305	    parser.skip_ws();
   306	    if parser.pos != parser.bytes.len() {
   307	        return Err(parser.error(JsonErrorKind::TrailingData));
   308	    }
   309	    Ok(value)
   310	}
   311	
   312	struct Parser<'a> {
   313	    input: &'a str,
   314	    bytes: &'a [u8],
   315	    pos: usize,
   316	    nodes: usize,
   317	}
   318	
   319	impl Parser<'_> {
   320	    fn error(&self, kind: JsonErrorKind) -> JsonError {
   321	        JsonError {
   322	            offset: self.pos,
   323	            kind,
   324	        }
   325	    }
   326	
   327	    fn error_at(&self, offset: usize, kind: JsonErrorKind) -> JsonError {
   328	        JsonError { offset, kind }
   329	    }
   330	
   331	    fn skip_ws(&mut self) {
   332	        while matches!(self.bytes.get(self.pos), Some(b' ' | b'\n' | b'\r' | b'\t')) {
   333	            self.pos += 1;
   334	        }
   335	    }
   336	
   337	    fn peek(&self) -> Option<u8> {
   338	        self.bytes.get(self.pos).copied()
   339	    }
