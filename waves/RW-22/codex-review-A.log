   578	#[derive(Debug, Clone, PartialEq, Eq)]
   579	pub enum MarkdownNode {
   580	    Text(String),
   581	    Markup(String, String),
   582	    Link(String, String),
   583	    Sequence(Vec<MarkdownNode>),
   584	}
   585	/// Parse a safe subset of Discord markdown into a bounded syntax tree.
   586	#[must_use]
   587	pub fn parse_markdown(input: &str) -> MarkdownNode {
   588	    parse_md(input, 0)
   589	}
   590	fn parse_md(s: &str, depth: usize) -> MarkdownNode {
   591	    if depth > 32 {
   592	        return MarkdownNode::Text(s.into());
   593	    }
   594	    let patterns = [
   595	        ("**", "**"),
   596	        ("__", "__"),
   597	        ("~~", "~~"),
   598	        ("||", "||"),
   599	        ("*", "*"),
   600	        ("_", "_"),
   601	        ("`", "`"),
   602	    ];
   603	    let mut nodes = Vec::new();
   604	    let mut i = 0;
   605	    let mut text = String::new();
   606	    while i < s.len() {
   607	        let rest = &s[i..];
   608	        if let Some((consumed, node)) = parse_fence(rest) {
   609	            push_text(&mut nodes, &mut text);
   610	            nodes.push(node);
   611	            i += consumed;
   612	            continue;
   613	        }
   614	        if rest.starts_with('\\') && rest.len() > 1 {
   615	            let ch = rest[1..].chars().next().unwrap();
   616	            text.push(ch);
   617	            i += 1 + ch.len_utf8();
   618	            continue;
   619	        }
   620	        if let Some((consumed, node)) = parse_link(rest) {
   621	            push_text(&mut nodes, &mut text);
   622	            nodes.push(node);
   623	            i += consumed;
   624	            continue;
   625	        }
   626	        if let Some((consumed, node)) = parse_markup(rest, &patterns, depth) {
   627	            push_text(&mut nodes, &mut text);
   628	            nodes.push(node);
   629	            i += consumed;
   630	            continue;
   631	        }
   632	        let ch = rest.chars().next().unwrap();
   633	        text.push(ch);
   634	        i += ch.len_utf8();
   635	    }
   636	    push_text(&mut nodes, &mut text);
   637	    MarkdownNode::Sequence(nodes)
   638	}
   639	
   640	fn push_text(nodes: &mut Vec<MarkdownNode>, text: &mut String) {
   641	    if !text.is_empty() {
   642	        nodes.push(MarkdownNode::Text(std::mem::take(text)));
   643	    }
   644	}
   645	
   646	fn parse_fence(rest: &str) -> Option<(usize, MarkdownNode)> {
   647	    let after = rest.strip_prefix("```")?;
   648	    let open_end = after.find('\n')? + 3;
   649	    let close = rest[open_end + 1..].find("```")?;
   650	    let end = open_end + 1 + close;
   651	    let lang = rest[3..open_end].trim();
   652	    let body = rest[open_end + 1..end].trim_end_matches('\n');
   653	    let text = if lang.is_empty() {
   654	        body.into()
   655	    } else {
   656	        format!("{lang}\n{body}")
   657	    };
   658	    Some((end + 3, MarkdownNode::Markup("```".into(), text)))
   659	}
   660	
   661	fn parse_link(rest: &str) -> Option<(usize, MarkdownNode)> {
   662	    let after = rest.strip_prefix('[')?;
   663	    let mid = after.find("](")? + 1;
   664	    let end = rest.rfind(')')?;
   665	    if end < mid + 2 {
   666	        return None;
   667	    }
   668	    let label = &rest[1..mid];
   669	    let url = &rest[mid + 2..end];
   670	    let node = if safe_url(url) {
   671	        MarkdownNode::Link(label.into(), url.into())
   672	    } else {
   673	        MarkdownNode::Text(label.into())
   674	    };
   675	    Some((end + 1, node))
   676	}
   677	
   678	fn parse_markup(
   679	    rest: &str,
   680	    patterns: &[(&str, &str)],
   681	    depth: usize,
   682	) -> Option<(usize, MarkdownNode)> {
   683	    for (open, close) in patterns {
   684	        let Some(after) = rest.strip_prefix(*open) else {
   685	            continue;
   686	        };
   687	        let Some(end) = after.find(*close) else {
   688	            continue;
   689	        };
   690	        let inner = &after[..end];
   691	        if inner.is_empty() {
   692	            continue;
   693	        }
   694	        let node =
   695	            MarkdownNode::Markup((*open).into(), render_markdown(&parse_md(inner, depth + 1)));
   696	        return Some((open.len() + end + close.len(), node));
   697	    }
   698	    None
   699	}
   700	fn safe_url(url: &str) -> bool {
   701	    let lower = url.trim().to_ascii_lowercase();
   702	    ["http://", "https://", "mailto:"]
   703	        .iter()
   704	        .any(|p| lower.starts_with(p))
   705	}
   706	/// Render markdown as normalized markdown, dropping unsafe link destinations.
   707	#[must_use]
   708	pub fn render_markdown(node: &MarkdownNode) -> String {
   709	    match node {
   710	        MarkdownNode::Text(s) => s.clone(),
   711	        MarkdownNode::Markup(m, s) if m == "```" => format!("{m}{s}\n{m}"),
   712	        MarkdownNode::Markup(m, s) => format!("{m}{s}{m}"),
   713	        MarkdownNode::Link(t, u) => {
   714	            if safe_url(u) {
   715	                format!("[{t}]({u})")
   716	            } else {
   717	                t.clone()
   718	            }
   719	        }
   720	        MarkdownNode::Sequence(v) => v.iter().map(render_markdown).collect(),
   721	    }
   722	}
