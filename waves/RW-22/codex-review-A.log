   551	fn format_number(n: f64, locale: &str) -> String {
   552	    let raw = if n.fract() == 0.0 {
   553	        format!("{n:.0}")
   554	    } else {
   555	        n.to_string()
   556	    };
   557	    let (whole, fraction) = raw.split_once('.').unwrap_or((&raw, ""));
   558	    let (sign, digits) = whole.strip_prefix('-').map_or(("", whole), |v| ("-", v));
   559	    let (group_separator, decimal_separator) = if locale.starts_with("ru") {
   560	        ('\u{00a0}', ',')
   561	    } else {
   562	        (',', '.')
   563	    };
   564	    let mut grouped = String::new();
   565	    for (i, ch) in digits.chars().enumerate() {
   566	        if i > 0 && (digits.len() - i) % 3 == 0 {
   567	            grouped.push(group_separator);
   568	        }
   569	        grouped.push(ch);
   570	    }
   571	    if fraction.is_empty() {
   572	        format!("{sign}{grouped}")
   573	    } else {
   574	        format!("{sign}{grouped}{decimal_separator}{fraction}")
   575	    }
   576	}
