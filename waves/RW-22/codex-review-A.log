    77	#[test]
    78	fn rejects_malformed_and_dangerous_input() {
    79	    let cases: &[(&str, JsonErrorKind)] = &[
    80	        ("", JsonErrorKind::UnexpectedEof),
    81	        (" ", JsonErrorKind::UnexpectedEof),
    82	        ("{", JsonErrorKind::UnexpectedEof),
    83	        ("[1,]", JsonErrorKind::UnexpectedByte(b']')),
    84	        ("{\"a\":1,}", JsonErrorKind::UnexpectedByte(b'}')),
    85	        ("{\"a\" 1}", JsonErrorKind::UnexpectedByte(b'1')),
    86	        ("01", JsonErrorKind::InvalidNumber),
    87	        ("+1", JsonErrorKind::UnexpectedByte(b'+')),
    88	        (".5", JsonErrorKind::UnexpectedByte(b'.')),
    89	        ("1.", JsonErrorKind::InvalidNumber),
    90	        ("1e", JsonErrorKind::InvalidNumber),
    91	        ("NaN", JsonErrorKind::UnexpectedByte(b'N')),
    92	        ("\"\\x\"", JsonErrorKind::InvalidEscape),
    93	        ("\"\\u12\"", JsonErrorKind::InvalidUnicode),
    94	        ("\"\\ud800\"", JsonErrorKind::InvalidUnicode),
    95	        ("\"a\nb\"", JsonErrorKind::ControlCharacter),
    96	        ("{\"a\":1,\"a\":2}", JsonErrorKind::DuplicateKey),
    97	        ("{}x", JsonErrorKind::TrailingData),
    98	        ("null null", JsonErrorKind::TrailingData),
    99	    ];
   100	    for (input, expected) in cases {
   101	        let error = parse(input).expect_err(input);
   102	        assert_eq!(
   103	            std::mem::discriminant(&error.kind),
   104	            std::mem::discriminant(expected),
   105	            "input={input:?} got={error:?}"
   106	        );
   107	        assert!(error.offset <= input.len(), "offset for {input:?}");
   108	    }
   109	}
