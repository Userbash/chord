   502	                    "one"
   503	                } else if x % 10 == 2 && x % 100 != 12 {
   504	                    "two"
   505	                } else if x % 10 == 3 && x % 100 != 13 {
   506	                    "few"
   507	                } else {
   508	                    "other"
   509	                }
   510	            } else if locale.starts_with("ru") {
   511	                let x = (v - *offset as f64).abs() as i64;
   512	                if x % 10 == 1 && x % 100 != 11 {
   513	                    "one"
   514	                } else if (2..=4).contains(&(x % 10)) && !(12..=14).contains(&(x % 100)) {
   515	                    "few"
   516	                } else {
   517	                    "many"
   518	                }
   519	            } else if (v - *offset as f64) == 1.0 {
   520	                "one"
   521	            } else {
   522	                "other"
   523	            };
