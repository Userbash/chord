   267	fn write_json_string(text: &str, out: &mut String) {
   268	    out.push('"');
   269	    for ch in text.chars() {
   270	        match ch {
   271	            '"' => out.push_str("\\\""),
   272	            '\\' => out.push_str("\\\\"),
   273	            '\u{8}' => out.push_str("\\b"),
   274	            '\u{c}' => out.push_str("\\f"),
   275	            '\n' => out.push_str("\\n"),
   276	            '\r' => out.push_str("\\r"),
   277	            '\t' => out.push_str("\\t"),
   278	            ch if ch < '\u{20}' => {
   279	                out.push_str("\\u00");
   280	                let byte = ch as u8;
   281	                out.push(char::from_digit(u32::from(byte >> 4), 16).unwrap_or('0'));
   282	                out.push(char::from_digit(u32::from(byte & 0x0f), 16).unwrap_or('0'));
   283	            }
   284	            ch => out.push(ch),
   285	        }
   286	    }
   287	    out.push('"');
   288	}
