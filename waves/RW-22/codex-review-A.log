   130	#[test]
   131	fn depth_limit_is_enforced_without_panic() {
   132	    let mut input = String::new();
   133	    for _ in 0..MAX_DEPTH {
   134	        input.push('[');
   135	    }
   136	    input.push('0');
   137	    for _ in 0..MAX_DEPTH {
   138	        input.push(']');
   139	    }
   140	    // Ровно MAX_DEPTH вложенных массивов допустимо; следующий уровень — уже нет.
   141	    assert!(parse(&input).is_ok());
   142	
   143	    let mut too_deep = String::from("[");
   144	    too_deep.push_str(&input);
   145	    too_deep.push(']');
   146	    assert!(matches!(
   147	        parse(&too_deep).unwrap_err().kind,
   148	        JsonErrorKind::DepthLimit
   149	    ));
   150	}
