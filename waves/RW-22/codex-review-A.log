   290	/// Разобрать JSON-документ.
   291	///
   292	/// # Errors
   293	///
   294	/// Любое нарушение RFC 8259, duplicate keys, превышение [`MAX_DEPTH`]/[`MAX_NODES`] или
   295	/// непробельные байты после значения.
   296	pub fn parse(input: &str) -> Result<JsonValue, JsonError> {
   297	    let mut parser = Parser {
   298	        input,
   299	        bytes: input.as_bytes(),
   300	        pos: 0,
   301	        nodes: 0,
   302	    };
   303	    parser.skip_ws();
   304	    let value = parser.parse_value(0)?;
   305	    parser.skip_ws();
   306	    if parser.pos != parser.bytes.len() {
   307	        return Err(parser.error(JsonErrorKind::TrailingData));
   308	    }
   309	    Ok(value)
   310	}
   311	
   312	struct Parser<'a> {
   313	    input: &'a str,
   314	    bytes: &'a [u8],
   315	    pos: usize,
   316	    nodes: usize,
   317	}
   318	
   319	impl Parser<'_> {
   320	    fn error(&self, kind: JsonErrorKind) -> JsonError {
   321	        JsonError {
   322	            offset: self.pos,
   323	            kind,
   324	        }
   325	    }
   326	
   327	    fn error_at(&self, offset: usize, kind: JsonErrorKind) -> JsonError {
   328	        JsonError { offset, kind }
   329	    }
   330	
   331	    fn skip_ws(&mut self) {
   332	        while matches!(self.bytes.get(self.pos), Some(b' ' | b'\n' | b'\r' | b'\t')) {
   333	            self.pos += 1;
   334	        }
   335	    }
   336	
   337	    fn peek(&self) -> Option<u8> {
   338	        self.bytes.get(self.pos).copied()
   339	    }
   340	
   341	    fn expect(&mut self, byte: u8) -> Result<(), JsonError> {
   342	        if self.peek() == Some(byte) {
   343	            self.pos += 1;
   344	            Ok(())
   345	        } else {
   346	            Err(self.error(JsonErrorKind::UnexpectedByte(self.peek().unwrap_or(0))))
   347	        }
   348	    }
   349	
   350	    fn parse_value(&mut self, depth: usize) -> Result<JsonValue, JsonError> {
   351	        if depth > MAX_DEPTH {
   352	            return Err(self.error(JsonErrorKind::DepthLimit));
   353	        }
   354	        self.nodes = self.nodes.saturating_add(1);
   355	        if self.nodes > MAX_NODES {
   356	            return Err(self.error(JsonErrorKind::NodeLimit));
   357	        }
   358	        match self.peek() {
   359	            None => Err(self.error(JsonErrorKind::UnexpectedEof)),
   360	            Some(b'n') => {
   361	                self.consume_literal(b"null")?;
   362	                Ok(JsonValue::Null)
   363	            }
   364	            Some(b't') => {
   365	                self.consume_literal(b"true")?;
   366	                Ok(JsonValue::Bool(true))
   367	            }
   368	            Some(b'f') => {
   369	                self.consume_literal(b"false")?;
   370	                Ok(JsonValue::Bool(false))
   371	            }
   372	            Some(b'"') => Ok(JsonValue::String(self.parse_string()?)),
   373	            Some(b'{') => self.parse_object(depth),
   374	            Some(b'[') => self.parse_array(depth),
   375	            Some(b'-' | b'0'..=b'9') => Ok(JsonValue::Number(self.parse_number()?)),
   376	            Some(other) => Err(self.error(JsonErrorKind::UnexpectedByte(other))),
   377	        }
   378	    }
   379	
   380	    fn consume_literal(&mut self, literal: &[u8]) -> Result<(), JsonError> {
   381	        if self.bytes[self.pos..].starts_with(literal) {
   382	            self.pos += literal.len();
   383	            Ok(())
   384	        } else {
   385	            Err(self.error(JsonErrorKind::UnexpectedByte(self.peek().unwrap_or(0))))
   386	        }
   387	    }
   388	
   389	    fn parse_object(&mut self, depth: usize) -> Result<JsonValue, JsonError> {
   390	        self.expect(b'{')?;
   391	        self.skip_ws();
   392	        let mut object = BTreeMap::new();
   393	        if self.peek() == Some(b'}') {
   394	            self.pos += 1;
   395	            return Ok(JsonValue::Object(object));
   396	        }
   397	        loop {
   398	            self.skip_ws();
   399	            match self.peek() {
   400	                Some(b'"') => {}
   401	                Some(other) => return Err(self.error(JsonErrorKind::UnexpectedByte(other))),
   402	                None => return Err(self.error(JsonErrorKind::UnexpectedEof)),
   403	            }
   404	            let key_offset = self.pos;
