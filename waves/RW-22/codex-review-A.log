    12	fn lab_root() -> Option<PathBuf> {
    13	    if let Some(root) = std::env::var_os("RE_LAB_ROOT") {
    14	        let root = PathBuf::from(root);
    15	        if root.is_dir() {
    16	            return Some(root);
    17	        }
    18	    }
    19	    let fallback = Path::new("/home/user/clean-room-oracle");
    20	    fallback.is_dir().then(|| fallback.to_path_buf())
    21	}
