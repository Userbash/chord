   163	/// Parsed message expression.
   164	#[derive(Debug, Clone, PartialEq)]
   165	pub enum Ast {
   166	    Literal(String),
   167	    Argument(String),
   168	    Number(String),
   169	    Date(String),
   170	    Time(String),
   171	    Select(String, BTreeMap<String, Vec<Ast>>),
   172	    Plural(String, BTreeMap<String, Vec<Ast>>, i64, String),
   173	    Pound,
   174	    Tag(String, Vec<Ast>, Option<String>),
   175	    Sequence(Vec<Ast>),
   176	}
   177	
   178	/// Invalid catalog AST. Error text contains only structural location, never source values.
   179	#[derive(Debug, Clone, PartialEq, Eq)]
   180	pub struct AstError {
   181	    pub path: String,
   182	    pub kind: &'static str,
   183	}
   184	impl fmt::Display for AstError {
   185	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   186	        write!(f, "invalid catalog AST at {}: {}", self.path, self.kind)
   187	    }
   188	}
   189	impl std::error::Error for AstError {}
   190	
   191	/// Parsed key-to-message catalog.
   192	#[derive(Debug, Clone, Default)]
   193	pub struct Catalog {
   194	    entries: BTreeMap<String, Ast>,
   195	}
   196	impl Catalog {
   197	    pub fn parse(value: &discord_json::JsonValue) -> Result<Self, AstError> {
   198	        let obj = value.as_object().ok_or_else(|| AstError {
   199	            path: "$".into(),
   200	            kind: "expected object",
   201	        })?;
   202	        let mut entries = BTreeMap::new();
   203	        for (key, node) in obj {
   204	            entries.insert(key.clone(), parse_ast(node, format!("$.{key}"), 0)?);
   205	        }
   206	        Ok(Self { entries })
   207	    }
   208	    pub fn get(&self, key: &str) -> Option<&Ast> {
   209	        self.entries.get(key)
   210	    }
   211	    pub fn len(&self) -> usize {
   212	        self.entries.len()
   213	    }
   214	    pub fn is_empty(&self) -> bool {
   215	        self.entries.is_empty()
   216	    }
   217	}
   218	fn parse_ast(v: &discord_json::JsonValue, path: String, depth: usize) -> Result<Ast, AstError> {
   219	    if let Some(s) = v.as_str() {
   220	        return Ok(Ast::Literal(s.into()));
   221	    }
   222	    if depth > 128 {
   223	        return Err(AstError {
   224	            path,
   225	            kind: "depth limit",
   226	        });
   227	    }
   228	    if let Some(a) = v.as_array() {
   229	        if a.first()
   230	            .and_then(discord_json::JsonValue::as_i64)
   231	            .is_none()
   232	        {
   233	            let nodes = a
   234	                .iter()
   235	                .enumerate()
   236	                .map(|(i, x)| parse_ast(x, format!("{path}[{i}]"), depth + 1))
   237	                .collect::<Result<_, _>>()?;
   238	            return Ok(Ast::Sequence(nodes));
   239	        }
   240	        let bad = || AstError {
   241	            path: path.clone(),
   242	            kind: "invalid node shape",
   243	        };
   244	        let typ = a
   245	            .first()
   246	            .and_then(discord_json::JsonValue::as_i64)
   247	            .ok_or_else(bad)?;
   248	        let str_at = |i: usize| {
   249	            a.get(i)
   250	                .and_then(discord_json::JsonValue::as_str)
   251	                .map(str::to_owned)
   252	                .ok_or_else(bad)
   253	        };
   254	        let children = |i: usize| -> Result<Vec<Ast>, AstError> {
   255	            let vals = a
   256	                .get(i)
   257	                .and_then(discord_json::JsonValue::as_array)
   258	                .ok_or_else(bad)?;
   259	            vals.iter()
   260	                .enumerate()
   261	                .map(|(n, x)| parse_ast(x, format!("{path}[{i}][{n}]"), depth + 1))
   262	                .collect()
   263	        };
   264	        return Ok(match typ {
   265	            0 => Ast::Literal(str_at(1)?),
   266	            1 => Ast::Argument(str_at(1)?),
   267	            2 => Ast::Number(str_at(1)?),
   268	            3 => Ast::Date(str_at(1)?),
   269	            4 => Ast::Time(str_at(1)?),
   270	            5 | 6 => {
   271	                let name = str_at(1)?;
   272	                let opts = a
   273	                    .get(2)
   274	                    .and_then(discord_json::JsonValue::as_object)
   275	                    .ok_or_else(bad)?;
   276	                let mut parsed = BTreeMap::new();
   277	                for (k, v) in opts {
   278	                    let nodes = if v
   279	                        .as_array()
   280	                        .and_then(|x| x.first())
   281	                        .and_then(discord_json::JsonValue::as_i64)
   282	                        .is_some()
   283	                    {
   284	                        vec![parse_ast(v, format!("{path}[2].{k}"), depth + 1)?]
   285	                    } else {
   286	                        let list = v.as_array().ok_or_else(bad)?;
   287	                        list.iter()
   288	                            .enumerate()
   289	                            .map(|(n, x)| parse_ast(x, format!("{path}[2].{k}[{n}]"), depth + 1))
   290	                            .collect::<Result<_, _>>()?
   291	                    };
   292	                    parsed.insert(k.clone(), nodes);
   293	                }
   294	                if typ == 5 {
   295	                    Ast::Select(name, parsed)
   296	                } else {
   297	                    Ast::Plural(
   298	                        name,
   299	                        parsed,
   300	                        a.get(3)
   301	                            .and_then(discord_json::JsonValue::as_i64)
   302	                            .unwrap_or(0),
   303	                        a.get(4)
   304	                            .and_then(discord_json::JsonValue::as_str)
   305	                            .unwrap_or("cardinal")
   306	                            .into(),
   307	                    )
   308	                }
   309	            }
   310	            7 => Ast::Pound,
   311	            8 => {
   312	                let tag = str_at(1)?;
   313	                let kids = children(2)?;
   314	                Ast::Tag(tag, kids, None)
   315	            }
   316	            _ => {
   317	                return Err(AstError {
   318	                    path,
   319	                    kind: "unknown node type",
   320	                });
   321	            }
   322	        });
   323	    }
   324	    if let Some(a) = v.as_array() {
   325	        let mut nodes = Vec::new();
   326	        for (i, x) in a.iter().enumerate() {
   327	            nodes.push(parse_ast(x, format!("{path}[{i}]"), depth + 1)?)
   328	        }
   329	        return Ok(Ast::Sequence(nodes));
   330	    }
   331	    Err(AstError {
   332	        path,
   333	        kind: "expected node",
   334	    })
   335	}
