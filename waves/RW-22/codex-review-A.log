     1	//! # discord-json
     2	//!
     3	//! Строгий JSON-парсер по RFC 8259 без внешних зависимостей и без `unsafe`.
     4	//!
     5	//! Foundation волны RW-22: используется i18n-каталогами (`ru-catalog.json`), RTC-кадрами
     6	//! голосовой сигнализации и read-only REST-ресурсами. Парсер не паникует на входе, хранит
     7	//! числа в исходном виде (чтобы не терять `u64`/точность) и возвращает ошибку с байтовым
     8	//! смещением, не включая содержимое документа в сообщение.
     9	//!
    10	//! Ограничения: [`MAX_DEPTH`] вложенных контейнеров, [`MAX_NODES`] значений на документ,
    11	//! запрет duplicate keys. Это защита от DoS на недоверенном JSON, а не «мягкий» режим.
    12	
    13	use std::collections::BTreeMap;
    14	use std::fmt;
    15	
    16	/// Максимальная вложенность массивов/объектов (128 уровней).
    17	pub const MAX_DEPTH: usize = 128;
    18	
    19	/// Максимальное число JSON-значений в одном документе.
    20	pub const MAX_NODES: usize = 4_000_000;
    21	
    22	/// JSON-значение.
    23	#[derive(Debug, Clone, PartialEq)]
    24	pub enum JsonValue {
    25	    /// `null`.
    26	    Null,
    27	    /// `true`/`false`.
    28	    Bool(bool),
    29	    /// Число в исходном лексическом виде.
    30	    Number(JsonNumber),
    31	    /// Строка.
    32	    String(String),
    33	    /// Массив.
    34	    Array(Vec<JsonValue>),
    35	    /// Объект с детерминированным порядком ключей.
    36	    Object(BTreeMap<String, JsonValue>),
    37	}
    38	
    39	impl JsonValue {
    40	    /// Число в исходном виде.
    41	    #[must_use]
    42	    pub fn as_number(&self) -> Option<&JsonNumber> {
    43	        match self {
    44	            Self::Number(value) => Some(value),
    45	            _ => None,
    46	        }
    47	    }
    48	
    49	    /// Строка.
    50	    #[must_use]
    51	    pub fn as_str(&self) -> Option<&str> {
    52	        match self {
    53	            Self::String(value) => Some(value),
    54	            _ => None,
    55	        }
    56	    }
    57	
    58	    /// Булево значение.
    59	    #[must_use]
    60	    pub fn as_bool(&self) -> Option<bool> {
    61	        match self {
    62	            Self::Bool(value) => Some(*value),
    63	            _ => None,
    64	        }
    65	    }
    66	
    67	    /// Массив.
    68	    #[must_use]
    69	    pub fn as_array(&self) -> Option<&[JsonValue]> {
    70	        match self {
    71	            Self::Array(value) => Some(value),
    72	            _ => None,
    73	        }
    74	    }
    75	
    76	    /// Объект.
    77	    #[must_use]
    78	    pub fn as_object(&self) -> Option<&BTreeMap<String, JsonValue>> {
    79	        match self {
    80	            Self::Object(value) => Some(value),
    81	            _ => None,
    82	        }
    83	    }
    84	
    85	    /// Значение объекта по ключу; для не-объекта — `None`.
    86	    #[must_use]
    87	    pub fn get(&self, key: &str) -> Option<&JsonValue> {
    88	        self.as_object()?.get(key)
    89	    }
    90	
    91	    /// Число как `i64` (только целые в диапазоне).
    92	    #[must_use]
    93	    pub fn as_i64(&self) -> Option<i64> {
    94	        self.as_number()?.as_i64()
    95	    }
    96	
    97	    /// Число как `u64` (только неотрицательные целые в диапазоне).
    98	    #[must_use]
    99	    pub fn as_u64(&self) -> Option<u64> {
   100	        self.as_number()?.as_u64()
   101	    }
   102	
   103	    /// Число как `f64` (для дробных/экспоненциальных форм).
   104	    #[must_use]
   105	    pub fn as_f64(&self) -> Option<f64> {
   106	        self.as_number()?.as_f64()
   107	    }
   108	
   109	    /// `true`, если значение — `null`.
   110	    #[must_use]
   111	    pub fn is_null(&self) -> bool {
   112	        matches!(self, Self::Null)
   113	    }
   114	}
   115	
   116	/// Число в исходном лексическом виде (без потери точности при разборе).
   117	#[derive(Debug, Clone, PartialEq, Eq)]
   118	pub struct JsonNumber(String);
   119	
   120	impl JsonNumber {
   121	    /// Целое неотрицательное число для программно собранного JSON.
   122	    #[must_use]
   123	    pub fn from_u64(value: u64) -> Self {
   124	        Self(value.to_string())
   125	    }
   126	
   127	    /// Целое число со знаком для программно собранного JSON.
   128	    #[must_use]
   129	    pub fn from_i64(value: i64) -> Self {
   130	        Self(value.to_string())
   131	    }
   132	
   133	    /// Исходная запись числа.
   134	    #[must_use]
   135	    pub fn as_str(&self) -> &str {
   136	        &self.0
   137	    }
   138	
   139	    /// Целое `i64`, если запись — целое в диапазоне.
   140	    #[must_use]
   141	    pub fn as_i64(&self) -> Option<i64> {
   142	        if self.0.contains(['.', 'e', 'E']) {
   143	            return None;
   144	        }
   145	        self.0.parse().ok()
   146	    }
   147	
   148	    /// Неотрицательное целое `u64`, если запись — целое в диапазоне.
   149	    #[must_use]
   150	    pub fn as_u64(&self) -> Option<u64> {
   151	        if self.0.starts_with('-') || self.0.contains(['.', 'e', 'E']) {
   152	            return None;
   153	        }
   154	        self.0.parse().ok()
   155	    }
   156	
   157	    /// Число как `f64`; `None` для не-конечных значений.
   158	    #[must_use]
   159	    pub fn as_f64(&self) -> Option<f64> {
   160	        self.0.parse::<f64>().ok().filter(|value| value.is_finite())
   161	    }
   162	}
   163	
   164	/// Вид ошибки разбора.
   165	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
   166	pub enum JsonErrorKind {
   167	    /// Вход закончился раньше, чем ожидалось.
   168	    UnexpectedEof,
   169	    /// Неожиданный байт.
   170	    UnexpectedByte(u8),
   171	    /// Некорректная запись числа.
   172	    InvalidNumber,
   173	    /// Неизвестная escape-последовательность.
   174	    InvalidEscape,
   175	    /// Некорректная Unicode-последовательность или одиночный surrogate.
   176	    InvalidUnicode,
   177	    /// Управляющий символ внутри строки.
   178	    ControlCharacter,
   179	    /// Повторяющийся ключ объекта.
   180	    DuplicateKey,
   181	    /// Превышена [`MAX_DEPTH`].
   182	    DepthLimit,
   183	    /// Превышен [`MAX_NODES`].
   184	    NodeLimit,
   185	    /// После значения остались непробельные байты.
   186	    TrailingData,
   187	}
   188	
   189	impl fmt::Display for JsonErrorKind {
   190	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   191	        match self {
   192	            Self::UnexpectedEof => f.write_str("unexpected end of input"),
   193	            Self::UnexpectedByte(byte) => write!(f, "unexpected byte 0x{byte:02x}"),
   194	            Self::InvalidNumber => f.write_str("invalid number"),
   195	            Self::InvalidEscape => f.write_str("invalid escape"),
   196	            Self::InvalidUnicode => f.write_str("invalid unicode escape"),
   197	            Self::ControlCharacter => f.write_str("unescaped control character in string"),
   198	            Self::DuplicateKey => f.write_str("duplicate object key"),
   199	            Self::DepthLimit => f.write_str("maximum nesting depth exceeded"),
   200	            Self::NodeLimit => f.write_str("maximum node count exceeded"),
   201	            Self::TrailingData => f.write_str("trailing data after value"),
   202	        }
   203	    }
   204	}
