   474	            self.pos += 1;
   475	            if !matches!(self.peek(), Some(b'0'..=b'9')) {
   476	                return Err(self.error(JsonErrorKind::InvalidNumber));
   477	            }
   478	            while matches!(self.peek(), Some(b'0'..=b'9')) {
   479	                self.pos += 1;
   480	            }
   481	        }
   482	        if matches!(self.peek(), Some(b'e' | b'E')) {
   483	            self.pos += 1;
   484	            if matches!(self.peek(), Some(b'+' | b'-')) {
   485	                self.pos += 1;
   486	            }
   487	            if !matches!(self.peek(), Some(b'0'..=b'9')) {
   488	                return Err(self.error(JsonErrorKind::InvalidNumber));
   489	            }
   490	            while matches!(self.peek(), Some(b'0'..=b'9')) {
   491	                self.pos += 1;
   492	            }
   493	        }
   494	        Ok(JsonNumber(self.input[start..self.pos].to_string()))
   495	    }
   496	
   497	    fn parse_string(&mut self) -> Result<String, JsonError> {
   498	        self.expect(b'"')?;
   499	        let mut out = Vec::new();
   500	        loop {
   501	            let byte = self
   502	                .peek()
   503	                .ok_or_else(|| self.error(JsonErrorKind::UnexpectedEof))?;
   504	            match byte {
   505	                b'"' => {
   506	                    self.pos += 1;
   507	                    return String::from_utf8(out)
   508	                        .map_err(|_| self.error(JsonErrorKind::InvalidUnicode));
   509	                }
   510	                b'\\' => {
   511	                    let escape_offset = self.pos;
   512	                    self.pos += 1;
   513	                    let escaped = self
   514	                        .peek()
   515	                        .ok_or_else(|| self.error(JsonErrorKind::UnexpectedEof))?;
   516	                    self.pos += 1;
   517	                    match escaped {
   518	                        b'"' => out.push(b'"'),
   519	                        b'\\' => out.push(b'\\'),
   520	                        b'/' => out.push(b'/'),
   521	                        b'b' => out.push(0x08),
   522	                        b'f' => out.push(0x0c),
   523	                        b'n' => out.push(b'\n'),
   524	                        b'r' => out.push(b'\r'),
   525	                        b't' => out.push(b'\t'),
   526	                        b'u' => {
   527	                            let first = self.parse_hex4(escape_offset)?;
   528	                            let code = if (0xd800..=0xdbff).contains(&first) {
   529	                                if self.bytes.get(self.pos..self.pos + 2) != Some(b"\\u") {
   530	                                    return Err(
   531	                                        self.error_at(escape_offset, JsonErrorKind::InvalidUnicode)
   532	                                    );
   533	                                }
   534	                                self.pos += 2;
   535	                                let second = self.parse_hex4(escape_offset)?;
   536	                                if !(0xdc00..=0xdfff).contains(&second) {
   537	                                    return Err(
   538	                                        self.error_at(escape_offset, JsonErrorKind::InvalidUnicode)
   539	                                    );
   540	                                }
   541	                                let code = 0x1_0000
   542	                                    + ((u32::from(first) - 0xd800) << 10)
   543	                                    + (u32::from(second) - 0xdc00);
   544	                                char::from_u32(code).ok_or_else(|| {
   545	                                    self.error_at(escape_offset, JsonErrorKind::InvalidUnicode)
   546	                                })?
   547	                            } else if (0xdc00..=0xdfff).contains(&first) {
   548	                                return Err(
   549	                                    self.error_at(escape_offset, JsonErrorKind::InvalidUnicode)
   550	                                );
   551	                            } else {
   552	                                char::from_u32(u32::from(first)).ok_or_else(|| {
   553	                                    self.error_at(escape_offset, JsonErrorKind::InvalidUnicode)
   554	                                })?
   555	                            };
   556	                            let mut buffer = [0u8; 4];
   557	                            out.extend_from_slice(code.encode_utf8(&mut buffer).as_bytes());
   558	                        }
   559	                        _ => {
   560	                            return Err(self.error_at(escape_offset, JsonErrorKind::InvalidEscape));
   561	                        }
   562	                    }
   563	                }
   564	                0x00..=0x1f => {
   565	                    return Err(self.error(JsonErrorKind::ControlCharacter));
   566	                }
   567	                _ => {
   568	                    let ch = self.input[self.pos..]
   569	                        .chars()
   570	                        .next()
   571	                        .ok_or_else(|| self.error(JsonErrorKind::UnexpectedEof))?;
   572	                    let mut buffer = [0u8; 4];
   573	                    out.extend_from_slice(ch.encode_utf8(&mut buffer).as_bytes());
   574	                    self.pos += ch.len_utf8();
   575	                }
   576	            }
   577	        }
   578	    }
   579	
   580	    fn parse_hex4(&mut self, escape_offset: usize) -> Result<u16, JsonError> {
   581	        let Some(slice) = self.bytes.get(self.pos..self.pos + 4) else {
   582	            return Err(self.error_at(escape_offset, JsonErrorKind::InvalidUnicode));
   583	        };
   584	        let mut value = 0u16;
   585	        for byte in slice {
   586	            let digit = match byte {
   587	                b'0'..=b'9' => u16::from(byte - b'0'),
   588	                b'a'..=b'f' => u16::from(byte - b'a') + 10,
   589	                b'A'..=b'F' => u16::from(byte - b'A') + 10,
   590	                _ => {
   591	                    return Err(self.error_at(escape_offset, JsonErrorKind::InvalidUnicode));
   592	                }
   593	            };
   594	            value = (value << 4) | digit;
   595	        }
   596	        self.pos += 4;
   597	        Ok(value)
   598	    }
   599	}

