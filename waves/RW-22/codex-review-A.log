   411	                return Err(self.error_at(key_offset, JsonErrorKind::DuplicateKey));
   412	            }
   413	            self.skip_ws();
   414	            match self.peek() {
   415	                Some(b',') => {
   416	                    self.pos += 1;
   417	                }
   418	                Some(b'}') => {
   419	                    self.pos += 1;
   420	                    return Ok(JsonValue::Object(object));
   421	                }
   422	                Some(other) => return Err(self.error(JsonErrorKind::UnexpectedByte(other))),
   423	                None => return Err(self.error(JsonErrorKind::UnexpectedEof)),
   424	            }
   425	        }
   426	    }
