   290	/// Разобрать JSON-документ.
   291	///
   292	/// # Errors
   293	///
   294	/// Любое нарушение RFC 8259, duplicate keys, превышение [`MAX_DEPTH`]/[`MAX_NODES`] или
   295	/// непробельные байты после значения.
   296	pub fn parse(input: &str) -> Result<JsonValue, JsonError> {
