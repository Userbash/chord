    52	#[test]
    53	fn numbers_preserve_raw_and_parse_integers() {
    54	    let cases = [
    55	        ("0", Some(0), Some(0)),
    56	        ("-0", Some(0), None),
    57	        (
    58	            "9007199254740993",
    59	            Some(9007199254740993),
    60	            Some(9007199254740993),
    61	        ),
    62	        ("-42", Some(-42), None),
    63	        ("1.0", None, None),
    64	        ("1e3", None, None),
    65	        ("18446744073709551615", None, Some(18446744073709551615)),
    66	    ];
    67	    for (raw, i64_expected, u64_expected) in cases {
    68	        let value = parse(raw).unwrap();
    69	        let number = value.as_number().expect("number");
    70	        assert_eq!(number.as_i64(), i64_expected, "i64 raw={raw}");
    71	        assert_eq!(number.as_u64(), u64_expected, "u64 raw={raw}");
    72	        assert!(!number.as_str().is_empty());
    73	    }
    74	    assert_eq!(parse("1e3").unwrap().as_f64(), Some(1000.0));
    75	}
