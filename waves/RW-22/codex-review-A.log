   152	#[test]
   153	fn truncated_inputs_never_panic() {
   154	    let samples = [
   155	        r#"{"op":8,"d":{"v":8,"heartbeat_interval":13750}}"#,
   156	        r##"[1,"count",{"one":"# участник","few":"# участника","other":"# участников"}]"##,
   157	        r#"{"a":["\uD83D\uDE00",-1.5e-3,true,null]}"#,
   158	    ];
   159	    for sample in samples {
   160	        for end in 0..=sample.len() {
   161	            if !sample.is_char_boundary(end) {
   162	                continue;
   163	            }
   164	            let prefix = &sample[..end];
   165	            let result = catch_unwind(AssertUnwindSafe(|| parse(prefix)));
   166	            assert!(result.is_ok(), "panic on prefix {prefix:?}");
   167	        }
   168	    }
   169	}
