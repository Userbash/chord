new file mode 100644
index 0000000000000000000000000000000000000000..2b36c5a7347bfc54bc29cea4df7ded98614bd21a
--- /dev/null
+++ b//tmp/w24b-preload.cjs
@@ -0,0 +1,8 @@
+const childProcess = require('node:child_process');
+const original = childProcess.execFileSync;
+childProcess.execFileSync = function patchedExecFileSync(command, args, options) {
+  if (command === 'rustc' && args?.[0] === '-vV') {
+    return 'rustc 1.99.0\nhost: x86_64-unknown-linux-gnu\n';
+  }
+  return original.call(this, command, args, options);
+};
