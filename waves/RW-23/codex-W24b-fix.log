#!/usr/bin/env node
// @ts-check

import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const allowlist = new Set([
  'MIT', 'Apache-2.0', 'BSD-2-Clause', 'BSD-3-Clause', 'ISC', 'Unicode-3.0',
  'Zlib', 'MPL-2.0', 'CC0-1.0', 'Unlicense', '0BSD', 'CDLA-Permissive-2.0',
  'LLVM-exception',
]);

/** @typedef {{name:string,version:string,license?:string,source?:string}} MetaPackage */
/** @typedef {{id:string,deps?:Array<{pkg:string}>}} MetaNode */

/** @param {string} text */
function hostTarget(text) {
  const match = text.match(/^host:\s*(\S+)$/m);
  if (!match) throw new Error('rustc -vV: не найден host target');
  return match[1];
}

/** @returns {{packages: MetaPackage[], nodes: MetaNode[], workspace: string[]}} */
function loadMetadata() {
  const rustc = execFileSync('rustc', ['-vV'], { encoding: 'utf8' });
  const target = process.env.SBOM_TARGET || hostTarget(rustc);
  const args = [
    'metadata', '--offline', '--format-version', '1', '--filter-platform', target,
    '--manifest-path', join(root, 'rust', 'Cargo.toml'),
  ];
  let text;
  try {
    text = execFileSync('cargo', args, {
      cwd: root, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024,
    });
  } catch (error) {
    // Some sandboxes report EPERM after Cargo has exited 0 and emitted complete JSON.
    if (!(error && typeof error === 'object' && 'status' in error && error.status === 0 && 'stdout' in error)) {
      throw error;
    }
    text = String(error.stdout);
  }
  const parsed = JSON.parse(text);
  const nodes = Array.isArray(parsed.resolve?.nodes) ? parsed.resolve.nodes : [];
  return { packages: parsed.packages, nodes, workspace: parsed.workspace_members };
}

/** @param {string} name @param {string} version */
function spdxId(name, version) {
  return `SPDXRef-Package-${name}-${version}`.replace(/[^A-Za-z0-9.-]/g, '-');
}

/**
 * Strict enough SPDX expression parser for the license IDs used by Cargo.
 * OR needs one allowed branch; AND needs all; WITH needs base and exception.
 * @param {string} expression
 */
function allowedLicense(expression) {
  const tokens = expression.match(/\(|\)|[A-Za-z0-9.+-]+/g) || [];
  let at = 0;
  const peek = () => tokens[at];
  const take = () => tokens[at++];
  const allowedAtom = () => {
    const id = take();
    if (!id || id === '(' || id === ')' || /^(AND|OR|WITH)$/i.test(id)) return false;
    if (peek()?.toUpperCase() === 'WITH') {
      take();
      const exception = take();
      return allowlist.has(id) && Boolean(exception) && allowlist.has(exception);
    }
    return allowlist.has(id);
  };
  const allowedAnd = () => {
    let value = allowedFactor();
    while (peek()?.toUpperCase() === 'AND') {
      take();
      value = allowedFactor() && value;
    }
    return value;
  };
  const allowedFactor = () => {
    if (peek() === '(') {
      take();
      const value = allowedOr();
      if (take() !== ')') return false;
      return value;
    }
    return allowedAtom();
  };
  const allowedOr = () => {
    let value = allowedAnd();
    while (peek()?.toUpperCase() === 'OR') {
      take();
      value = allowedAnd() || value;
    }
    return value;
  };
  const result = allowedOr();
  return result && at === tokens.length;
}

/** @param {string} lockText @param {ReturnType<typeof loadMetadata>} metadata */
function buildDocument(lockText, metadata) {
  const byId = new Map(metadata.packages.map((pkg) => [pkg.id, pkg]));
  const packages = metadata.packages
    .slice()
    .sort((left, right) => `${left.name}@${left.version}`.localeCompare(`${right.name}@${right.version}`))
    .map((pkg) => ({
      name: pkg.name,
      SPDXID: spdxId(pkg.name, pkg.version),
      versionInfo: pkg.version,
      downloadLocation: pkg.source?.startsWith('registry+')
        ? `https://crates.io/api/v1/crates/${encodeURIComponent(pkg.name)}/${encodeURIComponent(pkg.version)}/download`
        : 'NOASSERTION',
      filesAnalyzed: false,
      licenseDeclared: pkg.license || 'NOASSERTION',
      licenseConcluded: 'NOASSERTION',
      copyrightText: 'NOASSERTION',
      externalRefs: [{
        referenceCategory: 'PACKAGE-MANAGER',
        referenceType: 'purl',
        referenceLocator: `pkg:cargo/${encodeURIComponent(pkg.name)}@${encodeURIComponent(pkg.version)}`,
      }],
    }));

  const relationships = metadata.workspace
    .map((id) => byId.get(id))
    .filter(Boolean)
    .map((pkg) => ({
      spdxElementId: 'SPDXRef-DOCUMENT',
      relationshipType: 'DESCRIBES',
      relatedSpdxElement: spdxId(pkg.name, pkg.version),
    }));
  for (const node of metadata.nodes) {
    const from = byId.get(node.id);
    if (!from) continue;
    for (const dep of node.deps || []) {
      const to = byId.get(dep.pkg);
      if (!to) continue;
      relationships.push({
        spdxElementId: spdxId(from.name, from.version),
        relationshipType: 'DEPENDS_ON',
        relatedSpdxElement: spdxId(to.name, to.version),
      });
    }
  }

  const epoch = Number.parseInt(process.env.SOURCE_DATE_EPOCH || '0', 10);
  if (!Number.isFinite(epoch) || epoch < 0) throw new Error('SOURCE_DATE_EPOCH должен быть неотрицательным целым');
  return {
    spdxVersion: 'SPDX-2.3',
    dataLicense: 'CC0-1.0',
    SPDXID: 'SPDXRef-DOCUMENT',
    name: 'discord-lab-rust-workspace',
    documentNamespace: `https://discord-lab.local/spdx/${createHash('sha256').update(lockText).digest('hex')}`,
    creationInfo: {
      created: new Date(epoch * 1000).toISOString().replace('.000Z', 'Z'),
      creators: ['Tool: discord-lab-sbom'],
      licenseListVersion: '3.25',
    },
    packages,
    relationships,
  };
}

function main() {
  const args = process.argv.slice(2);
  let output = join(root, 'rust', 'dist', 'sbom.spdx.json');
  let check = false;
  let dryRun = false;
  /** @type {string|null} */
  let checkLicense = null;
  for (let i = 0; i < args.length; i += 1) {
    if (args[i] === '--output' && args[i + 1]) output = resolve(args[++i]);
    else if (args[i] === '--check') check = true;
    else if (args[i] === '--dry-run') dryRun = true;
    else if (args[i] === '--check-license' && args[i + 1]) checkLicense = args[++i];
    else throw new Error(`Неизвестный или неполный аргумент: ${args[i]}`);
  }
  if (checkLicense !== null) {
    if (allowedLicense(checkLicense)) return 0;
    console.error(`sbom: запрещённая лицензия: ${checkLicense}`);
    return 1;
  }

  const lockText = readFileSync(join(root, 'rust', 'Cargo.lock'), 'utf8');
  const document = buildDocument(lockText, loadMetadata());
  if (check) {
    const rejected = document.packages.filter((pkg) => !allowedLicense(pkg.licenseDeclared));
    if (rejected.length) {
      for (const pkg of rejected) console.error(`sbom: ${pkg.name}@${pkg.versionInfo}: ${pkg.licenseDeclared}`);
      return 1;
    }
  }
  if (dryRun) {
    console.log(`sbom: SPDX-2.3, ${document.packages.length} packages, output=${output}`);
    return 0;
  }
  mkdirSync(dirname(output), { recursive: true });
  writeFileSync(output, `${JSON.stringify(document, null, 2)}\n`);
  console.log(`sbom: создан ${output} (${document.packages.length} packages)`);
  return 0;
}

try {
  process.exitCode = main();
} catch (error) {
  console.error(`sbom: ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 1;
}

