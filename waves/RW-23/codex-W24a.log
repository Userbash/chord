+        if !address_bytes.is_ascii() {
+            return Err(UdpError::InvalidAddress);
+        }
+        let end = address_bytes.iter().position(|byte| *byte == 0).unwrap_or(64);
+        if address_bytes[end..].iter().any(|byte| *byte != 0) {
+            return Err(UdpError::InvalidAddress);
+        }
+        let address = std::str::from_utf8(&address_bytes[..end]).map_err(|_| UdpError::InvalidAddress)?;
+        if address.is_empty() || address.bytes().any(|byte| byte.is_ascii_control() || byte == b' ') {
+            return Err(UdpError::InvalidAddress);
+        }
+        let port = u16::from_be_bytes([bytes[72], bytes[73]]);
+        if port == 0 {
+            return Err(UdpError::InvalidPort);
+        }
+        Ok(Self::Response { ssrc, address: address.to_owned(), port })
+    }
+
+    #[must_use]
+    pub fn encode(&self) -> [u8; DISCOVERY_LEN] {
+        let mut bytes = [0; DISCOVERY_LEN];
+        match self {
+            Self::Request { ssrc } => {
+                bytes[1] = 1;
+                bytes[4..8].copy_from_slice(&ssrc.to_be_bytes());
+            }
+            Self::Response { ssrc, address, port } => {
+                bytes[1] = 2;
+                bytes[4..8].copy_from_slice(&ssrc.to_be_bytes());
+                let address_bytes = address.as_bytes();
+                let count = address_bytes.len().min(64);
+                bytes[8..8 + count].copy_from_slice(&address_bytes[..count]);
+                bytes[72..74].copy_from_slice(&port.to_be_bytes());
+            }
+        }
+        bytes[3] = 0x46;
+        bytes
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RotationAction {
+    pub discovery: [u8; DISCOVERY_LEN],
+    pub empty_rr: [u8; 28],
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RotationSchedule {
+    started_at_ms: u64,
+    rotations: u64,
+}
+
+impl RotationSchedule {
+    #[must_use]
+    pub const fn new(started_at_ms: u64) -> Self {
+        Self { started_at_ms, rotations: 0 }
+    }
+
+    #[must_use]
+    pub fn due(&self, now_ms: u64) -> bool {
+        let windows = self.rotations.saturating_add(1);
+        now_ms.saturating_sub(self.started_at_ms) >= MEDIA_ROTATION_MS.saturating_mul(windows)
+    }
+
+    #[must_use]
+    pub fn action(&self, ssrc: u32) -> RotationAction {
+        RotationAction {
+            discovery: DiscoveryPacket::Request { ssrc }.encode(),
+            empty_rr: empty_receiver_report(ssrc),
+        }
+    }
+}
+
+pub struct UdpMediaSocket {
+    socket: Option<UdpSocket>,
+    bind_addr: String,
+    server: Option<SocketAddr>,
+    ssrc: Option<u32>,
+}
+
+impl fmt::Debug for UdpMediaSocket {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("UdpMediaSocket").field("local_addr", &self.local_addr().ok()).finish()
+    }
+}
+
+impl UdpMediaSocket {
+    pub fn bind(addr: &str) -> Result<Self, UdpError> {
+        let socket = UdpSocket::bind(addr)?;
+        let local_ip = socket.local_addr()?.ip().to_string();
+        Ok(Self { socket: Some(socket), bind_addr: format!("{local_ip}:0"), server: None, ssrc: None })
+    }
+
+    fn socket(&self) -> Result<&UdpSocket, UdpError> {
+        self.socket.as_ref().ok_or(UdpError::Closed)
+    }
+
+    pub fn local_addr(&self) -> Result<SocketAddr, UdpError> { Ok(self.socket()?.local_addr()?) }
+
+    pub fn send_to(&self, bytes: &[u8], target: SocketAddr) -> Result<usize, UdpError> {
+        Ok(self.socket()?.send_to(bytes, target)?)
+    }
+
+    pub fn recv_from(&self, bytes: &mut [u8]) -> Result<(usize, SocketAddr), UdpError> {
+        Ok(self.socket()?.recv_from(bytes)?)
+    }
+
+    pub fn send_discovery(&mut self, server: SocketAddr, ssrc: u32) -> Result<(), UdpError> {
+        self.send_to(&DiscoveryPacket::Request { ssrc }.encode(), server)?;
+        self.server = Some(server);
+        self.ssrc = Some(ssrc);
+        Ok(())
+    }
+
+    pub fn recv_discovery(&self) -> Result<DiscoveryPacket, UdpError> {
+        let mut bytes = [0; DISCOVERY_LEN];
+        let (size, _) = self.recv_from(&mut bytes)?;
+        DiscoveryPacket::parse(&bytes[..size])
+    }
+
+    pub fn send_keepalive(&self, server: SocketAddr) -> Result<(), UdpError> {
+        self.send_to(&KEEPALIVE_REQUEST, server)?;
+        Ok(())
+    }
+
+    pub fn recv_keepalive(&self) -> Result<[u8; KEEPALIVE_LEN], UdpError> {
+        let mut bytes = [0; KEEPALIVE_LEN];
+        let (size, _) = self.recv_from(&mut bytes)?;
+        if size != KEEPALIVE_LEN { return Err(UdpError::InvalidLength); }
+        if bytes == KEEPALIVE_RESPONSE || bytes == KEEPALIVE_REQUEST { Ok(bytes) } else { Err(UdpError::InvalidType) }
+    }
+
+    pub fn send_empty_rr(&self, server: SocketAddr, ssrc: u32) -> Result<(), UdpError> {
+        self.send_to(&empty_receiver_report(ssrc), server)?;
+        Ok(())
+    }
+
+    pub fn set_read_timeout(&self, timeout: Option<Duration>) -> Result<(), UdpError> {
+        self.socket()?.set_read_timeout(timeout)?;
+        Ok(())
+    }
+
+    pub fn rotate(&mut self) -> Result<(), UdpError> {
+        let server = self.server.ok_or(UdpError::InvalidAddress)?;
+        let ssrc = self.ssrc.ok_or(UdpError::InvalidAddress)?;
+        self.socket.take();
+        self.socket = Some(UdpSocket::bind(&self.bind_addr)?);
+        let action = RotationSchedule::new(0).action(ssrc);
+        self.send_to(&action.discovery, server)?;
+        self.send_to(&action.empty_rr, server)?;
+        Ok(())
+    }
+}
+
+#[must_use]
+pub fn empty_receiver_report(ssrc: u32) -> [u8; 28] {
+    let mut bytes = [0; 28];
+    bytes[..4].copy_from_slice(&[0x80, 0xc9, 0, 7]);
+    bytes[4..8].copy_from_slice(&ssrc.to_be_bytes());
+    bytes
+}
