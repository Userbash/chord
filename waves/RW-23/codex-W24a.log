+        address: "95.164.91.98".into(),
+        port: 35251,
+    }));
+}
+
+#[test]
+fn response_round_trips_and_rejects_malformed_fields() {
+    let packet = DiscoveryPacket::Response { ssrc: 0x12345678, address: "127.0.0.1".into(), port: 19329 };
+    assert_eq!(DiscoveryPacket::parse(&packet.encode()), Ok(packet));
+    let valid = decode_hex(RESPONSE_HEX);
+    for size in [73, 75] {
+        let mut bytes = valid.clone();
+        bytes.resize(size, 0);
+        assert_eq!(DiscoveryPacket::parse(&bytes), Err(UdpError::InvalidLength));
+    }
+    let mut bytes = valid.clone(); bytes[1] = 3;
+    assert_eq!(DiscoveryPacket::parse(&bytes), Err(UdpError::InvalidType));
+    let mut bytes = valid.clone(); bytes[3] = 0x45;
+    assert_eq!(DiscoveryPacket::parse(&bytes), Err(UdpError::InvalidLengthField));
+    let mut bytes = valid.clone(); bytes[8] = 0x7f;
+    assert_eq!(DiscoveryPacket::parse(&bytes), Err(UdpError::InvalidAddress));
+    let mut bytes = valid.clone(); bytes[8] = b'a'; bytes[9] = 0; bytes[10] = b'x';
+    assert_eq!(DiscoveryPacket::parse(&bytes), Err(UdpError::InvalidAddress));
+    let mut bytes = valid; bytes[72] = 0; bytes[73] = 0;
+    assert_eq!(DiscoveryPacket::parse(&bytes), Err(UdpError::InvalidPort));
+    assert_eq!(DiscoveryPacket::parse(&[0; 73]), Err(UdpError::InvalidLength));
+}
