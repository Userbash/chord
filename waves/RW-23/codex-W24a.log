+pub const MEDIA_ROTATION_MS: u64 = 60_080;
+pub const KEEPALIVE_REQUEST: [u8; 8] = [0x13, 0x37, 0xca, 0xfe, 1, 0, 0, 0];
+pub const KEEPALIVE_RESPONSE: [u8; 8] = [0x13, 0x37, 0xf0, 0x0d, 1, 0, 0, 0];
