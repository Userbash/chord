+    match UdpSocket::bind("127.0.0.1:0") {
+        Ok(socket) => Some(socket),
+        Err(error) if error.kind() == std::io::ErrorKind::PermissionDenied => {
+            eprintln!("skip: loopback UDP unavailable: {error}");
+            None
+        }
+        Err(error) => panic!("loopback bind failed: {error}"),
+    }
+}
