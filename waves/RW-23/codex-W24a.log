+#[test]
+fn empty_receiver_report_has_exact_rtcp_header_and_ssrc() {
+    let packet = empty_receiver_report(0x000023f8);
+    assert_eq!(packet.len(), 28);
+    assert_eq!(&packet[..8], &[0x80, 0xc9, 0, 7, 0, 0, 0x23, 0xf8]);
