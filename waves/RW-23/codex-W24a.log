+    assert_eq!(KEEPALIVE_RESPONSE, [0x13, 0x37, 0xf0, 0x0d, 1, 0, 0, 0]);
+    assert_eq!(KEEPALIVE_INTERVAL_MS, 5_000);
+}
+
