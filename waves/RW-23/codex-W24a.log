diff --git a/rust/crates/discord-voice/src/udp.rs b/rust/crates/discord-voice/src/udp.rs
index 7c370c52c8cb0c9adc8aec070fc58d1175dd89ad..015f87fd5f3e78e27faf34de0a42ceb66f204325
--- a/rust/crates/discord-voice/src/udp.rs
