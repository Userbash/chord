+    let action = schedule.action(9208);
+    assert_eq!(DiscoveryPacket::parse(&action.discovery), Ok(DiscoveryPacket::Request { ssrc: 9208 }));
+    assert_eq!(action.empty_rr, empty_receiver_report(9208));
+}
