   246	            socket: Some(socket),
   247	            bind_addr: format!("{local_ip}:0"),
   248	            server: None,
   249	            ssrc: None,
   250	            keepalive_sequence: 0,
   251	        })
   252	    }
   253	
   254	    fn socket(&self) -> Result<&UdpSocket, UdpError> {
   255	        self.socket.as_ref().ok_or(UdpError::Closed)
   256	    }
   257	
   258	    pub fn local_addr(&self) -> Result<SocketAddr, UdpError> {
   259	        Ok(self.socket()?.local_addr()?)
   260	    }
   261	
   262	    pub fn send_to(&self, bytes: &[u8], target: SocketAddr) -> Result<usize, UdpError> {
   263	        Ok(self.socket()?.send_to(bytes, target)?)
   264	    }
   265	
   266	    pub fn recv_from(&self, bytes: &mut [u8]) -> Result<(usize, SocketAddr), UdpError> {
   267	        Ok(self.socket()?.recv_from(bytes)?)
   268	    }
   269	
   270	    pub fn send_discovery(&mut self, server: SocketAddr, ssrc: u32) -> Result<(), UdpError> {
   271	        let port = self.local_addr()?.port();
   272	        self.send_to(&DiscoveryPacket::Request { ssrc, port }.encode(), server)?;
   273	        self.server = Some(server);
   274	        self.ssrc = Some(ssrc);
   275	        Ok(())
   276	    }
   277	
   278	    pub fn recv_discovery(&self) -> Result<DiscoveryPacket, UdpError> {
   279	        let mut bytes = [0; 128];
   280	        let (size, _) = self.recv_from(&mut bytes)?;
   281	        if size > DISCOVERY_LEN {
   282	            return Err(UdpError::InvalidLength);
   283	        }
   284	        DiscoveryPacket::parse(&bytes[..size])
   285	    }
   286	
   287	    pub fn send_keepalive(&mut self, server: SocketAddr) -> Result<(), UdpError> {
   288	        self.keepalive_sequence = self.keepalive_sequence.wrapping_add(1);
   289	        self.send_to(&keepalive_request(self.keepalive_sequence), server)?;
   290	        Ok(())
   291	    }
   292	
   293	    pub fn recv_keepalive(&self) -> Result<[u8; KEEPALIVE_LEN], UdpError> {
   294	        let mut bytes = [0; 128];
   295	        let (size, _) = self.recv_from(&mut bytes)?;
   296	        if size != KEEPALIVE_LEN {
   297	            return Err(UdpError::InvalidLength);
   298	        }
   299	        let packet: [u8; KEEPALIVE_LEN] = bytes[..KEEPALIVE_LEN]
   300	            .try_into()
   301	            .map_err(|_| UdpError::InvalidLength)?;
   302	        if packet[..4] == KEEPALIVE_RESPONSE[..4] || packet[..4] == KEEPALIVE_REQUEST[..4] {
   303	            Ok(packet)
   304	        } else {
   305	            Err(UdpError::InvalidType)
   306	        }
   307	    }
   308	
   309	    pub fn send_empty_rr(&self, server: SocketAddr, ssrc: u32) -> Result<(), UdpError> {
   310	        self.send_to(&empty_receiver_report(ssrc), server)?;
   311	        Ok(())
   312	    }
   313	
   314	    pub fn set_read_timeout(&self, timeout: Option<Duration>) -> Result<(), UdpError> {
   315	        self.socket()?.set_read_timeout(timeout)?;
   316	        Ok(())
   317	    }
   318	
   319	    pub fn rotate(&mut self) -> Result<(), UdpError> {
   320	        let server = self.server.ok_or(UdpError::InvalidAddress)?;
   321	        let ssrc = self.ssrc.ok_or(UdpError::InvalidAddress)?;
   322	        self.socket.take();
   323	        self.socket = Some(UdpSocket::bind(&self.bind_addr)?);
   324	        self.send_discovery(server, ssrc)?;
   325	        self.send_empty_rr(server, ssrc)?;
   326	        Ok(())
   327	    }
   328	}
   329	
   330	#[must_use]
   331	pub fn empty_receiver_report(ssrc: u32) -> [u8; 28] {
   332	    let mut bytes = [0; 28];
   333	    bytes[..4].copy_from_slice(&[0x80, 0xc9, 0, 7]);
   334	    bytes[4..8].copy_from_slice(&ssrc.to_be_bytes());
   335	    bytes
   336	}

