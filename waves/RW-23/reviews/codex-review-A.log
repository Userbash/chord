   195	
   196	impl RotationSchedule {
   197	    #[must_use]
   198	    pub const fn new(started_at_ms: u64) -> Self {
   199	        Self {
   200	            started_at_ms,
   201	            rotations: 0,
   202	        }
   203	    }
   204	
   205	    #[must_use]
   206	    pub fn due(&mut self, now_ms: u64) -> bool {
   207	        let windows = self.rotations.saturating_add(1);
   208	        let due =
   209	            now_ms.saturating_sub(self.started_at_ms) >= MEDIA_ROTATION_MS.saturating_mul(windows);
   210	        if due {
   211	            self.rotations = self.rotations.saturating_add(1);
   212	        }
   213	        due
   214	    }
