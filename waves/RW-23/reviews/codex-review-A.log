    31	fn loopback_socket() -> Option<UdpSocket> {
    32	    match UdpSocket::bind("127.0.0.1:0") {
    33	        Ok(socket) => Some(socket),
    34	        Err(error) if error.kind() == std::io::ErrorKind::PermissionDenied => {
    35	            eprintln!("skip: loopback UDP unavailable: {error}");
    36	            None
    37	        }
    38	        Err(error) => panic!("loopback bind failed: {error}"),
    39	    }
    40	}
    41	
    42	fn loopback_client() -> Option<UdpMediaSocket> {
    43	    match UdpMediaSocket::bind("127.0.0.1:0") {
    44	        Ok(socket) => Some(socket),
    45	        Err(UdpError::Io(error)) if error.kind() == std::io::ErrorKind::PermissionDenied => {
    46	            eprintln!("skip: loopback UDP unavailable: {error}");
    47	            None
    48	        }
    49	        Err(error) => panic!("loopback client bind failed: {error}"),
    50	    }
    51	}
