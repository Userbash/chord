    13	fn decode_hex(value: &str) -> Vec<u8> {
    14	    let bytes = value.as_bytes();
    15	    assert_eq!(bytes.len() % 2, 0, "hex fixture must have an even length");
    16	    bytes
    17	        .as_chunks::<2>()
    18	        .0
    19	        .iter()
    20	        .map(|pair| {
    21	            let digit = |byte| match byte {
    22	                b'0'..=b'9' => byte - b'0',
    23	                b'a'..=b'f' => byte - b'a' + 10,
    24	                _ => panic!("bad test hex"),
    25	            };
    26	            (digit(pair[0]) << 4) | digit(pair[1])
    27	        })
    28	        .collect()
    29	}
