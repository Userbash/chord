   104	impl DiscoveryPacket {
   105	    pub fn parse(bytes: &[u8]) -> Result<Self, UdpError> {
   106	        if bytes.len() != DISCOVERY_LEN {
   107	            return Err(UdpError::InvalidLength);
   108	        }
   109	        let kind = u16::from_be_bytes([bytes[0], bytes[1]]);
   110	        if kind != 1 && kind != 2 {
   111	            return Err(UdpError::InvalidType);
   112	        }
   113	        if u16::from_be_bytes([bytes[2], bytes[3]]) != 0x46 {
   114	            return Err(UdpError::InvalidLengthField);
   115	        }
   116	        let ssrc = u32::from_be_bytes([bytes[4], bytes[5], bytes[6], bytes[7]]);
   117	        let port = u16::from_be_bytes([bytes[72], bytes[73]]);
   118	        if kind == 1 {
   119	            if bytes[8..72].iter().any(|byte| *byte != 0) {
   120	                return Err(UdpError::InvalidAddress);
   121	            }
   122	            return Ok(Self::Request { ssrc, port });
   123	        }
   124	        let address_bytes = &bytes[8..72];
   125	        if !address_bytes.is_ascii() {
   126	            return Err(UdpError::InvalidAddress);
   127	        }
   128	        let end = address_bytes
   129	            .iter()
   130	            .position(|byte| *byte == 0)
   131	            .unwrap_or(64);
   132	        if address_bytes[end..].iter().any(|byte| *byte != 0) {
   133	            return Err(UdpError::InvalidAddress);
   134	        }
   135	        let address =
   136	            std::str::from_utf8(&address_bytes[..end]).map_err(|_| UdpError::InvalidAddress)?;
   137	        if address.is_empty()
   138	            || address
   139	                .bytes()
   140	                .any(|byte| byte.is_ascii_control() || byte == b' ')
   141	        {
   142	            return Err(UdpError::InvalidAddress);
   143	        }
   144	        address
   145	            .parse::<std::net::IpAddr>()
   146	            .map_err(|_| UdpError::InvalidAddress)?;
   147	        if port == 0 {
   148	            return Err(UdpError::InvalidPort);
   149	        }
   150	        Ok(Self::Response {
   151	            ssrc,
   152	            address: address.to_owned(),
   153	            port,
   154	        })
   155	    }
   156	
   157	    #[must_use]
   158	    pub fn encode(&self) -> [u8; DISCOVERY_LEN] {
   159	        let mut bytes = [0; DISCOVERY_LEN];
   160	        match self {
   161	            Self::Request { ssrc, port } => {
   162	                bytes[1] = 1;
   163	                bytes[4..8].copy_from_slice(&ssrc.to_be_bytes());
   164	                bytes[72..74].copy_from_slice(&port.to_be_bytes());
   165	            }
   166	            Self::Response {
   167	                ssrc,
   168	                address,
   169	                port,
   170	            } => {
   171	                bytes[1] = 2;
   172	                bytes[4..8].copy_from_slice(&ssrc.to_be_bytes());
   173	                let address_bytes = address.as_bytes();
   174	                let count = address_bytes.len().min(64);
   175	                bytes[8..8 + count].copy_from_slice(&address_bytes[..count]);
   176	                bytes[72..74].copy_from_slice(&port.to_be_bytes());
   177	            }
   178	        }
   179	        bytes[3] = 0x46;
   180	        bytes
   181	    }
   182	}
