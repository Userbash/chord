   217	    pub fn action(&self, ssrc: u32) -> RotationAction {
   218	        RotationAction {
   219	            discovery: DiscoveryPacket::Request { ssrc, port: 0 }.encode(),
   220	            empty_rr: empty_receiver_report(ssrc),
