    56	impl PartialEq for UdpError {
    57	    fn eq(&self, other: &Self) -> bool {
    58	        match (self, other) {
    59	            (Self::InvalidLength, Self::InvalidLength)
    60	            | (Self::InvalidType, Self::InvalidType)
    61	            | (Self::InvalidLengthField, Self::InvalidLengthField)
    62	            | (Self::InvalidAddress, Self::InvalidAddress)
    63	            | (Self::InvalidPort, Self::InvalidPort)
    64	            | (Self::Timeout, Self::Timeout)
    65	            | (Self::Closed, Self::Closed) => true,
    66	            (Self::Io(left), Self::Io(right)) => left.kind() == right.kind(),
    67	            _ => false,
    68	        }
    69	    }
    70	}
