    62	            | (Self::InvalidAddress, Self::InvalidAddress)
    63	            | (Self::InvalidPort, Self::InvalidPort)
    64	            | (Self::Timeout, Self::Timeout)
    65	            | (Self::Closed, Self::Closed) => true,
    66	            (Self::Io(left), Self::Io(right)) => left.kind() == right.kind(),
    67	            _ => false,
    68	        }
    69	    }
    70	}
