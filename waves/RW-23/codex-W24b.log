diff --git a/scripts/sbom.mjs b/scripts/sbom.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e4f0811b0a3dcf17d5bf2d89b942cbb292e927b7
--- /dev/null
+++ b/scripts/sbom.mjs
@@ -0,0 +1,171 @@
+#!/usr/bin/env node
+// @ts-check
+
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { mkdirSync, readFileSync, readdirSync, writeFileSync } from 'node:fs';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+/** @typedef {{name:string,version:string,source?:string,checksum?:string,dependencies:string[]}} LockPackage */
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const allowlist = new Set([
+  'MIT', 'Apache-2.0', 'BSD-2-Clause', 'BSD-3-Clause', 'ISC', 'Unicode-3.0',
+  'Zlib', 'MPL-2.0', 'CC0-1.0', 'Unlicense', '0BSD',
+]);
+
+/** Parse Cargo.lock's package records without depending on a TOML package. */
+function parseLock(text) {
+  /** @type {LockPackage[]} */
+  const packages = [];
+  for (const block of text.split(/^\[\[package\]\]\s*$/m).slice(1)) {
+    const scalar = (key) => block.match(new RegExp(`^${key}\\s*=\\s*"([^"]*)"`, 'm'))?.[1];
+    const name = scalar('name');
+    const version = scalar('version');
+    if (!name || !version) throw new Error('Cargo.lock: package без name/version');
+    const dependencyBlock = block.match(/^dependencies\s*=\s*\[([\s\S]*?)^\]/m)?.[1] ?? '';
+    packages.push({
+      name,
+      version,
+      source: scalar('source'),
+      checksum: scalar('checksum'),
+      dependencies: [...dependencyBlock.matchAll(/"([^"]+)"/g)].map((match) => match[1].split(' ')[0]),
+    });
+  }
+  if (packages.length === 0) throw new Error('Cargo.lock: package records не найдены');
+  return packages;
+}
+
+/** @param {string} name @param {string} version */
+function registryLicense(name, version) {
+  const cargoHome = process.env.CARGO_HOME || join(process.env.HOME || '', '.cargo');
+  const registryRoot = join(cargoHome, 'registry', 'src');
+  try {
+    for (const index of readdirSync(registryRoot)) {
+      const manifest = join(registryRoot, index, `${name}-${version}`, 'Cargo.toml');
+      try {
+        const text = readFileSync(manifest, 'utf8');
+        const match = text.match(/^license\s*=\s*"([^"]+)"\s*$/m);
+        if (match) return match[1];
+      } catch { /* Registry source is optional; missing license becomes NOASSERTION. */ }
+    }
+  } catch { /* An absent local registry is handled as NOASSERTION. */ }
+  return 'NOASSERTION';
+}
+
+/** @param {string} expression */
+function allowedLicense(expression) {
+  if (expression === 'NOASSERTION' || expression === 'NONE') return false;
+  const orGroups = expression.split(/\s+OR\s+/i);
+  return orGroups.some((group) => group.split(/\s+AND\s+/i).every((part) => {
+    const id = part.trim().replace(/^\(|\)$/g, '');
+    return allowlist.has(id);
+  }));
+}
+
+function spdxId(name, version) {
+  return `SPDXRef-Package-${name}-${version}`.replace(/[^A-Za-z0-9.-]/g, '-');
+}
+
+/** Build SPDX document from offline workspace metadata and the lockfile. */
+function buildDocument() {
+  const lockText = readFileSync(join(root, 'rust', 'Cargo.lock'), 'utf8');
+  const locked = parseLock(lockText);
+  let metadataText;
+  try {
+    metadataText = execFileSync('cargo', [
+      'metadata', '--offline', '--no-deps', '--format-version', '1', '--manifest-path', join(root, 'rust', 'Cargo.toml'),
+    ], { cwd: root, encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
+  } catch (error) {
+    // This sandbox can report EPERM after Cargo has exited successfully and emitted complete JSON.
+    if (!(error && typeof error === 'object' && 'status' in error && error.status === 0 && 'stdout' in error)) throw error;
+    metadataText = String(error.stdout);
+  }
+  const metadata = JSON.parse(metadataText);
+  const workspace = new Map(metadata.packages.map((pkg) => [`${pkg.name}@${pkg.version}`, pkg]));
+  const packages = locked.map((entry) => {
+    const local = workspace.get(`${entry.name}@${entry.version}`);
+    const license = local?.license || registryLicense(entry.name, entry.version);
+    const purl = `pkg:cargo/${encodeURIComponent(entry.name)}@${encodeURIComponent(entry.version)}`;
+    return {
+      name: entry.name,
+      SPDXID: spdxId(entry.name, entry.version),
+      versionInfo: entry.version,
+      downloadLocation: entry.source?.startsWith('registry+') ? 'https://crates.io' : 'NOASSERTION',
+      filesAnalyzed: false,
+      licenseDeclared: license || 'NOASSERTION',
+      licenseConcluded: 'NOASSERTION',
+      copyrightText: 'NOASSERTION',
+      externalRefs: [{ referenceCategory: 'PACKAGE-MANAGER', referenceType: 'purl', referenceLocator: purl }],
+    };
+  });
+  const ids = new Map(packages.map((pkg) => [pkg.name, pkg.SPDXID]));
+  const relationships = [{ spdxElementId: 'SPDXRef-DOCUMENT', relationshipType: 'DESCRIBES', relatedSpdxElement: packages[0].SPDXID }];
+  for (const entry of locked) {
+    const from = spdxId(entry.name, entry.version);
+    for (const dependency of entry.dependencies) {
+      const to = ids.get(dependency);
+      if (to) relationships.push({ spdxElementId: from, relationshipType: 'DEPENDS_ON', relatedSpdxElement: to });
+    }
+  }
+  const epoch = Number.parseInt(process.env.SOURCE_DATE_EPOCH || '0', 10);
+  if (!Number.isFinite(epoch) || epoch < 0) throw new Error('SOURCE_DATE_EPOCH должен быть неотрицательным целым');
+  return {
+    spdxVersion: 'SPDX-2.3',
+    dataLicense: 'CC0-1.0',
+    SPDXID: 'SPDXRef-DOCUMENT',
+    name: 'discord-lab-rust-workspace',
+    documentNamespace: `https://discord-lab.local/spdx/${createHash('sha256').update(lockText).digest('hex')}`,
+    creationInfo: {
+      created: new Date(epoch * 1000).toISOString().replace('.000Z', 'Z'),
+      creators: ['Tool: discord-lab-sbom'],
+      licenseListVersion: '3.25',
+    },
+    packages,
+    relationships,
+  };
+}
+
+function main() {
+  const args = process.argv.slice(2);
+  let output = join(root, 'rust', 'dist', 'sbom.spdx.json');
+  let check = false;
+  let dryRun = false;
+  let checkLicense = null;
+  for (let i = 0; i < args.length; i += 1) {
+    if (args[i] === '--output' && args[i + 1]) output = resolve(args[++i]);
+    else if (args[i] === '--check') check = true;
+    else if (args[i] === '--dry-run') dryRun = true;
+    else if (args[i] === '--check-license' && args[i + 1]) checkLicense = args[++i];
+    else throw new Error(`Неизвестный или неполный аргумент: ${args[i]}`);
+  }
+  if (checkLicense !== null) {
+    if (allowedLicense(checkLicense)) return 0;
+    console.error(`sbom: запрещённая лицензия: ${checkLicense}`);
+    return 1;
+  }
+  const document = buildDocument();
+  if (check) {
+    const rejected = document.packages.filter((pkg) => !allowedLicense(pkg.licenseDeclared));
+    if (rejected.length) {
+      for (const pkg of rejected) console.error(`sbom: ${pkg.name}@${pkg.versionInfo}: ${pkg.licenseDeclared}`);
+      return 1;
+    }
+  }
+  if (dryRun) {
+    console.log(`sbom: SPDX-2.3, ${document.packages.length} packages, output=${output}`);
+    return 0;
+  }
+  mkdirSync(dirname(output), { recursive: true });
+  writeFileSync(output, `${JSON.stringify(document, null, 2)}\n`);
+  console.log(`sbom: создан ${output} (${document.packages.length} packages)`);
+  return 0;
+}
+
+try {
+  process.exitCode = main();
+} catch (error) {
+  console.error(`sbom: ${error instanceof Error ? error.message : String(error)}`);
+  process.exitCode = 1;
+}

