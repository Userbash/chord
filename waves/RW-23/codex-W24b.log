+    metadataText = execFileSync('cargo', [
+      'metadata', '--offline', '--no-deps', '--format-version', '1', '--manifest-path', join(root, 'rust', 'Cargo.toml'),
+    ], { cwd: root, encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
+  } catch (error) {
+    // This sandbox can report EPERM after Cargo has exited successfully and emitted complete JSON.
+    if (!(error && typeof error === 'object' && 'status' in error && error.status === 0 && 'stdout' in error)) throw error;
+    metadataText = String(error.stdout);
+  }
+  const metadata = JSON.parse(metadataText);
+  const workspace = new Map(metadata.packages.map((pkg) => [`${pkg.name}@${pkg.version}`, pkg]));
+  const packages = locked.map((entry) => {
+    const local = workspace.get(`${entry.name}@${entry.version}`);
+    const license = local?.license || registryLicense(entry.name, entry.version);
+    const purl = `pkg:cargo/${encodeURIComponent(entry.name)}@${encodeURIComponent(entry.version)}`;
+    return {
+      name: entry.name,
+      SPDXID: spdxId(entry.name, entry.version),
+      versionInfo: entry.version,
+      downloadLocation: entry.source?.startsWith('registry+') ? 'https://crates.io' : 'NOASSERTION',
+      filesAnalyzed: false,
+      licenseDeclared: license || 'NOASSERTION',
+      licenseConcluded: 'NOASSERTION',
+      copyrightText: 'NOASSERTION',
+      externalRefs: [{ referenceCategory: 'PACKAGE-MANAGER', referenceType: 'purl', referenceLocator: purl }],
+    };
+  });
+  const ids = new Map(packages.map((pkg) => [pkg.name, pkg.SPDXID]));
+  const relationships = [{ spdxElementId: 'SPDXRef-DOCUMENT', relationshipType: 'DESCRIBES', relatedSpdxElement: packages[0].SPDXID }];
+  for (const entry of locked) {
+    const from = spdxId(entry.name, entry.version);
+    for (const dependency of entry.dependencies) {
+      const to = ids.get(dependency);
+      if (to) relationships.push({ spdxElementId: from, relationshipType: 'DEPENDS_ON', relatedSpdxElement: to });
+    }
+  }
+  const epoch = Number.parseInt(process.env.SOURCE_DATE_EPOCH || '0', 10);
+  if (!Number.isFinite(epoch) || epoch < 0) throw new Error('SOURCE_DATE_EPOCH должен быть неотрицательным целым');
+  return {
+    spdxVersion: 'SPDX-2.3',
+    dataLicense: 'CC0-1.0',
+    SPDXID: 'SPDXRef-DOCUMENT',
+    name: 'discord-lab-rust-workspace',
+    documentNamespace: `https://discord-lab.local/spdx/${createHash('sha256').update(lockText).digest('hex')}`,
+    creationInfo: {
+      created: new Date(epoch * 1000).toISOString().replace('.000Z', 'Z'),
+      creators: ['Tool: discord-lab-sbom'],
+      licenseListVersion: '3.25',
+    },
+    packages,
+    relationships,
+  };
+}
+
+function main() {
+  const args = process.argv.slice(2);
+  let output = join(root, 'rust', 'dist', 'sbom.spdx.json');
+  let check = false;
+  let dryRun = false;
+  let checkLicense = null;
+  for (let i = 0; i < args.length; i += 1) {
