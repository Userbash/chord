        "aes"
      ],
      "note": "Use vetted crypto library dispatch and known-answer tests; preserve software fallback beyond the platform baseline."
    },
    {
      "name": "AVX / AVX2",
      "rust_features": [
        "avx",
        "avx2"
      ],
      "note": "Require CPU and OS register-state support; never enable globally for the portable release."
    },
    {
      "name": "AVX-VNNI",
      "rust_features": [
        "avxvnni"
      ],
      "note": "Detect separately from AVX2 and AVX512-VNNI."
    },
    {
      "name": "AVX-512 family",
      "rust_features": [
        "avx512f",
        "avx512cd",
        "avx512er",
        "avx512pf",
        "avx512bw",
        "avx512dq",
        "avx512vl",
