% + var(--space-2));\n  left: var(--chat-pad-x);\n  display: none;\n  gap: var(--space-2);\n  align-items: center;\n  max-width: 60%;\n  padding: var(--space-1) var(--space-3);\n  border-left: 2px solid var(--accent);\n  border-radius: var(--radius-xs);\n  background: var(--surface-2);\n  color: var(--text-muted);\n  font-size: var(--font-size-small);\n  line-height: var(--line-height-small);\n}\n\n.composer-reply[data-visible="true"] {\n  display: flex;\n}\n\n.composer-reply-text {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-reply-cancel {\n  flex: 0 0 auto;\n  width: var(--icon-size);\n  height: var(--icon-size);\n  border: 0;\n  border-radius: var(--radius-xs);\n  background: transparent;\n  color: var(--text-muted);\n  font-size: var(--font-size-small);\n}\n\n/* Композер — контейнер для absolute-чипа ответа. */\n.composer {\n  position: relative;\n}\n\n/* CMP-07: disabled — поле в DOM и фокусируемо, ввод не проходит. */\n.composer[data-state="disabled"] .composer-input {\n  color: var(--text-muted);\n  cursor: not-allowed;\n}\n\n.composer[data-state="disabled"] .icon-btn,\n.composer[data-limit="exceeded"] .icon-btn {\n  opacity: var(--state-disabled-opacity);\n}\n\n/* CMP-14: focus-within на контейнере (ring не двигает раскладку). */\n.composer:focus-within {\n  outline: var(--focus-ring-width) solid var(--focus-ring);\n  outline-offset: var(--focus-ring-offset);\n}\n\n/* CMP-08: стиль ошибки (логика — вне Phase 2). */\n.composer[data-state="error"] .composer-input {\n  color: var(--danger-text);\n}\n\n.chat-sent-messages { flex: 0 0 auto; }\n.local-message { min-height: var(--line-height-message); }\n.local-message[data-message-status="pending"] { opacity: .65; }\n.local-message[data-message-status="error"] { color: var(--danger-text); }\n.message-error { margin-left: var(--space-2); }\n\n/* =============================================================================\n * P-03-UI (G6 §3.6): «Печатает…» над композером.\n * Живёт внутри `.composer` (position: relative), поэтому не двигает раскладку\n * (56px composer и высота списка не меняются). Пустой регион скрыт атрибутом\n * hidden, а не нулевой высотой: AT не должен видеть фантомный live-region.\n * ========================================================================== */\n\n.typing-indicator {\n  position: absolute;\n  bottom: calc(100% + var(--space-1));\n  left: var(--chat-pad-x);\n  display: none;\n  flex-direction: column;\n  gap: 0;\n  max-width: 60%;\n  padding: 0 var(--space-2);\n  color: var(--text-muted);\n  font-size: var(--font-size-small);\n  line-height: var(--line-height-small);\n  pointer-events: none;\n}\n\n.typing-indicator[data-visible="true"] {\n  display: flex;\n}\n\n.typing-indicator[hidden] {\n  display: none;\n}\n\n/* Чип ответа тоже висит над композером — индикатор встаёт над ним. */\n.composer[data-reply="true"] .typing-indicator {\n  bottom: calc(100% + var(--space-2) + var(--line-height-small) + var(--space-2));\n}\n\n.typing-indicator-text:empty {\n  display: none;\n}\n\n/* Slowmode/401/429: текст ошибки, без иконок и без нового live-региона. */\n.typing-indicator-notice {\n  color: var(--danger-text);\n}\n\n.typing-indicator-notice[hidden] {\n  display: none;\n}\n\n/* =============================================================================\n * RW-40 / B2b-ATTACH-UI: очередь вложений (#composer-attachments)\n * ========================================================================== */\n\n/* Очередь: absolute над композером, высота в поток не входит. */\n.composer-attachments {\n  position: absolute;\n  right: 0;\n  bottom: calc(100% + var(--space-1));\n  left: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n  max-height: calc(var(--attach-chip-thumb, var(--icon-size-lg)) * 3 + var(--space-2) * 2);\n  overflow-y: auto;\n  scrollbar-width: thin;\n}\n\n.composer-attachments[hidden] {\n  display: none;\n}\n\n/* Чип: карточка на --surface-2 */\n.attachment-chip {\n  position: relative;\n  display: grid;\n  grid-template-columns: var(--attach-chip-thumb, var(--icon-size-lg)) minmax(0, 1fr) auto;\n  grid-template-rows: auto auto;\n  gap: var(--space-1) var(--space-3);\n  width: var(--attach-chip-w, calc(var(--space-11) * 5));\n  max-width: 100%;\n  min-height: calc(var(--attach-chip-thumb, var(--icon-size-lg)) + var(--space-4) * 2);\n  padding: var(--space-4);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-sm);\n  background: var(--surface-2);\n  color: var(--text);\n  font-size: var(--font-size-small);\n  line-height: var(--line-height-small);\n}\n\n.attachment-thumb {\n  grid-row: 1;\n  width: var(--attach-chip-thumb, var(--icon-size-lg));\n  height: var(--attach-chip-thumb, var(--icon-size-lg));\n  border-radius: var(--radius-xs);\n  object-fit: cover;\n  background: var(--surface-3);\n}\n\n.attachment-meta {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.attachment-name {\n  overflow: hidden;\n  color: var(--text);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.attachment-size {\n  overflow: hidden;\n  color: var(--text-subtle);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.attachment-status {\n  overflow: hidden;\n  color: var(--text-muted);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.attachment-chip[data-state="ready"] .attachment-status {\n  color: var(--positive-text);\n}\n\n.attachment-error {\n  max-height: calc(var(--line-height-small) * 2);\n  overflow: hidden;\n  color: var(--danger-text);\n}\n\n.attachment-error[hidden],\n.attachment-status[hidden] {\n  display: none;\n}\n\n/* Прогресс: вторая строка под метаданными, на всю ширину, кроме превью. */\n.attachment-progress {\n  grid-row: 2;\n  grid-column: 2 / -1;\n  height: var(--progress-h, var(--space-1));\n  overflow: hidden;\n  border-radius: var(--radius-round);\n  background: var(--state-active);\n}\n\n.attachment-progress-fill {\n  height: 100%;\n  border-radius: inherit;\n  ba