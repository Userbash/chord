[T] --border-strong (#97979f) */\n  --divider: rgb(255 255 255 / 6%);          /* [A] разделитель строк/секций */\n\n  --state-hover: rgb(255 255 255 / 6%);      /* [A] hover строки/кнопки */\n  --state-active: rgb(255 255 255 / 9%);     /* [A] pressed */\n  --state-selected: rgb(255 255 255 / 11%);  /* [M] выбранный канал #2c2c30 */\n  --state-selected-strong: rgb(255 255 255 / 14%); /* [A] выбранная вкладка/пункт меню */\n  --state-disabled-opacity: 0.45;            /* [A] disabled: opacity контрола */\n  --row-hover-bg: var(--surface-1);          /* [M] hover сообщения #202024 */\n  --row-selected-bg: var(--surface-2);       /* [A] выбранное сообщение/пункт */\n\n  --focus-ring: #a5b0ff;        /* [A] 6.71–9.14 на всех поверхностях (AA non-text ≥3) */\n  --focus-ring-width: 2px;\n  --focus-ring-offset: 2px;\n\n  --scrollbar-thumb: #5f606a;   /* [T] --scrollbar-thin-thumb */\n  --scrollbar-track: transparent;\n  --scrollbar-size: 8px;\n\n  /* ---------------------------------------------------------------------------\n   * 5. Типографика — только системные шрифты\n   * ------------------------------------------------------------------------ */\n  --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue",\n    Arial, "Noto Sans", "Liberation Sans", sans-serif,\n    "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", emoji;\n  --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,\n    "Liberation Mono", "DejaVu Sans Mono", monospace;\n\n  --font-size-caption: 11px;    /* [A] бейджи, счётчики */\n  --font-size-small: 12px;      /* [M] категории каналов/групп участников */\n  --font-size-ui: 14px;         /* [M] подписи, таймстемпы, кнопки */\n  --font-size-body: 16px;       /* [M] текст сообщений, имена каналов */\n  --font-size-title: 20px;      /* [A] заголовки секций настроек */\n  --font-size-display: 24px;    /* [A] заголовок окна настроек */\n\n  --line-height-caption: 14px;\n  --line-height-small: 16px;\n  --line-height-ui: 18px;\n  --line-height-body: 22px;     /* [M] --chat-markup-line-height: 1.375rem = 22px */\n  --line-height-title: 24px;\n  --line-height-display: 30px;\n\n  --font-weight-normal: 400'... 11671 more characters,
