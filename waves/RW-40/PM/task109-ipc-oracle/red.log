impl ChannelOverrideInput {
    fn into_patch(self, channel_id: &str) -> ChannelNotificationOverridePatch {
        match self {
            Self::Envelope {
                mut channel_overrides,
            } => channel_overrides
                .remove(channel_id)
                .or_else(|| channel_overrides.into_values().next())
                .unwrap_or_default(),
            Self::Direct(patch) => patch,
        }
    }

    fn resolve(
        channel_id: &str,
        override_patch: Option<ChannelNotificationOverridePatch>,
        patch: Option<Self>,
        payload: Option<Self>,
    ) -> ChannelNotificationOverridePatch {
        override_patch
            .or_else(|| patch.map(|input| input.into_patch(channel_id)))
            .or_else(|| payload.map(|input| input.into_patch(channel_id)))
            .unwrap_or_default()
    }
}

