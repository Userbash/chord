================================================================ */\n.user-profile-popover,\n#member-profile-popover {\n  position: fixed;\n  z-index: var(--z-popover);\n  display: flex;\n  flex-direction: column;\n  width: min(300px, calc(100vw - var(--space-6)));\n  max-height: min(480px, calc(100vh - var(--space-6)));\n  overflow: hidden;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  background: var(--surface-1);\n  box-shadow: var(--shadow-popover);\n  color: var(--text);\n}\n\n.user-profile-popover[hidden],\n#member-profile-popover[hidden] {\n  display: none;\n}\n\n/* 1. Верхний баннер */\n.profile-banner {\n  position: relative;\n  flex: 0 0 calc(var(--space-12) + var(--space-2));\n  height: calc(var(--space-12) + var(--space-2));\n  background-color: var(--surface-3);\n}\n\n/* Кнопка закрытия */\n.profile-close {\n  position: absolute;\n  top: var(--space-3);\n  right: var(--space-3);\n  z-index: var(--z-header);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--btn-height-sm);\n  height: var(--btn-height-sm);\n  border: 0;\n  border-radius: var(--radius-round);\n  background: var(--surface-sunken);\n  color: var(--text-muted);\n  font-size: var(--font-size-ui);\n  line-height: var(--line-height-ui);\n  cursor: pointer;\n}\n\n.profile-close:hover {\n  background: var(--surface-4);\n  color: var(--text-strong);\n}\n\n.profile-close:focus-visible {\n  outline: var(--focus-ring-width) solid var(--focus-ring);\n  outline-offset: var(--focus-ring-offset);\n}\n\n/* 2. Аватар со статусом */\n.profile-avatar-wrap {\n  position: relative;\n  flex: 0 0 auto;\n  padding: 0 var(--space-6);\n}\n\n.profile-avatar {\n  position: relative;\n  width: var(--layout-composer-h);\n  height: var(--layout-composer-h);\n  margin-top: calc(var(--btn-height-sm) * -1);\n  border: 4px solid var(--surface-1);\n  border-radius: var(--radius-round);\n  background: var(--surface-4);\n  font-size: var(--font-size-