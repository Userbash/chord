    actual: '/* =============================================================================\n * members.css — панель участников 240 (--layout-member-panel-w), превью 42\n * (--row-member), список участников 40 (--row-member-track, inline из JS),\n * тулбар 48 (--space-11).\n * Видимость #member-panel переключает style.css (body[data-active-screen]).\n * ========================================================================== */\n\n/* ---------------------------------------------------------------------------\n * Панель в чате\n * ------------------------------------------------------------------------ */\n.member-panel {\n  flex: 0 0 var(--layout-member-panel-w);\n  flex-direction: column;\n  width: var(--layout-member-panel-w);\n  min-width: 0;\n  min-height: 0;\n  padding: var(--layout-panel-pad) var(--layout-member-pad-x);\n  overflow: hidden;\n  background: var(--bg-chat);\n  box-shadow: var(--shadow-elevation-stroke);\n}\n\n.member-panel-title {\n  flex: 0 0 auto;\n  margin: 0 0 var(--space-4);\n  padding: 0 var(--space-2);\n  color: var(--text-faint);\n  font-size: var(--font-size-small);\n  font-weight: var(--font-weight-semibold);\n  letter-spacing: var(--letter-spacing-caps);\n  line-height: var(--line-height-small);\n  text-transform: uppercase;\n}\n\n#member-online {\n  font-variant-numeric: tabular-nums;\n}\n\n.member-panel-list {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  min-height: 0;\n  overflow-x: hidden;\n  overflow-y: auto;\n  scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);\n  scrollbar-width: thin;\n}\n\n.member-panel-all {\n  flex: 0 0 auto;\n  height: var(--btn-height);\n  margin-top: var(--space-2);\n  border: 0;\n  border-radius: var(--btn-radius);\n  background: transparent;\n  color: var(--text-muted);\n  font-size: var(--font-size-ui);\n  line-height: var(--line-height-ui);\n  text-align: left;\n}\n\n.member-panel-all:hover {\n  background: var(--state-hover);\n  color: var(--text-strong);\n}\n\n/* ---------------------------------------------------------------------------\n * Экран участников\n * ------------------------------------------------------------------------ */\n.members-toolbar {\n  display: flex;\n  flex: 0 0 auto;\n  gap: var(--space-5);\n  align-items: center;\n  height: var(--space-11);\n  padding: 0 var(--space-6);\n  box-shadow: var(--shadow-elevation-low);\n}\n\n.members-toolbar .search-field {\n  flex: 0 1 var(--layout-member-panel-w);\n  width: var(--layout-member-panel-w);\n}\n\n.members-count {\n  margin-left: auto;\n  color: var(--text-muted);\n  font-size: var(--font-size-small);\n  font-variant-numeric: tabular-nums;\n  line-height: var(--line-height-small);\n}\n\n.member-list {\n  padding: var(--space-4) 0;\n  scrollbar-gutter: stable;\n}\n\n/* Строка участника: 40 на экране / 42 в панели — height приходит inline. */\n.member {\n  display: flex;\n  gap: var(--space-4);\n  align-items: center;\n  padding: 0 var(--space-4);\n  border-radius: var(--radius-xs);\n  transition: background var(--motion-fast) var(--ease-out);\n}\n\n.member:hover {\n  background: var(--state-hover);\n}\n\n.member.is-selected {\n  background: var(--state-selected);\n}\n\n.member-name {\n  display: flex;\n  flex: 1 1 auto;\n  gap: var(--space-2);\n  align-items: center;\n  min-width: 0;\n}\n\n.member-label {\n  overflow: hidden;\n  color: var(--text);\n  font-size: var(--font-size-ui);\n  line-height: var(--line-height-ui);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.member-role {\n  flex: 0 1 auto;\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text-muted);\n  font-size: var(--font-size-small);\n  line-height: var(--line-height-small);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* =============================================================================\n * P3-02 (W39h): 6 групп участников (MEM-02/04) и чипы экрана.\n * Блок заголовка группы — 42 (D-13, `--row-member-group`): 16 pad-top + строка 24.\n * ====================