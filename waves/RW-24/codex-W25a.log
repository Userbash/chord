+        "one" => PluralCategory::One,
+        "two" => PluralCategory::Two,
+        "few" => PluralCategory::Few,
+        "many" => PluralCategory::Many,
+        _ => PluralCategory::Other,
+    };
+    match kind {
+        PluralType::Ordinal => match language.as_str() {
+            "en" if v == 0 => {
+                let m10 = i % 10;
+                if i % 100 / 10 != 1 {
+                    match m10 {
+                        1 => cat("one"),
+                        2 => cat("two"),
+                        3 => cat("few"),
+                        _ => cat("other"),
+                    }
+                } else {
+                    cat("other")
+                }
+            }
+            "fr" | "ro" | "vi" => {
+                if n == 1.0 {
+                    cat("one")
+                } else {
+                    cat("other")
+                }
+            }
+            "hu" => {
