+    let mut body = format!("{rounded:.max$}");
+    while body.contains('.') && body.ends_with('0') && body.split_once('.').map_or(0, |(_, f)| f.len()) > min { body.pop(); }
+    if body.ends_with('.') { body.pop(); }
+    let (integer, fraction) = body.split_once('.').unwrap_or((&body, ""));
