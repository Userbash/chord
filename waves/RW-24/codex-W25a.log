+                    cat("one")
+                } else {
+                    cat("other")
+                }
+            }
+            "uk" => {
+                if i_mod_10 == 3 && i_mod_100 != 13 {
+                    cat("few")
+                } else {
+                    cat("other")
+                }
+            }
+            "hi" => match n {
+                1.0 => cat("one"),
+                2.0 | 3.0 => cat("two"),
+                4.0 => cat("few"),
+                6.0 => cat("many"),
+                _ => cat("other"),
