+                }
+            }
+            "uk" => {
+                if i_mod_10 == 3 && i_mod_100 != 13 {
+                    cat("few")
+                } else {
+                    cat("other")
+                }
+            }
+            "hi" => match n {
+                1.0 => cat("one"),
+                2.0 | 3.0 => cat("two"),
+                4.0 => cat("few"),
+                6.0 => cat("many"),
+                _ => cat("other"),
+            },
+            _ => cat("other"),
+        },
+        PluralType::Cardinal => match language.as_str() {
+            "ja" | "ko" | "zh" | "th" | "vi" | "id" => cat("other"),
+            "en" | "de" | "nl" | "sv" => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else {
+                    cat("other")
+                }
+            }
