+            "ar" => if n == 0.0 { cat("zero") } else if n == 1.0 { cat("one") } else if n == 2.0 { cat("two") } else if (3.0..=10.0).contains(&n_mod_100) { cat("few") } else if (11.0..=99.0).contains(&n_mod_100) { cat("many") } else { cat("other") },
