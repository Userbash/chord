+fn parts(timestamp_secs: i64, offset: i32) -> DateParts {
+    let days = timestamp_secs.div_euclid(86_400);
+    let seconds = timestamp_secs.rem_euclid(86_400);
+    let z = days + 719_468;
+    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1_460 + doe / 36_524 - doe / 146_096) / 365;
+    let mut year = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let day = doy - (153 * mp + 2) / 5 + 1;
+    let month = mp + if mp < 10 { 3 } else { -9 };
+    year += i64::from(month <= 2);
+    DateParts { year: year + i64::from(offset), month: month as usize, day: day as u32, weekday: (days + 4).rem_euclid(7) as usize, hour: (seconds / 3600) as u32, minute: ((seconds % 3600) / 60) as u32, second: (seconds % 60) as u32 }
 }
 
