+        "USD" => ("$", locale.starts_with("en")), "EUR" => ("€", false), "RUB" => ("₽", false), "GBP" => ("£", locale.starts_with("en")), "JPY" => ("¥", true),
+        _ => return format!("{number} {currency}"),
