+        .unwrap_or(locale)
+        .to_ascii_lowercase();
+    let n = if value.is_finite() { value.abs() } else { 0.0 };
+    let text = n.to_string();
+    let fraction = text.split_once('.').map_or("", |(_, f)| f);
+    let v = fraction.len();
