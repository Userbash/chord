+                } else if i == 2 && v == 0 {
+                    cat("two")
+                } else {
+                    cat("other")
+                }
+            }
+            _ => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else {
+                    cat("other")
+                }
+            }
