+                } else { cat("other") }
+            }
+            "fr" | "ro" | "vi" => if n == 1.0 { cat("one") } else { cat("other") },
+            "hu" => if n == 1.0 || n == 5.0 { cat("one") } else { cat("other") },
+            "it" => if [8.0, 11.0, 80.0, 800.0].contains(&n) { cat("many") } else { cat("other") },
+            "sv" => if (1..=2).contains(&i_mod_10) && ![11, 12].contains(&i_mod_100) { cat("one") } else { cat("other") },
+            "uk" => if i_mod_10 == 3 && i_mod_100 != 13 { cat("few") } else { cat("other") },
+            "hi" => match n { 1.0 => cat("one"), 2.0 | 3.0 => cat("two"), 4.0 => cat("few"), 6.0 => cat("many"), _ => cat("other") },
+            _ => cat("other"),
+        },
+        PluralType::Cardinal => match language.as_str() {
+            "ja" | "ko" | "zh" | "th" | "vi" | "id" => cat("other"),
+            "en" | "de" | "nl" | "sv" => if i == 1 && v == 0 { cat("one") } else { cat("other") },
+            "da" => if n == 1.0 || (t != 0 && (i == 0 || i == 1)) { cat("one") } else { cat("other") },
+            "no" | "fi" | "bg" | "el" | "hu" | "tr" => if n == 1.0 { cat("one") } else { cat("other") },
+            "es" => if n == 1.0 { cat("one") } else if exact_million { cat("many") } else { cat("other") },
+            "pt" if locale.eq_ignore_ascii_case("pt-PT") => if i == 1 && v == 0 { cat("one") } else if exact_million { cat("many") } else { cat("other") },
+            "pt" => if i == 0 || i == 1 { cat("one") } else if exact_million { cat("many") } else { cat("other") },
+            "fr" => if i == 0 || i == 1 { cat("one") } else if exact_million { cat("many") } else { cat("other") },
+            "it" => if i == 1 && v == 0 { cat("one") } else if exact_million { cat("many") } else { cat("other") },
+            "hi" => if i == 0 || n == 1.0 { cat("one") } else { cat("other") },
+            "ru" | "uk" | "pl" => {
