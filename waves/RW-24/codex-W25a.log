+            "cs" | "sk" => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else if (2..=4).contains(&i) && v == 0 {
+                    cat("few")
+                } else if v != 0 {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "hr" => {
+                if (v == 0 && i_mod_10 == 1 && i_mod_100 != 11) || (f % 10 == 1 && f % 100 != 11) {
+                    cat("one")
+                } else if (v == 0 && (2..=4).contains(&i_mod_10) && !(12..=14).contains(&i_mod_100))
+                    || ((2..=4).contains(&(f % 10)) && !(12..=14).contains(&(f % 100)))
+                {
+                    cat("few")
+                } else {
+                    cat("other")
+                }
+            }
+            "ro" => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else if v != 0 || n == 0.0 || (1.0..=19.0).contains(&n_mod_100) {
+                    cat("few")
+                } else {
+                    cat("other")
+                }
+            }
+            "lt" => {
+                if f != 0 {
+                    cat("many")
+                } else if n_mod_10 == 1.0 && !(11.0..=19.0).contains(&n_mod_100) {
+                    cat("one")
+                } else if (2.0..=9.0).contains(&n_mod_10) && !(11.0..=19.0).contains(&n_mod_100) {
+                    cat("few")
+                } else {
+                    cat("other")
+                }
+            }
+            "ar" => {
+                if n == 0.0 {
+                    cat("zero")
+                } else if n == 1.0 {
+                    cat("one")
+                } else if n == 2.0 {
+                    cat("two")
+                } else if (3.0..=10.0).contains(&n_mod_100) {
+                    cat("few")
+                } else if (11.0..=99.0).contains(&n_mod_100) {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "he" => {
+                if (i == 1 && v == 0) || (i == 0 && v != 0) {
+                    cat("one")
+                } else if i == 2 && v == 0 {
+                    cat("two")
+                } else {
+                    cat("other")
+                }
+            }
+            _ => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else {
+                    cat("other")
+                }
+            }
+        },
+    }
 }
 
