+                } else if (3.0..=10.0).contains(&n_mod_100) {
+                    cat("few")
+                } else if (11.0..=99.0).contains(&n_mod_100) {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "he" => {
+                if (i == 1 && v == 0) || (i == 0 && v != 0) {
+                    cat("one")
+                } else if i == 2 && v == 0 {
+                    cat("two")
+                } else {
+                    cat("other")
+                }
+            }
+            _ => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else {
+                    cat("other")
+                }
+            }
+        },
+    }
 }
 
