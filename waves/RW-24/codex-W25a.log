+            while pos < chars.len() && chars[pos] == c { pos += 1; }
+            let width = pos - start;
+            let value = match (c, width) {
+                ('y', 1) => p.year.to_string(), ('y', 2) => format!("{:02}", p.year.rem_euclid(100)), ('y', _) => format!("{:0width$}", p.year, width = width),
+                ('M', 1) => p.month.to_string(), ('M', 2) => format!("{:02}", p.month), ('M', 3) => data.months_short[p.month - 1].to_owned(), ('M', _) => data.months_long[p.month - 1].to_owned(),
+                ('d', 1) => p.day.to_string(), ('d', _) => format!("{:02}", p.day),
+                ('E', 1..=3) => data.weekdays_short[p.weekday].to_owned(), ('E', _) => data.weekdays_long[p.weekday].to_owned(),
+                ('G', _) => data.era.to_owned(), ('H', 1) => p.hour.to_string(), ('H', _) => format!("{:02}", p.hour),
+                ('h', 1) => ((p.hour + 11) % 12 + 1).to_string(), ('h', _) => format!("{:02}", (p.hour + 11) % 12 + 1),
+                ('m', 1) => p.minute.to_string(), ('m', _) => format!("{:02}", p.minute), ('s', 1) => p.second.to_string(), ('s', _) => format!("{:02}", p.second),
+                ('a', _) => data.day_periods[usize::from(p.hour >= 12)].to_owned(), ('z', 1..=3) => data.timezone_short.to_owned(), ('z', _) => data.timezone_long.to_owned(),
+                _ => return if skeleton { None } else { Some(String::new()) },
+            };
+            out.push_str(&value);
+        } else { out.push(c); pos += 1; }
+    }
+    Some(out.replace(['\u{202f}', '\u{a0}'], " "))
 }
 
