+struct DateParts { year: i64, month: usize, day: u32, weekday: usize, hour: u32, minute: u32, second: u32 }
+fn parts(timestamp_secs: i64, offset: i32) -> DateParts {
+    let days = timestamp_secs.div_euclid(86_400);
+    let seconds = timestamp_secs.rem_euclid(86_400);
+    let z = days + 719_468;
+    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1_460 + doe / 36_524 - doe / 146_096) / 365;
+    let mut year = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let day = doy - (153 * mp + 2) / 5 + 1;
+    let month = mp + if mp < 10 { 3 } else { -9 };
+    year += i64::from(month <= 2);
+    DateParts { year: year + i64::from(offset), month: month as usize, day: day as u32, weekday: (days + 4).rem_euclid(7) as usize, hour: (seconds / 3600) as u32, minute: ((seconds % 3600) / 60) as u32, second: (seconds % 60) as u32 }
+}
+
+fn render_pattern(pattern: &str, p: DateParts, data: &LocaleFormatData, skeleton: bool) -> Option<String> {
+    let chars: Vec<char> = pattern.chars().collect();
+    let mut out = String::new();
+    let mut pos = 0;
+    while pos < chars.len() {
+        if chars[pos] == '\'' {
+            pos += 1;
+            while pos < chars.len() {
+                if chars[pos] == '\'' {
+                    if chars.get(pos + 1) == Some(&'\'') { out.push('\''); pos += 2; } else { pos += 1; break; }
+                } else { out.push(chars[pos]); pos += 1; }
+            }
+            continue;
+        }
+        let c = chars[pos];
+        if c.is_ascii_alphabetic() {
+            let start = pos;
+            while pos < chars.len() && chars[pos] == c { pos += 1; }
+            let width = pos - start;
+            let value = match (c, width) {
+                ('y', 1) => p.year.to_string(), ('y', 2) => format!("{:02}", p.year.rem_euclid(100)), ('y', _) => format!("{:0width$}", p.year, width = width),
+                ('M', 1) => p.month.to_string(), ('M', 2) => format!("{:02}", p.month), ('M', 3) => data.months_short[p.month - 1].to_owned(), ('M', _) => data.months_long[p.month - 1].to_owned(),
+                ('d', 1) => p.day.to_string(), ('d', _) => format!("{:02}", p.day),
+                ('E', 1..=3) => data.weekdays_short[p.weekday].to_owned(), ('E', _) => data.weekdays_long[p.weekday].to_owned(),
+                ('G', _) => data.era.to_owned(), ('H', 1) => p.hour.to_string(), ('H', _) => format!("{:02}", p.hour),
+                ('h', 1) => ((p.hour + 11) % 12 + 1).to_string(), ('h', _) => format!("{:02}", (p.hour + 11) % 12 + 1),
+                ('m', 1) => p.minute.to_string(), ('m', _) => format!("{:02}", p.minute), ('s', 1) => p.second.to_string(), ('s', _) => format!("{:02}", p.second),
+                ('a', _) => data.day_periods[usize::from(p.hour >= 12)].to_owned(), ('z', 1..=3) => data.timezone_short.to_owned(), ('z', _) => data.timezone_long.to_owned(),
+                _ => return if skeleton { None } else { Some(String::new()) },
+            };
+            out.push_str(&value);
+        } else { out.push(c); pos += 1; }
+    }
+    Some(out.replace(['\u{202f}', '\u{a0}'], " "))
 }
 
