+    DateParts { year: year + i64::from(offset), month: month as usize, day: day as u32, weekday: (days + 4).rem_euclid(7) as usize, hour: (seconds / 3600) as u32, minute: ((seconds % 3600) / 60) as u32, second: (seconds % 60) as u32 }
