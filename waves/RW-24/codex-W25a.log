+                    cat("one")
+                } else {
+                    cat("other")
+                }
+            }
+            "it" => {
+                if [8.0, 11.0, 80.0, 800.0].contains(&n) {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "sv" => {
