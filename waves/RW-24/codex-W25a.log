+                } else if exact_million {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "pt" if locale.eq_ignore_ascii_case("pt-PT") => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else if exact_million {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "pt" => {
+                if i == 0 || i == 1 {
+                    cat("one")
+                } else if exact_million {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "fr" => {
+                if i == 0 || i == 1 {
+                    cat("one")
+                } else if exact_million {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "it" => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else if exact_million {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "hi" => {
+                if i == 0 || n == 1.0 {
+                    cat("one")
+                } else {
+                    cat("other")
+                }
+            }
+            "pl" => {
+                if v != 0 { cat("other") }
+                else if i == 1 { cat("one") }
+                else if (2..=4).contains(&i_mod_10) && !(12..=14).contains(&i_mod_100) { cat("few") }
+                else { cat("many") }
+            }
+            "ru" | "uk" => {
+                if v == 0 && i_mod_10 == 1 && i_mod_100 != 11 {
+                    cat("one")
+                } else if v == 0 && (2..=4).contains(&i_mod_10) && !(12..=14).contains(&i_mod_100) {
+                    cat("few")
+                } else if v == 0
+                    && (i_mod_10 == 0
+                        || (5..=9).contains(&i_mod_10)
+                        || (11..=14).contains(&i_mod_100))
+                {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "cs" | "sk" => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else if (2..=4).contains(&i) && v == 0 {
+                    cat("few")
+                } else if v != 0 {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "hr" => {
+                if (v == 0 && i_mod_10 == 1 && i_mod_100 != 11) || (f % 10 == 1 && f % 100 != 11) {
