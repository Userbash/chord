+    let text = n.to_string();
+    let fraction = text.split_once('.').map_or("", |(_, f)| f);
+    let v = fraction.len();
+    let i = text
+        .split('.')
+        .next()
+        .unwrap_or("0")
+        .parse::<u64>()
+        .unwrap_or(u64::MAX);
+    let f = fraction.parse::<u64>().unwrap_or(0);
+    let t = fraction.trim_end_matches('0').parse::<u64>().unwrap_or(0);
+    let n_mod_10 = n % 10.0;
+    let n_mod_100 = n % 100.0;
+    let i_mod_10 = i % 10;
+    let i_mod_100 = i % 100;
+    let exact_million = v == 0 && i != 0 && i % 1_000_000 == 0;
+    let cat = |s| match s {
