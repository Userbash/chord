+    let find = |name: &str| usable.iter().copied().find(|code| *code == name);
+    if !requested.is_empty() {
+        if let Some(code) = find(requested) {
+            return code.to_owned();
+        }
+        if let Some(code) = usable
+            .iter()
+            .copied()
+            .find(|code| code.eq_ignore_ascii_case(requested))
