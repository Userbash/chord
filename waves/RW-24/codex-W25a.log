+                else if ((2..=4).contains(&i_mod_10) && !(12..=14).contains(&i_mod_100)) || ((2..=4).contains(&(f % 10)) && !(12..=14).contains(&(f % 100))) { cat("few") }
+                else { cat("other") }
+            }
+            "ro" => if i == 1 && v == 0 { cat("one") } else if v != 0 || n == 0.0 || (2.0..=19.0).contains(&n_mod_100) { cat("few") } else { cat("other") },
