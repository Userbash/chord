diff --git a/rust/crates/discord-i18n/tests/format_contract.rs b/rust/crates/discord-i18n/tests/format_contract.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b565cd2c30c55dfd694066d6ac057821de55311b
--- /dev/null
+++ b/rust/crates/discord-i18n/tests/format_contract.rs
@@ -0,0 +1,72 @@
+use discord_i18n::format::{
+    format_currency, format_date, format_date_skeleton, format_integer, format_number,
+    format_number_named, format_number_with, format_percent, format_time, format_time_skeleton,
+    DateStyle, NumberOptions, NumberStyle,
+};
+use discord_i18n::locale::SUPPORTED_LOCALES;
+
+fn oracle() -> discord_json::JsonValue {
+    discord_json::parse(include_str!("data/cldr-oracle.json")).expect("valid oracle JSON")
+}
+
+#[test]
+fn all_locale_numbers_match_the_independent_intl_oracle() {
+    let oracle = oracle();
+    let locales = oracle.get("locales").unwrap();
+    for locale in SUPPORTED_LOCALES {
+        let expected = locales.get(locale).unwrap().get("number").unwrap();
+        for number in ["0", "1", "1.5", "1234", "1234567", "1234567.89"] {
+            if let Some(want) = expected.get(number).and_then(discord_json::JsonValue::as_str) {
+                let got = format_number(number.parse().unwrap(), locale);
+                assert_eq!(got, want, "{locale} {number}");
+            }
+        }
+    }
+}
+
+#[test]
+fn all_locale_dates_and_times_match_the_independent_intl_oracle() {
+    let oracle = oracle();
+    let timestamp = oracle.get("timestamp").unwrap().as_i64().unwrap();
+    let locales = oracle.get("locales").unwrap();
+    let styles = [DateStyle::Short, DateStyle::Medium, DateStyle::Long, DateStyle::Full];
+    let names = ["short", "medium", "long", "full"];
+    for locale in SUPPORTED_LOCALES {
+        let entry = locales.get(locale).unwrap();
+        for (style, name) in styles.into_iter().zip(names) {
+            let date = entry.get("dates").unwrap().get(name).unwrap().as_str().unwrap();
+            let time = entry.get("times").unwrap().get(name).unwrap().as_str().unwrap();
+            assert_eq!(format_date(timestamp, locale, style), date, "date {locale} {name}");
+            assert_eq!(format_time(timestamp, locale, style), time, "time {locale} {name}");
+        }
+    }
+}
+
+#[test]
+fn locale_specific_number_options_currency_and_skeletons_are_supported() {
+    assert_eq!(format_number(1_234_567.89, "ru"), "1\u{a0}234\u{a0}567,89");
+    assert_eq!(format_number(1_234_567.89, "fr"), "1\u{202f}234\u{202f}567,89");
+    assert_eq!(format_number(123_456_789., "hi"), "12,34,56,789");
+    assert_eq!(format_integer(-1234, "en-US"), "-1,234");
+    assert_eq!(format_percent(0.25, "en-US"), "25%");
+    assert_eq!(format_currency(1234.5, "en-US", "USD"), "$1,234.50");
+    assert_eq!(format_currency(1234.5, "ru", "RUB"), "1\u{a0}234,50 ₽");
+    assert_eq!(format_currency(1234.5, "de", "EUR"), "1.234,50 €");
+    assert_eq!(format_currency(1234.5, "fr", "EUR"), "1\u{202f}234,50 €");
+    assert_eq!(format_currency(1234.5, "ja", "JPY"), "¥1,235");
+    assert_eq!(format_number_with(1.5, "en-US", NumberOptions {
+        style: NumberStyle::Decimal, minimum_fraction_digits: 2, maximum_fraction_digits: 2,
+        use_grouping: false,
+    }), "1.50");
+    assert_eq!(format_number_named(1.5, "en-US", "other"), "1.5");
+    assert!(format_date(1_712_326_029, "th", DateStyle::Full).contains("พ.ศ."));
+    assert!(format_date(1_712_326_029, "th", DateStyle::Full).contains("2567"));
+    assert_eq!(format_date(1_712_326_029, "ru", DateStyle::Long), "5 апреля 2024 г.");
+    assert!(format_date_skeleton(1_712_326_029, "en-US", "M/d").is_some());
+    assert_eq!(format_date_skeleton(1_712_326_029, "en-US", "::MMMMd").as_deref(), Some("April 5"));
+    assert_eq!(format_date_skeleton(0, "en-US", "bogus"), None);
+    assert!(format_time_skeleton(-1, "en-US", "HH:mm").is_some());
+    assert_eq!(format_time_skeleton(0, "en-US", "bogus"), None);
+    assert_eq!(format_number(f64::NAN, "en-US"), "0");
+    assert_eq!(format_number(f64::INFINITY, "en-US"), "0");
+}
diff --git a/rust/crates/discord-i18n/tests/locale_contract.rs b/rust/crates/discord-i18n/tests/locale_contract.rs
new file mode 100644
index 0000000000000000000000000000000000000000..26b07a08ba432b399027ab8a9a0bdf185857049c
--- /dev/null
+++ b/rust/crates/discord-i18n/tests/locale_contract.rs
@@ -0,0 +1,33 @@
+use discord_i18n::locale::{
+    canonical_locale, fallback_chain, is_enabled, is_supported, locale_language, resolve_locale,
+    DEFAULT_LOCALE, DISABLED_LOCALES, ENABLED_LOCALES, SUPPORTED_LOCALES, TOTAL_LOCALES,
+};
+
+#[test]
+fn registry_and_disabled_locales_match_the_frozen_inventory() {
+    assert_eq!(TOTAL_LOCALES, 36);
+    assert_eq!(ENABLED_LOCALES, 31);
+    assert_eq!(SUPPORTED_LOCALES.len(), 36);
+    assert_eq!(DISABLED_LOCALES, ["pt-PT", "sk", "he", "ar", "id"]);
+    for code in SUPPORTED_LOCALES {
+        assert_eq!(is_supported(code), true, "{code}");
+        assert_eq!(canonical_locale(&code.to_ascii_lowercase()), Some(code));
+        assert_eq!(is_enabled(code), !DISABLED_LOCALES.contains(&code));
+    }
+    assert!(!is_supported("xx"));
+}
+
+#[test]
+fn locale_resolution_uses_available_enabled_exact_then_language_then_default() {
+    let available = ["en-US", "en-GB", "ru", "fr", "pt-PT", "sk"];
+    assert_eq!(resolve_locale("ru", &available), "ru");
+    assert_eq!(resolve_locale("FR", &available), "fr");
+    assert_eq!(resolve_locale("en-AU", &available), "en-US");
+    assert_eq!(resolve_locale("pt-PT", &available), "en-US");
+    assert_eq!(resolve_locale("sk", &available), "en-US");
+    assert_eq!(resolve_locale("", &available), DEFAULT_LOCALE);
+    assert_eq!(resolve_locale("ru", &["fr"]), DEFAULT_LOCALE);
+    assert_eq!(fallback_chain("ru", &available), ["ru", "en-US"]);
+    assert_eq!(fallback_chain("en-US", &available), ["en-US"]);
+    assert_eq!(locale_language("pt-BR"), "pt");
+}
diff --git a/rust/crates/discord-i18n/tests/plural_contract.rs b/rust/crates/discord-i18n/tests/plural_contract.rs
new file mode 100644
index 0000000000000000000000000000000000000000..abc6978fb0a324f1aa2ee957e9f99ac7e8dc7a9c
--- /dev/null
+++ b/rust/crates/discord-i18n/tests/plural_contract.rs
@@ -0,0 +1,45 @@
+use discord_i18n::locale::SUPPORTED_LOCALES;
+use discord_i18n::plural::{cardinal, ordinal, PluralCategory, PluralType};
+
+fn oracle() -> discord_json::JsonValue {
+    discord_json::parse(include_str!("data/cldr-oracle.json")).expect("valid oracle JSON")
+}
+
+#[test]
+fn every_oracle_cardinal_and_ordinal_sample_matches() {
+    let oracle = oracle();
+    let locales = oracle.get("locales").unwrap();
+    for locale in SUPPORTED_LOCALES {
+        let entry = locales.get(locale).unwrap();
+        for (key, kind, actual) in [
+            ("cardinal", PluralType::Cardinal, cardinal as fn(&str, f64) -> PluralCategory),
+            ("ordinal", PluralType::Ordinal, ordinal as fn(&str, f64) -> PluralCategory),
+        ] {
+            let samples = entry.get("plural").unwrap().get(key).unwrap().as_object().unwrap();
+            for (number, expected) in samples {
+                let value: f64 = number.parse().unwrap();
+                let got = match kind {
+                    PluralType::Cardinal => cardinal(locale, value),
+                    PluralType::Ordinal => ordinal(locale, value),
+                };
+                assert_eq!(got.as_str(), expected.as_str().unwrap(), "{locale} {key} {number}");
+            }
+        }
+    }
+}
+
+#[test]
+fn plural_edge_cases_follow_the_locale_contract() {
+    for (n, expected) in [(1., "one"), (2., "few"), (5., "many"), (11., "many"), (21., "one"), (22., "few"), (101., "one"), (-1., "one")] {
+        assert_eq!(cardinal("ru", n).as_str(), expected, "ru {n}");
+    }
+    assert_eq!(cardinal("ru", 1.5), PluralCategory::Other);
+    assert_eq!(cardinal("da", 1.5), PluralCategory::One);
+    assert_eq!(cardinal("he", 0.5), PluralCategory::One);
+    for (n, expected) in [(0., "zero"), (1., "one"), (2., "two"), (3., "few"), (11., "many")] {
+        assert_eq!(cardinal("ar", n).as_str(), expected, "ar {n}");
+    }
+    for (n, expected) in [(1., "one"), (2., "two"), (4., "few"), (6., "many")] {
+        assert_eq!(ordinal("hi", n).as_str(), expected, "hi ordinal {n}");
+    }
+}

