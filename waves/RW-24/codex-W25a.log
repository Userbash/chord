+    let mut chunks = Vec::new();
+    let mut end = digits.len();
+    let mut size = primary;
+    while end > 0 {
+        let start = end.saturating_sub(size);
+        chunks.push(&digits[start..end]);
+        end = start;
+        size = secondary.max(1);
+    }
+    chunks.reverse();
+    chunks.join(separator)
