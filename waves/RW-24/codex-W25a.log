+                } else {
+                    cat("other")
+                }
+            }
+            "pt" => {
+                if i == 0 || i == 1 {
+                    cat("one")
+                } else if exact_million {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "fr" => {
+                if i == 0 || i == 1 {
+                    cat("one")
+                } else if exact_million {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "it" => {
+                if i == 1 && v == 0 {
+                    cat("one")
+                } else if exact_million {
+                    cat("many")
+                } else {
+                    cat("other")
+                }
+            }
+            "hi" => {
