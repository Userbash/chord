+        return Some((true, digits.parse().ok(), &s[dot + 2..]));
+    }
+    None
+}
+
+fn parse_inline(input: &str, depth: usize) -> MarkdownNode {
+    if depth >= 32 {
+        return MarkdownNode::Text(input.to_owned());
+    }
+    let mut nodes = Vec::new();
+    let mut rest = input;
+    while !rest.is_empty() {
+        if let Some((node, n)) = parse_object(rest) {
