+        MarkdownNode::Spoiler(nodes) => wrap("||", "||", nodes),
+        MarkdownNode::BlockQuote(nodes) => format!("> {}", render_nodes(nodes)),
+        MarkdownNode::Heading { level, children } => format!(
+            "{} {}",
+            "#".repeat((*level).clamp(1, 3) as usize),
+            render_nodes(children)
