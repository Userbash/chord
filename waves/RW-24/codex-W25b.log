+                                    name: name.into(),
+                                    skin_tone: Some(tone),
+                                },
+                                suffix_start + ":skin-tone-".len() + digits_end + 1,
+                            ));
+                        }
+                    }
+                }
+                return Some((
+                    MarkdownNode::Emoji {
+                        name: name.into(),
+                        skin_tone: None,
+                    },
+                    end + 2,
+                ));
+            }
+        }
+    }
+    None
 }
