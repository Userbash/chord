+        MarkdownNode::Silent => "@silent".into(),
+        MarkdownNode::UserMention { id, nickname } => {
+            format!("<@{}{}>", if *nickname { "!" } else { "" }, id)
+        }
+        MarkdownNode::Everyone => "@everyone".into(),
+        MarkdownNode::Here => "@here".into(),
+        MarkdownNode::RoleMention(id) => format!("<@&{id}>"),
+        MarkdownNode::ChannelMention(id) => format!("<#{id}>"),
+        MarkdownNode::SlashCommand { name, id } => format!("</{name}:{id}>"),
+        MarkdownNode::CustomEmoji { animated, name, id } => {
+            format!("<{}:{name}:{id}>", if *animated { "a" } else { "" })
+        }
+        MarkdownNode::Emoji { name, skin_tone } => match skin_tone {
+            Some(tone) => format!(":{name}::skin-tone-{tone}:"),
+            None => format!(":{name}:"),
+        },
+        MarkdownNode::Timestamp { unix, style } => match style {
+            Some(style) => format!("<t:{unix}:{style}>"),
+            None => format!("<t:{unix}>"),
+        },
+        MarkdownNode::Soundboard { guild_id, sound_id } => format!("<sound:{guild_id}:{sound_id}>"),
+        MarkdownNode::StaticRoute { route, id } => match id {
+            Some(id) => format!("<id:{route}:{id}>"),
+            None => format!("<id:{route}>"),
+        },
+        MarkdownNode::Link { label, url } => format!("[{label}]({url})"),
+        MarkdownNode::AutoLink(url) => format!("[{url}]({url})"),
+    }
+}
+
+fn render_nodes(nodes: &[MarkdownNode]) -> String {
+    nodes.iter().map(render_markdown).collect()
+}
+fn wrap(open: &str, close: &str, nodes: &[MarkdownNode]) -> String {
+    format!("{open}{}{close}", render_nodes(nodes))
+}
+
+fn parse_blocks(input: &str, depth: usize) -> MarkdownNode {
+    if depth >= 32 {
+        return MarkdownNode::Text(input.to_owned());
+    }
+    let lines: Vec<&str> = input.split('\n').collect();
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < lines.len() {
+        let line = lines[i];
+        if let Some(first) = line.strip_prefix("```") {
+            if let Some(end) =
+                (i + 1..lines.len()).find(|&j| lines[j].trim_end_matches('\r') == "```")
+            {
+                let (language, body_start) = if first.is_empty() {
+                    (String::new(), i + 1)
+                } else {
+                    (first.to_owned(), i + 1)
+                };
+                out.push(MarkdownNode::CodeBlock {
+                    language,
+                    code: lines[body_start..end].join("\n"),
+                });
+                i = end + 1;
+                if i < lines.len() {
+                    out.push(MarkdownNode::Text("\n".into()));
+                }
+                continue;
+            }
+        }
+        if line.starts_with('>') {
+            let mut quote = Vec::new();
+            while i < lines.len() && lines[i].starts_with('>') {
+                quote.push(
+                    lines[i]
+                        .strip_prefix('>')
+                        .unwrap_or("")
+                        .strip_prefix(' ')
+                        .unwrap_or(lines[i].strip_prefix('>').unwrap_or("")),
+                );
+                i += 1;
+            }
+            out.push(MarkdownNode::BlockQuote(vec![parse_inline(
+                &quote.join("\n"),
+                0,
+            )]));
+            if i < lines.len() {
+                out.push(MarkdownNode::Text("\n".into()));
+            }
+            continue;
+        }
+        let trimmed = line.trim_start();
+        let hashes = trimmed.chars().take_while(|c| *c == '#').count();
+        if (1..=3).contains(&hashes) && trimmed[hashes..].starts_with(char::is_whitespace) {
+            let text = trimmed[hashes..].trim().trim_end_matches('#').trim_end();
+            out.push(MarkdownNode::Heading {
+                level: hashes as u8,
+                children: vec![parse_inline(text, 0)],
+            });
+            i += 1;
+            if i < lines.len() {
+                out.push(MarkdownNode::Text("\n".into()));
+            }
+            continue;
+        }
+        if let Some(text) = trimmed.strip_prefix("-# ") {
+            out.push(MarkdownNode::Subtext(vec![parse_inline(text, 0)]));
+            i += 1;
+            if i < lines.len() {
+                out.push(MarkdownNode::Text("\n".into()));
+            }
+            continue;
+        }
+        if let Some((ordered, start, content)) = list_item(line) {
+            let mut items = vec![vec![parse_inline(content, 0)]];
+            i += 1;
+            while i < lines.len() {
+                if let Some((next_ordered, _, next)) = list_item(lines[i])
+                    && next_ordered == ordered
+                {
+                    items.push(vec![parse_inline(next, 0)]);
+                    i += 1;
+                    continue;
+                }
+                break;
+            }
+            out.push(MarkdownNode::List {
+                ordered,
+                start,
+                items,
+            });
+            if i < lines.len() {
+                out.push(MarkdownNode::Text("\n".into()));
+            }
+            continue;
+        }
+        out.push(parse_inline(line, 0));
+        i += 1;
+        if i < lines.len() {
+            out.push(MarkdownNode::Text("\n".into()));
+        }
+    }
+    sequence(out)
+}
+
+fn sequence(mut nodes: Vec<MarkdownNode>) -> MarkdownNode {
+    if nodes.len() == 1 {
+        nodes.remove(0)
+    } else {
+        MarkdownNode::Sequence(nodes)
+    }
+}
+
+fn list_item(line: &str) -> Option<(bool, Option<u64>, &str)> {
+    let s = line.trim_start();
+    if let Some(rest) = s.strip_prefix("- ").or_else(|| s.strip_prefix("* ")) {
+        return Some((false, None, rest));
+    }
+    let dot = s.find(". ")?;
+    let digits = &s[..dot];
+    if !digits.is_empty() && digits.bytes().all(|b| b.is_ascii_digit()) {
+        return Some((true, digits.parse().ok(), &s[dot + 2..]));
+    }
+    None
+}
+
+fn parse_inline(input: &str, depth: usize) -> MarkdownNode {
+    if depth >= 32 {
+        return MarkdownNode::Text(input.to_owned());
+    }
+    let mut nodes = Vec::new();
+    let mut rest = input;
+    while !rest.is_empty() {
+        if let Some((node, n)) = parse_object(rest) {
+            nodes.push(node);
+            rest = &rest[n..];
+            continue;
+        }
+        if rest.starts_with('\\') {
+            if let Some(ch) = rest[1..].chars().next() {
+                if !ch.is_ascii_alphanumeric() && !ch.is_whitespace() {
+                    nodes.push(MarkdownNode::Text(ch.to_string()));
+                    rest = &rest[1 + ch.len_utf8()..];
+                    continue;
+                }
+            }
+        }
+        if let Some((node, n)) = parse_link_or_url(rest) {
+            nodes.push(node);
+            rest = &rest[n..];
+            continue;
+        }
+        let styles = [
+            ("**", "**", 0u8),
+            ("__", "__", 1),
+            ("~~", "~~", 2),
+            ("||", "||", 3),
+            ("*", "*", 4),
+            ("_", "_", 4),
+            ("`", "`", 5),
+        ];
+        let mut matched = None;
+        for (open, close, kind) in styles {
+            if !rest.starts_with(open) {
+                continue;
+            }
+            if let Some(end) = rest[open.len()..].find(close) {
+                if end == 0 {
+                    continue;
+                }
+                let body = &rest[open.len()..open.len() + end];
+                if kind == 5 {
+                    matched = Some((
+                        MarkdownNode::InlineCode(body.to_owned()),
+                        open.len() + end + close.len(),
+                    ));
+                    break;
+                }
+                if (kind == 0 && body.ends_with('*')) || (kind == 1 && body.ends_with('_')) {
+                    continue;
+                }
+                let children = vec![parse_inline(body, depth + 1)];
+                let node = match kind {
+                    0 => MarkdownNode::Bold(children),
+                    1 => MarkdownNode::Underline(children),
+                    2 => MarkdownNode::Strike(children),
+                    3 => MarkdownNode::Spoiler(children),
+                    _ => MarkdownNode::Italic(children),
+                };
+                matched = Some((node, open.len() + end + close.len()));
+                break;
+            }
+        }
+        if let Some((node, n)) = matched {
+            nodes.push(node);
+            rest = &rest[n..];
+            continue;
+        }
+        let ch = rest.chars().next().expect("nonempty remainder");
+        nodes.push(MarkdownNode::Text(ch.to_string()));
+        rest = &rest[ch.len_utf8()..];
+    }
+    sequence(nodes)
+}
+
+fn parse_link_or_url(s: &str) -> Option<(MarkdownNode, usize)> {
+    if s.starts_with('[') {
+        let close = s.find("](")?;
+        let mut nesting = 0usize;
+        let mut end = None;
+        for (offset, ch) in s[close + 2..].char_indices() {
+            match ch {
+                '(' => nesting += 1,
+                ')' if nesting == 0 => {
+                    end = Some(close + 2 + offset);
+                    break;
+                }
+                ')' => nesting -= 1,
+                _ => {}
+            }
+        }
+        let end = end?;
+        let label = &s[1..close];
+        let url = s[close + 2..end].trim();
+        if safe_url(url) {
+            return Some((
+                MarkdownNode::Link {
+                    label: label.to_owned(),
+                    url: url.to_owned(),
+                },
+                end + 1,
+            ));
+        }
+        return Some((parse_inline(label, 1), end + 1));
+    }
+    if s.starts_with('<') {
+        if let Some(end) = s.find('>') {
+            let url = &s[1..end];
+            if is_http_url(url) {
+                return Some((MarkdownNode::AutoLink(url.to_owned()), end + 1));
+            }
+        }
+    }
+    for scheme in ["https://", "http://"] {
+        if s.len() >= scheme.len() && s[..scheme.len()].eq_ignore_ascii_case(scheme) {
+            let end = s.find(char::is_whitespace).unwrap_or(s.len());
+            let mut url = &s[..end];
+            while url.ends_with(['.', ',', ':', ';', '"', ')', ']', '>']) {
+                url = &url[..url.len() - 1];
+            }
+            if url.len() > scheme.len() {
+                return Some((MarkdownNode::AutoLink(url.to_owned()), url.len()));
+            }
+        }
+    }
+    None
+}
+
+fn safe_url(url: &str) -> bool {
+    let url = url.trim().to_ascii_lowercase();
+    ["http://", "https://", "mailto:"]
+        .iter()
+        .any(|prefix| url.starts_with(prefix))
+}
+fn is_http_url(url: &str) -> bool {
+    safe_url(url)
+        && (url.to_ascii_lowercase().starts_with("http://")
+            || url.to_ascii_lowercase().starts_with("https://"))
+}
+
+fn parse_object(s: &str) -> Option<(MarkdownNode, usize)> {
+    if s.starts_with("@silent") && s[7..].chars().next().is_none_or(char::is_whitespace) {
+        return Some((MarkdownNode::Silent, 7));
+    }
+    for (literal, node) in [
+        ("@everyone", MarkdownNode::Everyone),
+        ("@here", MarkdownNode::Here),
+    ] {
+        if s.starts_with(literal)
+            && s[literal.len()..]
+                .chars()
+                .next()
+                .is_none_or(char::is_whitespace)
+        {
+            return Some((node, literal.len()));
+        }
+    }
+    if s.starts_with('<') {
+        let end = s.find('>')?;
+        let inside = &s[1..end];
+        let digits = |v: &str| !v.is_empty() && v.bytes().all(|b| b.is_ascii_digit());
+        if let Some(id) = inside
+            .strip_prefix("@!")
+            .or_else(|| inside.strip_prefix('@'))
+        {
+            if digits(id) {
+                return Some((
+                    MarkdownNode::UserMention {
+                        id: id.into(),
+                        nickname: inside.starts_with("@!"),
+                    },
+                    end + 1,
+                ));
+            }
+        }
+        if let Some(id) = inside.strip_prefix("@&") {
+            if digits(id) {
+                return Some((MarkdownNode::RoleMention(id.into()), end + 1));
+            }
+        }
+        if let Some(id) = inside.strip_prefix('#') {
+            if digits(id) {
+                return Some((MarkdownNode::ChannelMention(id.into()), end + 1));
+            }
+        }
+        if let Some(rest) = inside.strip_prefix("t:") {
+            let (num, style) = rest
+                .split_once(':')
+                .map_or((rest, None), |(n, st)| (n, st.chars().next()));
+            if !num.is_empty()
+                && num.strip_prefix('-').unwrap_or(num).len() <= 17
+                && num
+                    .strip_prefix('-')
+                    .unwrap_or(num)
+                    .bytes()
+                    .all(|b| b.is_ascii_digit())
+                && (style.is_none() || style.is_some_and(|c| "tTdDfFsSR".contains(c)))
+            {
+                if let Ok(unix) = num.parse() {
+                    return Some((MarkdownNode::Timestamp { unix, style }, end + 1));
+                }
+            }
+        }
+        if let Some(rest) = inside.strip_prefix("sound:") {
+            if let Some((guild, sound)) = rest.split_once(':') {
+                if digits(guild) && digits(sound) {
+                    return Some((
+                        MarkdownNode::Soundboard {
+                            guild_id: guild.into(),
+                            sound_id: sound.into(),
+                        },
+                        end + 1,
+                    ));
+                }
+            }
+        }
+        if let Some(rest) = inside.strip_prefix("id:") {
+            let (route, id) = rest
+                .split_once(':')
+                .map_or((rest, None), |(r, id)| (r, Some(id)));
+            if ["home", "browse", "customize", "guide", "linked-roles"].contains(&route)
+                && id.is_none_or(digits)
+            {
+                return Some((
+                    MarkdownNode::StaticRoute {
+                        route: route.into(),
+                        id: id.map(str::to_owned),
+                    },
+                    end + 1,
+                ));
+            }
+        }
+        let (animated, rest) = inside
+            .strip_prefix("a:")
+            .map_or((false, inside.strip_prefix(':')?), |r| (true, r));
+        if let Some((name, id)) = rest.split_once(':') {
+            if !name.is_empty()
+                && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+                && (17..=19).contains(&id.len())
+                && digits(id)
+            {
+                return Some((
+                    MarkdownNode::CustomEmoji {
+                        animated,
+                        name: name.into(),
+                        id: id.into(),
+                    },
+                    end + 1,
+                ));
+            }
+        }
+        if let Some(rest) = inside.strip_prefix('/') {
+            if let Some((name, id)) = rest.rsplit_once(':') {
+                if !name.is_empty() && digits(id) {
+                    return Some((
+                        MarkdownNode::SlashCommand {
+                            name: name.into(),
+                            id: id.into(),
+                        },
+                        end + 1,
+                    ));
+                }
+            }
+        }
+    }
+    if s.starts_with(':') {
+        if let Some(end) = s[1..].find(':') {
+            let name = &s[1..end + 1];
+            if !name.is_empty() && !name.chars().any(char::is_whitespace) {
+                let suffix_start = end + 2;
+                if let Some(tail) = s[suffix_start..].strip_prefix(":skin-tone-") {
+                    if let Some(digits_end) = tail.find(':') {
+                        if let Ok(tone) = tail[..digits_end].parse() {
+                            return Some((
+                                MarkdownNode::Emoji {
+                                    name: name.into(),
+                                    skin_tone: Some(tone),
+                                },
+                                suffix_start + ":skin-tone-".len() + digits_end + 1,
+                            ));
+                        }
+                    }
+                }
+                return Some((
+                    MarkdownNode::Emoji {
+                        name: name.into(),
+                        skin_tone: None,
+                    },
+                    end + 2,
+                ));
+            }
+        }
+    }
+    None
 }
diff --git a/rust/crates/discord-i18n/tests/markdown_contract.rs b/rust/crates/discord-i18n/tests/markdown_contract.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8009f0c437335e0ec2834a42d9808dd7205d4c8b
--- /dev/null
+++ b/rust/crates/discord-i18n/tests/markdown_contract.rs
@@ -0,0 +1,105 @@
+use discord_i18n::markdown::{parse_markdown, render_markdown};
+
+#[test]
+fn renders_the_23_frozen_markdown_rules() {
+    let cases = [
+        ("**bold**", "**bold**"),
+        ("__under__", "__under__"),
+        ("~~strike~~", "~~strike~~"),
+        ("*em*", "*em*"),
+        ("_em_", "*em*"),
+        ("`code`", "`code`"),
+        ("```rs\nlet x = 1;\n```", "```rs\nlet x = 1;\n```"),
+        ("||spoiler||", "||spoiler||"),
+        ("> quote", "> quote"),
+        ("# H1", "# H1"),
+        ("## H2", "## H2"),
+        ("### H3", "### H3"),
+        ("-# small", "-# small"),
+        ("- a\n- b", "- a\n- b"),
+        ("1. a\n2. b", "1. a\n2. b"),
+        ("@silent", "@silent"),
+        ("<@123>", "<@123>"),
+        ("<@!123>", "<@!123>"),
+        ("@everyone", "@everyone"),
+        ("@here", "@here"),
+        ("<@&123>", "<@&123>"),
+        ("<#123>", "<#123>"),
+        ("</cmd arg:123>", "</cmd arg:123>"),
+        ("<a:wave:123456789012345678>", "<a:wave:123456789012345678>"),
+        ("<:wave:123456789012345678>", "<:wave:123456789012345678>"),
+        (":wave:", ":wave:"),
+        (":wave::skin-tone-3:", ":wave::skin-tone-3:"),
+        ("<t:1712345678:R>", "<t:1712345678:R>"),
+        ("<sound:123:456>", "<sound:123:456>"),
+        ("<id:home>", "<id:home>"),
+        ("<id:browse:123>", "<id:browse:123>"),
+        ("[x](https://a.test)", "[x](https://a.test)"),
+        ("<https://a.test>", "[https://a.test](https://a.test)"),
+        ("https://a.test", "[https://a.test](https://a.test)"),
+        (r"\*", "*"),
+        (r"\\", "\\"),
+        (r"\a", r"\a"),
+    ];
+
+    for (index, (input, expected)) in cases.iter().enumerate() {
+        assert_eq!(render_markdown(&parse_markdown(input)), *expected, "rule {}: {input:?}", index + 1);
+    }
+}
+
+#[test]
+fn rejects_unsafe_urls_but_keeps_labels() {
+    for input in ["[x](javascript:alert(1))", "[x](data:text/html,evil)", "[x](vbscript:run)"] {
+        assert_eq!(render_markdown(&parse_markdown(input)), "x", "{input}");
+    }
+    assert_eq!(render_markdown(&parse_markdown("<https://safe.test>")), "[https://safe.test](https://safe.test)");
+    assert_eq!(render_markdown(&parse_markdown("[x](https://safe.test)")), "[x](https://safe.test)");
+}
+
+#[test]
+fn keeps_html_as_inert_text_and_preserves_unclosed_markers() {
+    for input in ["<script>alert(1)</script>", "**open", "||open", "****", "```\nbody", "#### H4", "#tag", "-#text"] {
+        assert_eq!(render_markdown(&parse_markdown(input)), input, "{input}");
+    }
+    assert_eq!(render_markdown(&parse_markdown("")), "");
+    assert_eq!(render_markdown(&parse_markdown("@silentx")), "@silentx");
+    assert_eq!(render_markdown(&parse_markdown("<@abc>")), "<@abc>");
+    assert_eq!(render_markdown(&parse_markdown("<:x:123>")), "<:x:123>");
+}
+
+#[test]
+fn supports_nested_styles_and_protects_code() {
+    for (input, expected) in [
+        ("**bold *em***", "**bold *em***"),
+        ("**`x`**", "**`x`**"),
+        ("\u{005c}*", "*"),
+    ] {
+        assert_eq!(render_markdown(&parse_markdown(input)), expected, "{input}");
+    }
+}
+
+#[test]
+fn parsing_and_rendering_are_bounded_for_arbitrary_boundaries() {
+    let alphabet = ['a', '*', '_', '~', '|', '\\', '<', '>', '`', '\n', ' '];
+    let mut state = 0x5eed_u64;
+    for _ in 0..2_000 {
+        let length = (state as usize % 48) + 1;
+        let mut input = String::with_capacity(length);
+        for _ in 0..length {
+            state = state.wrapping_mul(6364136223846793005).wrapping_add(1);
+            input.push(alphabet[(state as usize >> 32) % alphabet.len()]);
+        }
+        let rendered = render_markdown(&parse_markdown(&input));
+        assert!(!rendered.to_ascii_lowercase().contains("javascript:"));
+        assert!(!rendered.to_ascii_lowercase().contains("data:"));
+    }
+
+    let input = "a🦀**b**\\*c";
+    for (index, _) in input.char_indices().chain(std::iter::once((input.len(), '\0'))) {
+        let rendered = render_markdown(&parse_markdown(&input[..index]));
+        assert!(!rendered.to_ascii_lowercase().contains("javascript:"));
+    }
+
+    let nested_list = format!("{}- x", "  ".repeat(12));
+    let _ = render_markdown(&parse_markdown(&nested_list));
+}

