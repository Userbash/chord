+}
+
+fn safe_url(url: &str) -> bool {
+    let url = url.trim().to_ascii_lowercase();
+    ["http://", "https://", "mailto:"]
+        .iter()
+        .any(|prefix| url.starts_with(prefix))
+}
+fn is_http_url(url: &str) -> bool {
+    safe_url(url)
+        && (url.to_ascii_lowercase().starts_with("http://")
+            || url.to_ascii_lowercase().starts_with("https://"))
+}
