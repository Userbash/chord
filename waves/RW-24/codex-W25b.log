+#![allow(clippy::collapsible_if, clippy::manual_strip)]
+
 /// Bounded, renderer-neutral markdown tree.
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub enum MarkdownNode {
@@ -13,38 +15,570 @@
