+                    i += 1;
+                    continue;
+                }
+                break;
+            }
+            out.push(MarkdownNode::List {
+                ordered,
+                start,
+                items,
+            });
+            if i < lines.len() {
+                out.push(MarkdownNode::Text("\n".into()));
+            }
+            continue;
+        }
+        out.push(parse_inline(line, 0));
+        i += 1;
+        if i < lines.len() {
