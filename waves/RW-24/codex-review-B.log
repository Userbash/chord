    81	/// Render a markdown tree as normalized Discord markdown.
    82	#[must_use]
    83	pub fn render_markdown(node: &MarkdownNode) -> String {
    84	    match node {
    85	        MarkdownNode::Text(s) => s.clone(),
    86	        MarkdownNode::Sequence(nodes) => nodes.iter().map(render_markdown).collect(),
    87	        MarkdownNode::Bold(nodes) => wrap("**", "**", nodes),
    88	        MarkdownNode::Underline(nodes) => wrap("__", "__", nodes),
    89	        MarkdownNode::Strike(nodes) => wrap("~~", "~~", nodes),
    90	        MarkdownNode::Italic(nodes) => wrap("*", "*", nodes),
    91	        MarkdownNode::InlineCode(s) => format!("`{}`", s),
    92	        MarkdownNode::CodeBlock { language, code } => {
    93	            let lang = if language.is_empty() {
    94	                String::new()
    95	            } else {
    96	                format!("{language}\n")
    97	            };
    98	            format!("```{lang}{code}\n```")
    99	        }
   100	        MarkdownNode::Spoiler(nodes) => wrap("||", "||", nodes),
   101	        MarkdownNode::BlockQuote(nodes) => render_nodes(nodes)
   102	            .split('\n')
   103	            .map(|line| format!("> {line}"))
   104	            .collect::<Vec<_>>()
   105	            .join("\n"),
   106	        MarkdownNode::Heading { level, children } => format!(
   107	            "{} {}",
   108	            "#".repeat((*level).clamp(1, 3) as usize),
   109	            render_nodes(children)
   110	        ),
   111	        MarkdownNode::Subtext(nodes) => format!("-# {}", render_nodes(nodes)),
   112	        MarkdownNode::List {
   113	            ordered,
   114	            start,
   115	            items,
   116	        } => items
   117	            .iter()
   118	            .enumerate()
   119	            .map(|(i, item)| {
   120	                if *ordered {
   121	                    format!("{}. {}", start.unwrap_or(1) + i as u64, render_nodes(item))
   122	                } else {
   123	                    format!("- {}", render_nodes(item))
   124	                }
   125	            })
   126	            .collect::<Vec<_>>()
   127	            .join("\n"),
   128	        MarkdownNode::Silent => "@silent".into(),
   129	        MarkdownNode::UserMention { id, nickname } => {
   130	            format!("<@{}{}>", if *nickname { "!" } else { "" }, id)
   131	        }
   132	        MarkdownNode::Everyone => "@everyone".into(),
   133	        MarkdownNode::Here => "@here".into(),
   134	        MarkdownNode::RoleMention(id) => format!("<@&{id}>"),
   135	        MarkdownNode::ChannelMention(id) => format!("<#{id}>"),
   136	        MarkdownNode::SlashCommand { name, id } => format!("</{name}:{id}>"),
   137	        MarkdownNode::CustomEmoji { animated, name, id } => {
   138	            format!("<{}:{name}:{id}>", if *animated { "a" } else { "" })
