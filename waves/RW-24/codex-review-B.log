   142	            None => format!(":{name}:"),
   143	        },
   144	        MarkdownNode::Timestamp { unix, style } => match style {
   145	            Some(style) => format!("<t:{unix}:{style}>"),
   146	            None => format!("<t:{unix}>"),
   147	        },
   148	        MarkdownNode::Soundboard { guild_id, sound_id } => format!("<sound:{guild_id}:{sound_id}>"),
   149	        MarkdownNode::StaticRoute { route, id } => match id {
   150	            Some(id) => format!("<id:{route}:{id}>"),
   151	            None => format!("<id:{route}>"),
   152	        },
   153	        MarkdownNode::Link { label, url } => {
   154	            if safe_url(url) {
   155	                format!("[{label}]({url})")
   156	            } else {
   157	                label.clone()
   158	            }
   159	        }
   160	        MarkdownNode::AutoLink(url) => {
   161	            if is_http_url(url) {
   162	                format!("[{url}]({url})")
   163	            } else {
   164	                url.clone()
   165	            }
   166	        }
   167	    }
   168	}
