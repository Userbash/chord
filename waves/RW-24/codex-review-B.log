   176	
   177	fn parse_blocks(input: &str, depth: usize) -> MarkdownNode {
   178	    if depth >= 32 {
   179	        return MarkdownNode::Text(input.to_owned());
   180	    }
   181	    let lines: Vec<&str> = input.split('\n').collect();
   182	    let mut out = Vec::new();
   183	    let mut i = 0;
   184	    while i < lines.len() {
   185	        let line = lines[i];
   186	        if let Some(first) = line.strip_prefix("```") {
   187	            if let Some(end) =
   188	                (i + 1..lines.len()).find(|&j| lines[j].trim_end_matches('\r') == "```")
   189	            {
   190	                let (language, body_start) = if first.is_empty() {
   191	                    (String::new(), i + 1)
   192	                } else {
   193	                    (first.to_owned(), i + 1)
   194	                };
   195	                out.push(MarkdownNode::CodeBlock {
   196	                    language,
   197	                    code: lines[body_start..end].join("\n"),
   198	                });
   199	                i = end + 1;
   200	                if i < lines.len() {
   201	                    out.push(MarkdownNode::Text("\n".into()));
   202	                }
   203	                continue;
   204	            }
   205	        }
   206	        if line.starts_with('>') {
   207	            let mut quote = Vec::new();
   208	            while i < lines.len() && lines[i].starts_with('>') {
   209	                quote.push(
   210	                    lines[i]
   211	                        .strip_prefix('>')
   212	                        .unwrap_or("")
   213	                        .strip_prefix(' ')
   214	                        .unwrap_or(lines[i].strip_prefix('>').unwrap_or("")),
   215	                );
   216	                i += 1;
   217	            }
   218	            out.push(MarkdownNode::BlockQuote(vec![parse_inline(
   219	                &quote.join("\n"),
   220	                0,
   221	            )]));
   222	            if i < lines.len() {
   223	                out.push(MarkdownNode::Text("\n".into()));
   224	            }
   225	            continue;
   226	        }
   227	        let trimmed = line.trim_start();
   228	        let hashes = trimmed.chars().take_while(|c| *c == '#').count();
   229	        if (1..=3).contains(&hashes) && trimmed[hashes..].starts_with(char::is_whitespace) {
   230	            let text = trimmed[hashes..].trim().trim_end_matches('#').trim_end();
   231	            out.push(MarkdownNode::Heading {
   232	                level: hashes as u8,
   233	                children: vec![parse_inline(text, 0)],
   234	            });
   235	            i += 1;
   236	            if i < lines.len() {
   237	                out.push(MarkdownNode::Text("\n".into()));
   238	            }
   239	            continue;
   240	        }
   241	        if let Some(text) = trimmed.strip_prefix("-# ") {
   242	            out.push(MarkdownNode::Subtext(vec![parse_inline(text, 0)]));
   243	            i += 1;
   244	            if i < lines.len() {
   245	                out.push(MarkdownNode::Text("\n".into()));
   246	            }
   247	            continue;
   248	        }
   249	        if let Some((ordered, start, content)) = list_item(line) {
   250	            let mut items = vec![vec![parse_inline(content, 0)]];
   251	            i += 1;
   252	            while i < lines.len() {
   253	                if let Some((next_ordered, _, next)) = list_item(lines[i])
   254	                    && next_ordered == ordered
   255	                {
   256	                    items.push(vec![parse_inline(next, 0)]);
   257	                    i += 1;
   258	                    continue;
   259	                }
   260	                break;
   261	            }
   262	            out.push(MarkdownNode::List {
   263	                ordered,
   264	                start,
   265	                items,
   266	            });
   267	            if i < lines.len() {
   268	                out.push(MarkdownNode::Text("\n".into()));
   269	            }
   270	            continue;
   271	        }
   272	        out.push(parse_inline(line, 0));
   273	        i += 1;
   274	        if i < lines.len() {
   275	            out.push(MarkdownNode::Text("\n".into()));
   276	        }
   277	    }
   278	    sequence(out)
   279	}
   280	
   281	fn sequence(mut nodes: Vec<MarkdownNode>) -> MarkdownNode {
   282	    if nodes.len() == 1 {
   283	        nodes.remove(0)
   284	    } else {
   285	        MarkdownNode::Sequence(nodes)
   286	    }
   287	}
   288	
   289	fn list_item(line: &str) -> Option<(bool, Option<u64>, &str)> {
   290	    let s = line.trim_start();
   291	    if let Some(rest) = s.strip_prefix("- ").or_else(|| s.strip_prefix("* ")) {
   292	        return Some((false, None, rest));
   293	    }
   294	    let dot = s.find(". ")?;
   295	    let digits = &s[..dot];
   296	    if !digits.is_empty() && digits.bytes().all(|b| b.is_ascii_digit()) {
   297	        return Some((true, digits.parse().ok(), &s[dot + 2..]));
   298	    }
   299	    None
   300	}
   301	
   302	fn parse_inline(input: &str, depth: usize) -> MarkdownNode {
   303	    if depth >= 32 {
   304	        return MarkdownNode::Text(input.to_owned());
   305	    }
   306	    let mut nodes = Vec::new();
   307	    let mut rest = input;
   308	    while !rest.is_empty() {
   309	        if let Some((node, n)) = parse_object(rest) {
   310	            nodes.push(node);
   311	            rest = &rest[n..];
   312	            continue;
   313	        }
   314	        if rest.starts_with('\\') {
   315	            if let Some(ch) = rest[1..].chars().next() {
   316	                if !ch.is_ascii_alphanumeric() && !ch.is_whitespace() {
   317	                    nodes.push(MarkdownNode::Text(ch.to_string()));
   318	                    rest = &rest[1 + ch.len_utf8()..];
   319	                    continue;
   320	                }
   321	            }
   322	        }
   323	        if let Some((node, n)) = parse_link_or_url(rest) {
   324	            nodes.push(node);
   325	            rest = &rest[n..];
   326	            continue;
   327	        }
   328	        let styles = [
   329	            ("**", "**", 0u8),
   330	            ("__", "__", 1),
   331	            ("~~", "~~", 2),
   332	            ("||", "||", 3),
   333	            ("*", "*", 4),
   334	            ("_", "_", 4),
   335	            ("`", "`", 5),
   336	        ];
   337	        let mut matched = None;
   338	        for (open, close, kind) in styles {
   339	            if !rest.starts_with(open) {
   340	                continue;
   341	            }
   342	            if let Some(end) = rest[open.len()..].find(close) {
   343	                if end == 0 {
   344	                    continue;
   345	                }
   346	                let body = &rest[open.len()..open.len() + end];
   347	                if kind == 5 {
   348	                    matched = Some((
   349	                        MarkdownNode::InlineCode(body.to_owned()),
   350	                        open.len() + end + close.len(),
   351	                    ));
   352	                    break;
   353	                }
   354	                if (kind == 0 && body.ends_with('*')) || (kind == 1 && body.ends_with('_')) {
   355	                    continue;
   356	                }
   357	                let children = vec![parse_inline(body, depth + 1)];
   358	                let node = match kind {
   359	                    0 => MarkdownNode::Bold(children),
   360	                    1 => MarkdownNode::Underline(children),
   361	                    2 => MarkdownNode::Strike(children),
   362	                    3 => MarkdownNode::Spoiler(children),
   363	                    _ => MarkdownNode::Italic(children),
   364	                };
   365	                matched = Some((node, open.len() + end + close.len()));
   366	                break;
   367	            }
   368	        }
   369	        if let Some((node, n)) = matched {
   370	            nodes.push(node);
   371	            rest = &rest[n..];
   372	            continue;
   373	        }
   374	        let ch = rest.chars().next().expect("nonempty remainder");
   375	        nodes.push(MarkdownNode::Text(ch.to_string()));
   376	        rest = &rest[ch.len_utf8()..];
   377	    }
   378	    sequence(nodes)
   379	}
   380	
   381	fn parse_link_or_url(s: &str) -> Option<(MarkdownNode, usize)> {
   382	    if s.starts_with('[') {
   383	        let close = s.find("](")?;
   384	        let mut nesting = 0usize;
   385	        let mut end = None;
   386	        for (offset, ch) in s[close + 2..].char_indices() {
   387	            match ch {
   388	                '(' => nesting += 1,
   389	                ')' if nesting == 0 => {
   390	                    end = Some(close + 2 + offset);
   391	                    break;
   392	                }
   393	                ')' => nesting -= 1,
   394	                _ => {}
   395	            }
   396	        }
   397	        let end = end?;
   398	        let label = &s[1..close];
   399	        let url = s[close + 2..end].trim();
   400	        if safe_url(url) {
   401	            return Some((
   402	                MarkdownNode::Link {
   403	                    label: label.to_owned(),
   404	                    url: url.to_owned(),
   405	                },
   406	                end + 1,
   407	            ));
   408	        }
   409	        return Some((parse_inline(label, 1), end + 1));
   410	    }
   411	    if s.starts_with('<') {
   412	        if let Some(end) = s.find('>') {
   413	            let url = &s[1..end];
   414	            if is_http_url(url) {
   415	                return Some((MarkdownNode::AutoLink(url.to_owned()), end + 1));
   416	            }
   417	        }
   418	    }
   419	    for scheme in ["https://", "http://"] {
   420	        if s.get(..scheme.len())
   421	            .is_some_and(|prefix| prefix.eq_ignore_ascii_case(scheme))
   422	        {
   423	            let end = s.find(char::is_whitespace).unwrap_or(s.len());
   424	            let mut url = &s[..end];
   425	            while url.ends_with(['.', ',', ':', ';', '"', ')', ']', '>']) {
   426	                url = &url[..url.len() - 1];
   427	            }
   428	            if url.len() > scheme.len() {
   429	                return Some((MarkdownNode::AutoLink(url.to_owned()), url.len()));
   430	            }
   431	        }
   432	    }
   433	    None
   434	}
   435	
   436	fn safe_url(url: &str) -> bool {
   437	    let url = url.trim().to_ascii_lowercase();
   438	    ["http://", "https://", "mailto:"]
   439	        .iter()
   440	        .any(|prefix| url.starts_with(prefix))
   441	}
   442	fn is_http_url(url: &str) -> bool {
   443	    safe_url(url)
   444	        && (url.to_ascii_lowercase().starts_with("http://")
   445	            || url.to_ascii_lowercase().starts_with("https://"))
   446	}
   447	
   448	fn parse_object(s: &str) -> Option<(MarkdownNode, usize)> {
   449	    if s.starts_with("@silent") && s[7..].chars().next().is_none_or(char::is_whitespace) {
   450	        return Some((MarkdownNode::Silent, 7));
   451	    }
   452	    for (literal, node) in [
   453	        ("@everyone", MarkdownNode::Everyone),
   454	        ("@here", MarkdownNode::Here),
   455	    ] {
   456	        if s.starts_with(literal)
   457	            && s[literal.len()..]
   458	                .chars()
   459	                .next()
   460	                .is_none_or(char::is_whitespace)

