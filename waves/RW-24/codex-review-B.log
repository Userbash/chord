    81	/// Render a markdown tree as normalized Discord markdown.
    82	#[must_use]
    83	pub fn render_markdown(node: &MarkdownNode) -> String {
    84	    match node {
    85	        MarkdownNode::Text(s) => s.clone(),
    86	        MarkdownNode::Sequence(nodes) => nodes.iter().map(render_markdown).collect(),
    87	        MarkdownNode::Bold(nodes) => wrap("**", "**", nodes),
    88	        MarkdownNode::Underline(nodes) => wrap("__", "__", nodes),
    89	        MarkdownNode::Strike(nodes) => wrap("~~", "~~", nodes),
    90	        MarkdownNode::Italic(nodes) => wrap("*", "*", nodes),
    91	        MarkdownNode::InlineCode(s) => format!("`{}`", s),
    92	        MarkdownNode::CodeBlock { language, code } => {
    93	            let lang = if language.is_empty() {
    94	                String::new()
    95	            } else {
    96	                format!("{language}\n")
    97	            };
    98	            format!("```{lang}{code}\n```")
    99	        }
   100	        MarkdownNode::Spoiler(nodes) => wrap("||", "||", nodes),
   101	        MarkdownNode::BlockQuote(nodes) => render_nodes(nodes)
   102	            .split('\n')
   103	            .map(|line| format!("> {line}"))
   104	            .collect::<Vec<_>>()
   105	            .join("\n"),
   106	        MarkdownNode::Heading { level, children } => format!(
   107	            "{} {}",
   108	            "#".repeat((*level).clamp(1, 3) as usize),
   109	            render_nodes(children)
   110	        ),
   111	        MarkdownNode::Subtext(nodes) => format!("-# {}", render_nodes(nodes)),
   112	        MarkdownNode::List {
   113	            ordered,
   114	            start,
   115	            items,
   116	        } => items
   117	            .iter()
   118	            .enumerate()
   119	            .map(|(i, item)| {
   120	                if *ordered {
   121	                    format!("{}. {}", start.unwrap_or(1) + i as u64, render_nodes(item))
   122	                } else {
   123	                    format!("- {}", render_nodes(item))
   124	                }
   125	            })
   126	            .collect::<Vec<_>>()
   127	            .join("\n"),
   128	        MarkdownNode::Silent => "@silent".into(),
   129	        MarkdownNode::UserMention { id, nickname } => {
   130	            format!("<@{}{}>", if *nickname { "!" } else { "" }, id)
   131	        }
   132	        MarkdownNode::Everyone => "@everyone".into(),
   133	        MarkdownNode::Here => "@here".into(),
   134	        MarkdownNode::RoleMention(id) => format!("<@&{id}>"),
   135	        MarkdownNode::ChannelMention(id) => format!("<#{id}>"),
   136	        MarkdownNode::SlashCommand { name, id } => format!("</{name}:{id}>"),
   137	        MarkdownNode::CustomEmoji { animated, name, id } => {
   138	            format!("<{}:{name}:{id}>", if *animated { "a" } else { "" })
   139	        }
   140	        MarkdownNode::Emoji { name, skin_tone } => match skin_tone {
   141	            Some(tone) => format!(":{name}::skin-tone-{tone}:"),
   142	            None => format!(":{name}:"),
   143	        },
   144	        MarkdownNode::Timestamp { unix, style } => match style {
   145	            Some(style) => format!("<t:{unix}:{style}>"),
   146	            None => format!("<t:{unix}>"),
   147	        },
   148	        MarkdownNode::Soundboard { guild_id, sound_id } => format!("<sound:{guild_id}:{sound_id}>"),
   149	        MarkdownNode::StaticRoute { route, id } => match id {
   150	            Some(id) => format!("<id:{route}:{id}>"),
   151	            None => format!("<id:{route}>"),
   152	        },
   153	        MarkdownNode::Link { label, url } => {
   154	            if safe_url(url) {
   155	                format!("[{label}]({url})")
   156	            } else {
   157	                label.clone()
   158	            }
   159	        }
   160	        MarkdownNode::AutoLink(url) => {
   161	            if is_http_url(url) {
   162	                format!("[{url}]({url})")
   163	            } else {
   164	                url.clone()
   165	            }
   166	        }
   167	    }
   168	}
   169	
   170	fn render_nodes(nodes: &[MarkdownNode]) -> String {
   171	    nodes.iter().map(render_markdown).collect()
   172	}
   173	fn wrap(open: &str, close: &str, nodes: &[MarkdownNode]) -> String {
   174	    format!("{open}{}{close}", render_nodes(nodes))
   175	}
   176	
   177	fn parse_blocks(input: &str, depth: usize) -> MarkdownNode {
   178	    if depth >= 32 {
   179	        return MarkdownNode::Text(input.to_owned());
   180	    }
   181	    let lines: Vec<&str> = input.split('\n').collect();
   182	    let mut out = Vec::new();
   183	    let mut i = 0;
   184	    while i < lines.len() {
   185	        let line = lines[i];
   186	        if let Some(first) = line.strip_prefix("```") {
   187	            if let Some(end) =
   188	                (i + 1..lines.len()).find(|&j| lines[j].trim_end_matches('\r') == "```")
   189	            {
   190	                let (language, body_start) = if first.is_empty() {
   191	                    (String::new(), i + 1)
   192	                } else {
   193	                    (first.to_owned(), i + 1)
   194	                };
   195	                out.push(MarkdownNode::CodeBlock {
   196	                    language,
   197	                    code: lines[body_start..end].join("\n"),
   198	                });
   199	                i = end + 1;
   200	                if i < lines.len() {
   201	                    out.push(MarkdownNode::Text("\n".into()));
   202	                }
   203	                continue;
   204	            }
   205	        }
   206	        if line.starts_with('>') {
   207	            let mut quote = Vec::new();
   208	            while i < lines.len() && lines[i].starts_with('>') {
   209	                quote.push(
   210	                    lines[i]
   211	                        .strip_prefix('>')
   212	                        .unwrap_or("")
   213	                        .strip_prefix(' ')
   214	                        .unwrap_or(lines[i].strip_prefix('>').unwrap_or("")),
   215	                );
   216	                i += 1;
   217	            }
   218	            out.push(MarkdownNode::BlockQuote(vec![parse_inline(
   219	                &quote.join("\n"),
   220	                0,
   221	            )]));
   222	            if i < lines.len() {
   223	                out.push(MarkdownNode::Text("\n".into()));
   224	            }
   225	            continue;
   226	        }
   227	        let trimmed = line.trim_start();
   228	        let hashes = trimmed.chars().take_while(|c| *c == '#').count();
   229	        if (1..=3).contains(&hashes) && trimmed[hashes..].starts_with(char::is_whitespace) {
   230	            let text = trimmed[hashes..].trim().trim_end_matches('#').trim_end();
   231	            out.push(MarkdownNode::Heading {
   232	                level: hashes as u8,
   233	                children: vec![parse_inline(text, 0)],
   234	            });
   235	            i += 1;
   236	            if i < lines.len() {
   237	                out.push(MarkdownNode::Text("\n".into()));
   238	            }
   239	            continue;
   240	        }

