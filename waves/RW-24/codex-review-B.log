   381	fn parse_link_or_url(s: &str) -> Option<(MarkdownNode, usize)> {
   382	    if s.starts_with('[') {
   383	        let close = s.find("](")?;
   384	        let mut nesting = 0usize;
   385	        let mut end = None;
   386	        for (offset, ch) in s[close + 2..].char_indices() {
   387	            match ch {
   388	                '(' => nesting += 1,
   389	                ')' if nesting == 0 => {
   390	                    end = Some(close + 2 + offset);
   391	                    break;
   392	                }
   393	                ')' => nesting -= 1,
   394	                _ => {}
   395	            }
   396	        }
   397	        let end = end?;
   398	        let label = &s[1..close];
   399	        let url = s[close + 2..end].trim();
   400	        if safe_url(url) {
   401	            return Some((
   402	                MarkdownNode::Link {
   403	                    label: label.to_owned(),
   404	                    url: url.to_owned(),
   405	                },
   406	                end + 1,
   407	            ));
   408	        }
   409	        return Some((parse_inline(label, 1), end + 1));
   410	    }
   411	    if s.starts_with('<') {
   412	        if let Some(end) = s.find('>') {
   413	            let url = &s[1..end];
   414	            if is_http_url(url) {
   415	                return Some((MarkdownNode::AutoLink(url.to_owned()), end + 1));
   416	            }
   417	        }
   418	    }
   419	    for scheme in ["https://", "http://"] {
   420	        if s.get(..scheme.len())
   421	            .is_some_and(|prefix| prefix.eq_ignore_ascii_case(scheme))
   422	        {
   423	            let end = s.find(char::is_whitespace).unwrap_or(s.len());
   424	            let mut url = &s[..end];
   425	            while url.ends_with(['.', ',', ':', ';', '"', ')', ']', '>']) {
   426	                url = &url[..url.len() - 1];
   427	            }
   428	            if url.len() > scheme.len() {
   429	                return Some((MarkdownNode::AutoLink(url.to_owned()), url.len()));
   430	            }
   431	        }
   432	    }
   433	    None
   434	}
   435	
   436	fn safe_url(url: &str) -> bool {
   437	    let url = url.trim().to_ascii_lowercase();
   438	    ["http://", "https://", "mailto:"]
   439	        .iter()
   440	        .any(|prefix| url.starts_with(prefix))

