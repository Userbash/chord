/// Parsed message expression.
#[derive(Debug, Clone, PartialEq)]
pub enum Ast {
    Literal(String),
    Argument(String),
    Number(String),
    Date(String, String),
    Time(String, String),
    Select(String, BTreeMap<String, Vec<Ast>>),
    Plural(String, BTreeMap<String, Vec<Ast>>, i64, String),
    Pound,
    Tag(String, Vec<Ast>, Option<String>),
    Sequence(Vec<Ast>),
}

/// Invalid catalog AST. Error text contains only structural location, never source values.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct AstError {
    pub path: String,
    pub kind: &'static str,
}
impl fmt::Display for AstError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "invalid catalog AST at {}: {}", self.path, self.kind)
    }
}
impl std::error::Error for AstError {}

/// Parsed key-to-message catalog.
#[derive(Debug, Clone, Default)]
pub struct Catalog {
    entries: BTreeMap<String, Ast>,
}
impl Catalog {
    pub fn parse(value: &discord_json::JsonValue) -> Result<Self, AstError> {
        let obj = value.as_object().ok_or_else(|| AstError {
            path: "$".into(),
            kind: "expected object",
        })?;
        let mut entries = BTreeMap::new();
        for (key, node) in obj {
            entries.insert(key.clone(), parse_ast(node, format!("$.{key}"), 0)?);
        }
        Ok(Self { entries })
    }
    pub fn get(&self, key: &str) -> Option<&Ast> {
        self.entries.get(key)
    }
    pub fn len(&self) -> usize {
        self.entries.len()
    }
    pub fn is_empty(&self) -> bool {
        self.entries.is_empty()
    }
}
fn parse_ast(v: &discord_json::JsonValue, path: String, depth: usize) -> Result<Ast, AstError> {
    if let Some(s) = v.as_str() {
        return Ok(Ast::Literal(s.into()));
    }
    if depth > 128 {
        return Err(AstError {
            path,
            kind: "depth limit",
        });
    }
    if let Some(a) = v.as_array() {
        if a.first()
            .and_then(discord_json::JsonValue::as_i64)
            .is_none()
        {
            let nodes = a
                .iter()
                .enumerate()
                .map(|(i, x)| parse_ast(x, format!("{path}[{i}]"), depth + 1))
                .collect::<Result<_, _>>()?;
            return Ok(Ast::Sequence(nodes));
        }
        let bad = || AstError {
            path: path.clone(),
            kind: "invalid node shape",
        };
        let typ = a
            .first()
            .and_then(discord_json::JsonValue::as_i64)
            .ok_or_else(bad)?;
        let str_at = |i: usize| {
            a.get(i)
                .and_then(discord_json::JsonValue::as_str)
                .map(str::to_owned)
                .ok_or_else(bad)
        };
        let children = |i: usize| -> Result<Vec<Ast>, AstError> {
            let vals = a
                .get(i)
                .and_then(discord_json::JsonValue::as_array)
                .ok_or_else(bad)?;
            vals.iter()
                .enumerate()
                .map(|(n, x)| parse_ast(x, format!("{path}[{i}][{n}]"), depth + 1))
                .collect()
        };
        return Ok(match typ {
            0 => Ast::Literal(str_at(1)?),
            1 => Ast::Argument(str_at(1)?),
