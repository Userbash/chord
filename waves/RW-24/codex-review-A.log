   130	    let mut end = digits.len();
   131	    let mut size = primary;
   132	    while end > 0 {
   133	        let start = end.saturating_sub(size);
   134	        chunks.push(&digits[start..end]);
   135	        end = start;
   136	        size = secondary.max(1);
   137	    }
   138	    chunks.reverse();
   139	    chunks.join(separator)
   140	}
