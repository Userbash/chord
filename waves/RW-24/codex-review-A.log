   232	                .enumerate()
   233	                .map(|(n, x)| parse_ast(x, format!("{path}[{i}][{n}]"), depth + 1))
   234	                .collect()
   235	        };
   236	        return Ok(match typ {
   237	            0 => Ast::Literal(str_at(1)?),
   238	            1 => Ast::Argument(str_at(1)?),
   239	            2 => Ast::Number(str_at(1)?),
   240	            3 => Ast::Date(
