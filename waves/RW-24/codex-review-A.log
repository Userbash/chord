   108	/// Hash an internal message id and return the first six base64 characters of its LE digest.
   109	#[must_use]
   110	pub fn message_key(id: &str) -> String {
   111	    const B64: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
   112	    let bytes = xxh64(id.as_bytes(), 0).to_le_bytes();
   113	    let mut out = String::with_capacity(8);
   114	    for chunk in bytes.chunks(3) {
   115	        let n = (u32::from(chunk[0]) << 16)
   116	            | (u32::from(*chunk.get(1).unwrap_or(&0)) << 8)
   117	            | u32::from(*chunk.get(2).unwrap_or(&0));
   118	        out.push(B64[((n >> 18) & 63) as usize] as char);
   119	        out.push(B64[((n >> 12) & 63) as usize] as char);
   120	        if chunk.len() > 1 {
   121	            out.push(B64[((n >> 6) & 63) as usize] as char);
   122	        }
   123	        if chunk.len() > 2 {
   124	            out.push(B64[(n & 63) as usize] as char);
   125	        }
   126	    }
   127	    out.truncate(MESSAGE_KEY_LEN);
   128	    out
   129	}
