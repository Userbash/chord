     5	/// Number of locale codes shipped in the desktop client.
     6	pub const TOTAL_LOCALES: usize = 36;
     7	/// Number of enabled locales (a catalog key exists in the ru inventory).
     8	pub const ENABLED_LOCALES: usize = 31;
     9	/// Locale codes observed in the desktop client.
    10	pub const SUPPORTED_LOCALES: [&str; 36] = [
    11	    "en-US", "en-GB", "zh-CN", "zh-TW", "cs", "da", "nl", "fr", "de", "el", "hu", "it", "ja", "ko",
    12	    "pl", "pt-PT", "pt-BR", "ru", "sk", "es-419", "es-ES", "sv-SE", "tr", "bg", "uk", "fi", "no",
    13	    "hr", "ro", "lt", "th", "vi", "hi", "he", "ar", "id",
    14	];
    15	/// Default locale used when a request cannot be resolved.
    16	pub const DEFAULT_LOCALE: &str = "en-US";
    17	/// Locales present in the asset list but disabled in the client build.
    18	pub const DISABLED_LOCALES: [&str; 5] = ["pt-PT", "sk", "he", "ar", "id"];
    19	
    20	/// Return true when `code` is one of the 36 shipped locale codes.
    21	#[must_use]
    22	pub fn is_supported(code: &str) -> bool {
    23	    SUPPORTED_LOCALES
    24	        .iter()
    25	        .any(|candidate| candidate.eq_ignore_ascii_case(code))
    26	}
    27	
    28	/// Return true when `code` is supported and not disabled.
    29	#[must_use]
    30	pub fn is_enabled(code: &str) -> bool {
    31	    is_supported(code)
    32	        && !DISABLED_LOCALES
    33	            .iter()
    34	            .any(|candidate| candidate.eq_ignore_ascii_case(code))
    35	}
    36	
    37	/// Canonical spelling for a supported locale code.
    38	#[must_use]
    39	pub fn canonical_locale(code: &str) -> Option<&'static str> {
    40	    SUPPORTED_LOCALES
    41	        .iter()
    42	        .copied()
    43	        .find(|candidate| candidate.eq_ignore_ascii_case(code))
    44	}
    45	
    46	/// Language part of a locale code (`pt-BR` -> `pt`).
    47	#[must_use]
    48	pub fn locale_language(code: &str) -> &str {
    49	    code.split('-').next().unwrap_or(code)
    50	}
    51	
    52	/// Resolve a requested locale against enabled available locales.
    53	#[must_use]
    54	pub fn resolve_locale(requested: &str, available: &[&str]) -> String {
    55	    let usable: Vec<&str> = available
    56	        .iter()
    57	        .copied()
    58	        .filter(|code| is_enabled(code))
    59	        .collect();
    60	    let find = |name: &str| usable.iter().copied().find(|code| *code == name);
    61	    if !requested.is_empty() {
    62	        if let Some(code) = find(requested) {
    63	            return code.to_owned();
    64	        }
    65	        if let Some(code) = usable
    66	            .iter()
    67	            .copied()
    68	            .find(|code| code.eq_ignore_ascii_case(requested))
