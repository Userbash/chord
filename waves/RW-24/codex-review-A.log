   194	#[derive(Clone, Copy)]
   195	struct DateParts {
   196	    year: i64,
   197	    month: usize,
   198	    day: u32,
   199	    weekday: usize,
   200	    hour: u32,
   201	    minute: u32,
   202	    second: u32,
   203	}
   204	fn parts(timestamp_secs: i64, offset: i32) -> DateParts {
   205	    let days = timestamp_secs.div_euclid(86_400);
   206	    let seconds = timestamp_secs.rem_euclid(86_400);
   207	    let z = days + 719_468;
   208	    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
   209	    let doe = z - era * 146_097;
   210	    let yoe = (doe - doe / 1_460 + doe / 36_524 - doe / 146_096) / 365;
   211	    let mut year = yoe + era * 400;
   212	    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
   213	    let mp = (5 * doy + 2) / 153;
   214	    let day = doy - (153 * mp + 2) / 5 + 1;
   215	    let month = mp + if mp < 10 { 3 } else { -9 };
   216	    year += i64::from(month <= 2);
   217	    DateParts {
   218	        year: year + i64::from(offset),
   219	        month: month as usize,
   220	        day: day as u32,
   221	        weekday: (days + 4).rem_euclid(7) as usize,
   222	        hour: (seconds / 3600) as u32,
   223	        minute: ((seconds % 3600) / 60) as u32,
   224	        second: (seconds % 60) as u32,
   225	    }
   226	}
   227	
   228	fn render_pattern(
   229	    pattern: &str,
   230	    p: DateParts,
   231	    data: &LocaleFormatData,
   232	    skeleton: bool,
   233	) -> Option<String> {
   234	    let chars: Vec<char> = pattern.chars().collect();
   235	    let mut out = String::new();
   236	    let mut pos = 0;
   237	    while pos < chars.len() {
   238	        if chars[pos] == '\'' {
   239	            pos += 1;
   240	            while pos < chars.len() {
   241	                if chars[pos] == '\'' {
   242	                    if chars.get(pos + 1) == Some(&'\'') {
   243	                        out.push('\'');
   244	                        pos += 2;
   245	                    } else {
   246	                        pos += 1;
   247	                        break;
   248	                    }
   249	                } else {
   250	                    out.push(chars[pos]);
   251	                    pos += 1;
   252	                }
   253	            }
   254	            continue;
   255	        }
   256	        let c = chars[pos];
   257	        if c.is_ascii_alphabetic() {
   258	            let start = pos;
   259	            while pos < chars.len() && chars[pos] == c {
   260	                pos += 1;
   261	            }
   262	            let width = pos - start;
   263	            let value = match (c, width) {
   264	                ('y', 1) => p.year.to_string(),
   265	                ('y', 2) => format!("{:02}", p.year.rem_euclid(100)),
   266	                ('y', _) => format!("{:0width$}", p.year, width = width),
   267	                ('M', 1) => p.month.to_string(),
   268	                ('M', 2) => format!("{:02}", p.month),
   269	                ('M', 3) => data.months_short[p.month - 1].to_owned(),
   270	                ('M', _) => data.months_long[p.month - 1].to_owned(),
   271	                ('d', 1) => p.day.to_string(),
   272	                ('d', _) => format!("{:02}", p.day),
   273	                ('E', 1..=3) => data.weekdays_short[p.weekday].to_owned(),
   274	                ('E', _) => data.weekdays_long[p.weekday].to_owned(),
   275	                ('G', _) => data.era.to_owned(),
   276	                ('H', 1) => p.hour.to_string(),
   277	                ('H', _) => format!("{:02}", p.hour),
   278	                ('h', 1) => ((p.hour + 11) % 12 + 1).to_string(),
   279	                ('h', _) => format!("{:02}", (p.hour + 11) % 12 + 1),
   280	                ('m', 1) => p.minute.to_string(),
   281	                ('m', _) => format!("{:02}", p.minute),
   282	                ('s', 1) => p.second.to_string(),
   283	                ('s', _) => format!("{:02}", p.second),
   284	                ('a', _) => data.day_periods[usize::from(p.hour >= 12)].to_owned(),
   285	                ('z', 1..=3) => data.timezone_short.to_owned(),
   286	                ('z', _) => data.timezone_long.to_owned(),
   287	                _ => return if skeleton { None } else { Some(String::new()) },
   288	            };
   289	            out.push_str(&value);
   290	        } else {
   291	            out.push(c);
   292	            pos += 1;
   293	        }
   294	    }
   295	    Some(out.replace(['\u{202f}', '\u{a0}'], " "))
   296	}
   297	
   298	#[must_use]
   299	pub fn format_date(timestamp_secs: i64, locale: &str, style: DateStyle) -> String {
   300	    let data = format_data::data(locale);
   301	    render_pattern(
   302	        data.date_patterns[style.index()],
   303	        parts(timestamp_secs, data.year_offset),
   304	        data,
   305	        false,
   306	    )
   307	    .unwrap_or_default()
   308	}
   309	#[must_use]
   310	pub fn format_time(timestamp_secs: i64, locale: &str, style: DateStyle) -> String {
   311	    let data = format_data::data(locale);
   312	    render_pattern(
   313	        data.time_patterns[style.index()],
   314	        parts(timestamp_secs, 0),
   315	        data,
   316	        false,
   317	    )
   318	    .unwrap_or_default()
   319	}
   320	#[must_use]
   321	pub fn format_date_skeleton(timestamp_secs: i64, locale: &str, skeleton: &str) -> Option<String> {
   322	    let skeleton = skeleton.strip_prefix("::").unwrap_or(skeleton);
   323	    let pattern = match skeleton {
   324	        "M/d" => "M'/'d",
   325	        "MMMMd" => "MMMM' 'd",
   326	        "yyyy-MM-dd" => "yyyy'-'MM'-'dd",
   327	        _ => return None,
   328	    };
   329	    let data = format_data::data(locale);
   330	    let p = parts(timestamp_secs, data.year_offset);
   331	    render_pattern(pattern, p, data, true)
   332	}
   333	#[must_use]
   334	pub fn format_time_skeleton(timestamp_secs: i64, locale: &str, skeleton: &str) -> Option<String> {
   335	    let skeleton = skeleton.strip_prefix("::").unwrap_or(skeleton);
   336	    if skeleton != "HH:mm" {
   337	        return None;
   338	    }
   339	    let data = format_data::data(locale);
   340	    render_pattern("HH':'mm", parts(timestamp_secs, 0), data, true)
   341	}
   342	#[must_use]
   343	pub fn format_number_named(value: f64, locale: &str, name: &str) -> String {
   344	    match name {
   345	        "integer" => format_integer(value as i64, locale),
   346	        "percent" => format_percent(value, locale),
   347	        "currency" => format_currency(value, locale, "USD"),
   348	        _ => format_number(value, locale),
   349	    }
   350	}

