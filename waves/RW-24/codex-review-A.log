    78	            return code.to_owned();
    79	        }
    80	    }
    81	    find(DEFAULT_LOCALE).unwrap_or(DEFAULT_LOCALE).to_owned()
    82	}
    83	
    84	/// Fallback chain for a request: resolved locale followed by the default.
    85	#[must_use]
    86	pub fn fallback_chain(requested: &str, available: &[&str]) -> Vec<String> {
    87	    let resolved = resolve_locale(requested, available);
