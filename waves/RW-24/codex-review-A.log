   203	            .is_none()
   204	        {
   205	            let nodes = a
   206	                .iter()
   207	                .enumerate()
   208	                .map(|(i, x)| parse_ast(x, format!("{path}[{i}]"), depth + 1))
   209	                .collect::<Result<_, _>>()?;
   210	            return Ok(Ast::Sequence(nodes));
   211	        }
   212	        let bad = || AstError {
   213	            path: path.clone(),
   214	            kind: "invalid node shape",
   215	        };
   216	        let typ = a
   217	            .first()
   218	            .and_then(discord_json::JsonValue::as_i64)
   219	            .ok_or_else(bad)?;
   220	        let str_at = |i: usize| {
