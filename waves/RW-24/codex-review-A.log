   390	impl I18n {
   391	    pub fn new(default_locale: &str) -> Self {
   392	        let default = canonical_locale(default_locale)
   393	            .filter(|locale| is_enabled(locale))
   394	            .unwrap_or(DEFAULT_LOCALE)
   395	            .to_owned();
   396	        Self {
   397	            catalogs: BTreeMap::new(),
   398	            current: default.clone(),
   399	            default,
   400	        }
   401	    }
   402	    pub fn insert_catalog(&mut self, locale: &str, catalog: Catalog) -> Result<(), LocaleError> {
   403	        let canonical = canonical_locale(locale)
   404	            .filter(|locale| is_enabled(locale))
   405	            .ok_or_else(|| LocaleError::Unsupported(locale.into()))?;
   406	        self.catalogs.insert(canonical.to_owned(), catalog);
   407	        Ok(())
   408	    }
   409	    pub fn set_locale(&mut self, locale: &str) -> Result<(), LocaleError> {
   410	        if let Some(canonical) = canonical_locale(locale)
   411	            && !is_enabled(canonical)
   412	        {
   413	            return Err(LocaleError::Unsupported(locale.into()));
   414	        }
   415	        let available: Vec<&str> = self.catalogs.keys().map(String::as_str).collect();
   416	        let chosen = resolve_locale(locale, &available);
   417	        if !self.catalogs.contains_key(&chosen) {
   418	            return Err(LocaleError::Unsupported(locale.into()));
   419	        }
   420	        self.current = chosen;
   421	        Ok(())
   422	    }
   423	    pub fn translate(
   424	        &self,
   425	        key: &str,
   426	        args: &BTreeMap<String, Value>,
   427	    ) -> Result<String, TranslateError> {
   428	        let mut chain = vec![self.current.clone()];
   429	        if self.current != self.default {
   430	            chain.push(self.default.clone());
   431	        }
   432	        if !chain.iter().any(|locale| locale == DEFAULT_LOCALE) {
   433	            chain.push(DEFAULT_LOCALE.to_owned());
   434	        }
   435	        for locale in chain {
   436	            if let Some(catalog) = self.catalogs.get(&locale)
   437	                && let Some(ast) = catalog.get(key)
   438	            {
   439	                return render_ast(ast, args, None, &locale);
   440	            }
   441	        }
   442	        Err(TranslateError::MissingMessage {
   443	            key: key.into(),
   444	            locale: self.current.clone(),
   445	        })
   446	    }
   447	}
   448	fn render_ast(
   449	    ast: &Ast,
   450	    args: &BTreeMap<String, Value>,
   451	    plural: Option<f64>,
   452	    locale: &str,
   453	) -> Result<String, TranslateError> {
   454	    Ok(match ast {
   455	        Ast::Literal(s) => s.clone(),
   456	        Ast::Sequence(v) => v
   457	            .iter()
   458	            .map(|x| render_ast(x, args, plural, locale))
   459	            .collect::<Result<Vec<_>, _>>()?
   460	            .concat(),
   461	        Ast::Argument(n) => args
   462	            .get(n)
   463	            .ok_or_else(|| TranslateError::MissingArgument { name: n.clone() })?
   464	            .display(),
   465	        Ast::Number(n) => {
   466	            let value = args
   467	                .get(n)
   468	                .ok_or_else(|| TranslateError::MissingArgument { name: n.clone() })?;
   469	            match value {
   470	                Value::Int(number) => format::format_number_named(*number as f64, locale, n),
   471	                Value::Float(number) => format::format_number_named(*number, locale, n),
   472	                Value::Str(text) => text.clone(),
   473	            }
   474	        }
   475	        Ast::Date(n, style) => {
   476	            let value = args.get(n).and_then(Value::number).ok_or_else(|| {
   477	                TranslateError::InvalidArgument {
   478	                    name: n.clone(),
   479	                    expected: "unix timestamp",
   480	                }
   481	            })?;
   482	            let style = DateStyle::parse(style).unwrap_or(DateStyle::Medium);
   483	            format::format_date(value as i64, locale, style)
   484	        }
   485	        Ast::Time(n, style) => {
   486	            let value = args.get(n).and_then(Value::number).ok_or_else(|| {
   487	                TranslateError::InvalidArgument {
   488	                    name: n.clone(),
   489	                    expected: "unix timestamp",
   490	                }
   491	            })?;
   492	            let style = DateStyle::parse(style).unwrap_or(DateStyle::Short);
   493	            format::format_time(value as i64, locale, style)
   494	        }
   495	        Ast::Pound => plural
   496	            .map(|n| format::format_number(n, locale))
   497	            .unwrap_or_else(|| "#".into()),
   498	        Ast::Select(n, opts) => {
