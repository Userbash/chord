   167	#[must_use]
   168	pub fn format_currency(value: f64, locale: &str, currency: &str) -> String {
   169	    let decimals = if currency == "JPY" { 0 } else { 2 };
   170	    let number = format_number_with(
   171	        value,
   172	        locale,
   173	        NumberOptions {
   174	            minimum_fraction_digits: decimals,
   175	            maximum_fraction_digits: decimals,
   176	            ..NumberOptions::default()
   177	        },
   178	    );
   179	    let (symbol, prefix) = match currency {
   180	        "USD" => ("$", locale.starts_with("en")),
   181	        "EUR" => ("€", false),
   182	        "RUB" => ("₽", false),
   183	        "GBP" => ("£", locale.starts_with("en")),
   184	        "JPY" => ("¥", true),
   185	        _ => return format!("{number} {currency}"),
   186	    };
   187	    if prefix {
   188	        format!("{symbol}{number}")
   189	    } else {
   190	        format!("{number} {symbol}")
   191	    }
   192	}
