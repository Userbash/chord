   291	def main() -> None:
   292	    ready_path = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_READY
   293	    msgs_path = Path(sys.argv[2]) if len(sys.argv) > 2 else DEFAULT_MSGS
   294	    print(json.dumps(decode_ready(ready_path), ensure_ascii=False, indent=2, sort_keys=True))
   295	    print(
   296	        json.dumps(
   297	            decode_update(msgs_path), ensure_ascii=False, indent=2, sort_keys=True
   298	        )
   299	    )
