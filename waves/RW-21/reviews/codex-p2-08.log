    63	
    64	    /// Числовой type, с которым настройки пришли.
    65	    #[must_use]
    66	    pub fn proto_type(&self) -> u64 {
    67	        match self {
    68	            Self::Preloaded(_) => PRELOADED_USER_SETTINGS_TYPE,
    69	            Self::Frecency(_) => FRECENCY_AND_FAVORITES_SETTINGS_TYPE,
    70	            Self::Unsupported { proto_type, .. } => *proto_type,
    71	        }
