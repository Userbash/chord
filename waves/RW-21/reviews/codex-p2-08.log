    34	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
    35	        formatter
    36	            .debug_struct("FrecencyUserSettings")
    37	            .field("raw_fields", &self.raw.fields.len())
    38	            .field("versions", &self.versions.is_some())
    39	            .finish()
    40	    }
    41	}

