     1	//! P2-08: protobuf wire-декодер настроек (RW-21).
     2	//!
     3	//! Контракт заморожен `waves/RW-21/DESIGN-P2-08.md` §2–§3. Модуль не знает про Discord,
     4	//! состояние и сеть: только bytes → структурные поля. Группы (wire 3/4) не поддержаны —
     5	//! в захватах их нет; неизвестные поля сохраняются как [`ProtoField`], а не отбрасываются.
     6	
     7	use std::fmt;
     8	
     9	use crate::rest::base64::Base64Error;
    10	
    11	/// Верхний предел входного protobuf-сообщения (1 МиБ). Реальные настройки — 3–13 КБ.
    12	pub const MAX_PROTO_BYTES: usize = 1_048_576;
    13	
    14	/// Верхний предел числа полей в одном сообщении.
    15	pub const MAX_FIELDS: usize = 262_144;
    16	
    17	/// Максимальный номер protobuf-поля (`2^29 - 1`).
    18	const MAX_FIELD_NUMBER: u64 = 0x1FFF_FFFF;
    19	
    20	/// Ошибка разбора base64/protobuf.
    21	#[derive(Debug, Clone, PartialEq, Eq)]
    22	pub enum SettingsProtoError {
    23	    /// Ошибка base64-обёртки.
    24	    Base64(Base64Error),
    25	    /// Входное сообщение больше [`MAX_PROTO_BYTES`].
    26	    TooLarge { size: usize, limit: usize },
    27	    /// В сообщении больше [`MAX_FIELDS`] полей.
    28	    TooManyFields { limit: usize },
    29	    /// Varint/fixed/length обрывается до конца буфера.
    30	    UnexpectedEnd { offset: usize },
    31	    /// Varint длиннее 10 байт или не помещается в `u64`.
    32	    VarintOverflow { offset: usize },
    33	    /// Номер поля 0 или больше `2^29 - 1`.
    34	    InvalidFieldNumber { number: u64, offset: usize },
    35	    /// Wire type 3/4/6/7 не поддержан.
    36	    UnsupportedWireType {
    37	        field: u32,
    38	        wire_type: u8,
    39	        offset: usize,
    40	    },
    41	    /// Длина length-delimited поля больше остатка буфера.
    42	    LengthOutOfBounds {
    43	        field: u32,
    44	        length: u64,
    45	        remaining: usize,
    46	    },
    47	    /// Известное поле пришло с другим wire type.
    48	    WrongWireType {
    49	        field: u32,
    50	        expected: u8,
    51	        actual: u8,
    52	    },
    53	    /// StringValue содержит невалидный UTF-8.
    54	    InvalidUtf8 { field: u32 },
    55	}
    56	
    57	impl fmt::Display for SettingsProtoError {
    58	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
    59	        match self {
    60	            Self::Base64(error) => write!(formatter, "base64: {error:?}"),
    61	            Self::TooLarge { size, limit } => {
    62	                write!(formatter, "protobuf {size} bytes > limit {limit}")
    63	            }
    64	            Self::TooManyFields { limit } => write!(formatter, "protobuf fields > limit {limit}"),
    65	            Self::UnexpectedEnd { offset } => write!(formatter, "unexpected end at {offset}"),
    66	            Self::VarintOverflow { offset } => write!(formatter, "varint overflow at {offset}"),
    67	            Self::InvalidFieldNumber { number, offset } => {
    68	                write!(formatter, "invalid field {number} at {offset}")
    69	            }
    70	            Self::UnsupportedWireType {
    71	                field,
    72	                wire_type,
    73	                offset,
    74	            } => write!(
    75	                formatter,
    76	                "unsupported wire type {wire_type} for field {field} at {offset}"
    77	            ),
    78	            Self::LengthOutOfBounds {
    79	                field,
    80	                length,
    81	                remaining,
    82	            } => write!(
    83	                formatter,
    84	                "length {length} of field {field} > remaining {remaining}"
    85	            ),
    86	            Self::WrongWireType {
    87	                field,
    88	                expected,
    89	                actual,
    90	            } => write!(
    91	                formatter,
    92	                "field {field}: expected wire {expected}, got {actual}"
    93	            ),
    94	            Self::InvalidUtf8 { field } => write!(formatter, "field {field}: invalid utf-8"),
    95	        }
    96	    }
    97	}
    98	
    99	impl std::error::Error for SettingsProtoError {}
   100	
   101	impl From<Base64Error> for SettingsProtoError {
   102	    fn from(error: Base64Error) -> Self {
   103	        Self::Base64(error)
   104	    }
   105	}
   106	
   107	/// Значение protobuf-поля без интерпретации схемы.
   108	#[derive(Clone, PartialEq, Eq)]
   109	pub enum ProtoValue {
   110	    /// Varint (включая bool/int32/int64/enum).
   111	    Varint(u64),
   112	    /// 64-битное fixed little-endian.
   113	    Fixed64(u64),
   114	    /// Length-delimited bytes (вложенное сообщение/строка/map).
   115	    LengthDelimited(Vec<u8>),
   116	    /// 32-битное fixed little-endian.
   117	    Fixed32(u32),
   118	}
   119	
   120	impl ProtoValue {
   121	    /// Wire type значения.
   122	    #[must_use]
   123	    pub fn wire_type(&self) -> u8 {
   124	        match self {
   125	            Self::Varint(_) => 0,
   126	            Self::Fixed64(_) => 1,
   127	            Self::LengthDelimited(_) => 2,
   128	            Self::Fixed32(_) => 5,
   129	        }
   130	    }
   131	
   132	    /// Varint, если значение этого типа.
   133	    #[must_use]
   134	    pub fn as_varint(&self) -> Option<u64> {
   135	        match self {
   136	            Self::Varint(value) => Some(*value),
   137	            _ => None,
   138	        }
   139	    }
   140	
   141	    /// Length-delimited bytes, если значение этого типа.
   142	    #[must_use]
   143	    pub fn as_bytes(&self) -> Option<&[u8]> {
   144	        match self {
   145	            Self::LengthDelimited(bytes) => Some(bytes),
   146	            _ => None,
   147	        }
   148	    }
   149	}
   150	
   151	impl fmt::Debug for ProtoValue {
   152	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
   153	        match self {
   154	            Self::Varint(value) => write!(formatter, "Varint({value})"),
   155	            Self::Fixed64(value) => write!(formatter, "Fixed64({value})"),
   156	            Self::LengthDelimited(bytes) => {
   157	                write!(formatter, "LengthDelimited(<{} bytes>)", bytes.len())
   158	            }
   159	            Self::Fixed32(value) => write!(formatter, "Fixed32({value})"),
   160	        }
   161	    }
   162	}
   163	
   164	/// Одно поле protobuf.
   165	#[derive(Debug, Clone, PartialEq, Eq)]
   166	pub struct ProtoField {
   167	    /// Номер поля.
   168	    pub number: u32,
   169	    /// Значение.
   170	    pub value: ProtoValue,
   171	}
   172	
   173	/// Разобранное protobuf-сообщение (один уровень).
   174	#[derive(Clone, PartialEq, Eq)]
   175	pub struct ProtoMessage {
   176	    /// Поля в порядке провода; повторения сохранены.
   177	    pub fields: Vec<ProtoField>,
   178	}
   179	
   180	impl fmt::Debug for ProtoMessage {
   181	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
   182	        formatter
   183	            .debug_struct("ProtoMessage")
   184	            .field("fields", &self.fields.len())
   185	            .finish()
   186	    }
   187	}
   188	
   189	impl ProtoMessage {
   190	    /// Разобрать одно protobuf-сообщение.
   191	    pub fn decode(bytes: &[u8]) -> Result<Self, SettingsProtoError> {
   192	        if bytes.len() > MAX_PROTO_BYTES {
   193	            return Err(SettingsProtoError::TooLarge {
   194	                size: bytes.len(),
   195	                limit: MAX_PROTO_BYTES,
   196	            });
   197	        }
   198	
   199	        let mut fields = Vec::new();
   200	        let mut offset = 0;
   201	        while offset < bytes.len() {
   202	            if fields.len() >= MAX_FIELDS {
   203	                return Err(SettingsProtoError::TooManyFields { limit: MAX_FIELDS });
   204	            }
   205	            let tag_offset = offset;
   206	            let tag = read_varint(bytes, &mut offset)?;
   207	            let number = tag >> 3;
   208	            if number == 0 || number > MAX_FIELD_NUMBER {
   209	                return Err(SettingsProtoError::InvalidFieldNumber {
   210	                    number,
   211	                    offset: tag_offset,
   212	                });
   213	            }
   214	            let number =
   215	                u32::try_from(number).map_err(|_| SettingsProtoError::InvalidFieldNumber {
   216	                    number,
   217	                    offset: tag_offset,
   218	                })?;
   219	            let wire_type = (tag & 0x07) as u8;
   220	            let value = match wire_type {
   221	                0 => ProtoValue::Varint(read_varint(bytes, &mut offset)?),
   222	                1 => {
   223	                    let remaining = bytes.len().saturating_sub(offset);
   224	                    if remaining < 8 {
   225	                        return Err(SettingsProtoError::UnexpectedEnd { offset });
   226	                    }
   227	                    let mut raw = [0_u8; 8];
   228	                    raw.copy_from_slice(&bytes[offset..offset + 8]);
   229	                    offset += 8;
   230	                    ProtoValue::Fixed64(u64::from_le_bytes(raw))
   231	                }
   232	                2 => {
   233	                    let length = read_varint(bytes, &mut offset)?;
   234	                    let remaining = bytes.len().saturating_sub(offset);
   235	                    if length > remaining as u64 {
   236	                        return Err(SettingsProtoError::LengthOutOfBounds {
   237	                            field: number,
   238	                            length,
   239	                            remaining,
   240	                        });
   241	                    }
   242	                    let length = usize::try_from(length).map_err(|_| {
   243	                        SettingsProtoError::LengthOutOfBounds {
   244	                            field: number,
   245	                            length,
   246	                            remaining,
   247	                        }
   248	                    })?;
   249	                    let value = bytes[offset..offset + length].to_vec();
   250	                    offset += length;
   251	                    ProtoValue::LengthDelimited(value)
   252	                }
   253	                5 => {
   254	                    let remaining = bytes.len().saturating_sub(offset);
   255	                    if remaining < 4 {
   256	                        return Err(SettingsProtoError::UnexpectedEnd { offset });
   257	                    }
   258	                    let mut raw = [0_u8; 4];
   259	                    raw.copy_from_slice(&bytes[offset..offset + 4]);
   260	                    offset += 4;
   261	                    ProtoValue::Fixed32(u32::from_le_bytes(raw))
   262	                }
   263	                other => {
   264	                    return Err(SettingsProtoError::UnsupportedWireType {
   265	                        field: number,
   266	                        wire_type: other,
   267	                        offset: tag_offset,
   268	                    });
   269	                }
   270	            };
   271	            fields.push(ProtoField { number, value });
   272	        }
   273	        Ok(Self { fields })
   274	    }
   275	
   276	    /// Последнее поле с номером (protobuf singular last-wins).
   277	    #[must_use]
   278	    pub fn field(&self, number: u32) -> Option<&ProtoField> {
   279	        self.fields
   280	            .iter()
   281	            .rev()
   282	            .find(|field| field.number == number)
   283	    }
   284	
   285	    /// Все поля с номером в порядке провода.
   286	    pub fn fields_of(&self, number: u32) -> impl Iterator<Item = &ProtoField> {
   287	        self.fields
   288	            .iter()
   289	            .filter(move |field| field.number == number)
   290	    }
   291	
   292	    /// Вложенное сообщение поля; `None` — поле отсутствует.
   293	    pub fn message(&self, number: u32) -> Result<Option<Self>, SettingsProtoError> {
   294	        let Some(field) = self.field(number) else {
   295	            return Ok(None);
   296	        };
   297	        let bytes = field
   298	            .value
   299	            .as_bytes()
   300	            .ok_or(SettingsProtoError::WrongWireType {
   301	                field: number,
   302	                expected: 2,
   303	                actual: field.value.wire_type(),
   304	            })?;
   305	        Self::decode(bytes).map(Some)
   306	    }
   307	
   308	    /// Length-delimited bytes поля; `None` — поле отсутствует.
   309	    pub fn length_delimited(&self, number: u32) -> Result<Option<&[u8]>, SettingsProtoError> {
   310	        let Some(field) = self.field(number) else {
   311	            return Ok(None);
   312	        };
   313	        field
   314	            .value
   315	            .as_bytes()
   316	            .map(Some)
   317	            .ok_or(SettingsProtoError::WrongWireType {
   318	                field: number,
   319	                expected: 2,
   320	                actual: field.value.wire_type(),
   321	            })
   322	    }
   323	
   324	    /// StringValue (wrapper field 1); отсутствие поля → `None`, пустая строка валидна.
   325	    pub fn string(&self, number: u32) -> Result<Option<String>, SettingsProtoError> {
   326	        let Some(bytes) = self.length_delimited(number)? else {
   327	            return Ok(None);
   328	        };
   329	        let wrapper = Self::decode(bytes)?;
   330	        let Some(field) = wrapper.field(1) else {
   331	            return Ok(Some(String::new()));
   332	        };
   333	        let text = field
   334	            .value
   335	            .as_bytes()
   336	            .ok_or(SettingsProtoError::WrongWireType {
   337	                field: 1,
   338	                expected: 2,
   339	                actual: field.value.wire_type(),
   340	            })?;
   341	        String::from_utf8(text.to_vec())
   342	            .map(Some)
   343	            .map_err(|_| SettingsProtoError::InvalidUtf8 { field: number })
   344	    }
