   256	def decode_update(path: Path) -> dict:
   257	    base = None
   258	    for line in path.read_text().splitlines():
   259	        if "USER_SETTINGS_PROTO_UPDATE" not in line:
   260	            continue
   261	        obj = json.loads(line)
   262	        settings = obj["term"]["d"]["settings"]
   263	        base = settings["proto"]
   264	        payload = obj["term"]["d"]
   265	        break
   266	    if base is None:
   267	        raise SystemExit("USER_SETTINGS_PROTO_UPDATE not found")
   268	    raw = base64.b64decode(base)
   269	    top = fields(raw)
   270	    versions_raw = message_field(raw, 1)
   271	    return {
   272	        "source": str(path),
   273	        "base64_len": len(base),
   274	        "raw_len": len(raw),
   275	        "sha256": sha256(raw),
   276	        "md5": md5(raw),
   277	        "type": payload["settings"]["type"],
   278	        "partial": payload["partial"],
   279	        "top_level": [number for number, _, _ in top],
   280	        "lengths": {
   281	            number: len(value) for number, wire, value in top if wire == 2
   282	        },
   283	        "versions": {
   284	            "client_version": scalar(versions_raw, 1),
   285	            "server_version": scalar(versions_raw, 2),
   286	            "data_version": scalar(versions_raw, 3),
   287	        },
   288	    }
