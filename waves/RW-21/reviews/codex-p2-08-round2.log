   190	    /// Разобрать одно protobuf-сообщение.
   191	    pub fn decode(bytes: &[u8]) -> Result<Self, SettingsProtoError> {
   192	        if bytes.len() > MAX_PROTO_BYTES {
   193	            return Err(SettingsProtoError::TooLarge {
   194	                size: bytes.len(),
   195	                limit: MAX_PROTO_BYTES,
   196	            });
   197	        }
   198	
   199	        let mut fields = Vec::new();
   200	        let mut offset = 0;
   201	        while offset < bytes.len() {
   202	            if fields.len() >= MAX_FIELDS {
   203	                return Err(SettingsProtoError::TooManyFields { limit: MAX_FIELDS });
   204	            }
   205	            let tag_offset = offset;
   206	            let tag = read_varint(bytes, &mut offset)?;
   207	            let number = tag >> 3;
   208	            if number == 0 || number > MAX_FIELD_NUMBER {
   209	                return Err(SettingsProtoError::InvalidFieldNumber {
   210	                    number,
   211	                    offset: tag_offset,
   212	                });
   213	            }
   214	            let number =
   215	                u32::try_from(number).map_err(|_| SettingsProtoError::InvalidFieldNumber {
   216	                    number,
   217	                    offset: tag_offset,
   218	                })?;
   219	            let wire_type = (tag & 0x07) as u8;
   220	            let value = match wire_type {
   221	                0 => ProtoValue::Varint(read_varint(bytes, &mut offset)?),
   222	                1 => {
   223	                    let remaining = bytes.len().saturating_sub(offset);
   224	                    if remaining < 8 {
   225	                        return Err(SettingsProtoError::UnexpectedEnd { offset });
   226	                    }
   227	                    let mut raw = [0_u8; 8];
   228	                    raw.copy_from_slice(&bytes[offset..offset + 8]);
   229	                    offset += 8;
   230	                    ProtoValue::Fixed64(u64::from_le_bytes(raw))
   231	                }
   232	                2 => {
   233	                    let length = read_varint(bytes, &mut offset)?;
   234	                    let remaining = bytes.len().saturating_sub(offset);
   235	                    if length > remaining as u64 {
   236	                        return Err(SettingsProtoError::LengthOutOfBounds {
   237	                            field: number,
   238	                            length,
   239	                            remaining,
   240	                        });
   241	                    }
   242	                    let length = usize::try_from(length).map_err(|_| {
   243	                        SettingsProtoError::LengthOutOfBounds {
   244	                            field: number,
   245	                            length,
   246	                            remaining,
   247	                        }
   248	                    })?;
   249	                    let value = bytes[offset..offset + length].to_vec();
   250	                    offset += length;
   251	                    ProtoValue::LengthDelimited(value)
   252	                }
   253	                5 => {
   254	                    let remaining = bytes.len().saturating_sub(offset);
   255	                    if remaining < 4 {
   256	                        return Err(SettingsProtoError::UnexpectedEnd { offset });
   257	                    }
   258	                    let mut raw = [0_u8; 4];
   259	                    raw.copy_from_slice(&bytes[offset..offset + 4]);
   260	                    offset += 4;
   261	                    ProtoValue::Fixed32(u32::from_le_bytes(raw))
   262	                }
   263	                other => {
   264	                    return Err(SettingsProtoError::UnsupportedWireType {
   265	                        field: number,
   266	                        wire_type: other,
   267	                        offset: tag_offset,
   268	                    });
   269	                }
   270	            };
   271	            fields.push(ProtoField { number, value });
   272	        }
   273	        Ok(Self { fields })
   274	    }
