   425	fn read_varint(bytes: &[u8], offset: &mut usize) -> Result<u64, SettingsProtoError> {
   426	    let start = *offset;
   427	    let mut value = 0_u64;
   428	    let mut shift = 0_u32;
   429	    loop {
   430	        let Some(&byte) = bytes.get(*offset) else {
   431	            return Err(SettingsProtoError::UnexpectedEnd { offset: *offset });
   432	        };
   433	        *offset += 1;
   434	        if shift == 63 && byte > 1 {
   435	            return Err(SettingsProtoError::VarintOverflow { offset: start });
   436	        }
   437	        value |= u64::from(byte & 0x7F) << shift;
   438	        if byte & 0x80 == 0 {
   439	            return Ok(value);
   440	        }
   441	        shift += 7;
   442	        if shift >= 64 {
   443	            return Err(SettingsProtoError::VarintOverflow { offset: start });
   444	        }
   445	    }
   446	}

