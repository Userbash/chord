   108	#[derive(Clone, PartialEq, Eq)]
   109	pub enum ProtoValue {
   110	    /// Varint (включая bool/int32/int64/enum).
   111	    Varint(u64),
   112	    /// 64-битное fixed little-endian.
   113	    Fixed64(u64),
   114	    /// Length-delimited bytes (вложенное сообщение/строка/map).
