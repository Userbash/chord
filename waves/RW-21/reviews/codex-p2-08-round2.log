     1	//! P2-08: `FrecencyUserSettings` (type 2) — structural wrapper (RW-21).
     2	//!
     3	//! В захватах `USER_SETTINGS_PROTO_UPDATE` приходит `settings.type=2`; это **не**
     4	//! `PreloadedUserSettings`, а отдельная схема favorite/frecency. P2-08 сохраняет её
     5	//! top-level поля и версии структурно, не выдумывая семантику map-значений.
     6	
     7	use std::fmt;
     8	
     9	use super::preloaded::Versions;
    10	use super::wire::{ProtoMessage, SettingsProtoError};
    11	
    12	/// `FrecencyUserSettings` из `USER_SETTINGS_PROTO_UPDATE` (type 2).
    13	#[derive(Clone, PartialEq, Eq)]
    14	pub struct FrecencyUserSettings {
    15	    /// Полное top-level сообщение; вложенные map/frecency-структуры не типизированы.
    16	    pub raw: ProtoMessage,
    17	    /// Версии схемы.
    18	    pub versions: Option<Versions>,
    19	}
    20	
    21	impl FrecencyUserSettings {
    22	    /// Разобрать bytes `FrecencyUserSettings`.
    23	    pub fn decode(bytes: &[u8]) -> Result<Self, SettingsProtoError> {
    24	        let raw = ProtoMessage::decode(bytes)?;
    25	        let versions = raw
    26	            .message(1)?
    27	            .map(|message| Versions::from_message(&message))
    28	            .transpose()?;
    29	        Ok(Self { raw, versions })
    30	    }
    31	}
    32	
    33	impl fmt::Debug for FrecencyUserSettings {
    34	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
    35	        formatter
    36	            .debug_struct("FrecencyUserSettings")
    37	            .field("raw_fields", &self.raw.fields.len())
    38	            .field("versions", &self.versions.is_some())
    39	            .finish()
    40	    }
    41	}
     1	//! P2-08: settings-proto (RW-21).
     2	//!
     3	//! Публичная граница: base64/bytes → [`SettingsProto`]. Type 1 — READY
     4	//! `user_settings_proto` (`PreloadedUserSettings`), type 2 — `USER_SETTINGS_PROTO_UPDATE`
     5	//! (`FrecencyUserSettings`). Неизвестный type сохраняется как generic [`ProtoMessage`].
     6	//!
     7	//! Модуль не делает I/O, не знает про `State`, REST, UI и live Discord; base64 берётся из
     8	//! уже принятого `rest::base64` (P1-08), чтобы не дублировать декодер.
     9	
    10	pub mod frecency;
    11	pub mod preloaded;
    12	pub mod wire;
    13	
    14	use crate::rest::base64;
    15	
    16	pub use frecency::FrecencyUserSettings;
    17	pub use preloaded::{
    18	    AppearanceSettings, InboxSettings, LocalizationSettings, NotificationSettings,
    19	    PreloadedUserSettings, StatusSettings, TextAndImagesSettings, Versions, VoiceAndVideoSettings,
    20	};
    21	pub use wire::{
    22	    MAX_FIELDS, MAX_PROTO_BYTES, ProtoField, ProtoMessage, ProtoValue, SettingsProtoError,
    23	};
    24	
    25	/// `PRELOADED_USER_SETTINGS` из enum `UserSettingsProtoType`.
    26	pub const PRELOADED_USER_SETTINGS_TYPE: u64 = 1;
    27	
    28	/// `FRECENCY_AND_FAVORITES_SETTINGS` из enum `UserSettingsProtoType`.
    29	pub const FRECENCY_AND_FAVORITES_SETTINGS_TYPE: u64 = 2;
    30	
    31	/// Разобранные настройки в зависимости от `settings.type`.
    32	#[derive(Debug, Clone, PartialEq, Eq)]
    33	pub enum SettingsProto {
    34	    /// Type 1 — READY `user_settings_proto`.
    35	    Preloaded(Box<PreloadedUserSettings>),
    36	    /// Type 2 — `USER_SETTINGS_PROTO_UPDATE`.
    37	    Frecency(FrecencyUserSettings),
    38	    /// Неизвестный type; wire сохранён без интерпретации.
    39	    Unsupported {
    40	        /// Числовой type из события.
    41	        proto_type: u64,
    42	        /// Generic top-level сообщение.
    43	        message: ProtoMessage,
    44	    },
    45	}
    46	
    47	impl SettingsProto {
    48	    /// Разобрать bytes по числовому `settings.type`.
    49	    pub fn parse(proto_type: u64, bytes: &[u8]) -> Result<Self, SettingsProtoError> {
    50	        match proto_type {
    51	            PRELOADED_USER_SETTINGS_TYPE => Ok(Self::Preloaded(Box::new(
    52	                PreloadedUserSettings::decode(bytes)?,
    53	            ))),
    54	            FRECENCY_AND_FAVORITES_SETTINGS_TYPE => {
    55	                Ok(Self::Frecency(FrecencyUserSettings::decode(bytes)?))
    56	            }
    57	            other => Ok(Self::Unsupported {
    58	                proto_type: other,
    59	                message: ProtoMessage::decode(bytes)?,
    60	            }),
    61	        }
    62	    }
    63	
    64	    /// Числовой type, с которым настройки пришли.
    65	    #[must_use]
    66	    pub fn proto_type(&self) -> u64 {
    67	        match self {
    68	            Self::Preloaded(_) => PRELOADED_USER_SETTINGS_TYPE,
    69	            Self::Frecency(_) => FRECENCY_AND_FAVORITES_SETTINGS_TYPE,
    70	            Self::Unsupported { proto_type, .. } => *proto_type,
    71	        }
    72	    }
    73	
    74	    /// Top-level wire-сообщение (включая неизвестные поля).
    75	    #[must_use]
    76	    pub fn raw(&self) -> &ProtoMessage {
    77	        match self {
    78	            Self::Preloaded(settings) => &settings.raw,
    79	            Self::Frecency(settings) => &settings.raw,
    80	            Self::Unsupported { message, .. } => message,
    81	        }
    82	    }
    83	}
    84	
    85	/// Разобрать base64-строку настроек по числовому type.
    86	pub fn decode_settings(
    87	    proto_type: u64,
    88	    base64_text: &str,
    89	) -> Result<SettingsProto, SettingsProtoError> {
    90	    let bytes = base64::decode(base64_text)?;
    91	    SettingsProto::parse(proto_type, &bytes)
    92	}
    93	
    94	/// Разобрать base64 `PreloadedUserSettings` (type 1, READY).
    95	pub fn decode_preloaded_user_settings(
    96	    base64_text: &str,
    97	) -> Result<PreloadedUserSettings, SettingsProtoError> {
    98	    let bytes = base64::decode(base64_text)?;
    99	    PreloadedUserSettings::decode(&bytes)
   100	}
   101	
   102	/// Разобрать base64 `FrecencyUserSettings` (type 2, UPDATE).
   103	pub fn decode_frecency_user_settings(
   104	    base64_text: &str,
   105	) -> Result<FrecencyUserSettings, SettingsProtoError> {
   106	    let bytes = base64::decode(base64_text)?;
   107	    FrecencyUserSettings::decode(&bytes)
   108	}

