    90	                "фикстура {name:?} не найдена: {} или {}",
    91	                repository.display(),
    92	                lab.display()
    93	            ),
    94	            Self::Io { path, source } => {
    95	                write!(formatter, "ошибка чтения {}: {source}", path.display())
    96	            }
    97	            Self::Utf8 { path } => {
    98	                write!(formatter, "фикстура {} не является UTF-8", path.display())
    99	            }
   100	        }
   101	    }
   102	}
