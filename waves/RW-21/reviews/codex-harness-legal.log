    25	#[derive(Debug, Clone, PartialEq, Eq)]
    26	pub struct Fixture {
    27	    /// Имя относительно корня фикстур (например, `gateway/ready-stats.json`).
    28	    pub name: String,
    29	    /// Где именно найден файл.
