     2	# Внешние зависимости: ruzstd 0.9.1 (чистый Rust, карточка RW-02) и — с RW-04 — транспорт
     3	# шлюза: tokio/tokio-tungstenite (WS), rustls с провайдером ring, webpki-roots, futures-util;
     4	# dev-зависимость `zstd` (C-энкодер) — только для стабов в тестах. После первой сборки (сеть,
     5	# разрешение владельца 2026-10-19) тесты идут офлайн (`cargo test --offline`).
     6	[workspace]
     7	resolver = "2"
     8	members = ["crates/*"]
     9	
    10	[workspace.package]
    11	version = "0.1.0"
    12	edition = "2024"
    13	license = "MIT OR Apache-2.0"
    14	rust-version = "1.87"
    15	
    16	[workspace.dependencies]
    17	discord-codec = { path = "crates/discord-codec" }
    18	discord-core = { path = "crates/discord-core" }
    19	discord-conformance = { path = "crates/discord-conformance" }
    20	# Транспорт шлюза (RW-04). Версии — стартовые из ТЗ, точные фиксирует Cargo.lock.
    21	tokio = { version = "1.53", features = ["rt-multi-thread", "macros", "net", "time"] }
    22	tokio-tungstenite = { version = "0.30", features = ["rustls-tls-webpki-roots"] }
    23	# TLS-провайдер ring (не aws-lc-rs: без cmake/nasm), tls12 оставлен для совместимости.
    24	rustls = { version = "0.23", default-features = false, features = ["ring", "std", "tls12"] }
    25	# HTTP/1.1-транспорт REST (RW-10, решение владельца — вариант A): TLS поверх tokio.
    26	# Версии уже в Cargo.lock/офлайн-кэше; сетевых загрузок нет.
    27	tokio-rustls = { version = "0.26", default-features = false, features = ["ring", "tls12"] }
    28	httparse = "1"
    29	webpki-roots = "1"
    30	futures-util = { version = "0.3", default-features = false, features = ["sink", "std"] }
    31	# Энкодер zstd — только для стабов тестов (продукт на чтении использует ruzstd).
    32	zstd = "0.14"

