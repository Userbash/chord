   125	    )
   126	}
   127	
   128	/// Путь к манифесту фикстур.
   129	pub fn manifest_path() -> PathBuf {
   130	    fixtures_root().join("MANIFEST.json")
   131	}
   132	
   133	/// Текст манифеста фикстур.
   134	pub fn manifest_text() -> Result<String, ConformanceError> {
