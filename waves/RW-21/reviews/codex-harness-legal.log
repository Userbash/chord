    77	
    78	impl fmt::Display for ConformanceError {
    79	    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
    80	        match self {
    81	            Self::InvalidName { name } => {
    82	                write!(formatter, "недопустимое имя фикстуры: {name:?}")
    83	            }
    84	            Self::NotFound {
