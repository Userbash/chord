     1	//! REST v9: запрет телеметрии science/beaker/track (RW-11 / P1-11, T-SEC-04).
     2	//!
     3	//! Контракт заморожен координатором до старта W11b; реализация — `is_telemetry_path` +
     4	//! `guard_target` (4/4 green), без сети и без отправки телеметрии.
     5	//!
     6	//! Оракул: `docs/re/rest-d02.md` §3/§7 — `POST /api/v9/science` (88 запросов с
     7	//! `Authorization`), `POST /beaker` (1), `POST /track` не наблюдался; в API-таблицу они
     8	//! осознанно не включены. Политика клиента — телеметрия по умолчанию **не отправляется**.
     9	
    10	/// Точные первые сегменты путей телеметрии (после `/api/v9`).
    11	pub const TELEMETRY_SEGMENTS: [&str; 3] = ["science", "beaker", "track"];
    12	
    13	/// Отказ политики телеметрии.
    14	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    15	pub enum TelemetryError {
    16	    /// Путь относится к телеметрии и не должен уходить в сеть.
    17	    Blocked,
    18	}
    19	
    20	/// Первый сегмент пути: между ведущим `/` и следующим `/`, без query и fragment.
    21	///
    22	/// `None` — target не начинается с `/` (относительный путь не является путём REST-запроса,
    23	/// поэтому, например, `science` без слэша — не телеметрия).
    24	fn first_path_segment(target: &str) -> Option<&str> {
    25	    // Query и fragment отбрасываются целиком: режем по первому `?` или `#`.
    26	    let path = match target.find(['?', '#']) {
    27	        Some(end) => &target[..end],
    28	        None => target,
    29	    };
    30	    let rest = path.strip_prefix('/')?;
    31	    Some(
    32	        rest.split_once('/')
    33	            .map_or(rest, |(segment, _tail)| segment),
    34	    )
    35	}
    36	
    37	/// Является ли target телеметрическим: первый сегмент пути точно `science`/`beaker`/`track`.
    38	///
    39	/// Query и fragment отбрасываются; `/scientific` и `/users/@me/science` — **не** телеметрия.
    40	#[must_use]
    41	pub fn is_telemetry_path(target: &str) -> bool {
    42	    first_path_segment(target).is_some_and(|segment| TELEMETRY_SEGMENTS.contains(&segment))
    43	}
    44	
    45	/// Пропускает target или отказывает [`TelemetryError::Blocked`].
    46	///
    47	/// При пропуске возвращается исходный срез без копирования и нормализации.
    48	pub fn guard_target(target: &str) -> Result<&str, TelemetryError> {
    49	    if is_telemetry_path(target) {
    50	        Err(TelemetryError::Blocked)
    51	    } else {
    52	        Ok(target)
    53	    }
    54	}

