   138	/// Найти фикстуру: сначала курированную копию, затем лабораторию.
   139	///
   140	/// Возвращает [`ConformanceError::InvalidName`] до любых обращений к файловой системе,
   141	/// поэтому имя не может выйти за корень.
   142	pub fn resolve(name: &str) -> Result<Fixture, ConformanceError> {
   143	    validate_name(name)?;
   144	    let repository = fixtures_root().join(name);
   145	    if repository.is_file() {
   146	        return Ok(Fixture {
   147	            name: name.to_string(),
   148	            source: FixtureSource::Repository,
   149	            path: repository,
   150	        });
   151	    }
   152	    let lab = lab_root().join(name);
   153	    if lab.is_file() {
   154	        return Ok(Fixture {
   155	            name: name.to_string(),
   156	            source: FixtureSource::Lab,
   157	            path: lab,
   158	        });
   159	    }
   160	    Err(ConformanceError::NotFound {
   161	        name: name.to_string(),
   162	        repository,
   163	        lab,
   164	    })
   165	}
   166	
   167	/// Прочитать фикстуру как байты (repo → lab).
   168	pub fn load_bytes(name: &str) -> Result<Vec<u8>, ConformanceError> {
   169	    resolve(name)?.read_bytes()
   170	}
   171	
   172	/// Прочитать фикстуру как UTF-8-текст (repo → lab).
   173	pub fn load_text(name: &str) -> Result<String, ConformanceError> {
   174	    resolve(name)?.read_text()
   175	}
   176	
   177	/// Проверка относительного имени без выхода за корень.
   178	fn validate_name(name: &str) -> Result<(), ConformanceError> {
   179	    let path = Path::new(name);
   180	    let invalid = name.is_empty()
   181	        || path.is_absolute()
   182	        || path.components().any(|component| {
   183	            matches!(
   184	                component,
   185	                Component::ParentDir | Component::RootDir | Component::Prefix(_)
   186	            )
   187	        });
   188	    if invalid {
   189	        Err(ConformanceError::InvalidName {
   190	            name: name.to_string(),
   191	        })
   192	    } else {
   193	        Ok(())
   194	    }
   195	}
   196	
   197	/// Чтение с типизированной ошибкой; `NotFound` здесь тоже `Io` — вызывающий уже разрешил путь.
   198	fn read_bytes(path: &Path) -> Result<Vec<u8>, ConformanceError> {
   199	    std::fs::read(path).map_err(|source| ConformanceError::Io {
   200	        path: path.to_path_buf(),
   201	        source,
   202	    })
   203	}
   204	
   205	fn read_text(path: &Path) -> Result<String, ConformanceError> {
   206	    let bytes = read_bytes(path)?;
   207	    String::from_utf8(bytes).map_err(|_| ConformanceError::Utf8 {
   208	        path: path.to_path_buf(),
   209	    })
   210	}

