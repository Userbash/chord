   604	/// Атом: чистый ASCII → `0x64`; иначе ≤255 Б → `0x77`; иначе → `0x76`.
   605	fn write_atom(name: &str, out: &mut Vec<u8>) -> Result<(), EtfEncodeError> {
   606	    let bytes = name.as_bytes();
