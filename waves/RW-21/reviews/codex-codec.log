   340	/// Ровно `depth` вложенных LIST (внутри — Int(0)), по контракту глубины.
   341	fn nested_lists(depth: usize) -> Vec<u8> {
   342	    let mut buf = Vec::new();
   343	    for _ in 0..depth {
   344	        buf.extend_from_slice(&[0x6c, 0x00, 0x00, 0x00, 0x01]);
   345	    }
   346	    buf.extend_from_slice(&[0x61, 0x00]);
   347	    buf.extend(std::iter::repeat_n(0x6a_u8, depth));
   348	    buf
   349	}
