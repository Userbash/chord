   644	/// Минимальное число байт для величины (≥1); `u64::MIN.leading_zeros()` даёт 1, а не 0.
   645	fn min_digits(magnitude: u64) -> u8 {
   646	    let bits = u64::BITS - magnitude.leading_zeros();
   647	    bits.div_ceil(8).max(1) as u8
   648	}

