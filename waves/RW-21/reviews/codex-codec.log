     1	//! P1-01: полный контракт ETF-энкодера (checked-путь, границы, глубина) и усиленный fuzz.
     2	//!
     3	//! Оракул: `docs/re/gateway-protocol.md` §2, канонические байты RW-01 и `MAX_DEPTH=64`
     4	//! (тот же предел у декодера). Тесты не подгоняют реализацию: для обычных значений
     5	//! `encode_checked` обязан давать ровно те же байты, что принятый `encode`.
     6	
     7	use discord_codec::etf::{self, EtfEncodeError, EtfError, EtfValue, MAX_DEPTH};
     8	
     9	fn atom(s: &str) -> EtfValue {
    10	    EtfValue::Atom(s.to_string())
    11	}
    12	
    13	fn int(v: i64) -> EtfValue {
    14	    EtfValue::Int(v)
    15	}
    16	
    17	fn text(s: &str) -> EtfValue {
    18	    EtfValue::Str(s.to_string())
    19	}
    20	
    21	fn nested_lists(depth: usize) -> EtfValue {
    22	    let mut value = EtfValue::Nil;
    23	    for _ in 0..depth {
    24	        value = EtfValue::List(vec![value]);
    25	    }
    26	    value
    27	}
    28	
    29	#[test]
    30	fn checked_encoder_is_byte_exact_with_infallible_encoder() {
    31	    let cases = vec![
    32	        EtfValue::Nil,
    33	        atom("op"),
    34	        atom("Проверка"),
    35	        int(0),
    36	        int(-1),
    37	        int(i32::MIN.into()),
    38	        int(i64::MIN),
    39	        int(i64::MAX),
    40	        EtfValue::Float(-0.0),
    41	        text(""),
    42	        text("привет"),
    43	        EtfValue::Tuple(vec![int(1), atom("a")]),
    44	        EtfValue::List(vec![int(1), EtfValue::Nil]),
    45	        EtfValue::Map(vec![(atom("a"), int(1)), (text("b"), text("x"))]),
    46	        nested_lists(MAX_DEPTH),
    47	    ];
    48	    for value in cases {
    49	        assert_eq!(
    50	            etf::encode_checked(&value),
    51	            Ok(etf::encode(&value)),
    52	            "framed checked != infallible для {value:?}"
    53	        );
    54	        assert_eq!(
    55	            etf::encode_term_checked(&value),
    56	            Ok(etf::encode_term(&value)),
    57	            "term checked != infallible для {value:?}"
    58	        );
    59	    }
    60	}
    61	
    62	#[test]
    63	fn depth_limit_is_the_same_for_encoder_and_decoder() {
    64	    let at_limit = nested_lists(MAX_DEPTH);
    65	    let encoded = etf::encode_checked(&at_limit).expect("глубина 64 допустима");
    66	    let (decoded, consumed) = etf::decode(&encoded).expect("декодер принимает глубину 64");
    67	    assert_eq!(consumed, encoded.len());
    68	    assert_eq!(decoded, at_limit);
    69	
    70	    let too_deep = nested_lists(MAX_DEPTH + 1);
    71	    assert_eq!(
    72	        etf::encode_checked(&too_deep),
    73	        Err(EtfEncodeError::DepthLimit { limit: MAX_DEPTH })
    74	    );
    75	
    76	    // Сырой поток из 65 вложенных LIST_EXT: декодер обязан остановиться на 65-м
    77	    // контейнере, не пытаясь рекурсивно читать хвост.
    78	    let mut raw = Vec::new();
    79	    for _ in 0..=MAX_DEPTH {
    80	        raw.push(0x6c); // LIST_EXT
    81	        raw.extend_from_slice(&1u32.to_be_bytes());
    82	    }
    83	    raw.push(discord_codec::TAG_NIL_EXT);
    84	    assert!(matches!(
    85	        etf::decode_term(&raw),
    86	        Err(EtfError::DepthLimit { .. })
    87	    ));
    88	}
    89	
    90	#[test]
    91	fn checked_encoder_rejects_atom_that_does_not_fit_u16_without_truncation() {
    92	    // 65 536 ASCII-байт: `u16` длины не хватает. Обычный `encode` в этом случае паникует
    93	    // по документированному контракту, checked-путь обязан вернуть ошибку.
    94	    let value = atom(&"x".repeat(usize::from(u16::MAX) + 1));
    95	    assert_eq!(
    96	        etf::encode_checked(&value),
    97	        Err(EtfEncodeError::AtomTooLong {
    98	            len: usize::from(u16::MAX) + 1
    99	        })
   100	    );
   101	    assert_eq!(
   102	        etf::encode_term_checked(&value),
   103	        Err(EtfEncodeError::AtomTooLong {
   104	            len: usize::from(u16::MAX) + 1
   105	        })
   106	    );
   107	}
   108	
   109	#[test]
   110	fn big_int_borders_roundtrip_through_checked_path() {
   111	    for value in [
   112	        int(i64::MIN),
   113	        int(i64::MIN + 1),
   114	        int(-(1 << 32)),
   115	        int(-1),
   116	        int(1),
   117	        int(1 << 32),
   118	        int(i64::MAX - 1),
   119	        int(i64::MAX),
   120	    ] {
   121	        let encoded = etf::encode_term_checked(&value).expect("big-int в границах i64");
   122	        let (decoded, consumed) = etf::decode_term(&encoded).expect("big-int декодируется");
   123	        assert_eq!(consumed, encoded.len());
   124	        assert_eq!(decoded, value);
   125	    }
   126	}
   127	
   128	#[test]
   129	fn fuzz_50k_random_and_all_single_bytes_never_panic() {
   130	    let mut state = 0x9e37_79b9_7f4a_7c15u64;
   131	    let mut next = || {
   132	        state ^= state << 7;
   133	        state ^= state >> 9;
   134	        state ^= state << 8;
   135	        state
   136	    };
   137	    for _ in 0..50_000 {
   138	        let len = (next() as usize) % 129;
   139	        let mut bytes = vec![0u8; len];
   140	        for byte in &mut bytes {
   141	            *byte = next() as u8;
   142	        }
   143	        if let Ok((_, consumed)) = etf::decode(&bytes) {
   144	            assert!(consumed <= bytes.len(), "consumed вышел за буфер");
   145	        }
   146	    }
   147	    for byte in 0u8..=u8::MAX {
   148	        let _ = etf::decode(&[byte]);
   149	        let _ = etf::decode_term(&[byte]);
   150	    }
   151	}
   152	
   153	#[test]
   154	fn prefix_truncation_is_bounded_and_never_reports_overread() {
   155	    let value = EtfValue::Map(vec![
   156	        (atom("op"), int(10)),
   157	        (
   158	            atom("d"),
   159	            EtfValue::List(vec![text("alpha"), int(1_792_391_313_326)]),
   160	        ),
   161	    ]);
   162	    let encoded = etf::encode(&value);
   163	    for end in 0..encoded.len() {
   164	        if let Ok((_, consumed)) = etf::decode(&encoded[..end]) {
   165	            assert!(
   166	                consumed <= end,
   167	                "потреблено {consumed} Б из усечённых {end}"
   168	            );
   169	        }
   170	    }
   171	    let (decoded, consumed) = etf::decode(&encoded).expect("полный буфер");
   172	    assert_eq!(consumed, encoded.len());
   173	    assert_eq!(decoded, value);
   174	}

