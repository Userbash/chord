   584	/// Проверка глубины при входе в контейнер (корень — уровень 1).
   585	fn check_encode_depth(depth: usize) -> Result<(), EtfEncodeError> {
   586	    if depth > MAX_DEPTH {
   587	        Err(EtfEncodeError::DepthLimit { limit: MAX_DEPTH })
   588	    } else {
   589	        Ok(())
   590	    }
   591	}
   592	
   593	/// `0x6d`: бинарник — u32 BE длина + UTF-8 (`0x6b`/`0x63` энкодер не производит).
   594	fn write_binary(text: &str, out: &mut Vec<u8>) -> Result<(), EtfEncodeError> {
   595	    if text.len() > u32::MAX as usize {
   596	        return Err(EtfEncodeError::BinaryTooLong { len: text.len() });
   597	    }
   598	    out.push(TAG_BINARY_EXT);
   599	    out.extend_from_slice(&(text.len() as u32).to_be_bytes());
   600	    out.extend_from_slice(text.as_bytes());
   601	    Ok(())
   602	}
   603	
   604	/// Атом: чистый ASCII → `0x64`; иначе ≤255 Б → `0x77`; иначе → `0x76`.
   605	fn write_atom(name: &str, out: &mut Vec<u8>) -> Result<(), EtfEncodeError> {
   606	    let bytes = name.as_bytes();
   607	    if bytes.len() > u16::MAX as usize {
   608	        return Err(EtfEncodeError::AtomTooLong { len: bytes.len() });
   609	    }
   610	    if bytes.is_ascii() {
   611	        out.push(TAG_ATOM_EXT);
   612	        out.extend_from_slice(&(bytes.len() as u16).to_be_bytes());
   613	    } else if bytes.len() <= usize::from(u8::MAX) {
   614	        out.push(TAG_SMALL_ATOM_UTF8_EXT);
   615	        out.push(bytes.len() as u8);
   616	    } else {
   617	        out.push(TAG_ATOM_UTF8_EXT);
   618	        out.extend_from_slice(&(bytes.len() as u16).to_be_bytes());
   619	    }
   620	    out.extend_from_slice(bytes);
   621	    Ok(())
   622	}
   623	
   624	/// Целое: `0..=255` → `0x61`; диапазон i32 → `0x62`; иначе big-int `0x6e` (знак, затем LE-цифры).
   625	fn write_int(number: i64, out: &mut Vec<u8>) {
   626	    if (0..=i64::from(u8::MAX)).contains(&number) {
   627	        out.push(TAG_SMALL_INTEGER_EXT);
   628	        out.push(number as u8);
   629	        return;
   630	    }
   631	    if let Ok(narrow) = i32::try_from(number) {
   632	        out.push(TAG_INTEGER_EXT);
   633	        out.extend_from_slice(&narrow.to_be_bytes());
   634	        return;
   635	    }
   636	    out.push(TAG_SMALL_BIG_EXT);
   637	    let magnitude = number.unsigned_abs();
   638	    let digits = min_digits(magnitude);
   639	    out.push(digits);
   640	    out.push(u8::from(number < 0));
   641	    out.extend_from_slice(&magnitude.to_le_bytes()[..usize::from(digits)]);
   642	}
   643	
   644	/// Минимальное число байт для величины (≥1); `u64::MIN.leading_zeros()` даёт 1, а не 0.
   645	fn min_digits(magnitude: u64) -> u8 {
   646	    let bits = u64::BITS - magnitude.leading_zeros();
   647	    bits.div_ceil(8).max(1) as u8
   648	}

