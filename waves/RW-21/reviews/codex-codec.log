   383	fn truncated_hello_prefixes_are_errors_not_panics() {
   384	    let hello = unhex(HELLO_HEX);
   385	    for len in 0..138 {
   386	        match etf::decode(&hello[..len]) {
   387	            Err(_) => {}
   388	            Ok(other) => panic!("усечение {len} Б разобрано как целый терм: {other:?}"),
   389	        }
   390	    }
   391	    assert!(etf::decode(&hello).is_ok(), "полный HELLO — ок");
   392	}
