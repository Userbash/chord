    16	/// Строка hex → байты (пробелы игнорируются).
    17	fn unhex(s: &str) -> Vec<u8> {
    18	    let compact: String = s.chars().filter(|c| !c.is_whitespace()).collect();
    19	    assert_eq!(compact.len() % 2, 0, "hex нечётной длины: {s}");
    20	    (0..compact.len() / 2)
    21	        .map(|i| u8::from_str_radix(&compact[2 * i..2 * i + 2], 16).expect("hex"))
    22	        .collect()
    23	}
