   285	/// Позиционный читатель с проверкой границ **до** любых выделений памяти.
   286	struct Reader<'a> {
   287	    buf: &'a [u8],
   288	    pos: usize,
   289	}
   290	
   291	impl<'a> Reader<'a> {
   292	    fn new(buf: &'a [u8]) -> Self {
   293	        Self { buf, pos: 0 }
   294	    }
   295	
   296	    /// Сколько байт ещё не прочитано.
   297	    fn remaining(&self) -> usize {
   298	        self.buf.len().saturating_sub(self.pos)
   299	    }
   300	
   301	    /// Текущий байт без продвижения (для детекта ведущего `0x83`).
   302	    fn peek(&self) -> Result<u8, EtfError> {
   303	        self.buf
   304	            .get(self.pos)
   305	            .copied()
   306	            .ok_or(EtfError::UnexpectedEof {
   307	                at: self.pos,
   308	                need: 1,
   309	            })
   310	    }
   311	
   312	    /// Читает `n` байт; при нехватке — `UnexpectedEof` (без `with_capacity(n)`).
   313	    fn take(&mut self, n: usize) -> Result<&'a [u8], EtfError> {
   314	        if self.remaining() < n {
   315	            return Err(EtfError::UnexpectedEof {
   316	                at: self.pos,
   317	                need: n,
   318	            });
   319	        }
   320	        let slice = &self.buf[self.pos..self.pos + n];
   321	        self.pos += n;
   322	        Ok(slice)
   323	    }
   324	
   325	    fn u8(&mut self) -> Result<u8, EtfError> {
   326	        Ok(self.take(1)?[0])
   327	    }
   328	
   329	    fn u16_be(&mut self) -> Result<u16, EtfError> {
   330	        let bytes = self.take(2)?;
   331	        Ok(u16::from_be_bytes([bytes[0], bytes[1]]))
   332	    }
   333	
   334	    fn u32_be(&mut self) -> Result<u32, EtfError> {
   335	        let bytes = self.take(4)?;
   336	        Ok(u32::from_be_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]))
   337	    }
   338	
   339	    fn i32_be(&mut self) -> Result<i32, EtfError> {
   340	        let bytes = self.take(4)?;
   341	        Ok(i32::from_be_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]))
   342	    }
   343	
   344	    fn f64_be(&mut self) -> Result<f64, EtfError> {
   345	        let bytes = self.take(8)?;
   346	        let mut raw = [0u8; 8];
   347	        raw.copy_from_slice(bytes);
   348	        Ok(f64::from_be_bytes(raw))
   349	    }
   350	
   351	    /// Один терм; `depth` — уровень вложенности (корень — 1).
   352	    fn term(&mut self, depth: usize) -> Result<EtfValue, EtfError> {
   353	        let at = self.pos;
   354	        let tag = self.u8()?;
   355	        match tag {
   356	            TAG_NEW_FLOAT_EXT => Ok(EtfValue::Float(self.f64_be()?)),
   357	            TAG_SMALL_INTEGER_EXT => Ok(EtfValue::Int(i64::from(self.u8()?))),
   358	            TAG_INTEGER_EXT => Ok(EtfValue::Int(i64::from(self.i32_be()?))),
   359	            TAG_FLOAT_EXT => self.float_ext(at),
   360	            TAG_ATOM_EXT => {
   361	                let len = usize::from(self.u16_be()?);
   362	                Ok(EtfValue::Atom(self.latin1(len)?))
   363	            }
   364	            TAG_SMALL_ATOM_EXT => {
   365	                let len = usize::from(self.u8()?);
   366	                Ok(EtfValue::Atom(self.latin1(len)?))
   367	            }
   368	            TAG_SMALL_TUPLE_EXT => {
   369	                let count = usize::from(self.u8()?);
   370	                self.tuple(count, depth, at)
   371	            }
   372	            TAG_LARGE_TUPLE_EXT => {
   373	                let count = self.u32_be()? as usize;
   374	                self.tuple(count, depth, at)
   375	            }
   376	            TAG_NIL_EXT => Ok(EtfValue::Nil),
   377	            TAG_STRING_EXT => {
   378	                let len = usize::from(self.u16_be()?);
   379	                Ok(EtfValue::Str(self.latin1(len)?))
   380	            }
   381	            TAG_LIST_EXT => self.list(depth, at),
   382	            TAG_BINARY_EXT => {
   383	                let len = self.u32_be()? as usize;
   384	                let data_at = self.pos;
   385	                Ok(EtfValue::Str(self.utf8(len, data_at)?))
   386	            }
   387	            TAG_SMALL_BIG_EXT => {
   388	                let digits = usize::from(self.u8()?);
   389	                self.big_int(digits, at)
   390	            }
   391	            TAG_LARGE_BIG_EXT => {
   392	                let digits = self.u32_be()? as usize;
   393	                self.big_int(digits, at)
   394	            }
   395	            TAG_ATOM_UTF8_EXT => {
   396	                let len = usize::from(self.u16_be()?);
   397	                let data_at = self.pos;
   398	                Ok(EtfValue::Atom(self.utf8(len, data_at)?))
   399	            }
   400	            TAG_SMALL_ATOM_UTF8_EXT => {
   401	                let len = usize::from(self.u8()?);
   402	                let data_at = self.pos;
   403	                Ok(EtfValue::Atom(self.utf8(len, data_at)?))
   404	            }
   405	            TAG_MAP_EXT => self.map(depth, at),
   406	            other => Err(EtfError::UnknownTag { tag: other, at }),
   407	        }
   408	    }
