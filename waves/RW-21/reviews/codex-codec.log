   394	#[test]
   395	fn fuzz_lite_never_panics_on_garbage() {
   396	    // Детерминированный LCG (без внешних крейтов): x = x*6364136223846793005 + 1442695040888963407.
   397	    let mut state: u64 = 0x0123_4567_89ab_cdef;
   398	    let mut next = || {
   399	        state = state
   400	            .wrapping_mul(6_364_136_223_846_793_005)
   401	            .wrapping_add(1_442_695_040_888_963_407);
   402	        state
   403	    };
   404	    for _ in 0..20_000 {
   405	        let len = (next() >> 33) as usize % 65;
   406	        let buf: Vec<u8> = (0..len).map(|_| (next() >> 24) as u8).collect();
   407	        let _ = etf::decode_term(&buf);
   408	        let _ = etf::decode(&buf);
   409	    }
   410	    // Исчерпывающе: все однобайтовые буферы.
   411	    for byte in 0u8..=255 {
   412	        let _ = etf::decode_term(&[byte]);
   413	    }
   414	    // Одиночные инверсии (xor 0xff) первых ≤64 байт пяти реальных векторов.
   415	    for src in [
   416	        HELLO_HEX,
   417	        ACK_HEX,
   418	        PRESENCE_HEX,
   419	        MESSAGE_ACK_HEX,
   420	        MEMBER_LIST_HEX,
   421	    ] {
   422	        let bytes = unhex(src);
   423	        let head = bytes.len().min(64);
   424	        for i in 0..head {
   425	            let mut mutated = bytes[..head].to_vec();
   426	            mutated[i] ^= 0xff;
   427	            let _ = etf::decode_term(&mutated);
   428	            let _ = etf::decode(&mutated);
   429	        }
   430	    }
   431	}
