   206	/// Ожидание ошибки `decode_term` без привязки к конкретным `at`/`need`.
   207	fn expect_err(name: &str, bytes: &[u8]) -> EtfError {
   208	    match etf::decode_term(bytes) {
   209	        Err(e) => e,
   210	        Ok((value, consumed)) => {
   211	            panic!("{name}: ожидалась ошибка, получено {value:?} ({consumed} Б)")
   212	        }
   213	    }
   214	}
