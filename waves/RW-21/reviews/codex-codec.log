     1	//! Свойства кодека ETF (волна RW-1, P0-02, крейт `discord-codec`): round-trip, канонический
     2	//! энкод, ошибки, лимиты глубины и fuzz-lite.
     3	//!
     4	//! Оракулы: фиксированные канонические байты сверены с реальными термами захвата
     5	//! (`capture-run2.jsonl`, сокет `95974.1389`; `gw-proto/msgs-run2-95974_1389.jsonl`) и со спекой
     6	//! `docs/re/gateway-protocol.md` §2. Правила канона — контракт ТЗ RW-01.
     7	//!
     8	//! Проверяемое свойство: `decode_term(encode_term(v)) == v` **побайтово** обратимо
     9	//! (`encode_term(decode_term(b).0) == b`) для канонических байт.
    10	
    11	use discord_codec::etf::{self, EtfError, EtfValue, MAX_DEPTH};
    12	
    13	/// Строка hex → байты (пробелы игнорируются).
    14	fn unhex(s: &str) -> Vec<u8> {
    15	    let compact: String = s.chars().filter(|c| !c.is_whitespace()).collect();
    16	    assert_eq!(compact.len() % 2, 0, "hex нечётной длины: {s}");
    17	    (0..compact.len() / 2)
    18	        .map(|i| u8::from_str_radix(&compact[2 * i..2 * i + 2], 16).expect("hex"))
    19	        .collect()
    20	}
    21	
    22	/// Байты → строка hex.
    23	fn hex(bytes: &[u8]) -> String {
    24	    bytes.iter().map(|b| format!("{b:02x}")).collect()
    25	}
    26	
    27	fn atom(s: &str) -> EtfValue {
    28	    EtfValue::Atom(s.to_string())
    29	}
    30	
    31	fn int(v: i64) -> EtfValue {
    32	    EtfValue::Int(v)
    33	}
    34	
    35	fn text(s: &str) -> EtfValue {
    36	    EtfValue::Str(s.to_string())
    37	}
    38	
    39	/// Рекурсивная сверка битов `f64` (чтобы `-0.0` не «уравнивался» с `0.0` по `PartialEq`).
    40	fn assert_float_bits_equal(expected: &EtfValue, actual: &EtfValue, path: &str) {
    41	    match (expected, actual) {
    42	        (EtfValue::Float(x), EtfValue::Float(y)) => {
    43	            assert_eq!(x.to_bits(), y.to_bits(), "{path}: биты f64");
    44	        }
    45	        (EtfValue::Tuple(x), EtfValue::Tuple(y)) | (EtfValue::List(x), EtfValue::List(y)) => {
    46	            assert_eq!(x.len(), y.len(), "{path}: длина");
    47	            for (i, (xe, xa)) in x.iter().zip(y.iter()).enumerate() {
    48	                assert_float_bits_equal(xe, xa, &format!("{path}[{i}]"));
    49	            }
    50	        }
    51	        (EtfValue::Map(x), EtfValue::Map(y)) => {
    52	            assert_eq!(x.len(), y.len(), "{path}: число пар");
    53	            for (i, ((ke, ve), (ka, va))) in x.iter().zip(y.iter()).enumerate() {
    54	                assert_float_bits_equal(ke, ka, &format!("{path}[{i}].key"));
    55	                assert_float_bits_equal(ve, va, &format!("{path}[{i}].value"));
    56	            }
    57	        }
    58	        _ => {}
    59	    }
    60	}
    61	
    62	/// Round-trip значения: `encode_term → decode_term` и `encode → decode`.
    63	fn roundtrip(value: &EtfValue) {
    64	    let payload = etf::encode_term(value);
    65	    let (decoded, consumed) = etf::decode_term(&payload).expect("decode_term");
    66	    assert_eq!(consumed, payload.len(), "consumed != длины терма");
    67	    assert_eq!(&decoded, value, "значение исказилось");
    68	    assert_float_bits_equal(value, &decoded, "$");
    69	    assert_eq!(
    70	        etf::encode_term(&decoded),
    71	        payload,
    72	        "повторный энкод не идемпотентен"
    73	    );
    74	
    75	    let framed = etf::encode(value);
    76	    assert_eq!(
    77	        framed.first().copied(),
    78	        Some(0x83),
    79	        "encode обязан начинаться с 0x83"
    80	    );
    81	    assert_eq!(&framed[1..], payload.as_slice(), "0x83 + терм");
    82	    let (decoded_framed, framed_consumed) = etf::decode(&framed).expect("decode");
    83	    assert_eq!(framed_consumed, framed.len());
    84	    assert_eq!(decoded_framed, *value);
    85	}
