    36	/// Ошибки zstd-стрима.
    37	#[derive(Debug, Clone, PartialEq, Eq)]
    38	pub enum ZstdError {
    39	    /// Поток не начинается с магии zstd-кадра (`28 b5 2f fd`) — это не поток шлюза.
