   351	#[test]
   352	fn nesting_depth_limit_is_enforced() {
   353	    let ok = nested_lists(MAX_DEPTH);
   354	    let (value, consumed) = etf::decode_term(&ok).expect("ровно MAX_DEPTH — допустимо");
   355	    assert_eq!(consumed, ok.len());
   356	    let mut cursor = &value;
   357	    let mut depth = 0;
   358	    while let Some(items) = cursor.as_list() {
   359	        depth += 1;
   360	        cursor = &items[0];
   361	    }
   362	    assert_eq!(depth, MAX_DEPTH, "вложенность разобралась не полностью");
   363	    assert_eq!(cursor, &int(0));
   364	    roundtrip(&value);
   365	
   366	    match etf::decode_term(&nested_lists(MAX_DEPTH + 1)) {
   367	        Err(EtfError::DepthLimit { .. }) => {}
   368	        other => panic!("MAX_DEPTH+1: ожидался DepthLimit, получено {other:?}"),
   369	    }
   370	    // Глубина режется и внутри кортежей/map: 65 кортежей подряд — предел.
   371	    let mut deep_tuple = Vec::new();
   372	    for _ in 0..=MAX_DEPTH {
   373	        deep_tuple.extend_from_slice(&[0x68, 0x01]);
   374	    }
   375	    deep_tuple.extend_from_slice(&[0x61, 0x00]);
   376	    assert!(matches!(
   377	        etf::decode_term(&deep_tuple),
   378	        Err(EtfError::DepthLimit { .. })
   379	    ));
   380	}
