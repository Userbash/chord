   433	#[test]
   434	fn accessors_keep_types_strict() {
   435	    let a = atom("nil");
   436	    let s = text("nil");
   437	    let n = EtfValue::Nil;
   438	    assert_eq!(a.as_atom(), Some("nil"));
   439	    assert_eq!(a.as_str(), None, "атом — не бинарник");
   440	    assert_eq!(s.as_str(), Some("nil"));
   441	    assert_eq!(s.as_atom(), None, "бинарник — не атом");
   442	    assert_eq!(n.as_atom(), None);
   443	    assert_eq!(n.as_str(), None);
   444	    assert_eq!(n.as_int(), None);
   445	    assert_eq!(n.as_float(), None);
   446	    assert_eq!(int(3).as_int(), Some(3));
   447	    assert_eq!(int(3).as_float(), None, "int — не float");
   448	    assert_eq!(EtfValue::Float(3.5).as_float(), Some(3.5));
   449	    assert_eq!(EtfValue::Float(3.5).as_int(), None, "float — не int");
   450	    assert_eq!(EtfValue::Tuple(vec![int(1)]).as_list(), None);
   451	    assert_eq!(EtfValue::List(vec![int(1)]).as_list(), Some(&[int(1)][..]));
   452	    assert_eq!(EtfValue::List(vec![int(1)]).as_map(), None);
   453	    assert_eq!(
   454	        EtfValue::Map(vec![(atom("k"), int(9))])
   455	            .as_map()
   456	            .map(<[(EtfValue, EtfValue)]>::len),
   457	        Some(1)
   458	    );
   459	    // get: только Map; ключ — атом ИЛИ бинарник.
   460	    let m = EtfValue::Map(vec![(atom("a"), int(1)), (text("b"), int(2))]);
   461	    assert_eq!(m.get("a"), Some(&int(1)));
   462	    assert_eq!(m.get("b"), Some(&int(2)));
   463	    assert_eq!(m.get("c"), None);
   464	    assert_eq!(n.get("a"), None);
   465	    assert_eq!(EtfValue::Map(vec![(int(1), text("x"))]).get("1"), None);
   466	    // Бинарные ключи HELLO-подобной map с дубликатом атом/бинарник: находится первый.
   467	    let mixed = EtfValue::Map(vec![(atom("k"), int(1)), (text("k"), int(2))]);
   468	    assert_eq!(mixed.get("k"), Some(&int(1)));
   469	}
