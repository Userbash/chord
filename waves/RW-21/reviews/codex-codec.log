   594	fn write_binary(text: &str, out: &mut Vec<u8>) -> Result<(), EtfEncodeError> {
   595	    if text.len() > u32::MAX as usize {
   596	        return Err(EtfEncodeError::BinaryTooLong { len: text.len() });
