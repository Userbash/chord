   216	#[test]
   217	fn decoder_reports_specific_errors() {
   218	    // Пустой буфер и обрыв фиксированного поля.
   219	    assert!(
   220	        matches!(expect_err("пусто", &[]), EtfError::UnexpectedEof { .. }),
   221	        "пустой буфер — UnexpectedEof"
   222	    );
   223	    assert!(matches!(
   224	        expect_err("0x62 без 4 байт", &[0x62, 0x00]),
   225	        EtfError::UnexpectedEof { .. }
   226	    ));
   227	    assert!(matches!(
   228	        expect_err("0x46 без 8 байт", &[0x46, 0x00, 0x00]),
   229	        EtfError::UnexpectedEof { .. }
   230	    ));
   231	    // Неизвестный тег (в т.ч. 0x83 — маркер кадра, в терме недопустим).
   232	    assert_eq!(
   233	        expect_err("0x7f", &[0x7f]),
   234	        EtfError::UnknownTag { tag: 0x7f, at: 0 }
   235	    );
   236	    assert_eq!(
   237	        expect_err("0x83", &[0x83]),
   238	        EtfError::UnknownTag { tag: 0x83, at: 0 }
   239	    );
   240	    match expect_err("тег внутри map", &unhex("7400000001 7f 6101")) {
   241	        EtfError::UnknownTag { tag, .. } => assert_eq!(tag, 0x7f),
   242	        other => panic!("ожидался UnknownTag, получено {other:?}"),
   243	    }
   244	    // Строгий UTF-8 у 0x6d.
   245	    match expect_err("0x6d ff", &unhex("6d00000001ff")) {
   246	        EtfError::InvalidUtf8 { .. } => {}
   247	        other => panic!("ожидался InvalidUtf8, получено {other:?}"),
   248	    }
   249	    match expect_err("0x76 невалидный utf8", &unhex("760002 ff80")) {
   250	        EtfError::InvalidUtf8 { .. } => {}
   251	        other => panic!("ожидался InvalidUtf8, получено {other:?}"),
   252	    }
   253	    // Хвост LIST_EXT — только NIL_EXT.
   254	    match expect_err("хвост-Int", &unhex("6c0000000161016101")) {
   255	        EtfError::ListTailNotNil { tail_tag, .. } => assert_eq!(tail_tag, 0x61),
   256	        other => panic!("ожидался ListTailNotNil, получено {other:?}"),
   257	    }
   258	    match expect_err("хвост-0x83", &unhex("6c00000000 83")) {
   259	        EtfError::ListTailNotNil { tail_tag, .. } => assert_eq!(tail_tag, 0x83),
   260	        other => panic!("ожидался ListTailNotNil, получено {other:?}"),
   261	    }
   262	    match expect_err("хвост оборван", &unhex("6c000000016101")) {
   263	        EtfError::UnexpectedEof { .. } => {}
   264	        other => panic!("ожидался UnexpectedEof, получено {other:?}"),
   265	    }
   266	    // FLOAT_EXT: 31 байт мусора не парсится как f64.
   267	    let mut spaces = vec![0x63];
   268	    spaces.extend([0x20u8; 31]);
   269	    match expect_err("float из пробелов", &spaces) {
   270	        EtfError::MalformedFloat { .. } => {}
   271	        other => panic!("ожидался MalformedFloat, получено {other:?}"),
   272	    }
   273	    assert!(
   274	        matches!(
   275	            expect_err("0x63 без 31 Б", &[0x63, 0x31]),
   276	            EtfError::UnexpectedEof { .. }
   277	        ),
   278	        "0x63 короткий — UnexpectedEof"
   279	    );
   280	    // Заявленная длина 0xffffffff: ошибка ДО какой-либо аллокации (не 4 ГиБ).
   281	    match expect_err("0x6d ffffffff", &unhex("6dffffffff")) {
   282	        EtfError::UnexpectedEof { .. } => {}
   283	        other => panic!("ожидался UnexpectedEof, получено {other:?}"),
   284	    }
   285	    for src in ["6bffff03 616263", "69000000", "6cffffffff 6a", "74ffffffff"] {
   286	        assert!(
   287	            matches!(expect_err(src, &unhex(src)), EtfError::UnexpectedEof { .. }),
   288	            "{src}: ожидался UnexpectedEof"
