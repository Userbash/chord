   517	/// Канонический энкод терма в буфер.
   518	fn write_term(value: &EtfValue, out: &mut Vec<u8>, depth: usize) -> Result<(), EtfEncodeError> {
   519	    match value {
   520	        EtfValue::Nil => out.push(TAG_NIL_EXT),
   521	        EtfValue::Int(number) => write_int(*number, out),
   522	        EtfValue::Float(number) => {
   523	            out.push(TAG_NEW_FLOAT_EXT);
   524	            out.extend_from_slice(&number.to_be_bytes());
   525	        }
   526	        EtfValue::Str(text) => write_binary(text, out)?,
   527	        EtfValue::Atom(name) => write_atom(name, out)?,
   528	        EtfValue::Tuple(items) => {
   529	            check_encode_depth(depth)?;
   530	            if items.len() > u32::MAX as usize {
   531	                return Err(EtfEncodeError::ContainerTooLong {
   532	                    kind: "tuple",
   533	                    len: items.len(),
   534	                    max: u32::MAX as usize,
   535	                });
   536	            }
   537	            if items.len() <= usize::from(u8::MAX) {
   538	                out.push(TAG_SMALL_TUPLE_EXT);
   539	                out.push(items.len() as u8);
   540	            } else {
   541	                out.push(TAG_LARGE_TUPLE_EXT);
   542	                out.extend_from_slice(&(items.len() as u32).to_be_bytes());
   543	            }
   544	            for item in items {
   545	                write_term(item, out, depth + 1)?;
   546	            }
   547	        }
   548	        EtfValue::List(items) => {
   549	            check_encode_depth(depth)?;
   550	            if items.len() > u32::MAX as usize {
   551	                return Err(EtfEncodeError::ContainerTooLong {
   552	                    kind: "list",
   553	                    len: items.len(),
   554	                    max: u32::MAX as usize,
   555	                });
   556	            }
   557	            out.push(TAG_LIST_EXT);
   558	            out.extend_from_slice(&(items.len() as u32).to_be_bytes());
   559	            for item in items {
   560	                write_term(item, out, depth + 1)?;
   561	            }
   562	            out.push(TAG_NIL_EXT);
   563	        }
   564	        EtfValue::Map(pairs) => {
   565	            check_encode_depth(depth)?;
   566	            if pairs.len() > u32::MAX as usize {
   567	                return Err(EtfEncodeError::ContainerTooLong {
   568	                    kind: "map",
   569	                    len: pairs.len(),
   570	                    max: u32::MAX as usize,
   571	                });
   572	            }
   573	            out.push(TAG_MAP_EXT);
   574	            out.extend_from_slice(&(pairs.len() as u32).to_be_bytes());
   575	            for (key, value) in pairs {
   576	                write_term(key, out, depth + 1)?;
   577	                write_term(value, out, depth + 1)?;
   578	            }
   579	        }
   580	    }
   581	    Ok(())
   582	}
