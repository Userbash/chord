   508	/// Проверка лимита глубины при входе в контейнер (корень — уровень 1).
   509	fn check_depth(depth: usize, at: usize) -> Result<(), EtfError> {
   510	    if depth > MAX_DEPTH {
   511	        Err(EtfError::DepthLimit { at })
   512	    } else {
   513	        Ok(())
   514	    }
   515	}
