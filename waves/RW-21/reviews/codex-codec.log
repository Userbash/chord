   410	    /// `0x63 FLOAT_EXT`: 31 Б ASCII/latin1, значимая часть без хвостовых `\0` и пробелов.
   411	    fn float_ext(&mut self, at: usize) -> Result<EtfValue, EtfError> {
   412	        let raw = self.take(31)?;
   413	        let mut end = raw.len();
   414	        while end > 0 && matches!(raw[end - 1], 0 | b' ') {
   415	            end -= 1;
   416	        }
   417	        let text = std::str::from_utf8(&raw[..end]).map_err(|_| EtfError::MalformedFloat { at })?;
   418	        text.parse::<f64>()
   419	            .map(EtfValue::Float)
   420	            .map_err(|_| EtfError::MalformedFloat { at })
   421	    }
   422	
   423	    /// `0x64`/`0x73`/`0x6b`: latin1 — каждый байт становится code point.
   424	    fn latin1(&mut self, len: usize) -> Result<String, EtfError> {
   425	        let bytes = self.take(len)?;
   426	        Ok(bytes.iter().map(|&byte| char::from(byte)).collect())
   427	    }
   428	
   429	    /// `0x6d`/`0x76`/`0x77`: строгий UTF-8 (иначе `InvalidUtf8`).
   430	    fn utf8(&mut self, len: usize, at: usize) -> Result<String, EtfError> {
   431	        let bytes = self.take(len)?;
   432	        std::str::from_utf8(bytes)
   433	            .map(str::to_owned)
   434	            .map_err(|_| EtfError::InvalidUtf8 { at })
   435	    }
   436	
   437	    /// `0x68`/`0x69`: кортеж (в трафике — массивы без хвоста).
   438	    fn tuple(&mut self, count: usize, depth: usize, at: usize) -> Result<EtfValue, EtfError> {
   439	        check_depth(depth, at)?;
   440	        let mut items = Vec::new();
   441	        for _ in 0..count {
   442	            items.push(self.term(depth + 1)?);
   443	        }
   444	        Ok(EtfValue::Tuple(items))
   445	    }
   446	
   447	    /// `0x6c`: список с обязательным хвостовым `NIL_EXT` (8794/8794 в захвате).
   448	    fn list(&mut self, depth: usize, at: usize) -> Result<EtfValue, EtfError> {
   449	        check_depth(depth, at)?;
   450	        let count = self.u32_be()? as usize;
   451	        let mut items = Vec::new();
   452	        for _ in 0..count {
   453	            items.push(self.term(depth + 1)?);
   454	        }
   455	        let tail_at = self.pos;
   456	        let tail_tag = self.u8()?;
   457	        if tail_tag != TAG_NIL_EXT {
   458	            return Err(EtfError::ListTailNotNil {
   459	                tail_tag,
   460	                at: tail_at,
   461	            });
   462	        }
   463	        Ok(EtfValue::List(items))
   464	    }
   465	
   466	    /// `0x74`: map; порядок пар сохраняется.
   467	    fn map(&mut self, depth: usize, at: usize) -> Result<EtfValue, EtfError> {
   468	        check_depth(depth, at)?;
   469	        let count = self.u32_be()? as usize;
   470	        let mut pairs = Vec::new();
   471	        for _ in 0..count {
   472	            let key = self.term(depth + 1)?;
   473	            let value = self.term(depth + 1)?;
   474	            pairs.push((key, value));
   475	        }
   476	        Ok(EtfValue::Map(pairs))
   477	    }
   478	
   479	    /// `0x6e`/`0x6f`: big-int `[n][sign][n байт LE]` — знак **до** цифр (§2.5 спеки).
   480	    fn big_int(&mut self, digits: usize, at: usize) -> Result<EtfValue, EtfError> {
   481	        if digits > BIG_INT_MAX_DIGITS {
   482	            return Err(EtfError::BigIntOverflow { at });
   483	        }
   484	        let sign = self.u8()?;
   485	        let bytes = self.take(digits)?;
   486	        let mut magnitude: u128 = 0;
   487	        for &byte in bytes.iter().rev() {
   488	            magnitude = (magnitude << 8) | u128::from(byte);
   489	        }
   490	        const TWO_POW_63: u128 = 1 << 63;
   491	        if sign == 0 {
   492	            if magnitude > i64::MAX as u128 {
   493	                return Err(EtfError::BigIntOverflow { at });
   494	            }
   495	            Ok(EtfValue::Int(magnitude as i64))
   496	        } else {
   497	            if magnitude > TWO_POW_63 {
   498	                return Err(EtfError::BigIntOverflow { at });
   499	            }
   500	            if magnitude == TWO_POW_63 {
   501	                return Ok(EtfValue::Int(i64::MIN));
   502	            }
   503	            Ok(EtfValue::Int(-(magnitude as i64)))
   504	        }
   505	    }
   506	}
