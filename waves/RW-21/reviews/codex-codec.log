    73	/// Инкрементальный декодер непрерывного zstd-потока шлюза.
    74	///
    75	/// Внутри — один [`FrameDecoder`] на весь поток: `end()` (сброс/завершение) не вызывается,
    76	/// поэтому окно и состояние блока переживают границы WS-сообщений.
    77	pub struct ZstdStream {
    78	    /// Декодер непрерывного кадра `ruzstd`.
    79	    decoder: FrameDecoder,
    80	    /// Ещё не отданные сжатые байты (хвост, который декодер не смог разобрать целиком).
    81	    pending: Vec<u8>,
    82	    /// Проверена ли магия потока (первая четвёрка байт; только кадр 0).
    83	    magic_checked: bool,
    84	    /// Декодер уже начинал разбор кадра (у свежего `FrameDecoder` `is_finished() == true`).
    85	    initialized: bool,
    86	    /// Поток терминально завершён ошибкой; дальнейшие `push` запрещены.
    87	    dead: bool,
    88	    /// Переиспользуемый буфер выдачи.
    89	    target: Vec<u8>,
    90	}
    91	
    92	impl ZstdStream {
    93	    /// Пустой поток; магия проверяется на первых поданных байтах.
    94	    pub fn new() -> Self {
    95	        Self {
    96	            decoder: FrameDecoder::new(),
    97	            pending: Vec::new(),
    98	            magic_checked: false,
    99	            initialized: false,
   100	            dead: false,
   101	            target: vec![0u8; TARGET_CAPACITY],
   102	        }
   103	    }
   104	
   105	    /// Добавляет кусок провода (одно WS-сообщение) и возвращает **новые** распакованные байты.
   106	    ///
   107	    /// Алгоритм:
   108	    /// 1. если поток уже ошибался — [`ZstdError::Poisoned`] (декодер не трогается);
   109	    /// 2. кусок добавляется в накопитель `pending`;
   110	    /// 3. пока не проверена магия: при `pending.len() >= 4` сверка с [`crate::ZSTD_FRAME_MAGIC`]
   111	    ///    (нет — [`ZstdError::MissingMagic`]); при `pending.len() < 4` — `Ok` с пустым выходом;
   112	    /// 4. цикл декодирования: `ruzstd` получает весь накопитель и переиспользуемый буфер выдачи.
   113	    ///    Продвижение считается **дельтой `bytes_read_from_source()`**, а не возвращённым кортежем
   114	    ///    (у `ruzstd` есть ветка с некорректным возвратом при добирании контрольной суммы);
   115	    ///    разобранные сжатые байты снимаются с накопителя;
   116	    /// 5. цикл крутится, пока есть прогресс (прочитаны сжатые байты или выданы распакованные):
   117	    ///    за один вызов ruzstd отдаёт не более ёмкости буфера выдачи, а payload больше неё
   118	    ///    (синтетика: 139 264 Б при буфере 64 КиБ);
   119	    /// 6. ошибка `ruzstd` → [`ZstdError::Decode`]; если кадр уже начат и завершён, а накопитель
   120	    ///    не пуст → [`ZstdError::TrailingData`]. Любая из этих ошибок переводит поток в `dead`.
   121	    ///
   122	    /// Паник нет: накопитель растёт ровно на поданные байты и снимается по счётчику декодера.
   123	    pub fn push(&mut self, frame: &[u8]) -> Result<Vec<u8>, ZstdError> {
   124	        if self.dead {
   125	            return Err(ZstdError::Poisoned);
   126	        }
   127	        self.pending.extend_from_slice(frame);
   128	
   129	        if !self.magic_checked {
   130	            if self.pending.len() < crate::ZSTD_FRAME_MAGIC.len() {
   131	                // Магия ещё не собрана — ничего не декодируем и не решаем.
   132	                return Ok(Vec::new());
   133	            }
   134	            if self.pending[..crate::ZSTD_FRAME_MAGIC.len()] != crate::ZSTD_FRAME_MAGIC {
   135	                self.dead = true;
   136	                return Err(ZstdError::MissingMagic);
   137	            }
   138	            self.magic_checked = true;
   139	        }
   140	
   141	        let mut out = Vec::new();
   142	        loop {
   143	            // Заголовок читается из среза целиком: пока его нет, попытка бессмысленна.
   144	            if self.decoder.bytes_read_from_source() == 0 && self.pending.len() < FRAME_HEADER_MAX {
   145	                break;
   146	            }
   147	            let before = self.decoder.bytes_read_from_source();
   148	            let result = self.decoder.decode_from_to(&self.pending, &mut self.target);
   149	            let written = match result {
   150	                Ok((_reported, written)) => written,
   151	                Err(error) => {
   152	                    self.dead = true;
   153	                    return Err(ZstdError::Decode {
   154	                        msg: error.to_string(),
   155	                    });
   156	                }
   157	            };
   158	            self.initialized = true;
   159	            // Счётчик декодера монотонен, но берём saturating_sub: паника хуже, чем ноль.
   160	            // Источник у декодера один — `pending`, поэтому дельта не превышает его длину;
   161	            // `min` — страховка от паники `drain` на будущих версиях ruzstd.
   162	            let delta = self.decoder.bytes_read_from_source().saturating_sub(before);
   163	            let advanced = usize::try_from(delta)
   164	                .unwrap_or(usize::MAX)
   165	                .min(self.pending.len());
   166	            if advanced > 0 {
   167	                self.pending.drain(..advanced);
   168	            }
   169	            if written > 0 {
   170	                out.extend_from_slice(&self.target[..written]);
   171	            }
   172	            if advanced == 0 && written == 0 {
   173	                // Прогресса нет: источник и буфер выдачи исчерпаны до следующего push.
   174	                break;
   175	            }
   176	        }
   177	
   178	        // NB: свежий `FrameDecoder` без состояния тоже отвечает `is_finished() == true`
   179	        // (кадра ещё нет), поэтому хвост проверяем только после инициализации декодера.
   180	        if self.initialized && self.decoder.is_finished() && !self.pending.is_empty() {
   181	            self.dead = true;
   182	            return Err(ZstdError::TrailingData {
   183	                bytes: self.pending.len(),
   184	            });
   185	        }
   186	        Ok(out)
   187	    }
   188	
   189	    /// Сколько сжатых байт потока уже разобрано — `FrameDecoder::bytes_read_from_source()`.
   190	    pub fn compressed_consumed(&self) -> u64 {
   191	        self.decoder.bytes_read_from_source()
   192	    }
   193	
   194	    /// Терминально ли поток завершён ошибкой; после `true` `push` возвращает [`ZstdError::Poisoned`].
   195	    pub fn is_dead(&self) -> bool {
   196	        self.dead
   197	    }
   198	
   199	    /// Завершён ли текущий кадр.
   200	    ///
   201	    /// У свежего потока — `false` (кадра ещё нет), после полного кадра — `true`, у непрерывного
   202	    /// потока шлюза (`end()` не вызывался) — `false`.
   203	    pub fn is_finished(&self) -> bool {
   204	        self.initialized && self.decoder.is_finished()
   205	    }
   206	}
   207	
   208	impl Default for ZstdStream {
   209	    fn default() -> Self {
   210	        Self::new()
   211	    }
   212	}

