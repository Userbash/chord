   299	fn big_int_rejects_overflow_and_keeps_signed_borders() {
   300	    // n > 16 → BigIntOverflow (0x6e: u8 n, 0x6f: u32 n).
   301	    let mut small17 = vec![0x6e, 17, 0];
   302	    small17.extend([0u8; 17]);
   303	    assert!(matches!(
   304	        expect_err("0x6e n=17", &small17),
   305	        EtfError::BigIntOverflow { .. }
   306	    ));
   307	    let mut large17 = vec![0x6f, 0, 0, 0, 17, 0];
   308	    large17.extend([0u8; 17]);
   309	    assert!(matches!(
   310	        expect_err("0x6f n=17", &large17),
   311	        EtfError::BigIntOverflow { .. }
   312	    ));
   313	    // sign=0 и magnitude > i64::MAX.
   314	    assert!(matches!(
   315	        expect_err("u64::MAX положительный", &unhex("6e0800ffffffffffffffff")),
   316	        EtfError::BigIntOverflow { .. }
   317	    ));
   318	    // sign=1 и magnitude > 2^63.
   319	    assert!(matches!(
   320	        expect_err("2^63+1 отрицательный", &unhex("6e08 01 0100000000000080")),
   321	        EtfError::BigIntOverflow { .. }
   322	    ));
   323	    // Границы i64 разбираются: i64::MAX (sign=0) и i64::MIN (sign=1, magnitude 2^63).
   324	    assert_eq!(
   325	        etf::decode_term(&unhex("6e0800ffffffffffffff7f")),
   326	        Ok((int(i64::MAX), 11))
   327	    );
   328	    assert_eq!(
   329	        etf::decode_term(&unhex("6e08 01 0000000000000080")),
   330	        Ok((int(i64::MIN), 11))
   331	    );
   332	    assert_eq!(
   333	        etf::decode_term(&unhex("6f00000008010000000000000080")),
   334	        Ok((int(i64::MIN), 14))
   335	    );
   336	    // Ноль байт цифр: 6e 00 sign → 0.
   337	    assert_eq!(etf::decode_term(&unhex("6e0000")), Ok((int(0), 3)));
   338	}
