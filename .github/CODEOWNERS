# CODEOWNERS — automatic reviewer assignment based on changed files
# GitHub automatically adds listed reviewers to PRs
# Format: <glob-pattern> <@github-username or @team>
#
# Rule: PR author must NOT be in the reviewer list for their own code
# For AI workers: reviewer = different model/account

# ─── SHARED / COORDINATOR ONLY ───────────────────────────────
# These files require approval from the project coordinator
Cargo.lock                              @Userbash
package-lock.json                       @Userbash
TASKS.md                                @Userbash
AGENTS.md                               @Userbash
PROCESS.md                              @Userbash
TEAM.md                                 @Userbash
TEST-POLICY.md                          @Userbash
waves/                                  @Userbash
.claude/ecc2.toml                       @Userbash

# ─── CI / DEVOPS ─────────────────────────────────────────────
.github/                                @Userbash
scripts/                                @Userbash
*.toml                                  @Userbash

# ─── G1: BACKEND (Rust Core, State, Gateway, REST) ───────────
/rust/crates/chord-core/                @Userbash
/rust/crates/chord-codec/               @Userbash
/rust/crates/chord-json/                @Userbash
/rust/crates/chord-store/               @Userbash
/rust/crates/chord-i18n/                @Userbash
/rust/chord-gpui/src/*.rs               @Userbash

# ─── G2: FRONTEND (UI, Views) ────────────────────────────────
/rust/chord-gpui/src/views/             @Userbash

# ─── G5: VOICE / PLATFORM ────────────────────────────────────
/rust/crates/chord-voice/               @Userbash
