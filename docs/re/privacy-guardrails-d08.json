{
  "task": "D-08",
  "title": "Platform Privacy Guardrails",
  "target": "Platform Shell",
  "version": "1.0.162",
  "provenance": {
    "mainArch": "docs/re/main-arch.md",
    "mainArchJson": "docs/re/main-arch.json",
